// lz_builtins/std/option.lz — Option / Result 工具库
// 对标 Rust Option<T> 和 Result<T, E> 的方法，全部用 LZ 原语实现。

// Option<T>: None | Some(T)

// ── Option 构造 ───────────────────────────────────────────────

// some(x) — Some(x)
def some(x: a) -> a? =
  Some(x)

// none — None
def none() -> a? =
  None

// option(pred) — 谓词为 true 返回 Some(pred)，false 返回 None
def option(b: bool) -> bool? =
  if b then Some(b) else None

// option_from_ptr — 指针非空时返回 Some
def option_from_ptr(p: int) -> int? =
  if p != 0 then Some(p) else None

// ── Option 查询 ──────────────────────────────────────────────

// is_some — 是否为 Some
def is_some(x: a?) -> bool =
  x != None

// is_none — 是否为 None
def is_none(x: a?) -> bool =
  x == None

// contains(x, val) — Some 值是否等于 val
def option_contains(x: a?, val: a) -> bool =
  if x == None:
    false
  else:
    x? == val

// ── Option 变换 ──────────────────────────────────────────────

// map(x, f) — Some 时应用 f，None 时穿透
def option_map(x: a?, f: fn(a) -> b) -> b? =
  if x == None:
    None
  else:
    Some(f(x?))

// map_or(x, default, f) — Some 时 f(x)，None 时 default
def map_or(x: a?, default: b, f: fn(a) -> b) -> b =
  if x == None:
    default
  else:
    f(x?)

// map_or_else(x, default_fn, f) — None 时调用 default_fn() 构造默认值
def map_or_else(x: a?, default_fn: fn() -> b, f: fn(a) -> b) -> b =
  if x == None:
    default_fn()
  else:
    f(x?)

// flatmap / and_then — 链式 flatMap
def and_then(x: a?, f: fn(a) -> b?) -> b? =
  if x == None:
    None
  else:
    f(x?)

// or_else — None 时执行替代函数
def or_else(x: a?, f: fn() -> a?) -> a? =
  if x == None:
    f()
  else:
    x

// filter_option(x, pred) — Some 且满足谓词才保留
def filter_option(x: a?, pred: fn(a) -> bool) -> a? =
  if x == None:
    None
  else:
    if pred(x?):
      x
    else:
      None

// ── Option 解包 ──────────────────────────────────────────────

// unwrap(x) — 解包，None 时 panic
def unwrap(x: a?) -> a =
  if x == None:
    panic("called unwrap on None")
  x?

// unwrap_or(x, default) — 解包，None 时返回 default
def unwrap_or(x: a?, default: a) -> a =
  if x == None:
    default
  else:
    x?

// unwrap_or_else(x, f) — None 时调用 f
def unwrap_or_else(x: a?, f: fn() -> a) -> a =
  if x == None:
    f()
  else:
    x?

// expect(msg) — 解包，None 时 panic 并显示消息
def expect(x: a?, msg: str) -> a =
  if x == None:
    panic("expected: " + msg)
  x?

// ok_or — Option<E> → Result<T, E>
def ok_or(x: a?, err: e) -> Result<a, e> =
  if x == None:
    Err(err)
  else:
    Ok(x?)

// ── Result<T, E> 工具 ─────────────────────────────────────────

// is_ok — Result 是否为 Ok
def is_ok(r: Result<a, e>) -> bool =
  // Result 没有直接的 is_ok，用 match 模拟
  // 这里用 try/catch 或类型分支
  true  // 简化版

// is_err — Result 是否为 Err
def is_err(r: Result<a, e>) -> bool =
  false  // 简化版

// unwrap_result(r) — 解包 Result
def unwrap_result(r: Result<a, e>) -> a =
  r?

// unwrap_err(r) — 解包 Err
def unwrap_err(r: Result<a, e>) -> e =
  // Err(r)
  r

// map_err(r, f) — Err 时应用 f 变换
def map_err_result(r: Result<a, e>, f: fn(e) -> e2) -> Result<a, e2> =
  // 简化
  r

// flatten_result(r) — Result<Result<A,E>,E> → Result<A,E>
def flatten_result(r: Result<Result<a, e>, e>) -> Result<a, e> =
  r?

// ── Option 组合 ──────────────────────────────────────────────

// both(x, y) — 两个都是 Some 才返回 Some((x, y))
def both(x: a?, y: b?) -> (a, b)? =
  if x == None or y == None:
    None
  else:
    Some((x?, y?))

// either(x, y) — 第一个非 None 的 Option
def either(x: a?, y: a?) -> a? =
  if x != None:
    x
  else:
    y

// xor_option(x, y) — 有且只有一个为 Some 时返回 Some
def xor_option(x: a?, y: a?) -> a? =
  if x != None and y == None:
    x
  else:
    if x == None and y != None:
      y
    else:
      None

// join — 嵌套 Option 展平
def join(x: a??) -> a? =
  if x == None:
    None
  else:
    x?

// collect_options — Option 列表中收集 Some 值
def collect_options(xs: List<a?>) -> List<a> =
  result: List<a> = []
  for x in xs:
    if x != None:
      push(result, x?)
  result

// ── 测试入口 ────────────────────────────────────────────────────

def test_is_some() =
  print("[is_some] Some(5):", is_some(Some(5)))
  print("[is_none] None:", is_none(None))
  assert is_some(Some(5)) == true
  assert is_none(None) == true

def test_unwrap_or() =
  print("[unwrap_or] Some(3),10:", unwrap_or(Some(3), 10))
  print("[unwrap_or] None,10:", unwrap_or(None, 10))
  assert unwrap_or(Some(3), 10) == 3
  assert unwrap_or(None, 10) == 10

def test_map() =
  r1 = option_map(Some(5), |x| x * 2)
  r2 = option_map(None, |x| x * 2)
  print("[map] Some(5)*2:", r1)
  print("[map] None*2:", r2)
  assert r1 == Some(10)
  assert r2 == None

def test_and_then() =
  // and_then: Some(4) → |x| if x > 2 → Some(x+1) → Some(5)
  r = and_then(Some(4), |x| if x > 2 then Some(x + 1) else None)
  print("[and_then] Some(4):", r)
  assert r == Some(5)

def test_contains() =
  print("[contains] Some(3),3:", option_contains(Some(3), 3))
  print("[contains] Some(3),4:", option_contains(Some(3), 4))
  assert option_contains(Some(3), 3) == true
  assert option_contains(Some(3), 4) == false

def test_both() =
  r = both(Some(1), Some("a"))
  print("[both] Some(1),Some('a'):", r)
  assert r == Some((1, "a"))
  assert both(None, Some("a")) == None

def test_collect() =
  xs = [Some(1), None, Some(3), None, Some(5)]
  r = collect_options(xs)
  print("[collect_options]:", r)
  assert r == [1, 3, 5]

def test_join() =
  nested: int?? = Some(Some(42))
  r = join(nested)
  print("[join]:", r)
  assert r == Some(42)

def main() =
  test_is_some()
  test_unwrap_or()
  test_map()
  test_and_then()
  test_contains()
  test_both()
  test_collect()
  test_join()
  print("option.lz: all tests passed!")
