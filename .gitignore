/target
*.exe
*.pdb

# generated .rs output from lzc — keep only source in src/
*.rs
!src/**/*.rs
!tests/**/*.rs
# workspace 成员的 Rust 源码必须入库（否则干净检出无法构建）
!lz_builtins/**/*.rs
!lz-infer/**/*.rs
# std 目录的 Rust 桥接源（shims.rs，被 src/codegen 引用）同样必须入库
!std/**/*.rs

# generated LZ IR codegen intermediate (.lzlz → .rs → .exe) from --emit=ir-lz
*.lzlz

# generated output directories
test-suite/*/_work/
test-suite/*/__pycache__/
*.pyc

# build artifacts
*.o
*.so
*.dylib

# workspace-specific
.workbuddy/
workbuddy/
# 自举目录：只入库规范文档、脚本与 .lz 试点源（构建产物 .rs/.exe/log/backup 不入库）
bootstrap/*
!bootstrap/01-自举总纲.md
!bootstrap/02-自举前置条件清单.md
!bootstrap/03-自举执行计划.md
!bootstrap/04-当前项目自举具体方案.md
!bootstrap/05-自举里程碑台账.md
!bootstrap/06-自举交接续推文档.md
!bootstrap/README.md
!bootstrap/build.sh
!bootstrap/build.ps1
!bootstrap/rollback.sh
!bootstrap/rollback.ps1
!bootstrap/work/
bootstrap/work/*
!bootstrap/work/fail_drill.sh
!bootstrap/work/*.lz
!bootstrap/work/lz_ir/
bootstrap/work/lz_ir/*
!bootstrap/work/lz_ir/*.lz
!bootstrap/work/lz_ir/*.ps1
!bootstrap/work/lz_ir/README.md
!bootstrap/work/lz_codegen/
bootstrap/work/lz_codegen/*
!bootstrap/work/lz_codegen/*.ps1
!bootstrap/stage/
bootstrap/stage/*
!bootstrap/stage/*.ps1
!bootstrap/stage/*.lz
!bootstrap/stage/*.md
!bootstrap/work/lz_lexer/
bootstrap/work/lz_lexer/*
!bootstrap/work/lz_lexer/*.lz
!bootstrap/work/lz_parser/
bootstrap/work/lz_parser/*
!bootstrap/work/lz_parser/*.lz

err.log
demo_err.log
demo_rc.log
rc.log
.trae/
_bak/
_mz/

