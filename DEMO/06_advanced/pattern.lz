// ==== Advanced Pattern Matching ====
enum Result<T, E>:
    Ok(T)
    Err(E)

enum Shape:
    Circle(x: f64, y: f64, radius: f64)
    Rect(x: f64, y: f64, w: f64, h: f64)

def process(result: Result<int, str>) -> str =
    match result:
        case Ok(0) => "zero"
        case Ok(v) => f"got {v}"
        case Err(e) => f"error: {e}"

def info(s: Shape) -> str =
    match s:
        case Shape.Circle(radius: r) => f"circle r={r}"
        case Shape.Rect(w: w, h: h1) => f"rect {w}x{h1}"

def main() =
    print(process(Ok(5)))
    print(process(Err("fail")))
    let c = Shape.Circle(x: 0.0, y: 0.0, radius: 3.0)
    print(info(c))
