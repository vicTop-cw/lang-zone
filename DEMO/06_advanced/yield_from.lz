// ==== Generator ====
def counter(n: int) -> int =
    for i in 0..n:
        yield i

def chain(a: int, b: int) -> int =
    yield from counter(a)
    yield from counter(b)

def gen() -> int =
    yield 1
    yield 2
    yield 3
    yield from gen()

def main() =
    for x in counter(3):
        print(x)
    for x in chain(2, 2):
        print(x)
