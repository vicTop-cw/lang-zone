// ==== Testing ====
def add(a: int, b: int) -> int = a + b

test "basic addition":
    let result = add(2, 3)
    assert result == 5
    check result > 0

test "zero addition":
    assert add(0, 5) == 5
    assert add(0, 0) == 0

suite "math operations":
    setup:
        let base = 10

    test "add with base":
        assert add(base, 5) == 15

    teardown:
        print("test done")

def main() =
    print("all tests passed")
