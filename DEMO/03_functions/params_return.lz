// ==== Params & Return ====
def greet(ref name: str) -> str =
    f"Hello, {name}!"

def div(a: int, b: int = 1) -> int =
    if b == 0:
        return 0
    a / b

def process(ref data: List<int>) =
    data.append(42)

def main() =
    let s = "World"
    print(greet(s))
    print(f"10/2 = {div(10, 2)}")
    print(f"10/0 = {div(10, 0)}")
    let xs = [1, 2, 3]
    process(xs)
    print(f"xs = {xs}")
