// ============================================================
// break / continue — with and without values, nested loops
// LZ Spec §6
// ============================================================

def main() =
    // --- 6.1 break: exit the innermost loop ---
    for x in [1, 2, 3, 4, 5]:
        if x > 3:
            break              // exit the for loop
        print(x)               // 1 2 3

    // --- break with value (only valid in loop body) ---
    let found = loop:
        for i in 0..100:
            if i == 42:
                break i        // loop returns 42
        break -1               // fallback

    print(found)               // 42

    // --- 6.2 continue: skip to next iteration ---
    for x in [1, 2, 3, 4, 5]:
        if x < 3:
            continue           // skip x < 3
        print(x)               // 3 4 5

    // --- continue skips even numbers ---
    total = 0
    for x in [1, 2, 3, 4, 5]:
        if x % 2 == 0:
            continue           // skip even numbers
        total += x             // odd numbers only: 1 + 3 + 5
    print(total)               // 9

    // --- break in nested loop: targets innermost only ---
    for i in 0..3:
        for j in 0..3:
            if j == 1:
                break          // only breaks inner loop
            print(f"({i},{j})") // (0,0) (1,0) (2,0)

    // --- continue in nested loop: targets innermost only ---
    for i in 0..3:
        for j in 0..3:
            if j == 1:
                continue       // only skips inner loop iteration
            print(f"[{i},{j}]")
