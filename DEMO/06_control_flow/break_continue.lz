// ============================
// LZ Control Flow — break / continue
// ============================

def main() =
    // --- break: exit the innermost loop ---
    // break supports single-level only
    for x in [1, 2, 3, 4, 5]:
        if x > 3:
            break              // exit the for loop
        print(x)               // 1 2 3

    // break with value (return from loop)
    let found = loop:
        for i in 0..100:
            if i == 42:
                break i        // loop returns 42
        break -1               // fallback

    print(found)               // 42

    // --- continue: skip to next iteration ---
    for x in [1, 2, 3, 4, 5]:
        if x < 3:
            continue           // skip x < 3
        print(x)               // 3 4 5

    // continue with value (only valid in loop body)
    // continue expr  // skips to next iteration, expr is evaluated

    // continue带值形式（仅 loop 体中有效）
    total = 0
    for x in [1, 2, 3, 4, 5]:
        if x % 2 == 0:
            continue
        total += x              // odd numbers only: 1 + 3 + 5
    print(total)                // 9
