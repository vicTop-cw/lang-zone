// ============================
// LZ Control Flow — break / continue
// ============================

def main() =
    for x in [1, 2, 3, 4, 5]:
        if x > 3:
            break
        print(x)

    for x in [1, 2, 3, 4, 5]:
        if x < 3:
            continue
        print(x)

    total = 0
    for x in [1, 2, 3, 4, 5]:
        if x % 2 == 0:
            continue
        total += x
    print(total)
