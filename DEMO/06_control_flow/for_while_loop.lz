// ============================
// LZ Control Flow — for / while / loop
// ============================

def main() =
    // --- for loop ---
    for i in 0..5:
        print(i)          // 0 1 2 3 4

    for x in [1, 2, 3]:
        print(x)          // 1 2 3

    for (k, v) in {"a": 1, "b": 2}:
        print(f"{k}: {v}")

    // --- Declarative for: sum / prod ---
    let total = sum x in 1..5: x * x     // 1 + 4 + 9 + 16 = 30
    let fact = prod i in 1..5: i          // 1*2*3*4 = 24
    print(total, fact)

    // --- while loop ---
    i = 0
    while i < 5:
        print(i)
        i += 1

    // --- while/else ---
    n = 3
    while n > 0:
        print(n)
        n -= 1
    else:
        print("while done")     // executes when condition becomes false

    // --- loop (infinite, needs break) ---
    count = 0
    loop:
        if count >= 3:
            break
        print(count)
        count += 1

    // loop does NOT support else
    // loop ... else:  // ❌ not valid
