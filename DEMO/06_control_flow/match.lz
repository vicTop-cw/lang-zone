// ============================================================
// match / case — Colon blocks, => inline, nested patterns
// LZ Spec §2
// ============================================================

enum Color =
    Red
    Green
    Blue

enum Shape =
    Circle(x: f64, y: f64, radius: f64)
    Rectangle(width: f64, height: f64)
    Square(side: f64)

// --- 2.1 Colon form (block body) ---
def describe_num(n: int) -> str =
    match n:
        case 0:
            "zero"
        case 1:
            "one"
        case _:
            "other"

// --- 2.2 Fat arrow form (inline) ---
def describe_color(c: Color) -> str =
    match c:
        case Color.Red => "warm"
        case Color.Green => "nature"
        case Color.Blue => "calm"

// --- 2.3 String literal matching ---
def greet(name: str) -> str =
    match name:
        case "hello":
            "greeting"
        case "bye":
            "farewell"
        case _:
            "unknown"

// --- 2.4 Nested patterns ---
def process_result(result: Result<Option<int>, str>) -> str =
    match result:
        case Ok(Some(v)):
            f"got: {v}"
        case Ok(None):
            "empty"
        case Err(e):
            f"error: {e}"

// --- 2.5 Enum variant destructuring ---
def area(shape: Shape) -> f64 =
    match shape:
        Shape.Circle(x: _, y: _, radius: r) =>
            3.14 * r * r
        Shape.Rectangle(width: w, height: h) =>
            w * h
        Shape.Square(side: s) =>
            s * s

def main() =
    // Colon form
    let d = describe_num(0)
    print(d)                         // "zero"
    print(describe_num(5))           // "other"

    // Arrow form
    let c = describe_color(Color.Red)
    print(c)                         // "warm"

    // String match
    print(greet("hello"))            // "greeting"
    print(greet("unknown"))          // "unknown"

    // Nested patterns
    let r1: Result<Option<int>, str> = Ok(Some(42))
    print(process_result(r1))        // "got: 42"

    let r2: Result<Option<int>, str> = Ok(None)
    print(process_result(r2))        // "empty"

    let r3: Result<Option<int>, str> = Err("oops")
    print(process_result(r3))        // "error: oops"

    // Enum destructuring
    let circle = Shape.Circle(x: 0.0, y: 0.0, radius: 5.0)
    print(area(circle))
