// ============================
// LZ Control Flow — guard / guard let
// ============================

def main() =
    // --- 7.1 guard condition guard ---
    // guard cond else: handler → when cond is False, execute handler
    // when cond is True, continue with code after the guard block
    def safe_div(a: int, b: int) -> int =
        guard b != 0 else:
            return 0          // fail path: return early
        // guard b != 0 else 0  // can be written inline and no `return` keyword
        a / b                  // success path: continues here

    print(safe_div(10, 2))     // 5
    print(safe_div(10, 0))     // 0

    // guard with truthiness chain (__bool__ → __len__ → default true)
    def process(val: Option<int>) -> str =
        guard let Some(n) = val else:
            return "empty"
        f"value: {n}"

    print(process(Some(42)))   // "value: 42"
    print(process(None))       // "empty"

    // --- 7.2 guard let pattern guard ---
    // guard let PATTERN = expr else: handler
    // pattern match success → bind variables and continue
    // pattern match failure → execute else handler

    let opt_name: Option<str> = Some("Alice")
    guard let Some(name) = opt_name else:
        print("no name")
        return

    print(f"hello {name}")     // "hello Alice"
