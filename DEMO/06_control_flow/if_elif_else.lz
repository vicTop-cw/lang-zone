// ============================
// LZ Control Flow — if / elif / else
// ============================

def main() =
    // --- 1.1 Basic if/elif/else ---
    score = 85

    if score >= 90:
        print("A")
    elif score >= 80:
        print("B")        // executes: score is 85
    elif score >= 70:
        print("C")
    else:
        print("D")

    // --- 1.2 if expression (returns value) ---
    let grade = if score >= 90:
            "A"
        elif score >= 80:
            "B"
        else:
            "C"
    print(grade)           // "B"

    // --- 1.3 Single condition (no else required) ---
    if x > 0:
        print("positive")

    // --- else keyword used with other constructs ---
    // else with for: executes when loop ends normally (no break)
    for i in 0..3:
        if i == 10:       // never true
            break
    else:
        print("loop completed normally")

    // else with while: executes when condition becomes false
    n = 5
    while n > 0:
        n -= 1
    else:
        print("while done")

let x = 10
