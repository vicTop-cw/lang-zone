// ============================================================
// if / elif / else — Statement, Expression, Ternary
// LZ Spec §1, §13.1
// ============================================================

def classify(score: int) -> str =
    // --- 1.1 if/elif/else as statement ---
    if score >= 90:
        "A"
    elif score >= 80:
        "B"
    elif score >= 70:
        "C"
    else:
        "F"

def sign(n: int) -> str =
    // --- 1.4 Ternary: a if cond else b ---
    "positive" if n > 0 else "negative" if n < 0 else "zero"

def main() =
    // --- 1.1 Statement form ---
    score = 85
    if score >= 90:
        print("A")
    elif score >= 80:
        print("B")        // executes: score is 85
    elif score >= 70:
        print("C")
    else:
        print("D")

    // --- 1.2 if expression (returns value) ---
    let grade = if score >= 90:
            "A"
        elif score >= 80:
            "B"
        else:
            "C"
    print(grade)           // "B"

    // --- 1.3 Single condition (no else required) ---
    if score > 0:
        print("positive")

    // --- 1.4 Ternary expression a if cond else b ---
    let status = "pass" if score >= 60 else "fail"
    print(status)          // "pass"

    let msg = "even" if score % 2 == 0 else "odd"
    print(msg)             // "odd"

    // Nested ternary
    let r = classify(95)
    print(r)               // "A"

    print(sign(5))         // "positive"
    print(sign(-3))        // "negative"
    print(sign(0))         // "zero"

    // --- 1.5 for/else (loop normal completion) ---
    for i in 0..3:
        if i == 10:       // never true — no break
            break
    else:
        print("for loop completed normally")  // executes

    // --- 1.6 while/else (condition becomes false) ---
    n = 5
    while n > 0:
        n -= 1
    else:
        print("while loop done")  // executes after loop ends

    // --- 1.7 pass no-op in a branch ---
    if False:
        pass               // no-op placeholder
    else:
        print("pass demo ok")
