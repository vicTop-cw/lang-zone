// ============================
// LZ Modules — import / from / as / bridge
// ============================

// --- 1. Import a module ---
import std.io
import std.collections.HashMap

// --- 2. Import with alias ---
import std.collections.HashMap as Map

// --- 3. From import (selective) ---
from std.io import print, read
from std.collections import List, Dict

// --- 4. Import all public items ---
from std.io import *

// --- 5. Relative imports ---
from .utils import helper
from ..common import config

// --- 6. Bridge system (Rust interop) ---
import std.bridge.rust.serde_json

// --- 7. @export decorator for FFI ---
@export(Rust)
def add(a: int, b: int) -> int = a + b

@export(Python)
def greet(name: str) -> str = f"Hello, {name}"

// --- 8. Module file structure ---
// Single file: math.lz → module "math"
// Directory module:
//   my_package/
//       __init__.lz     ← module entry point
//       utils.lz        ← sub-module
//       types.lz        ← sub-module

// --- 9. Bridge configuration (TOML) ---
// std/bridge/rust/serde_json.toml:
//   rust_prefix = "serde_json"
//   version = "1.0"

// --- Path syntax ---
// LZ uses "." as path separator (not "::")
// std.io.print          // module path
// std.collections.List  // type path
// Option.Some           // enum variant
// "::" is deprecated and produces a lexical error

def main() =
    let r = add(1, 2)
    print(r)
