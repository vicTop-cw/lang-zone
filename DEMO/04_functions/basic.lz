// ============================================================
// 04_functions / basic.lz
// 覆盖: 03-函数基础.md — def 声明、等式体、块体、
//       参数(ref/mut ref)、默认参数值、返回类型、
//       return 语句、raises 声明、@math 自动泛型
// ============================================================

// ── 1.1 等式体（单行）───────────────────────────────────
def add(a: int, b: int) -> int = a + b

def double(x) = x * 2              // 无注解，推断 int

def greet(name: str) -> str = f"Hello, {name}"

// ── 1.2 块体（多行）────────────────────────────────────
def max(a: int, b: int) -> int =
    if a > b:
        a
    else:
        b

// ── 2.1 基本参数 ──────────────────────────────────────
def multiply(a: int, b: int) -> int = a * b

// ── 2.2 @math 自动泛型化 ──────────────────────────────
@math
def sq(x, y) = x * x + y * y
// 编译器生成: sq<T: Number, U: Number>(x: T, y: U) = ...

// ── 2.3 参数修饰符 ref / mut ref ──────────────────────
def read_data(ref data: List<int>) -> int =
    data.len()

def modify(mut ref data: List<int>) =
    data.push(42)

// ── 2.4 默认参数值 ────────────────────────────────────
def greet_default(name: str = "world") -> str =
    f"Hello, {name}"

// ── 3.1 显式返回类型 ──────────────────────────────────
def is_positive(x: int) -> bool = x > 0

// ── 3.2 无注解返回类型（默认推断） ─────────────────────
def inferred_double(x) = x * 2       // -> int

// ── 3.3 main 函数（默认 ()） ──────────────────────────
def main() =
    print("=== basic.lz ===")
    print(add(3, 5))                 // 8
    print(double(7))                 // 14
    print(greet("LZ"))               // Hello, LZ
    print(max(10, 20))               // 20
    print(multiply(4, 6))            // 24
    print(sq(3, 4))                  // 25
    print(sq(3.0, 4.0))             // 25.0
    print(read_data([1, 2, 3]))     // 3
    print(greet_default())           // Hello, world
    print(greet_default("LZ"))       // Hello, LZ
    print(is_positive(-1))          // false
    print(inferred_double(5))       // 10
    print(divide(10, 2))            // 5
    print(early_exit(-5))           // 0
    print(early_exit(3))            // 4

// ── 3.4 无返回值 () ────────────────────────────────────
def log(msg: str) -> () =
    print(msg)

// ── 3.5 发散函数 Never ─────────────────────────────────
def abort(msg: str) -> Never =
    raise Exception(msg)

// ── 4. return 语句 ─────────────────────────────────────
def early_exit(x: int) -> int =
    if x < 0:
        return 0
    x + 1

// ── 5. raises 声明 ────────────────────────────────────
def divide(a: int, b: int) -> int raises str =
    if b == 0:
        raise "division by zero"
    a / b

// ── 边界情况（注释说明）────────────────────────────────
// ❌ 错误：冒号后缺少类型
// def bad(x:): ...
// ❌ 错误：-> 必须在参数列表后
// def bad(-> int): ...
// ❌ 错误：等式体换行不缩进
// def bad() =
// x + 1
