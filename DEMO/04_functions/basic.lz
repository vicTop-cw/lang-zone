// ============================
// LZ Functions — Basic def
// ============================

// --- 1.1 def declaration ---
def function_name(param1: int, param2: str) -> str =
    f"{param1}: {param2}"

// --- 1.2 Equational body (single line) ---
def double(x: int) -> int = x * 2
def greet(name: str) -> str = f"Hello, {name}"

// --- 1.3 Block body (multi-line) ---
def max(a: int, b: int) -> int =
    if a > b:
        a
    else:
        b

// --- 2.2 No-annotation parameters (@math auto-generic) ---
@math
def sq(x, y) = x * x + y * y
// sq(3, 4)     → 25 (int)
// sq(3.0, 4.0) → 25.0 (f64)

// --- 2.3 Parameter modifiers ---
def read_data(ref data: List<int>) -> int =
    data.len()

def modify(mut ref data: List<int>) =
    data.push(42)

// --- 2.4 Default parameter values ---
def greet_with_default(name: str = "world") -> str =
    f"Hello, {name}"

// --- Return types ---
def is_positive(x: int) -> bool = x > 0   // explicit return type
def inferred(x) = x * 2                    // default: int

def main() =
    // main() returns () by default
    print("hello")

// --- 3.5 Divergent function Never ---
def abort(msg: str) -> Never =
    raise Exception(msg)

// --- return statement ---
def early_exit(x: int) -> int =
    if x < 0:
        return 0          // early return
    x + 1                 // tail expression as return value
