// ============================================================
// 04_functions / checker.lz
// 覆盖: 03c-检查站.md — [checker_name] 语法、__Params、
//       调用时传入/跳过检查站、普通/可变参数/魔法方法
// ============================================================

// ── 1. 检查函数（契约: (__Params) -> __Params）──────────
def validate_age(ps: __Params) -> __Params =
    if ps.kwargs.contains("age"):
        let age = ps.kwargs["age"].downcast.<int>()
        if age < 0 or age > 150:
            raise "invalid age"
    ps

def validate_non_empty(ps: __Params) -> __Params =
    for arg in ps.args:
        val = arg.downcast.<str>()
        if val == "":
            raise "empty string not allowed"
    ps

// ── 2. 普通函数 + 检查站 ──────────────────────────────
def add[validate](a: int, b: int) -> int =
    a + b

def greet[check_non_empty](name: str) -> str =
    f"Hello, {name}"

// ── 3. 可变参数函数 + 检查站 ──────────────────────────
def send[validate]<R>(.., ..) -> R =
    for v in args:
        print(v)
    for (k, v) in kwargs:
        print(f"{k}: {v}")

// ── 4. 检查站 + 泛型 ──────────────────────────────────
def process[validate]<T: Display>(val: T) -> str =
    f"processed: {val}"

// ── 5. 带默认参数 + 检查站 ────────────────────────────
def config[validate](host: str = "localhost", port: int = 8080) -> str =
    f"{host}:{port}"

// ── main 入口 ──────────────────────────────────────────
def main() =
    print("=== checker.lz ===")
    print(add[validate_age](1, 2))            // 3
    print(greet[validate_non_empty]("LZ"))    // Hello, LZ
    print(add(10, 20))                        // 30（跳过检查站）
    print(config())                           // localhost:8080
    print(config("example.com", 443))         // example.com:443
    print(process[validate_age]<str>("hello"))

// ── 边界情况（注释说明）────────────────────────────────
// ❌ 错误：[checker] 在 <T> 之后
// def bad<T>[check](..) = ...
// ❌ 错误：检查站名称为空
// def bad[](..) = ...
// ✅ 正确位置
// def good[check]<T>(..) = ...
// ❌ 错误：自引用检查站
// def add[add](1, 2)
