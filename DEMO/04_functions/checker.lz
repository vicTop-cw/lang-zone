// ============================
// LZ Functions — Checker [checker]
// ============================

def check_positive(ps: __Params) -> __Params raises str =
    if ps.kwargs.contains("x"):
        let val = ps.kwargs["x"]
        if val <= 0:
            raise "must be positive"
    ps

def test_val[check_positive](x: int) -> int = x

def main() =
    let r1 = test_val[check_positive](5)
    print(r1)
