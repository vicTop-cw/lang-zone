// ==== Option<T> ====
def divide(a: int, b: int) -> Option<int> =
    if b == 0:
        None
    else:
        Some(a / b)

def main() =
    match divide(10, 2):
        case Some(v) => print(f"result={v}")
        case None => print("division by zero")
    match divide(10, 0):
        case Some(v) => print(f"result={v}")
        case None => print("division by zero")
