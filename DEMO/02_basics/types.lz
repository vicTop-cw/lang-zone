// ==== Type Annotations ====
def main() =
    let i: int = 42
    let s: str = "hello"
    let f: f64 = 3.14
    let b: bool = true
    let u: () = ()
    let xs: List<int> = [1, 2, 3]
    let d: Dict<str, int> = {"a": 1}
    let opt: Option<int> = Some(42)
    let none: Option<int> = None
    let ok: Result<int, str> = Ok(42)
    let err: Result<int, str> = Err("fail")
    print(f"{i},{s},{f}")
