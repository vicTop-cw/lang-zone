// ==== Variables & Bindings ====
def main() =
    // immutable binding
    let x = 42
    // mutable binding (default)
    y = 10
    y = 20
    // const
    const MAX = 100
    // immutable reference
    ref r = x
    // mutable reference
    mut ref mr = y
    mr = 30
    print(f"x={x} y={y} MAX={MAX}")
