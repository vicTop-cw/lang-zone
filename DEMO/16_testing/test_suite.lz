// ============================
// LZ Testing Framework (v3.2)
// ============================

// --- 1. Individual test: static name ---
test "addition":
    assert 1 + 1 == 2

test "subtraction":
    assert 5 - 3 == 2

// --- 2. Dynamic test name ---
for i in 1..3:
    test f"dynamic_{i}":
        assert i > 0

// --- 3. Suite ---
suite MathTests:
    test "add":
        assert 1 + 1 == 2
    test "mul":
        assert 2 * 3 == 6

// --- 4. Suite with setup/teardown ---
suite DatabaseTests:
    setup:
        prefix = "db"

    teardown:
        print("cleanup")

    test f"{prefix}_insert":
        assert 1 == 1

// --- 5. Suite/Test as first-class data ---
// struct Suite = name: str, tests: List<Test>, setup: Option<fn()>, teardown: Option<fn()>
// struct Test = name: str, body: fn(), suite_name: Option<str>

// SuiteOps trait (auto-implemented):
// def __add__(self, other: Suite) -> Suite
// def __getitem__(self, names: List<str>) -> Suite
// def __sub__(self, names: List<str>) -> Suite

// Global functions (auto-generated):
// def all_tests() -> List<Test>
// def suite_by_name(name: str) -> Suite
// def new_suite(name: str, tests: List<Test>) -> Suite

// --- 6. Composition: merge ---
suite CoreTests:
    test "core_add":
        assert 5 + 5 == 10

suite AllTests =
    new_suite("all", all_tests()) + CoreTests

// --- 7. Composition: filter & exclude ---
suite QuickCheck = CoreTests["core_add"]

// --- 8. Conditional composition ---
def build_tests(is_ci: bool) -> Suite =
    let base = new_suite("base", all_tests()) + CoreTests
    if is_ci:
        base - ["slow_network"]
    else:
        base

// --- 9. Traverse test names ---
for t in all_tests():
    print(f"found test: {t.name}")

// --- 10. assert (hard assertion) ---
test "hard assertion":
    assert 1 + 1 == 2
    assert "hello".len() == 5, "string length should be 5"

// --- 11. check (soft assertion) ---
test "soft assertion":
    check 1 + 1 == 3
    check 2 + 2 == 4
    assert 3 + 3 == 6

def main() =
    print("running: lang-zone test")
