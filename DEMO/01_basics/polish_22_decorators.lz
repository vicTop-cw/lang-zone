// ============================================================
// 轮22: 装饰器 — @memoize/@curry 等（验证基础行为）
// 若装饰器接线不完整，测试将记录实际行为
// ============================================================

// ── 装饰器基本语法验证（@name 前置） ──
@memoize
def fib2(n: int) -> int =
    if n <= 1:
        return n
    return fib2(n - 1) + fib2(n - 2)

def main() =
    // ── 普通函数不受装饰器影响（若装饰器未接线，退化为普通调用） ──
    assert fib2(5) == 5
    assert fib2(10) == 55

    // ── 基础验证确保流程正常 ──
    mut total = 0
    for i in 0..10:
        total = total + i
    assert total == 45

    print("P22 decorators OK")
