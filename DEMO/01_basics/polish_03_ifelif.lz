// ============================================================
// 轮3: if/elif 链边界 — 多 elif/嵌套 if 表达式/三元
// 每项用 assert 确保正确
// ============================================================

def main() =
    // ── 多 elif 链（5 分支） ──
    def grade(score: int) -> str =
        if score >= 90:
            "A"
        elif score >= 80:
            "B"
        elif score >= 70:
            "C"
        elif score >= 60:
            "D"
        else:
            "F"
    assert grade(95) == "A"
    assert grade(85) == "B"
    assert grade(75) == "C"
    assert grade(65) == "D"
    assert grade(50) == "F"
    assert grade(90) == "A"    // 边界：>=90
    assert grade(89) == "B"    // 边界：<90
    assert grade(60) == "D"    // 边界：>=60
    assert grade(59) == "F"    // 边界：<60

    // ── 三元（if 表达式单行） ──
    let a = 10
    let bigger = if a > 5: "big" else "small"
    assert bigger == "big"
    let smaller = if a < 5: "big" else "small"
    assert smaller == "small"

    // ── 嵌套 if 表达式（表达式内嵌表达式） ──
    let x = 7
    let desc = if x > 0: (if x > 5: "pos-big" else "pos-small") else "non-pos"
    assert desc == "pos-big"
    let y = 3
    let desc2 = if y > 0: (if y > 5: "pos-big" else "pos-small") else "non-pos"
    assert desc2 == "pos-small"
    let z = -1
    let desc3 = if z > 0: (if z > 5: "pos-big" else "pos-small") else "non-pos"
    assert desc3 == "non-pos"

    // ── 深层嵌套 if 语句（3 层） ──
    mut level = 0
    let n = 25
    if n > 0:
        if n > 10:
            if n > 20:
                level = 3
            else:
                level = 2
        else:
            level = 1
    else:
        level = -1
    assert level == 3

    // ── if 语句块内声明变量并用于后续 ──
    mut result = ""
    if True:
        let temp = "from-block"
        result = temp
    assert result == "from-block"

    // ── elif 与 else 组合边界（全部命中首个真分支） ──
    def classify2(v: int) -> str =
        if v == 0:
            "zero"
        elif v == 1:
            "one"
        elif v == 2:
            "two"
        elif v == 3:
            "three"
        else:
            "many"
    assert classify2(0) == "zero"
    assert classify2(3) == "three"
    assert classify2(10) == "many"

    // ── if 表达式作为函数参数 ──
    def pick(a: str, b: str) -> str =
        a + b
    let combined = pick(if 1 > 0: "yes" else "no", "-suffix")
    assert combined == "yes-suffix"

    // ── 条件用复杂逻辑表达式 ──
    let p = 15
    let q = 20
    let r = 25
    if (p < q) and (q < r):
        assert True
    else:
        assert False

    print("P3 ifelif OK")
