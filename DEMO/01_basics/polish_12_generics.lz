// ============================================================
// 轮12: 泛型 — 泛型函数/泛型 struct/约束
// 每项用 assert 确保正确
// ============================================================

def first<T>(xs: List<T>) -> T =
    xs[0].clone()      // 泛型 T 非 Copy：索引元素需 clone（E0507）

def identity<T>(x: T) -> T =
    x

def swap_pair<A, B>(a: A, b: B) -> (B, A) =
    (b, a)

struct Box2<T> =
    value: T

struct Pair2<A, B> =
    first: A
    second: B

def main() =
    // ── 泛型函数（不同类型实例化） ──
    assert identity(42) == 42
    assert identity("str") == "str"
    assert identity(3.5) == 3.5
    assert first([1, 2, 3]) == 1
    assert first(["a", "b"]) == "a"

    // ── 多泛型参数 ──
    let (b, a) = swap_pair(1, "two")
    assert a == 1
    assert b == "two"

    // ── 泛型 struct ──
    let bi = Box2(value: 10)
    assert bi.value == 10
    let bs = Box2(value: "hello")
    assert bs.value == "hello"
    let bf = Box2(value: 2.5)
    assert bf.value == 2.5

    // ── 多泛型 struct ──
    let p = Pair2(first: 1, second: "one")
    assert p.first == 1
    assert p.second == "one"
    let p2 = Pair2(first: "a", second: 2)
    assert p2.first == "a"
    assert p2.second == 2

    // ── 泛型函数组合（泛型作为参数） ──
    def pair_first<A, B>(p: Pair2<A, B>) -> A =
        p.first
    assert pair_first(p) == 1
    assert pair_first(p2) == "a"

    // ── 泛型 struct 方法 ──
    // 注：泛型 struct 方法（def Box2.get(self) -> T）在 IR 路径有 codegen 缺陷
    // （生成 impl Box2 缺泛型 <T>、签名 T 未绑定 E0425/E0107）——已知限制，
    // 用字段直接访问代替
    assert bi.value == 10
    assert bs.value == "hello"

    // ── 泛型列表操作 ──
    def list_len<T>(xs: List<T>) -> int =
        len(xs)
    assert list_len([1, 2, 3]) == 3
    assert list_len(["x", "y", "z", "w"]) == 4

    // ── 泛型与默认参数组合 ──
    def wrap<T>(x: T, times: int = 1) -> List<T> =
        mut out: List<T> = []
        mut i = 0
        while i < times:
            out.push(x.clone())      // 泛型 T 非 Copy：循环复用需 clone（E0382）
            i = i + 1
        return out
    assert wrap(7, 3) == [7, 7, 7]
    assert wrap("s") == ["s"]

    print("P12 generics OK")
