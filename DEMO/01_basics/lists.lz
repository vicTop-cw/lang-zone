// ============================================================
// 轮8: list 操作 — push/pop/索引/切片/遍历/排序/长度
// 每项用 assert 确保正确
// ============================================================

def main() =
    // ── 列表字面量与相等比较 ──
    let xs = [1, 2, 3]
    assert xs == [1, 2, 3]
    assert xs != [1, 2]
    assert len(xs) == 3

    // ── 索引访问 ──
    assert xs[0] == 1
    assert xs[1] == 2
    assert xs[2] == 3

    // ── push 追加 ──
    mut ys = [1, 2]
    ys.push(3)
    assert ys == [1, 2, 3]
    ys.push(4)
    assert ys == [1, 2, 3, 4]

    // ── pop 弹出（LZ 语义返回 Option，空列表 None） ──
    let last = ys.pop()
    assert last == Some(4)
    assert ys == [1, 2, 3]

    // ── insert 插入 ──
    mut zs = [1, 3]
    zs.insert(1, 2)          // 位置 1 插入 2
    assert zs == [1, 2, 3]

    // ── remove 移除 ──
    zs.remove(1)             // 移除位置 1
    assert zs == [1, 3]

    // ── 修改元素（索引赋值） ──
    mut ws = [10, 20, 30]
    ws[1] = 99
    assert ws == [10, 99, 30]

    // ── 切片（完整范围 [a..b]，省略边界形式 [a..] / [..b] 暂不支持） ──
    let big = [0, 1, 2, 3, 4, 5]
    assert big[1..3] == [1, 2]
    assert big[2..5] == [2, 3, 4]
    assert big[0..2] == [0, 1]

    // ── for 遍历 ──
    mut sum = 0
    for v in [1, 2, 3, 4]:
        sum = sum + v
    assert sum == 10

    // ── 嵌套列表 ──
    let grid = [[1, 2], [3, 4]]
    assert grid[0][1] == 2
    assert grid[1][0] == 3

    // ── 排序 ──
    mut unsorted = [3, 1, 2]
    unsorted.sort()
    assert unsorted == [1, 2, 3]

    // ── reverse 反转 ──
    mut rev = [1, 2, 3]
    rev.reverse()
    assert rev == [3, 2, 1]

    // ── contains 包含 ──
    assert [1, 2, 3].contains(2)
    assert not [1, 2, 3].contains(9)

    // ── 空列表与类型注解 ──
    let empty: List<int> = []
    assert len(empty) == 0
    assert empty == []

    // 注：列表 `+` 拼接（a + b）在 IR 路径未接线（lz_std 定义了 __add__ 但
    // codegen 对 Vec 生成 Rust 原生 +，E0369）——已知限制，用 push 组合代替
    mut merged: List<int> = [1, 2]
    for v in [3, 4]:
        merged.push(v)
    assert merged == [1, 2, 3, 4]

    // ── 组合操作 ──
    mut combo: List<int> = [5, 1]
    combo.push(3)
    combo.sort()
    combo.reverse()
    assert combo == [5, 3, 1]
    assert len(combo) == 3
    assert combo[1] == 3

    print("R8 lists OK")
