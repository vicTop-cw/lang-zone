// ============================================================
// 轮18: 综合组合测试 — 多特性嵌套组合（函数+循环+列表+match+struct+字符串）
// 只使用前 17 轮已验证的特性组合，确保正确
// ============================================================

struct Person =
    name: str
    age: int

def adult(p: Person) -> bool =
    p.age >= 18

def age_group(p: Person) -> str =
    if p.age < 13:
        "child"
    elif p.age < 20:
        "teen"
    else:
        "adult"

def main() =
    // ── 组合1: 结构体数组 + 循环 + 函数过滤 ──
    let people = [
        Person(name: "A", age: 10),
        Person(name: "B", age: 25),
        Person(name: "C", age: 17),
        Person(name: "D", age: 30),
    ]
    mut adult_count = 0
    mut adult_names: List<str> = []
    for p in people:
        if adult(p):
            adult_count = adult_count + 1
            adult_names.push(p.name)
    assert adult_count == 2
    assert adult_names == ["B", "D"]

    // ── 组合2: match + 函数调用链（注：按索引传值 people[i] 会 move E0507，
    // 用独立构造的 Person 调用） ──
    def describe_age(p: Person) -> str =
        match age_group(p):
            case "child": return p.name + " is young"
            case "teen": return p.name + " is teen"
            case _: return p.name + " is grown"
    assert describe_age(Person(name: "A", age: 10)) == "A is young"
    assert describe_age(Person(name: "B", age: 25)) == "B is grown"
    assert describe_age(Person(name: "C", age: 17)) == "C is teen"

    // ── 组合3: 嵌套循环 + 列表收集 ──
    mut grid_sums: List<int> = []
    for i in 1..4:
        mut row_sum = 0
        for j in 1..4:
            row_sum = row_sum + i * j
        grid_sums.push(row_sum)
    assert grid_sums == [6, 12, 18]

    // ── 组合4: 函数组合 + 默认参数 + 元组 ──
    def stats(xs: List<int>) -> (int, int) =
        mut total = 0
        mut cnt = 0
        for x in xs:
            total = total + x
            cnt = cnt + 1
        return (total, cnt)
    let (sum, count) = stats([1, 2, 3, 4])
    assert sum == 10
    assert count == 4

    // ── 组合5: 字符串操作 + 循环 + 条件 ──
    mut shout = ""
    for ch in "lz":
        shout = shout + str(ch).to_upper()
    assert shout == "LZ"

    // ── 组合6: dict + 循环 + 累加 ──
    let prices = {"a": 10, "b": 20}
    mut total_price = 0
    for k in ["a", "b"]:
        total_price = total_price + prices[k]
    assert total_price == 30

    // ── 组合7: 三层嵌套（for + if + match 表达式） ──
    mut labels: List<str> = []
    for i in 1..5:
        if i % 2 == 0:
            let label = if i > 2: "big-even" else "small-even"
            labels.push(label)
    assert labels == ["small-even", "big-even"]

    // ── 组合8: 列表推导遍历 + 函数调用 ──
    def double(x: int) -> int =
        x * 2
    mut doubled: List<int> = []
    for v in [1, 2, 3]:
        doubled.push(double(v))
    assert doubled == [2, 4, 6]

    print("R18 combined OK")
