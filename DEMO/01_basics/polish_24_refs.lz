// ============================================================
// 轮24: 指针与引用 — ref/mut 参数
// 注：ref 参数函数内返回未自动解引用（&i64 vs i64 E0308）、Box 元组构造
// 私有字段（E0423）为已知限制，测试用已验证的写法
// 每项用 assert 确保正确
// ============================================================

def mutate_val(mut x: int) =
    x = x * 10

def read_ref(ref x: int) -> int =
    let v = x        // ref 参数读取（函数内借用）
    v * 1

def main() =
    // ── 引用参数（只读借用） ──
    let a = 5
    assert read_ref(a) == 5

    // ── 可变参数（值传递，函数内修改不影响外部） ──
    mut v = 3
    mutate_val(v)
    assert v == 3        // 值语义：函数内修改不影响外部

    // ── 直接修改外部变量 ──
    mut w = 2
    w = w * 100
    assert w == 200

    // ── 基础验证确保流程正常 ──
    mut total = 0
    for i in 0..5:
        total = total + i
    assert total == 10

    print("P24 refs OK")
