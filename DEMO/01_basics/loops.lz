// ============================================================
// 轮4: 循环 — for/while（range、break/continue、else、嵌套、边界）
// 每项用 assert 确保正确
// ============================================================

def main() =
    // ── for 遍历 range（0..n） ──
    mut sum = 0
    for i in 0..5:
        sum = sum + i
    assert sum == 10          // 0+1+2+3+4

    // ── for 遍历列表 ──
    mut total = 0
    for v in [1, 2, 3, 4]:
        total = total + v
    assert total == 10

    // ── for 遍历字符串 ──
    mut chars = 0
    for c in "abcd":
        chars = chars + 1
    assert chars == 4

    // ── for 带 guard（跳过条件） ──
    mut evens = 0
    for i in 0..6 if i % 2 == 0:
        evens = evens + i
    assert evens == 6          // 0+2+4

    // ── while 循环 ──
    mut n = 10
    mut steps = 0
    while n > 0:
        n = n - 3
        steps = steps + 1
    assert steps == 4          // 10→7→4→1→-2

    // ── while 条件含复杂表达式 ──
    mut v = 1
    mut count = 0
    while v < 100:
        v = v * 2
        count = count + 1
    assert count == 7          // 1→2→4→8→16→32→64→128

    // ── break：提前退出循环 ──
    mut found = -1
    for i in 0..10:
        if i == 4:
            found = i
            break
    assert found == 4

    // ── continue：跳过本次迭代 ──
    mut odd_sum = 0
    for i in 0..6:
        if i % 2 == 0:
            continue
        odd_sum = odd_sum + i
    assert odd_sum == 9        // 1+3+5

    // ── break 提前退出 + 结果保存（loop 表达式为高级特性，此处用循环内赋值） ──
    mut first_match = -1
    for i in 0..100:
        if i * i >= 50:
            first_match = i
            break
    assert first_match == 8    // 8*8=64 >= 50

    // ── while 内 break/continue ──
    mut w = 0
    mut wsum = 0
    while True:
        w = w + 1
        if w == 2:
            continue
        if w >= 5:
            break
        wsum = wsum + w
    assert wsum == 8           // 1 + 3 + 4

    // ── for...else：循环正常结束（未 break）时执行 else ──
    mut ran_else = False
    for i in 0..3:
        pass
    else:
        ran_else = True
    assert ran_else == True

    // 注：for...else + break 组合（break 应跳过 else 体）为已知边界缺陷——
    // codegen 的 break 未生成 `break 'label` 跳过 labeled block（遗留 bug，
    // 见回归记录；正常结束路径已验证通过）

    // ── 嵌套循环（乘法表） ──
    mut products: List<int> = []   // 空列表需显式类型注解（规范 01）
    for i in 1..4:
        for j in 1..4:
            products.push(i * j)
    assert products == [1, 2, 3, 2, 4, 6, 3, 6, 9]

    // ── 嵌套循环 + break（内层 break 只退出内层） ──
    mut pairs: List<int> = []
    for i in 1..4:
        for j in 1..4:
            if j >= i:
                break
            pairs.push(i * 10 + j)
    assert pairs == [21, 31, 32]

    // ── 循环变量作用域（结束后不可用）与循环后代码 ──
    mut after = 0
    for k in 0..3:
        after = after + 1
    assert after == 3

    // ── 边界：空 range / 空列表 ──
    mut empty_sum = 0
    for e in 0..0:
        empty_sum = empty_sum + 1
    assert empty_sum == 0
    for e in []:
        empty_sum = empty_sum + 1
    assert empty_sum == 0

    print("R4 loops OK")
