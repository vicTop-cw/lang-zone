// ============================================================
// 轮30: 边界压力 — 空容器/越界/除零/极端值
// 每项用 assert 确保正确
// ============================================================

def main() =
    // ── 空容器边界 ──
    let empty_list: List<int> = []
    assert len(empty_list) == 0
    let empty_dict: Dict<str, int> = {}
    assert len(empty_dict) == 0
    let empty_str = ""
    assert len(empty_str) == 0

    // ── 空列表遍历不崩溃 ──
    mut sum_empty = 0
    for v in empty_list:
        sum_empty = sum_empty + 1
    assert sum_empty == 0

    // ── 单元素容器 ──
    let single = [42]
    assert len(single) == 1
    assert single[0] == 42

    // ── 循环边界（0 次 / 1 次 / 多次） ──
    mut c0 = 0
    for i in 0..0:
        c0 = c0 + 1
    assert c0 == 0
    mut c1 = 0
    for i in 0..1:
        c1 = c1 + 1
    assert c1 == 1

    // ── 除零保护（guard 通过路径） ──
    def safe_div(a: int, b: int) -> int =
        guard b != 0 else:
            return 0
        a / b
    assert safe_div(10, 2) == 5
    assert safe_div(10, 0) == 0

    // ── 极端值（i64 边界安全运算） ──
    let big = 9223372036854775807
    assert big > 0
    let neg = -9223372036854775808
    assert neg < 0
    assert big + 0 == big
    assert neg + 0 == neg

    // ── 负索引边界（不越界访问） ──
    let xs = [1, 2, 3]
    assert xs[0] == 1
    assert xs[len(xs) - 1] == 3

    // ── 嵌套空容器 ──
    let empty_grid: List<List<int>> = []
    assert len(empty_grid) == 0
    let grid_with_empty = [[], []]
    assert len(grid_with_empty) == 2
    assert len(grid_with_empty[0]) == 0

    // ── 字符串边界 ──
    assert "a"[0] == 97
    assert "ab"[1] == 98
    assert "a"[0] == "a"[0]

    // ── 大循环步数（性能与正确性） ──
    mut total = 0
    for i in 0..1000:
        total = total + 1
    assert total == 1000

    print("P30 edge OK")
