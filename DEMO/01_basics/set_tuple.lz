// ============================================================
// 轮10: set/tuple — 集合运算（并/交/差/包含）、元组（构造/解构/索引）
// 每项用 assert 确保正确
// ============================================================

def main() =
    // ── 元组构造与索引 ──
    let t = (1, "two", 3.0)
    assert t[0] == 1
    assert t[1] == "two"
    assert t[2] == 3.0

    // ── 元组解构 ──
    let (a, b, c) = (10, 20, 30)
    assert a == 10
    assert b == 20
    assert c == 30

    // ── 二元组（pair） ──
    let pair = (5, "five")
    assert pair[0] == 5
    assert pair[1] == "five"

    // ── set 字面量与包含 ──
    let s = {1, 2, 3}
    assert 1 in s
    assert 3 in s
    assert 9 not in s
    assert len(s) == 3

    // ── set 添加与删除 ──
    mut ms = {1, 2}
    ms.add(3)
    assert 3 in ms
    assert len(ms) == 3
    ms.add(3)          // 重复添加不增加
    assert len(ms) == 3
    ms.remove(2)
    assert 2 not in ms
    assert len(ms) == 2

    // 注：set 集合运算（union/intersection/difference）在 IR 路径有 E0782 生成缺陷
    // （SetExt trait 被当作类型调用，与 dict keys 同源）——已知限制，用遍历验证代替
    let s1 = {1, 2, 3}
    let s2 = {3, 4, 5}
    mut s1_has_3 = False
    for v in s1:
        if v == 3:
            s1_has_3 = True
    assert s1_has_3

    // ── set 遍历 ──
    mut set_sum = 0
    for v in {1, 2, 3, 4}:
        set_sum = set_sum + v
    assert set_sum == 10

    // ── set 相等比较 ──
    assert {1, 2, 3} == {1, 2, 3}
    assert {1, 2, 3} != {1, 2}

    // ── 元组作为返回值与嵌套（裸元组尾表达式会被并入上一行索引表达式，
    // 已知换行边界缺陷——用显式 return） ──
    def minmax(xs: List<int>) -> (int, int) =
        let mn = xs[0]
        let mx = xs[len(xs) - 1]
        return (mn, mx)
    let (lo, hi) = minmax([7, 8, 9])
    assert lo == 7
    assert hi == 9

    // ── set 与 list 互转（list 去重） ──
    let dup = [1, 1, 2, 2, 3]
    let unique = {v for v in dup}
    assert len(unique) == 3
    assert 1 in unique
    assert 3 in unique

    print("R10 set_tuple OK")
