//     check 2 + 2 == 4

// --- 1.10 Operator keywords ---
def logic_demo(a: bool, b: bool) =
    let r1 = a and b
    let r2 = a or b
    let r3 = not a
    let r4 = a && b
    let r5 = a || b
    let r6 = !a
    let r7 = 42 is int
    pass
