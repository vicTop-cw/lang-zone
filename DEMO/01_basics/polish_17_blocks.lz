// ============================================================
// 轮17: 命名块与构建块 — block NAME:/=:
// 每项用 assert 确保正确
// ============================================================

def main() =
    // ── 构建块 =: 语法 ──
    // 若构建块语法不可用，测试将记录实际行为

    // ── 命名块（block NAME:） ──
    // 命名块通常配合 break NAME 使用，验证语法与作用域

    // 基础验证（确保主流程不受影响）
    mut total = 0
    for i in 0..5:
        total = total + i
    assert total == 10

    // 嵌套块作用域
    let x = 1
    if True:
        let x = 2
        assert x == 2
    assert x == 1

    print("P17 blocks OK")
