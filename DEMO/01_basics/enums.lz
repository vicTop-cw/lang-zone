// ============================================================
// 轮12: enum 定义 — 变体/字段/模式匹配/方法
// 每项用 assert 确保正确
// ============================================================

enum Color =
    Red
    Green
    Blue

enum Shape =
    Circle(radius: int)
    Rect(w: int, h: int)

def main() =
    // ── 枚举变体构造与相等比较（enum 自动派生 PartialEq） ──
    let c = Color.Red
    assert c == Color.Red
    assert c != Color.Green
    let g = Color.Green
    assert g == Color.Green

    // ── 枚举 match 匹配（无字段变体） ──
    def color_name(col: Color) -> str =
        match col:
            case Color.Red: return "red"
            case Color.Green: return "green"
            case Color.Blue: return "blue"
    assert color_name(Color.Red) == "red"
    assert color_name(Color.Green) == "green"
    assert color_name(Color.Blue) == "blue"

    // ── 带字段变体构造与字段访问 ──
    let c1 = Shape.Circle(radius: 5)
    let r1 = Shape.Rect(w: 3, h: 4)

    // ── 带字段变体 match（提取字段） ──
    def area(s: Shape) -> int =
        match s:
            case Shape.Circle(radius): return 3 * radius * radius
            case Shape.Rect(w, h): return w * h
    assert area(c1) == 75        // 3 * 5 * 5
    assert area(r1) == 12        // 3 * 4

    // ── 枚举数组与遍历 ──
    let shapes = [Shape.Rect(w: 1, h: 2), Shape.Circle(radius: 2)]
    mut total_area = 0
    for s in shapes:
        total_area = total_area + area(s)
    assert total_area == 14      // 1*2 + 3*2*2

    // ── 枚举方法（self match） ──
    def Color.is_warm(self) -> bool =
        match self:
            case Color.Red: return True
            case _: return False
    assert Color.Red.is_warm() == True
    assert Color.Blue.is_warm() == False

    // ── 枚举比较与组合 ──
    let fav = Color.Blue
    assert fav == Color.Blue
    assert fav != Color.Red
    assert color_name(fav) == "blue"

    // ── 嵌套枚举（枚举字段用其他枚举） ──
    enum Tag =
        ColorTag(c: Color)
        NumTag(n: int)
    let t1 = Tag.ColorTag(Color.Red)
    let t2 = Tag.NumTag(42)
    // 注：match 分支内调用其他函数（return color_name(c)）存在嵌套函数返回
    // 类型误判（同轮5 describe/classify，E0277）——已知限制，用字段提取验证
    def tag_desc(t: Tag) -> str =
        match t:
            case Tag.ColorTag(c): return "colored"
            case Tag.NumTag(n): return "num"
    assert tag_desc(t1) == "colored"
    assert tag_desc(t2) == "num"

    print("R12 enums OK")
