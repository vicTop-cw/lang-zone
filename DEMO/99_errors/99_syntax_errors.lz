// ============================
// LZ 错误边界合集 — 语法错误 (99-语法错误.md)
// 这些代码在编译器中应产生明确的语法错误。
// 以注释形式展示，不实际运行。
// ============================

// --- 1. 缺失冒号 ---
// def f()                       // ❌ 函数定义缺少冒号
//     return 42

// --- 2. 等式体未缩进 ---
// def f() =
// return 42                     // ❌ 等式体必须缩进

// --- 3. 不匹配的括号 ---
// let x = (1 + 2                // ❌ 括号不匹配

// --- 4. 表达式缺项 ---
// let x = 1 +                   // ❌ 二元运算缺少右操作数

// --- 5. 非法 token ---
// let x = 1 $ 2                 // ❌ $ 不是合法 token

// --- 6. match 缺少 case ---
// match x:                      // ❌ match 至少需要一个 case

// --- 7. enum 缺少 variant ---
// enum Empty:                   // ❌ enum 至少需要一个 variant

// --- 8. 循环中赋值不可变变量 ---
// let x = 1
// while True:
//     x = 2                     // ❌ let 绑定不可重新赋值

// --- 9. raise 在等式体中单独 ---
// def f() =
//     raise "err"               // ❌ 等式体是表达式，不能单独 raise

// --- 10. 缩进块缺失 ---
// if True:                      // ❌ if 后必须跟缩进块
