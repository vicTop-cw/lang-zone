// ============================
// LZ 错误边界合集 — 变量与绑定 (02-变量与绑定.md)
// ============================

// --- 1. let 绑定不可重新赋值 ---
// let x = 1
// x = 2                       // ❌ 编译错误

// --- 2. const 运行时赋值 ---
// const X: int = rand()       // ❌ 运行时表达式，需用 comptime 包裹
// const NOW: str = get_time() // ❌ 运行时表达式

// --- 3. let owned 修饰符（当前解析器忽略 owned，退化为普通 let，不再报错） ---
// let owned s: str = "hi"     // 实际：解析器忽略 owned，等价 let s（不报错）

// --- 4. 变量名与关键字冲突 ---
// let if = 1                  // ❌ if 是关键字
// let match = 2               // ❌ match 是关键字
// let test = 3                // ❌ test 是关键字
