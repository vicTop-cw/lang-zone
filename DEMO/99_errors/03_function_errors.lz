// ============================
// LZ 错误边界合集 — 函数 (03-函数基础.md)
// ============================

// --- 1. 有 raise 但无 raises 声明 ---
// def bad() -> int =
//     raise "oops"
//     // ❌ 缺少 raises 子句

// --- 2. 冒号不匹配 / 箭头位置错误 ---
// def bad(x:): ...             // ❌ : 后缺类型
// def bad(-> int): ...         // ❌ -> 必须在参数列表后

// --- 3. 等式体换行不缩进 ---
// def bad() =
// x + 1                        // ❌ 必须缩进

// --- 4. return 在等式体中多余 ---
// def f() = return 42           // ❌ 等式体不需要 return

// --- 5. 匿名函数语法错误 ---
// |x, y| -> x + y              // ❌ 闭包不用 ->
