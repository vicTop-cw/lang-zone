// ============================

// --- 1. await 在非 async 函数中 ---
// def sync_fn() =
//     await async_fn()          // ❌ 需用 spawn 启动

// --- 2. spawn 非函数调用 ---
// spawn 42                     // ❌ spawn 后必须是调用

// --- 3. async 函数作为 spawn 参数 ---
// spawn async def f(): ...      // ❌ spawn 接受调用而非定义
