// ============================
// LZ Control Flow — with / defer
// ============================

def main() =
    // --- with context manager ---
    // Requires __enter__ / __exit__ magic methods on the struct

    with open("test.txt") as f:
        let content = f.read()
        print(content)
    // f is automatically closed here

    // Custom struct for with
    struct MyResource =
        name: str

        def __enter__(self) -> MyResource =
            print(f"acquiring {self.name}")
            self

        def __exit__(mut self) =
            print(f"releasing {self.name}")

    with MyResource(name: "database") as res:
        print(f"using {res.name}")
    // automatically calls __exit__

    // --- defer (LIFO order) ---
    defer:
        print("cleanup step 2")

    defer:
        print("cleanup step 1")

    defer print("cleanup step 3") // write in same line

    // Multiple defers execute in reverse order (LIFO)
    // Output when main() ends:
    //   cleanup step 3
    //   cleanup step 1
    //   cleanup step 2

    // Typical use: resource management
    def process_file() =
        let file = open("data.txt")
        defer:
            file.close()  //  equal: `defter file.colse()` ,yes can be write in same line
        // ... process file ...
        // file.close() is called automatically when function exits

    print("with and defer demonstrated")
