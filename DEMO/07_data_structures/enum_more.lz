// LZ 数据结构 — 递归 enum 与表达式树
// 覆盖：enum 变体引用自身类型、嵌套构造（单行调用）、递归 match
// 注意：构造调用需单行书写（多行缩进参数当前不被解析）

enum Expr =
    Num(value: f64)
    Add(left: Expr, right: Expr)
    Mul(left: Expr, right: Expr)

def eval(e: Expr) -> f64 =
    match e:
        case Expr.Num(value: v) => v
        case Expr.Add(left: a, right: b) => eval(a) + eval(b)
        case Expr.Mul(left: a, right: b) => eval(a) * eval(b)

def main() =
    // (2 + (3 * 4)) = 14  —— 单行构造
    let e = Expr.Add(left: Expr.Num(value: 2.0), right: Expr.Mul(left: Expr.Num(value: 3.0), right: Expr.Num(value: 4.0)))
    print(eval(e))

    // 另一例：(1 + 2) * 3 = 9
    let e2 = Expr.Mul(left: Expr.Add(left: Expr.Num(value: 1.0), right: Expr.Num(value: 2.0)), right: Expr.Num(value: 3.0))
    print(eval(e2))
