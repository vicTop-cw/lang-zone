// ==== For / While / Loop ====
def main() =
    // for loop with range
    for i in 0..5:
        print(i)
    // while loop
    n = 3
    while n > 0:
        print(n)
        n -= 1
    // infinite loop with break
    count = 0
    loop:
        count += 1
        if count >= 3:
            break
        print(count)
