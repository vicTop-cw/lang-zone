// ==== Match / Case ====
enum Color:
    Red
    Green
    Blue

def describe(c: Color) -> str =
    match c:
        case Red => "warm"
        case Green => "nature"
        case Blue => "calm"

def describe_value(x: int) -> str =
    match x:
        case 0 => "zero"
        case 1 => "one"
        case _ => "many"

def main() =
    print(describe(Color.Red))
    print(describe_value(5))
