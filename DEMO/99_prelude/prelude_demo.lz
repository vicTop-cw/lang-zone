// ============================
// LZ Prelude — Built-in Functions & Common APIs
// ============================

// Prelude symbols are automatically available without import.

def main() =
    // --- Basic I/O ---
    print("hello world")

    // --- Common built-in functions ---
    let xs = [3, 1, 4, 1, 5, 9]

    // len() — container length (calls __len__)
    let n = len(xs)
    print(n)

    // str() — convert to string (calls __str__)
    let s = str(42)
    print(s)

    // int() — convert to int
    let i = int("42")
    print(i)

    // float() — convert to f64
    let f = float(3)
    print(f)

    // bool() — convert to bool (calls __bool__)
    let b = bool(1)
    print(b)

    // hash() — compute hash (calls __hash__)
    let h = hash("hello")

    // contains() — membership check (calls __contains__)
    let has = contains([1, 2, 3], 2)
    print(has)

    // iter() — get iterator (calls __iter__)
    let it = iter([1, 2, 3])

    // enumerate() — indexed iteration
    for (idx, val) in enumerate(["a", "b", "c"]):
        print(f"{idx}: {val}")

    // zip() — parallel iteration
    for (a, b) in zip([1, 2, 3], ["x", "y", "z"]):
        print(f"{a}{b}")

    // clone() — clone a value (calls __clone__)
    let copy = clone(xs)
    print(copy)

    // sort() — sort a list
    let sorted_xs = sort(xs)
    print(sorted_xs)

    // reverse() — reverse a list
    let reversed_xs = reverse(xs)
    print(reversed_xs)

    // format() — format string
    let msg = format("value: {}", 42)
    print(msg)

    // --- str instance methods ---
    let hello = "hello world"
    print(hello.length())
    print(hello.starts_with("hello"))
    print(hello.ends_with("world"))
    let parts = hello.split(" ")
    print(parts)
    print("  trim  ".trim())

    // --- List<T> instance methods ---
    let list = [1, 2, 3]
    list.append(4)
    print(list)
    let last = list.pop()
    print(last)
    print(list.length())
    list.sort()

    print("prelude demonstrated")
