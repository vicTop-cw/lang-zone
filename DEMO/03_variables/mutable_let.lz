// ============================
// LZ Variables — Default Mutable & let Immutable
// ============================

def main() =
    // --- Default mutable binding ---
    x = 42            // mutable by default
    x = 100           // reassignment is legal
    print(x)          // 100

    // With type annotation (still mutable)
    y: int = 10
    y = 20

    // mut keyword is no-op (already mutable by default)
    mut z = 50        // same as: z = 50
    z = 60

    // --- let immutable binding ---
    let a = 42        // immutable
    // a = 100        // ❌ compile error

    let name: str = "world"
    let pi: f64 = 3.14159

    // --- Destructuring bindings ---
    let (first, second) = (1, 2)
    let Some(v) = Some(42)     // destructure in let (within match/guard)

    // rest pattern: ignore remaining elements
    let (head, ..,) = (1, 2, 3, 4)    // head = 1
    print(x, y, z, a, first, second)
