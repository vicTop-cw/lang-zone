// ============================================================
// G6 D2 codegen 补缺 - 列表推导 / 集合推导 / 字典推导
// 覆盖: 单 for、多 for + guard、嵌套推导、推导中调用函数、
//       集合推导、字典推导
// 运行: lzc DEMO/g6/g6_listcomp.lz → rustc → 输出见文件尾部注释
// ============================================================

def sq(x: int) -> int =
    x * x

def main() =
    // 多 for + guard（本轮修复：extra 子句变量先绑定再求值）
    let r = [(a, b) for a in 1..4 for b in 10..13 if (a + b) % 2 == 0]
    print(r)

    // 嵌套推导
    let m = [[y * 10 + x for x in 1..3] for y in 1..3]
    print(m)

    // 推导中调用函数
    let q = [sq(x) for x in 1..5]
    print(q)

    // 集合推导 / 字典推导
    let s = {x * 2 for x in 1..5}
    print(s)
    let d = {x: x * x for x in 1..5}
    print(d)

    // 期望输出:
    // [(1, 11), (2, 10), (2, 12), (3, 11)]
    // [[11, 12], [21, 22]]
    // [1, 4, 9, 16]
    // 集合/字典为无序容器，元素一致但打印顺序不定
    // （如 {2, 4, 6, 8} 或 {4, 2, 6, 8}；{1: 1, 2: 4, 3: 9, 4: 16} 或乱序）
