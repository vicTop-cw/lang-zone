#!bin lz
// ============================================================
// lz_std/iter.lz — 迭代器构造与工具模块
// 覆盖: SYNTAX/06e-trait定义.md, SYNTAX/14-生成器.md
// 提供迭代器构造器、常用迭代工具和组合子
// ============================================================

// ============================================================
// 基础迭代器构造器
// ============================================================

/// 范围迭代器 [start, end)
struct Range =
    current: int
    end: int

impl Iterator for Range =
    type Item = int

    def __next__(mut self) -> Option<int> =
        if self.current >= self.end:
            return None
        let value = self.current
        self.current = self.current + 1
        return Some(value)

    def size_hint(ref self) -> (int, Option<int>) =
        let remaining = self.end - self.current
        if remaining < 0:
            return (0, Some(0))
        return (remaining, Some(remaining))

/// 创建范围迭代器 [start, end)
def range(start: int, end: int) -> Range =
    Range(current: start, end: end)

/// 创建范围迭代器 [0, end)
def range_to(end: int) -> Range =
    Range(current: 0, end: end)

/// 包含结束的范围 [start, end]
struct RangeInclusive =
    current: int
    end: int
    done: bool

impl Iterator for RangeInclusive =
    type Item = int

    def __next__(mut self) -> Option<int> =
        if self.done:
            return None
        if self.current > self.end:
            return None
        let value = self.current
        if self.current == self.end:
            self.done = True
        else:
            self.current = self.current + 1
        return Some(value)

/// 创建包含范围的迭代器 [start, end]
def range_inclusive(start: int, end: int) -> RangeInclusive =
    RangeInclusive(current: start, end: end, done: False)


/// 单元素迭代器
struct Once<T> =
    value: Option<T>

impl<T> Iterator for Once<T> =
    type Item = T

    def __next__(mut self) -> Option<T> =
        let taken = self.value
        self.value = None
        return taken

    def size_hint(ref self) -> (int, Option<int>) =
        match self.value:
            case Some(_):
                return (1, Some(1))
            case None:
                return (0, Some(0))

/// 创建单元素迭代器
def once<T>(value: T) -> Once<T> =
    Once(value: Some(value))


/// 重复元素迭代器
struct Repeat<T> =
    value: T

impl<T> Iterator for Repeat<T> =
    type Item = T

    def __next__(ref self) -> Option<T> =
        Some(self.value)

/// 创建无限重复迭代器
def repeat<T>(value: T) -> Repeat<T> =
    Repeat(value: value)


/// 重复 n 次迭代器
struct RepeatN<T> =
    value: T
    count: int
    remaining: int

impl<T> Iterator for RepeatN<T> =
    type Item = T

    def __next__(mut self) -> Option<T> =
        if self.remaining <= 0:
            return None
        self.remaining = self.remaining - 1
        return Some(self.value)

    def size_hint(ref self) -> (int, Option<int>) =
        return (self.remaining, Some(self.remaining))

/// 创建重复 n 次迭代器
def repeat_n<T>(value: T, n: int) -> RepeatN<T> =
    RepeatN(value: value, count: n, remaining: n)


/// 空迭代器
struct Empty<T> =
    _phantom: T

impl<T> Iterator for Empty<T> =
    type Item = T

    def __next__(mut self) -> Option<T> =
        None

    def size_hint(ref self) -> (int, Option<int>) =
        return (0, Some(0))

/// 创建空迭代器
def empty<T>() -> Empty<T> =
    Empty(_phantom: None as T)


// ============================================================
// Zip — 同时迭代两个迭代器
// ============================================================

struct Zip<A: Iterator, B: Iterator> =
    a: A
    b: B

impl<A: Iterator, B: Iterator> Iterator for Zip<A, B> =
    type Item = (A.Item, B.Item)

    def __next__(mut self) -> Option<(A.Item, B.Item)> =
        match (self.a.__next__(), self.b.__next__()):
            case (Some(a_item), Some(b_item)):
                return Some((a_item, b_item))
            case _:
                return None

    def size_hint(ref self) -> (int, Option<int>) =
        let (lo_a, hi_a) = self.a.size_hint()
        let (lo_b, hi_b) = self.b.size_hint()
        let lo = min(lo_a, lo_b)
        let hi = match (hi_a, hi_b):
            case (Some(x), Some(y)):
                return Some(min(x, y))
            case _:
                return None
        return (lo, hi)

/// 同时迭代两个迭代器
def zip<A: Iterator, B: Iterator>(a: A, b: B) -> Zip<A, B> =
    Zip(a: a, b: b)


// ============================================================
// 步进范围迭代器
// ============================================================

struct StepRange =
    current: int
    end: int
    step: int

impl Iterator for StepRange =
    type Item = int

    def __next__(mut self) -> Option<int> =
        if self.step > 0 and self.current >= self.end:
            return None
        if self.step < 0 and self.current <= self.end:
            return None
        let value = self.current
        self.current = self.current + self.step
        return Some(value)

/// 创建步进范围迭代器
def step_range(start: int, end: int, step: int) -> StepRange =
    StepRange(current: start, end: end, step: step)


// ============================================================
// 全局迭代器工具函数
// ============================================================

/// 对可迭代对象的每个元素应用函数
def for_each<I: Iterable>(iterable: ref I, f: fn(I.Item) -> ()) =
    for item in iterable:
        f(item)

/// 映射可迭代对象的每个元素
def map<I: Iterable, U>(iterable: ref I, f: fn(I.Item) -> U) -> List<U> =
    let mut result = List()
    for item in iterable:
        result.push(f(item))
    return result

/// 过滤可迭代对象
def filter<I: Iterable>(iterable: ref I, predicate: fn(ref I.Item) -> bool) -> List<I.Item> =
    let mut result = List()
    for item in iterable:
        if predicate(item):
            result.push(item)
    return result

/// 折叠可迭代对象
def fold<I: Iterable, U>(iterable: ref I, init: U, f: fn(U, I.Item) -> U) -> U =
    let mut acc = init
    for item in iterable:
        acc = f(acc, item)
    return acc

/// 收集可迭代对象为 List
def collect_list<I: Iterable>(iterable: ref I) -> List<I.Item> =
    let mut result = List()
    for item in iterable:
        result.push(item)
    return result

/// 可迭代对象是否全部满足条件
def all<I: Iterable>(iterable: ref I, predicate: fn(I.Item) -> bool) -> bool =
    for item in iterable:
        if not predicate(item):
            return False
    return True

/// 可迭代对象是否任一满足条件
def any<I: Iterable>(iterable: ref I, predicate: fn(I.Item) -> bool) -> bool =
    for item in iterable:
        if predicate(item):
            return True
    return False

/// 查找第一个满足条件的元素
def find<I: Iterable>(iterable: ref I, predicate: fn(ref I.Item) -> bool) -> Option<I.Item> =
    for item in iterable:
        if predicate(item):
            return Some(item)
    return None

/// 计数满足条件的元素
def count_if<I: Iterable>(iterable: ref I, predicate: fn(I.Item) -> bool) -> int =
    let mut n = 0
    for item in iterable:
        if predicate(item):
            n = n + 1
    return n

/// 求可迭代对象的和
def sum<I: Iterable>(iterable: ref I) -> I.Item
    where I.Item: Add<Output = I.Item> + Default
    =
    let mut total = I.Item.default()
    for item in iterable:
        total = total + item
    return total

/// 求可迭代对象的积
def product<I: Iterable>(iterable: ref I) -> I.Item
    where I.Item: Mul<Output = I.Item> + Default
    =
    let mut total = I.Item.default()
    let mut first = True
    for item in iterable:
        if first:
            total = item
            first = False
        else:
            total = total * item
    return total


// ============================================================
// 辅助函数
// ============================================================

def min(a: int, b: int) -> int =
    if a < b:
        return a
    return b


// ============================================================
// 自测试
// ============================================================

def main():
    test "range":
        let result = collect_list(range(0, 5))
        assert result == [0, 1, 2, 3, 4]

    test "range inclusive":
        let result = collect_list(range_inclusive(1, 3))
        assert result == [1, 2, 3]

    test "once":
        let result = collect_list(once(42))
        assert result == [42]

    test "repeat_n":
        let result = collect_list(repeat_n("x", 3))
        assert result == ["x", "x", "x"]

    test "empty":
        // 泛型由上下文推断
        assert collect_list(empty()) == []

    test "zip":
        let a = range(0, 3)
        let b = range(10, 13)
        let result = collect_list(zip(a, b))
        assert result == [(0, 10), (1, 11), (2, 12)]

    test "step range":
        let result = collect_list(step_range(0, 10, 3))
        assert result == [0, 3, 6, 9]

    test "for_each":
        let mut total = 0
        for_each([1, 2, 3], |x: int| = total = total + x)
        assert total == 6

    test "map and filter":
        let result = map([1, 2, 3, 4], |x: int| -> int = x * x)
        assert result == [1, 4, 9, 16]
        let evens = filter([1, 2, 3, 4, 5], |x: ref int| -> bool = x % 2 == 0)
        assert evens == [2, 4]

    test "fold":
        let result = fold([1, 2, 3, 4], 0, |acc: int, x: int| -> int = acc + x)
        assert result == 10

    test "all any":
        assert all([2, 4, 6], |x: int| -> bool = x % 2 == 0)
        assert not all([2, 3, 6], |x: int| -> bool = x % 2 == 0)
        assert any([1, 3, 5], |x: int| -> bool = x % 2 == 0)
        assert not any([1, 3, 5], |x: int| -> bool = x % 2 == 0)

    test "find":
        assert find([1, 2, 3, 4], |x: ref int| -> bool = x > 2) == Some(3)
        assert find([1, 2, 3], |x: ref int| -> bool = x > 5) == None

    test "sum product":
        assert sum([1, 2, 3, 4, 5]) == 15
        assert product([1, 2, 3, 4]) == 24

    print("iter.lz — all tests passed!")
