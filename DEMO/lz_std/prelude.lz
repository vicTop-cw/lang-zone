// ============================================================
// 自测试 — 演示 prelude 的使用
// ============================================================

def main():
    test "prelude — Option usage":
        let val = Some(42)
        assert val.is_some()
        assert val.unwrap() == 42

    test "prelude — Result usage":
        let ok_val: Result<int, str> = Ok(100)
        assert ok_val.is_ok()
        assert ok_val.unwrap() == 100

    test "prelude — Ordering usage":
        assert Ordering.Less.is_lt()
        assert Ordering.Equal.is_eq()

    test "prelude — range and collect":
        let items = collect_list(range(1, 4))
        assert items == [1, 2, 3]

    test "prelude — min max":
        assert min(3, 7) == 3
        assert max(3, 7) == 7

    test "prelude — map filter":
        let result = map([1, 2, 3], |x: int| -> int = x * 10)
        assert result == [10, 20, 30]

    test "prelude — join":
        assert join(["a", "b", "c"], ",") == "a,b,c"

    test "prelude — error":
        let err = LzError.value_error("bad")
        assert err.kind() == "ValueError"

    print("prelude.lz — all tests passed!")
