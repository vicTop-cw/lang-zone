// ⚠️ 规范符合性示例 —— 暂不可运行（PENDING COMPILER SUPPORT）
// 当前编译器（lzrsc / lzcyc）尚未实现 `..` 可变参数注入，请勿在实现前编译。
// 详见 SYNTAX/03d-可变参数.md。
//
// LZ 可变参数语法（详见 SYNTAX/03d-可变参数.md）
// `..` 用于变参注入：带注解限定一侧，无注解则仅注入 args（Tuple<Any,..>）

// === 安全收集：无 ..，类型安全 ===
def sum_all(values: List<int>) -> int =
    total = 0
    for v in values:
        total += v
    total

sum_all(1, 2, 3, 4)        // 10 — 自动收集为 List<int>

// === 单 .. 无注解 → 仅注入 args（元素 Any，等价 Tuple<Any,..>） ===
def catch_all(..) =
    print(f"args={args}")      // args: List<Any>

catch_all(1, 2, 3)            // args=[1,2,3]
// catch_all(1, name="x")     // ❌ 单 .. 无注解不收集 kwargs

// 想要 kwargs：用 ..: Dict 或第二个 ..
def kw_only(..: Dict<str, int>) =
    for (k, v) in kwargs:
        print(f"{k}={v}")

kw_only(timeout=30, retry=3)   // timeout=30, retry=3

// === ..: Tuple → 仅 args（带类型约束） ===
def total(..: Tuple<int>) -> int =
    s = 0
    for v in args:
        s += v
    s

total(1, 2, 3)             // 6

// === .., .. → args + kwargs 双收集（均 Any） ===
def both(.., ..) =
    print(f"args={args}")
    print(f"kwargs={kwargs}")

both(1, 2, name="x")      // args=[1,2], kwargs={name:"x"}
