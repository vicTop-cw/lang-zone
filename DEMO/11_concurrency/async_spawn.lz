// ============================================================
// LZ Concurrency & Async — async / await / spawn / go
// Spec: SYNTAX/10-并发与异步.md
// Covers: async def, await, spawn (inline + block syntax),
// go (process), Futures<T1,T2> aggregation, spawn vs go
// comparison, error boundaries (await outside async,
// spawn non-function).
// ============================================================

// =============================================================
// 1. async 函数定义
// =============================================================
// async def 定义异步函数，返回 future。

async def fetch_data(id: int) -> str =
    "data_{id}"

async def compute_sum(a: int, b: int) -> int =
    a + b

// 异步函数可以调用其他异步函数
async def fetch_metadata(id: int) -> str =
    fetch_data(id)            // calling another async function

// =============================================================
// 2. await 等待
// =============================================================
// await 暂停当前异步函数执行直到结果就绪。
// await 只能在 async 函数中使用。

async def fetch_all() -> str =
    let a = await fetch_data(1)
    let b = await fetch_data(2)
    a + " + " + b

async def process_sequential() =
    let r1 = await fetch_data(10)
    let r2 = await fetch_data(20)
    print("sequential results: {r1}, {r2}")

// =============================================================
// 3. spawn 并发（线程，适合 I/O 密集型）
// =============================================================
// spawn 启动异步任务，返回 Future<T>。

// 3a. 内联语法
async def run_spawn_inline() =
    let f1 = spawn fetch_data(10)
    let f2 = spawn fetch_data(20)

    let r1 = await f1
    let r2 = await f2
    print(r1, r2)

// 3b. 赋值给变量
async def run_spawn_var() =
    let task: Future<str> = spawn fetch_data(42)
    // ... other work ...
    let result = await task
    print("result: {result}")

// 3c. 块语法（冒号 + 换行缩进）
// 块末尾表达式作为 spawn 的返回，task: Future<T>
async def run_spawn_block() =
    let task = spawn:
        let data = prepare()
        let url = build_url(data)
        fetch_data(url)
    let result = await task
    print("block spawn: {result}")

// 3d. 多任务并发
async def run_multi_spawn() =
    let t1 = spawn download("url1")
    let t2 = spawn download("url2")
    let t3: Future<str> = spawn:
        let u = build_url(99)
        download(u)

    let results = [await t1, await t2, await t3]
    print("downloaded: {results}")

// =============================================================
// 4. Futures<T1, T2> 聚合
// =============================================================
// Futures<T1, ..., Tn> 支持 1~12 个类型参数。
// 单参数使用 Future<T>。多 Future 合并用 Futures<T1, T2, ...>。

async def futures_aggregation() ->
    // Multiple futures of different types
    let tasks: Futures<str, str, int> = (
        spawn fetch_data(1),
        spawn fetch_data(2),
        spawn compute_all()
    )
    let results = await tasks            // 并发等待所有完成
    print("aggregated: {results}")

async def futures_two() ->
    let pair: Futures<str, int> = (
        spawn fetch_data(100),
        spawn compute_sum(3, 4)
    )
    let (label, total) = await pair
    print("{label} = {total}")

// =============================================================
// 5. go 并行进程（适合 CPU 密集型）
// =============================================================
// go 启动独立进程，返回 Future<T>，与 spawn 用法一致。

// 5a. 内联语法
async def run_go_inline() =
    let worker: Future<int> = go heavy_computation(1000)
    let result = await worker
    print("go result: {result}")

// 5b. 块语法
async def run_go_block() =
    let worker = go:
        let config = load_config()
        let data = prepare(config)
        heavy_computation(data)
    let result = await worker
    print("go block result: {result}")

// 5c. go with CPU-intensive task
async def run_parallel_cpu() =
    let w1 = go prime_sieve(1000000)
    let w2 = go prime_sieve(2000000)
    let w3 = go prime_sieve(3000000)

    let results = [await w1, await w2, await w3]
    print("prime counts: {results}")

// =============================================================
// 6. spawn vs go 对比
// =============================================================
//         | spawn          | go
// --------|----------------|------------------
// 启动   | 线程           | 独立进程
// 适合   | I/O 密集型     | CPU 密集型
// 返回值 | Future<T>      | Future<T>
// 语法   | spawn fn()     | go fn()
//        | spawn: ...     | go: ...

async def compare_spawn_vs_go() =
    // spawn for I/O tasks
    let io_tasks = (
        spawn download("file1.txt"),
        spawn download("file2.txt"),
        spawn download("file3.txt")
    )
    let files = await io_tasks
    print("I/O done: {files}")

    // go for CPU tasks
    let cpu_tasks = (
        go heavy_computation(1000),
        go heavy_computation(2000)
    )
    let results = await cpu_tasks
    print("CPU done: {results}")

// =============================================================
// 7. 错误语法边界
// =============================================================
// ❌ await 在非 async 函数中使用（无 spawn 包装）
// def sync_fn() =
//     await async_fn()          // error: need spawn

// ❌ spawn 非函数调用
// spawn 42                     // error: spawn must be a call

// ❌ async 函数作为 spawn 参数
// spawn async def f(): ...     // error: spawn accepts calls, not defs

// ❌ await 在顶层（非 async 函数外）
// let x = await fetch_data(1)  // error: await needs async context

// =============================================================
// Helper functions
// =============================================================
def prepare() -> int = 42
def prepare(config: int) -> int = config * 10
def load_config() -> int = 100
def build_url(id: int) -> str = "http://example/{id}"
def build_url(data: int) -> str = "http://data/{data}"
def download(url: str) -> str = "content_of_{url}"
def compute_all() -> int = 42
def heavy_computation(n: int) -> int = n * n
def prime_sieve(limit: int) -> int = limit / 10  // simplified

// =============================================================
// main — run all demos
// =============================================================
async def main() =
    // spawn inline
    await run_spawn_inline()

    // spawn block
    await run_spawn_block()

    // multi spawn
    await run_multi_spawn()

    // go inline
    await run_go_inline()

    // go block
    await run_go_block()

    // Futures aggregation
    await futures_aggregation()
    await futures_two()

    // spawn vs go comparison
    await compare_spawn_vs_go()

    // sequential async
    await process_sequential()

    print("=== concurrency demo complete ===")
