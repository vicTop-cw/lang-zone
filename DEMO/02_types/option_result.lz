// ============================
// LZ Type System — Option & Result
// ============================

// --- Option<T> with keyword-argument construction ---
def main() =
    // 完整形式 Option<int>
    let x: Option<int> = Option.Some(value: 42)
    let y: Option<int> = Option.None

    // 简写形式 int?（等价于 Option<int>）
    let a: int? = Option.Some(value: 10)
    let b: int? = Option.None

    let desc = match x:
        Option.Some(value: v) =>
            f"value: {v}"
        Option.None =>
            "empty"

    // 简写形式也支持模式匹配
    let desc2 = match a:                     // a: int?
        case Option.Some(value: v) => f"got {v}"
        case Option.None => "none"

    print(desc)

    match y:
        case Option.Some(value: v):
            print(f"got: {v}")
        case Option.None:
            print("none")

    guard let Option.Some(value: n) = x else:
        return
    print(f"unwrapped: {n}")

    let nested: Option<Option<int>> =
        Option.Some(value: Option.Some(value: 99))

    let nested_desc = match nested:
        Option.Some(value: Option.Some(value: v)) =>
            f"nested value: {v}"
        Option.Some(value: Option.None) =>
            "inner none"
        Option.None =>
            "outer none"
    print(nested_desc)

    // --- 3.2 Result<T, E> with keyword-argument construction ---
    def safe_div(a: int, b: int) -> Result<int, str> =
        if b == 0:
            Result.Err(error: "division by zero")
        else:
            Result.Ok(value: a / b)

    let r1 = safe_div(10, 2)
    let r2 = safe_div(10, 0)

    let r1_desc = match r1:
        Result.Ok(value: v) =>
            f"result: {v}"
        Result.Err(error: e) =>
            f"error: {e}"

    let r2_desc = match r2:
        Result.Ok(value: v) =>
            f"result: {v}"
        Result.Err(error: e) =>
            f"error: {e}"

    print(r1_desc, r2_desc)

    // --- 3.3 Error propagation with ? ---
    def parse_int(s: str) -> Result<int, str> =
        if s.is_digit():
            Result.Ok(value: int(s))
        else:
            Result.Err(error: "not a number")

    def process(s: str) -> Result<int, str> =
        let val = parse_int(s)?
        Result.Ok(value: val * 2)

    let p1 = process("42")
    let p2 = process("abc")

    let p1_desc = match p1:
        Result.Ok(value: v) => f"processed: {v}"
        Result.Err(error: e) => f"failed: {e}"

    let p2_desc = match p2:
        Result.Ok(value: v) => f"processed: {v}"
        Result.Err(error: e) => f"failed: {e}"

    print(p1_desc, p2_desc)

    // --- 3.4 Nested Result<Option<T>, E> ---
    let nested_res: Result<Option<int>, str> =
        Result.Ok(value: Option.Some(value: 777))

    let nested_res_desc = match nested_res:
        Result.Ok(value: Option.Some(value: v)) =>
            f"nested ok-some: {v}"
        Result.Ok(value: Option.None) =>
            "nested ok-none"
        Result.Err(error: e) =>
            f"nested err: {e}"

    print(nested_res_desc)
