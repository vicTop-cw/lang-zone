// ============================
// LZ Type — Primitives
// ============================

// --- Scalar types ---
def main() =
    let a: int = 42
    let b: f64 = 3.14
    let c: str = "hello"
    let d: bool = True

    // --- Unit type ---
    let u: Unit = ()

    // --- Never type (diverging) ---
    def abort(msg: str) -> Never =
        panic(msg)

    // --- Type annotations ---
    let annotated: int = 100
    let named: str = "world"

    // --- Type inference ---
    let inf_a = 42
    let inf_b = "hello"
    let inf_c = [1, 2, 3]
    let inf_d = (1, "hi")
    let inf_e = {"key": 42}
    let inf_f = {1, 2, 3}

    // --- Nil type ---
    let empty = []

    // --- Tuple ---
    let t: (int, str, bool) = (42, "hi", True)
    let (x, y, z) = t
    let (first, ..) = t

    // --- Reference ---
    let val = 42
    ref r = val
    let ref s = val

    // --- Function type ---
    let add: fn(int, int) -> int = |x, y| x + y

    // --- Pointer types ---
    let boxed: Box<int> = Box.new(99)
    let bv = boxed[0]

    print(a)
    print(b)
    print(c)
    print(d)
