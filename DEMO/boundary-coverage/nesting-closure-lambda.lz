// ============================================================
// boundary-coverage: 闭包/Lambda 深度嵌套测试
// 覆盖: 闭包嵌套、闭包作为参数/返回值、
//      偏应用嵌套、闭包捕获多层作用域
// ============================================================

// --- 1. 三层嵌套闭包 ---
def triple_nested_closure() =
    let outer = |a: int|
        let middle = |b: int|
            let inner = |c: int| -> int = a + b + c
            inner
        middle
    print(outer(1)(2)(3))

// --- 2. 闭包作为返回值 ---
def make_adder(n: int) -> fn(int) -> int =
    |x| x + n

def make_multiplier(factor: int) -> fn(int) -> int =
    |x| x * factor

// --- 3. 高阶函数组合 ---
def compose(f: fn(int) -> int, g: fn(int) -> int) -> fn(int) -> int =
    |x| f(g(x))

// --- 4. 闭包捕获多层变量 ---
def capture_multilevel(base: int) -> fn(int) -> int =
    let a = base * 2
    let b = base * 3
    |x| a + b + x + base

// --- 5. 偏应用多洞嵌套 ---
def sum4(a: int, b: int, c: int, d: int) -> int =
    a + b + c + d

def partial_nested() =
    let f1 = sum4(_, 10, _, 20)
    let f2 = f1(_, 30)
    print(f2(1))     // sum4(1, 10, 30, 20) = 61

// --- 6. 闭包数组/集合 ---
def closure_collection() =
    let ops: List<fn(int) -> int> = [
        |x| x + 1,
        |x| x * 2,
        |x| x ** 2
    ]
    let base = 5
    for op in ops:
        print(op(base))

// --- 7. 闭包内嵌 match ---
def closure_with_match(threshold: int) =
    let classify = |x: int| -> str =
        match x:
            case v if v < threshold => "low"
            case v if v == threshold => "equal"
            case _ => "high"
    print(classify(5))
    print(classify(10))
    print(classify(20))

// --- 8. 闭包内嵌 if 表达式 ---
def closure_with_ifexpr() =
    let conditional = |x: int, y: int| -> int =
        x + y if x > 0 else x - y
    print(conditional(5, 3))
    print(conditional(-2, 3))

// --- 9. 返回闭包的函数嵌套 ---
def factory_chain(x: int) -> fn(int) -> fn(int) -> int =
    |a|
        |b|
            x + a + b

// --- 10. 复杂闭包组合：管道 + 闭包 + 偏应用 ---
def complex_closure_pipe(data: List<int>, threshold: int) -> List<int> =
    let above = |x: int| -> bool = x > threshold
    let double = |x: int| -> int = x * 2
    [double(x) for x in data if above(x)]

// --- main ---
def main() =
    print("=== nesting-closure-lambda ===")
    triple_nested_closure()

    let add5 = make_adder(5)
    let mul3 = make_multiplier(3)
    print(add5(10))
    print(mul3(10))

    let composed = compose(add5, mul3)
    print(composed(4))    // add5(mul3(4)) = 12 + 5 = 17

    let f = capture_multilevel(10)
    print(f(1))           // 20 + 30 + 1 + 10 = 61

    partial_nested()
    closure_collection()
    closure_with_match(10)
    closure_with_ifexpr()

    let chain = factory_chain(1)(2)
    print(chain(3))     // 1 + 2 + 3 = 6
    print(chain(10))    // 1 + 2 + 10 = 13

    print(complex_closure_pipe([1, 5, 10, 15, 20], 8))

    print("nesting-closure-lambda done")
