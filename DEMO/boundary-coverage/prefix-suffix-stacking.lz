// ============================================================
// 前缀/后缀运算符叠写 — 必须括号逐层拆开
// LZ Spec 12-操作符.md §1.18.1
//
// 一元紧贴（§1.18），但多前缀/多后缀不允许裸叠写：
//   -&!b   ❌ →  -( &(!b) )   逐层括号
//   s?^    ❌ →  (s?)^         显式求值顺序
// ============================================================

def main() =
    // --- 1. 前缀叠写：逐层括号 ---
    let x = 5
    let v2 = -(-x)           // 双重否定 → 5
    print(v2)                // 5

    let a = 3
    let v3 = ~(~a)           // 双重位反 → 3
    print(v3)                // 3

    let v4 = !(!(x == 5))    // 双重逻辑非 → True
    print(v4)                // True

    // 取引用 + 解引用组合（& 得引用，* 解引用还原）
    let boxed = Box.new(10)
    let v5 = *(&(*boxed))    // 先 * 解引用取 10，& 取引用，再 * 还原 → 10
    print(v5)                // 10

    // --- 2. 后缀叠写：逐层括号 ---
    let s: Option<int> = Some(10)

    // 先 ? 解包，再 ^ 转移所有权
    let w1 = (s?)^           // ? 得 int，^ 转移
    print(w1)                // 10

    // 嵌套后缀：先 ?. 安全导航，再 ? 解包
    let dict: Option<Dict<str, int>> = Some({"k": 1})
    let w2 = (dict?.get("k"))?    // ?. 安全导航 → Option<int>，? 解包
    print(w2)                // 1

    // --- 3. 前缀 + 后缀混用：括号显式分层 ---
    let opt = Some(5)
    let mix1 = -(opt?)       // 先 ? 解包得 5，再负 → -5
    print(mix1)              // -5

    let v = 7
    let mix2 = (-v)?         // 先 -v → -7，再 ?（-7 不可传播，仅为演示分层语法）
    print(mix2)

    // --- 4. not 关键字例外：自然分隔，可叠写 ---
    let c = False
    print(not not c)         // False（关键字形式合法叠写）

    // --- 5. 错误示例（编译错误，注释演示）---
    // let bad1 = -&!b        // ❌ 多前缀裸叠，须括号
    // let bad2 = --x         // ❌ 双前缀裸叠，须括号
    // let bad3 = s?^         // ❌ 多后缀裸叠，须括号
    // let bad4 = x?^         // ❌ 多后缀裸叠，须括号
