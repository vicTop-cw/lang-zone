// ============================================================
// 99_spec / closure_fatarrow.lz
// 规范目标 — 闭包胖箭头语法 `=>`（parser 尚未实现）
// 状态: spec-target（编译器不支持，不纳入 compile_demos）
// 需求: parser/expr.rs 闭包分支需检查 FatArrow token
// ============================================================

// ── 单行胖箭头 ────────────────────────────────────────
// spec: |x| => x * 2          // 等价于 |x| x * 2

// ── 多参数胖箭头 ──────────────────────────────────────
// spec: |a, b| => a + b

// ── 无参胖箭头 ────────────────────────────────────────
// spec: | | => 42
// spec: | | => print("no args")

// ── 多行块体胖箭头 ────────────────────────────────────
// spec:
//   let compute = |a, b| =>
//       c = a + b
//       c * c

// ── 完整示例 ──────────────────────────────────────────
// spec:
// def main() =
//     let double = |x| => x * 2
//     print(double(5))
//
//     let add = |a, b| => a + b
//     print(add(3, 4))
//
//     let noop = | | => 42
//     print(noop())
//
//     let compute = |a, b| =>
//         c = a + b
//         c * c
//     print(compute(3, 4))
//
//     // 旧式（无箭头）仍兼容
//     let old_style = |x| x + 1
//     print(old_style(5))
