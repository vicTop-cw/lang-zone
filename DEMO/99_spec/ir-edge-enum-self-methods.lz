// ============================
// IR边界测试: 枚举方法调用链
// ============================

enum MyOption:
    MySome(value: int)
    MyNone

impl MyOption =
    def is_my_some(self) -> bool =
        match self:
            case MyOption.MySome(value: _) => True
            case MyOption.MyNone => False
    
    def unwrap_my(self) -> int =
        match self:
            case MyOption.MySome(value: v) => v
            case MyOption.MyNone => panic("unwrap on MyNone")

def main() =
    let x = MyOption.MySome(value: 42)
    let y = MyOption.MyNone
    print(x.is_my_some())
    print(y.is_my_some())
    print(x.unwrap_my())
