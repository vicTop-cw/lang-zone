// ✅ combo-syntax：while 守卫 + else 分支
// 出处：SYNTAX/05-控制流.md §四（while）+ §4.2（for/while 的 else 子句）
count = 0

def next() -> int =
    count += 1
    count

def main() =
    while (n := next()) <= 5 if n != 3:    // 守卫：跳过 3
        print(n)
    else:
        print("loop exited normally")      // 非 break 退出时执行
