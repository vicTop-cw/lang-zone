// ✅ combo-syntax：while 守卫 + try/catch 错误处理 + 海象 :=（已纳入 compile_demos 覆盖）
// combo-syntax：while 守卫 + try/catch 错误处理 + 海象 :=
// 出处：SYNTAX/05-控制流.md §3.5 + try 语法
enum E:
    Boom(str)

def step() -> int raises E =
    count += 1
    guard count <= 3 else:
        raise E.Boom("over")
    count

def main() =
    count = 0
    try:
        while (n := step()) <= 3 if n % 2 == 1:    // 守卫：只取奇数步
            print(n)
    catch E.Boom(msg):
        print(msg)
