// ✅ combo-syntax：for 守卫 + match 模式匹配（已纳入 compile_demos 覆盖）
// combo-syntax：for 守卫 + match 模式匹配
// 出处：SYNTAX/05-控制流.md §3.5 + match 语法
enum Kind:
    A(int)
    B(str)

def keep(k: Kind) -> bool = True

def main() =
    let items = [Kind.A(1), Kind.B("x"), Kind.A(2)]
    for it in items if keep(it):
        let label = match it:
            case Kind.A(n) => f"a:{n}"
            case Kind.B(s) => f"b:{s}"
        print(label)                 // 预期：a:1 b:x a:2
