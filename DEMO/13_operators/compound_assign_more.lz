// LZ 操作符 — 全部复合赋值
// 覆盖：+= -= *= /= %= &= |= ^= <<= >>= （共 11 种）
// 注意：LZ 默认绑定可变更（x = 10），let 为不可变绑定不可复合赋值

def main() =
    a = 10                 // 默认可变绑定
    a += 2      // 12
    a -= 3      // 9
    a *= 4      // 36
    a /= 2      // 18
    a %= 5      // 3
    a &= 1      // 1
    a |= 4      // 5
    a ^= 1      // 4
    a <<= 1     // 8
    a >>= 1     // 4
    print(a)
