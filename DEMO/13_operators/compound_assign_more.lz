// LZ 操作符 — 全部复合赋值
// 覆盖：+= -= *= /= %= &= |= ^= <<= >>= （共 11 种）

def main() =
    let mut a = 10
    a += 2      // 12
    a -= 3      // 9
    a *= 4      // 36
    a /= 2      // 18
    a %= 5      // 3
    a &= 1      // 1
    a |= 4      // 5
    a ^= 1      // 4
    a <<= 1     // 8
    a >>= 1     // 4
    print(a)
