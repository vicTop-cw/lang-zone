// 由 lzc --emit=parse-lz 生成（自举路线 B：LZ 写的前端处理输入文件）
// ═══════════════════════════════════════════════════════════════
// 自举试点 4：用 LZ 实现递归下降表达式解析器（Parser 前端 LZ 化起步）
// 基于词法试点（lexer.lz）的 Token 流：tokenize → parse_expr → 求值
// 覆盖：+ - * / 优先级、括号、整数/标识符；验证「LZ 写语法前端」可行性
//
// 规避（p29 定位的 LZ 缺陷）：
//   A. tokenize 运算符分支用查表法（List 数据驱动），避免 9 层 elif 链
//      触发 lang-zone 编译栈溢出（p27 同类：深层 elif 链）
//   B. 递归下降返回元组先绑定中间变量（let r = (...) 再 return r），
//      避免「let 语句后跟元组字面量」被 codegen 拼成调用（E0618）
// ═══════════════════════════════════════════════════════════════

// ── Token（词法试点精简子集，v171 加语句关键字，v177 加逗号/箭头，
//     v179 加比较/逻辑运算符，v188 加字符串字面量）──
enum Token:
    IntLit(v: int)
    StrLit(s: str)
    Ident(name: str)
    Plus
    Minus
    Star
    Slash
    LParen
    RParen
    LBracket
    RBracket
    LBrace
    RBrace
    Colon
    Comma
    Arrow
    FatArrow
    EqEq
    Ne
    Lt
    Gt
    Le
    Ge
    AmpAmp
    PipePipe
    Eq
    Let
    Dot
    Match
    Case
    While
    For
    In
    Return
    If
    Else
    Def
    Indent(v: int)
    Newline
    Eof

// ── 字符工具 ──
def char_at(s: str, idx: int) -> str =
    s[idx..(idx + 1)]

def str_len(s: str) -> int =
    s.len()

def is_digit(c: str) -> bool =
    c >= "0" and c <= "9"

def is_alpha(c: str) -> bool =
    (c >= "a" and c <= "z") or (c >= "A" and c <= "Z") or c == "_"

// ── 扫描（数字/标识符）──
// 数字直接返回 int（切片表达式 s[a..b] as int 走 codegen parse 分支；
// tokenize 函数级上下文中 `num as int` 变量 cast 仍走 as i64——p33-p38
// 证明枚举构造/List 拼接/while 循环场景均已走 parse（v170 覆盖），
// 仅 tokenize 复杂函数上下文差异登记待修）
def scan_int(src: str, start: int) -> (int, int) =
    let mut i = start
    while i < str_len(src) && is_digit(char_at(src, i)):
        i = i + 1
    let v = src[start..i] as int
    let res: (int, int) = (v, i)
    res

def scan_indent(src: str, start: int) -> (int, int) =
    let mut j = start
    while j < str_len(src) && (char_at(src, j) == " " or char_at(src, j) == "	"):
        j = j + 1
    (j - start, j)

def scan_ident(src: str, start: int) -> (str, int) =
    let mut i = start
    while i < str_len(src) && (is_alpha(char_at(src, i)) or is_digit(char_at(src, i))):
        i = i + 1
    (src[start..i], i)

// 扫描字符串字面量（v188）："..." 到匹配引号；返回 (内容, 结束位置)
def scan_string(src: str, start: int) -> (str, int) =
    let mut i = start + 1
    while i < str_len(src) && char_at(src, i) != "\"":
        i = i + 1
    let res: (str, int) = (src[(start + 1)..i], i + 1)
    res

// ── 关键字 → Token（查表，规避深层 elif 链）──
def keyword_token(w: str) -> (bool, Token) =
    let table: List<(str, Token)> = [
        ("return", Token.Return),
        ("if", Token.If),
        ("else", Token.Else),
        ("def", Token.Def),
        ("let", Token.Let),
        ("match", Token.Match),
        ("case", Token.Case),
        ("while", Token.While),
        ("for", Token.For),
        ("in", Token.In),
    ]
    let mut result: (bool, Token) = (false, Token.Ident(name: w.clone()))
    for idx in 0..table.len():
        let pair = table[idx].clone()
        if pair.0 == w:
            result = (true, pair.1)
    result

// ── 单字符运算符查表（规避深层 elif 链）──
def op_token(c: str) -> (bool, Token) =
    let table: List<(str, Token)> = [
        ("+", Token.Plus),
        ("-", Token.Minus),
        ("*", Token.Star),
        ("/", Token.Slash),
        ("(", Token.LParen),
        (")", Token.RParen),
        ("[", Token.LBracket),
        ("]", Token.RBracket),
        ("{", Token.LBrace),
        ("}", Token.RBrace),
        ("<", Token.Lt),
        (">", Token.Gt),
        ("=", Token.Eq),
        (".", Token.Dot),
    ]
    let mut result: (bool, Token) = (false, Token.Plus)
    for idx in 0..table.len():
        let pair = table[idx].clone()
        if pair.0 == c:
            result = (true, pair.1)
    result

// ── 双字符运算符查表（v179：== != <= >= && ||，规避深层 elif 链）──
def two_char_op(c1: str, c2: str) -> (bool, Token) =
    let key: str = c1 + c2
    let table: List<(str, Token)> = [
        ("==", Token.EqEq),
        ("!=", Token.Ne),
        ("<=", Token.Le),
        (">=", Token.Ge),
        ("&&", Token.AmpAmp),
        ("||", Token.PipePipe),
        ("=>", Token.FatArrow),
    ]
    let mut result: (bool, Token) = (false, Token.Plus)
    for idx in 0..table.len():
        let pair = table[idx].clone()
        if pair.0 == key:
            result = (true, pair.1)
    result

// ── tokenize：完整扫描源码（行首缩进 → Indent(v)，嵌套块解析）──
// v176：编译器栈溢出解除（main.rs 大栈线程 512MB）后，缩进块版恢复入库——
// 行首空格数生成 Indent(v)；parse_block↔parse_stmt 互相递归解析嵌套块。
// 限制：空行/纯缩进行不生成 Indent（块内空行会终止块），见 p43 同款设计
def tokenize(src: str) -> List<Token> =
    let mut tokens: List<Token> = []
    let mut i = 0
    let mut line_start = true
    while i < str_len(src):
        let c = char_at(src, i)
        if c == "\n":
            tokens = tokens + [Token.Newline]
            i = i + 1
            line_start = true
        elif line_start && c == " ":
            let r = scan_indent(src, i)
            tokens = tokens + [Token.Indent(v: r.0)]
            i = r.1
            line_start = false
        elif line_start:
            tokens = tokens + [Token.Indent(v: 0)]
            line_start = false
        elif c == " ":
            i = i + 1
        elif c == "\"":
            let r = scan_string(src, i)
            i = r.1
            tokens = tokens + [Token.StrLit(s: r.0)]
        elif is_digit(c):
            let r = scan_int(src, i)
            i = r.1
            tokens = tokens + [Token.IntLit(v: r.0)]
        elif is_alpha(c):
            let r = scan_ident(src, i)
            i = r.1
            let kw = keyword_token(r.0)
            if kw.0:
                tokens = tokens + [kw.1]
            else:
                tokens = tokens + [Token.Ident(name: r.0)]
        elif c == ":":
            tokens = tokens + [Token.Colon]
            i = i + 1
        elif c == ",":
            tokens = tokens + [Token.Comma]
            i = i + 1
        elif c == "-" && i + 1 < str_len(src) && char_at(src, i + 1) == ">":
            tokens = tokens + [Token.Arrow]
            i = i + 2
        else:
            let mut handled = false
            if i + 1 < str_len(src):
                let r2 = two_char_op(c, char_at(src, i + 1))
                if r2.0:
                    tokens = tokens + [r2.1]
                    i = i + 2
                    handled = true
            if not handled:
                let r = op_token(c)
                let found = r.0
                let tok = r.1
                if found:
                    tokens = tokens + [tok]
                    i = i + 1
                else:
                    i = i + 1
    tokens = tokens + [Token.Eof]
    tokens

// ── Token 流工具 ──
def tok_at(toks: List<Token>, idx: int) -> Token =
    // 越界保护：索引超出 token 流末尾时返回 Eof，避免裸索引 panic
    if idx >= toks.len():
        Token.Eof
    else:
        toks[idx].clone()

// ── 表达式 AST（v178：求值 → 建树，自举 Parser 核心数据结构；
//     v179：加 Cmp/Logic 节点；v181：加 Call 节点；v182：加 Get 节点；
//     v187：加 Index 节点）──
// 递归枚举（Bin/Cmp/Logic/Call/Get/Index 含 Expr；v189 加 ListLit；
// v190 加 TupleLit；v191 加 DictLit）——p0_recursive_enum 已验证 codegen
// 可行（v178 修复子 CodeGen 漏克隆 enum_variant_fields 后 Box 包装正常；
// v181 确认 enum 定义/构造两侧均用 type_refers_to 深查——`List<Expr>`
// 字段两侧一致生成 Box<Vec<Expr>>；`List<(Expr, Expr)>` 经 Tuple 深查
// 两侧一致）；
// 字段名用 v:nm/op 长名，规避单字母 codegen 降级（E0308）
enum Expr:
    IntLit(v: int)
    StrLit(v: str)
    Ident(name: str)
    Bin(op: str, l: Expr, r: Expr)
    Cmp(op: str, l: Expr, r: Expr)
    Logic(op: str, l: Expr, r: Expr)
    Call(callee: Expr, args: List<Expr>)
    Get(recv: Expr, name: str)
    Index(recv: Expr, idx: Expr)
    ListLit(elems: List<Expr>)
    TupleLit(elems: List<Expr>)
    DictLit(pairs: List<(Expr, Expr)>)

// ── 递归下降解析器（返回 (Expr, 新位置)，元组先绑定中间变量）──
// parse_atom: 整数 | 字符串 | 标识符 | ( expr )/(a, b, c) | [elem, ...]
def parse_atom(toks: List<Token>, pos: int) -> (Expr, int) =
    let t = tok_at(toks, pos)
    let res: (Expr, int) = match t:
        case Token.IntLit(v: n) => (Expr.IntLit(v: n), pos + 1)
        case Token.StrLit(s: sv) => (Expr.StrLit(v: sv), pos + 1)
        case Token.Ident(name: nm) => (Expr.Ident(name: nm), pos + 1)
        case Token.LParen =>
            // (expr) 括号表达式 | (a, b, c) 元组字面量（v190 逗号探测）
            let r = parse_logic(toks, pos + 1)
            let rv = r.0
            let rp = r.1
            let sep = tok_at(toks, rp)
            if sep == Token.Comma:
                // 元组：首元素 + 逗号分隔剩余元素直到 RParen
                let mut elems: List<Expr> = [rv]
                let mut p = rp + 1
                let mut done = false
                while not done:
                    let t2 = tok_at(toks, p)
                    if t2 == Token.RParen:
                        done = true
                        p = p + 1
                    else:
                        let r2 = parse_logic(toks, p)
                        let rv2 = r2.0
                        let rp2 = r2.1
                        elems = elems + [rv2]
                        let sep2 = tok_at(toks, rp2)
                        if sep2 == Token.Comma:
                            p = rp2 + 1
                        else:
                            p = rp2
                let pr: (Expr, int) = (Expr.TupleLit(elems: elems), p)
                pr
            else:
                let pr: (Expr, int) = (rv, rp + 1)
                pr
        case Token.LBracket =>
            // 列表字面量 [a, b, c]（v189）
            let r = parse_list_elems(toks, pos + 1)
            let elems = r.0
            let rp = r.1
            let pr: (Expr, int) = (Expr.ListLit(elems: elems), rp + 1)
            pr
        case Token.LBrace =>
            // 字典字面量 {"k": v, ...}（v191）
            let r = parse_dict_pairs(toks, pos + 1)
            let pairs = r.0
            let rp = r.1
            let pr: (Expr, int) = (Expr.DictLit(pairs: pairs), rp + 1)
            pr
        case _ => (Expr.Ident(name: "?"), pos + 1)
    res

// 字典键值对解析（v191）：`"k": v, "k2": v2` → List<(Expr, Expr)> +
// RBrace 后位置
def parse_dict_pairs(toks: List<Token>, pos: int) -> (List<(Expr, Expr)>, int) =
    let mut out: List<(Expr, Expr)> = []
    let mut p = pos
    let mut done = false
    while not done:
        let t = tok_at(toks, p)
        if t == Token.RBrace:
            done = true
            p = p + 1
        elif t == Token.Eof:
            // 输入截断护栏
            done = true
        else:
            let rk = parse_logic(toks, p)
            let k = rk.0
            let after_key = rk.1
            let rv = parse_logic(toks, after_key + 1)
            let v = rv.0
            let after_val = rv.1
            let pair: (Expr, Expr) = (k, v)
            out = out + [pair]
            let sep = tok_at(toks, after_val)
            if sep == Token.Comma:
                p = after_val + 1
            else:
                p = after_val
    let res: (List<(Expr, Expr)>, int) = (out, p)
    res

// 列表元素解析（v189）：`a, b, c` → List<Expr> + RBracket 后位置
def parse_list_elems(toks: List<Token>, pos: int) -> (List<Expr>, int) =
    let mut out: List<Expr> = []
    let mut p = pos
    let mut done = false
    while not done:
        let t = tok_at(toks, p)
        if t == Token.RBracket:
            done = true
            p = p + 1
        else:
            let r = parse_logic(toks, p)
            let rv = r.0
            let rp = r.1
            out = out + [rv]
            let sep = tok_at(toks, rp)
            if sep == Token.Comma:
                p = rp + 1
            else:
                p = rp
    let res: (List<Expr>, int) = (out, p)
    res

// ── 调用实参解析（v181）：`(a, b)` → List<Expr> + RParen 后位置 ──
def parse_args(toks: List<Token>, pos: int) -> (List<Expr>, int) =
    let mut out: List<Expr> = []
    let mut p = pos
    let mut done = false
    while not done:
        let t = tok_at(toks, p)
        if t == Token.RParen:
            done = true
            p = p + 1
        else:
            let r = parse_logic(toks, p)
            let rv = r.0
            let rp = r.1
            out = out + [rv]
            let sep = tok_at(toks, rp)
            if sep == Token.Comma:
                p = rp + 1
            else:
                p = rp
    let res: (List<Expr>, int) = (out, p)
    res

// ── 后缀调用/字段/下标层（v181 调用；v182 取字段；v187 下标）──
// parse_atom 之后循环探测后缀：LParen → Call；Dot+Ident → Get；
// LBracket → Index（recv[idx]）
def parse_postfix(toks: List<Token>, pos: int) -> (Expr, int) =
    let first = parse_atom(toks, pos)
    let mut value = first.0
    let mut p = first.1
    let mut done = false
    while not done:
        let t = tok_at(toks, p)
        if t == Token.LParen:
            let r = parse_args(toks, p + 1)
            let args_list = r.0
            let rp = r.1
            let ne = Expr.Call(callee: value.clone(), args: args_list)
            value = ne
            p = rp
        elif t == Token.Dot:
            let name_t = tok_at(toks, p + 1)
            let nm = field_desc(name_t)
            let ne = Expr.Get(recv: value.clone(), name: nm)
            value = ne
            p = p + 2
        elif t == Token.LBracket:
            let r = parse_logic(toks, p + 1)
            let idx_expr = r.0
            let rp = r.1
            let ne = Expr.Index(recv: value.clone(), idx: idx_expr)
            value = ne
            p = (rp + 1)  // 跳过 RBracket
        else:
            done = true
    let res: (Expr, int) = (value, p)
    res

// parse_term: postfix (* postfix)* / postfix
def parse_term(toks: List<Token>, pos: int) -> (Expr, int) =
    let first = parse_postfix(toks, pos)
    let mut value = first.0
    let mut p = first.1
    let mut done = false
    while not done:
        let t = tok_at(toks, p)
        if t == Token.Star:
            let r = parse_postfix(toks, p + 1)
            let rv = r.0
            let rp = r.1
            let ne = Expr.Bin(op: "*", l: value.clone(), r: rv)
            value = ne
            p = rp
        elif t == Token.Slash:
            let r = parse_postfix(toks, p + 1)
            let rv = r.0
            let rp = r.1
            let ne = Expr.Bin(op: "/", l: value.clone(), r: rv)
            value = ne
            p = rp
        else:
            done = true
    let res: (Expr, int) = (value, p)
    res

// parse_expr: term (+ term)* - term
def parse_expr(toks: List<Token>, pos: int) -> (Expr, int) =
    let first = parse_term(toks, pos)
    let mut value = first.0
    let mut p = first.1
    let mut done = false
    while not done:
        let t = tok_at(toks, p)
        if t == Token.Plus:
            let r = parse_term(toks, p + 1)
            let rv = r.0
            let rp = r.1
            let ne = Expr.Bin(op: "+", l: value.clone(), r: rv)
            value = ne
            p = rp
        elif t == Token.Minus:
            let r = parse_term(toks, p + 1)
            let rv = r.0
            let rp = r.1
            let ne = Expr.Bin(op: "-", l: value.clone(), r: rv)
            value = ne
            p = rp
        else:
            done = true
    let res: (Expr, int) = (value, p)
    res

// ── 比较运算符 → (bool, 操作符串)（v179）──
def cmp_op(t: Token) -> (bool, str) =
    let res: (bool, str) = match t:
        case Token.EqEq => (true, "==")
        case Token.Ne => (true, "!=")
        case Token.Lt => (true, "<")
        case Token.Le => (true, "<=")
        case Token.Gt => (true, ">")
        case Token.Ge => (true, ">=")
        case _ => (false, "?")
    res

// 逻辑运算符 → (bool, 操作符串)（v179）
def logic_op(t: Token) -> (bool, str) =
    let res: (bool, str) = match t:
        case Token.AmpAmp => (true, "&&")
        case Token.PipePipe => (true, "||")
        case _ => (false, "?")
    res

// parse_cmp: expr (比较 expr)*（v179；比较优先级高于逻辑、低于加减）
def parse_cmp(toks: List<Token>, pos: int) -> (Expr, int) =
    let first = parse_expr(toks, pos)
    let mut value = first.0
    let mut p = first.1
    let mut done = false
    while not done:
        let t = tok_at(toks, p)
        let co = cmp_op(t)
        if co.0:
            let r = parse_expr(toks, p + 1)
            let rv = r.0
            let rp = r.1
            let ne = Expr.Cmp(op: co.1, l: value.clone(), r: rv)
            value = ne
            p = rp
        else:
            done = true
    let res: (Expr, int) = (value, p)
    res

// parse_logic: cmp ((&& | ||) cmp)*（v179；逻辑优先级最低）
def parse_logic(toks: List<Token>, pos: int) -> (Expr, int) =
    let first = parse_cmp(toks, pos)
    let mut value = first.0
    let mut p = first.1
    let mut done = false
    while not done:
        let t = tok_at(toks, p)
        let lo = logic_op(t)
        if lo.0:
            let r = parse_cmp(toks, p + 1)
            let rv = r.0
            let rp = r.1
            let ne = Expr.Logic(op: lo.1, l: value.clone(), r: rv)
            value = ne
            p = rp
        else:
            done = true
    let res: (Expr, int) = (value, p)
    res

// List<Expr> → 摘要字符串（逗号分隔，Call 实参展示用，v181）
def expr_list_summary(xs: List<Expr>) -> str =
    let mut out = ""
    for idx in 0..xs.len():
        if idx > 0:
            out = out + ", "
        out = out + display_expr(xs[idx])
    out

// List<(Expr, Expr)> → 摘要字符串（"k": v, "k2": v2，DictLit 展示用，v191）
def expr_pair_summary(xs: List<(Expr, Expr)>) -> str =
    let mut out = ""
    for idx in 0..xs.len():
        if idx > 0:
            out = out + ", "
        let pair = xs[idx].clone()
        out = out + display_expr(pair.0) + ": " + display_expr(pair.1)
    out

// Expr → 中缀串（v178：IntLit(3) → "3"；Bin("+",a,b) → "a + b"；
// v179：Cmp/Logic 同款递归渲染；v181：Call 渲染 f(a, b)；
// v182：Get 渲染 recv.name；v187：Index 渲染 recv[idx]；
// v189：ListLit 渲染 [a, b, c]；v190：TupleLit 渲染 (a, b, c)；
// v191：DictLit 渲染 {"k": v, ...}）
def display_expr(e: Expr) -> str =
    let res: str = match e:
        case Expr.IntLit(v: n) => n.to_string()
        case Expr.StrLit(v: sv) => "\"" + sv + "\""
        case Expr.Ident(name: nm) => nm
        case Expr.Bin(op: op, l: lv, r: rv) =>
            display_expr(lv) + " " + op + " " + display_expr(rv)
        case Expr.Cmp(op: op, l: lv, r: rv) =>
            display_expr(lv) + " " + op + " " + display_expr(rv)
        case Expr.Logic(op: op, l: lv, r: rv) =>
            display_expr(lv) + " " + op + " " + display_expr(rv)
        case Expr.Call(callee: cv, args: av) =>
            display_expr(cv) + "(" + expr_list_summary(av) + ")"
        case Expr.Get(recv: rv, name: nm) =>
            display_expr(rv) + "." + nm
        case Expr.Index(recv: rv, idx: iv) =>
            display_expr(rv) + "[" + display_expr(iv) + "]"
        case Expr.ListLit(elems: ev) =>
            "[" + expr_list_summary(ev) + "]"
        case Expr.TupleLit(elems: ev) =>
            "(" + expr_list_summary(ev) + ")"
        case Expr.DictLit(pairs: pv) =>
            "{" + expr_pair_summary(pv) + "}"
    res

// ── 语句级解析（v171：if/def/return；v176：缩进值传递）──
// parse_stmt: return expr | if expr: 块 | def name: 块 | 表达式语句
// 返回 (语句描述 str, 新位置)；indent = 本语句所在行的缩进值，
// 嵌套块（if/def 体）须 > indent 才会被收集
def parse_stmt(toks: List<Token>, pos: int, indent: int) -> (str, int) =
    let t = tok_at(toks, pos)
    let res: (str, int) = match t:
        case Token.Return =>
            let r = parse_logic(toks, pos + 1)
            let rv = r.0
            let rp = r.1
            let rr: (str, int) = ("return " + display_expr(rv), rp)
            rr
        case Token.If =>
            let r = parse_logic(toks, pos + 1)
            let rv = r.0
            let rp = r.1
            let after = tok_at(toks, rp)
            // LZ 三元表达式：a if cond else b（if 是语句式，不能内联）
            let npos = (rp + 1) if after == Token.Colon else rp
            let blk = parse_block(toks, npos, indent)
            let body = blk.0
            let blk_end = blk.1
            let body_s = list_summary(body)
            let rr: (str, int) = ("if " + display_expr(rv) + " {" + body_s + "}", blk_end)
            rr
        case Token.Else =>
            let rr: (str, int) = ("else", pos + 1)
            rr
        case Token.Match =>
            // match expr: 块（v183：case 行由 Case 分支处理）
            let r = parse_logic(toks, pos + 1)
            let rv = r.0
            let rp = r.1
            let after = tok_at(toks, rp)
            let npos = (rp + 1) if after == Token.Colon else rp
            let blk = parse_block(toks, npos, indent)
            let body = blk.0
            let blk_end = blk.1
            let body_s = list_summary(body)
            let rr: (str, int) = ("match " + display_expr(rv) + " {" + body_s + "}", blk_end)
            rr
        case Token.Case =>
            // case 模式: 块（v183）| case 模式 => 值（v186 match 表达式）
            let pat_t = tok_at(toks, pos + 1)
            let pat_s = pattern_desc(pat_t)
            let arrow_t = tok_at(toks, pos + 2)
            if arrow_t == Token.FatArrow:
                let r = parse_logic(toks, pos + 3)
                let rv = r.0
                let rp = r.1
                let rr: (str, int) = ("case " + pat_s + " => " + display_expr(rv), rp)
                rr
            else:
                let colon_t = tok_at(toks, pos + 2)
                let npos = (pos + 3) if colon_t == Token.Colon else pos + 2
                let blk = parse_block(toks, npos, indent)
                let body = blk.0
                let blk_end = blk.1
                let body_s = list_summary(body)
                let rr: (str, int) = ("case " + pat_s + " {" + body_s + "}", blk_end)
                rr
        case Token.While =>
            // while cond: 块（v184）
            let r = parse_logic(toks, pos + 1)
            let rv = r.0
            let rp = r.1
            let after = tok_at(toks, rp)
            let npos = (rp + 1) if after == Token.Colon else rp
            let blk = parse_block(toks, npos, indent)
            let body = blk.0
            let blk_end = blk.1
            let body_s = list_summary(body)
            let rr: (str, int) = ("while " + display_expr(rv) + " {" + body_s + "}", blk_end)
            rr
        case Token.For =>
            // for x in iter: 块（v185）
            let name_t = tok_at(toks, pos + 1)
            let name_s = ident_name(name_t)
            let r = parse_logic(toks, pos + 3)
            let rv = r.0
            let rp = r.1
            let after = tok_at(toks, rp)
            let npos = (rp + 1) if after == Token.Colon else rp
            let blk = parse_block(toks, npos, indent)
            let body = blk.0
            let blk_end = blk.1
            let body_s = list_summary(body)
            let rr: (str, int) = ("for " + name_s + " in " + display_expr(rv) + " {" + body_s + "}", blk_end)
            rr
        case Token.Def =>
            let name_t = tok_at(toks, pos + 1)
            let name_s = ident_name(name_t)
            // 注：name_s 来自 ident_name（&str 切片），`+ ""` 强制 sig 为 String
            // 起点，否则 `sig + pr.0` 生成 &str + String 拼接（E0308，v177 缺陷）
            let mut sig = name_s + ""
            let mut ap = pos + 2
            // 参数列表：(a: int, b: str)
            let lp_t = tok_at(toks, ap)
            if lp_t == Token.LParen:
                let pr = parse_params(toks, ap)
                sig = sig + pr.0
                ap = pr.1
            // 返回类型：-> int
            let rf = ret_suffix(toks, ap)
            sig = sig + rf.0
            ap = rf.1
            let colon_t = tok_at(toks, ap)
            let npos = (ap + 1) if colon_t == Token.Colon else ap
            let blk = parse_block(toks, npos, indent)
            let body = blk.0
            let blk_end = blk.1
            let body_s = list_summary(body)
            let rr: (str, int) = ("def " + sig + " {" + body_s + "}", blk_end)
            rr
        case Token.Let =>
            // let x = expr | let x: ty = expr（v180）
            let name_t = tok_at(toks, pos + 1)
            let name_s = ident_name(name_t)
            let mut ap = pos + 2
            let mut ty_s = ""
            let colon_t = tok_at(toks, ap)
            if colon_t == Token.Colon:
                let ty_t = tok_at(toks, ap + 1)
                ty_s = ident_name(ty_t)
                ap = ap + 2
            let eq_t = tok_at(toks, ap)
            let rp = (ap + 1) if eq_t == Token.Eq else ap
            let r = parse_logic(toks, rp)
            let rv = r.0
            let rend = r.1
            let full = name_s + (" : " + ty_s if ty_s.len() > 0 else "") + " = " + display_expr(rv)
            let rr: (str, int) = ("let " + full, rend)
            rr
        case Token.Newline =>
            let rr: (str, int) = ("", pos + 1)
            rr
        case _ =>
            // 表达式语句或赋值：lhs = rhs（v184，while 体需要）
            let r = parse_logic(toks, pos)
            let rv = r.0
            let rp = r.1
            let eq_t = tok_at(toks, rp)
            if eq_t == Token.Eq:
                let r2 = parse_logic(toks, rp + 1)
                let rv2 = r2.0
                let rend = r2.1
                let rr: (str, int) = (display_expr(rv) + " = " + display_expr(rv2), rend)
                rr
            else:
                let rr: (str, int) = ("expr " + display_expr(rv), rp)
                rr
    res

// 提取 Ident 的 name（非 Ident 返回 "?"）
def ident_name(t: Token) -> str =
    // 注：绑定名用 nm 而非 n——单字母 n 触发 codegen 降级（n_）且体内引用
    // 未同步（E0308，自举暴露缺陷）
    let res: str = match t:
        case Token.Ident(name: nm) => nm
        case _ => "?"
    res

// 模式描述（v183）：case 模式 → 字符串（IntLit → 数字、Ident/通配 → 名）
def pattern_desc(t: Token) -> str =
    let res: str = match t:
        case Token.IntLit(v: n) => n.to_string()
        case Token.Ident(name: nm) => nm
        case _ => "?"
    res

// 字段描述（v190）：.字段 → 字符串（Ident → 名；IntLit → 数字，元组
// 字段访问 pair.0/pair.1 用）
def field_desc(t: Token) -> str =
    let res: str = match t:
        case Token.IntLit(v: n) => n.to_string()
        case Token.Ident(name: nm) => nm
        case _ => "?"
    res

// List<str> → 摘要字符串（逗号分隔，块体展示用）
def list_summary(xs: List<str>) -> str =
    let mut out = ""
    for idx in 0..xs.len():
        if idx > 0:
            out = out + ", "
        out = out + xs[idx]
    out

// ── 参数列表解析（v177）：(a: int, b: str) → 参数描述串 + 新位置 ──
// pos 指向 LParen；返回 (描述串 "(a: int, b: str)", RParen 后位置)
def parse_params(toks: List<Token>, pos: int) -> (str, int) =
    let mut out: List<str> = []
    let mut p = pos + 1
    let mut done = false
    while not done:
        let t = tok_at(toks, p)
        if t == Token.RParen:
            done = true
            p = p + 1
        elif t == Token.Eof:
            // 输入截断护栏：避免在 Eof 上无限循环
            done = true
        else:
            let nm = ident_name(t)
            let colon_t = tok_at(toks, p + 1)
            if colon_t == Token.Colon:
                let ty_t = tok_at(toks, p + 2)
                let ty = ident_name(ty_t)
                let item: str = nm + ": " + ty
                out = out + [item]
                let sep = tok_at(toks, p + 3)
                if sep == Token.Comma:
                    p = p + 4
                else:
                    p = p + 3
            else:
                // 无类型标注参数：def f(x)
                out = out + [nm]
                let sep = tok_at(toks, p + 1)
                if sep == Token.Comma:
                    p = p + 2
                else:
                    p = p + 1
    let params_s = "(" + list_summary(out) + ")"
    let res: (str, int) = (params_s, p)
    res

// 返回类型后缀：`-> int` → (" -> int", 新位置)；无则 ("", 原位置)
def ret_suffix(toks: List<Token>, pos: int) -> (str, int) =
    let t = tok_at(toks, pos)
    if t == Token.Arrow:
        let ty_t = tok_at(toks, pos + 1)
        let ty = ident_name(ty_t)
        let res: (str, int) = (" -> " + ty, pos + 2)
        res
    else:
        let res: (str, int) = ("", pos)
        res

// parse_program: stmt* 直到 Eof；返回 (语句列表描述, 位置)
def parse_block(toks: List<Token>, pos: int, indent: int) -> (List<str>, int) =
    let mut out: List<str> = []
    let mut p = pos
    let mut done = false
    while not done:
        let t = tok_at(toks, p)
        let tag = block_tag(t)
        if tag == 0:
            done = true
        elif tag == 1:
            p = p + 1
        elif tag == 2:
            let n = block_indent(t)
            if n > indent:
                let r = parse_stmt(toks, p + 1, n)
                let s = r.0
                if s.len() > 0:
                    out = out + [s]
                p = r.1
            else:
                done = true
        else:
            done = true
    (out, p)

def block_tag(t: Token) -> int =
    let res: int = match t:
        case Token.Eof => 0
        case Token.Newline => 1
        case Token.Indent(v: n) => 2
        case _ => 0
    res

def block_indent(t: Token) -> int =
    let res: int = match t:
        case Token.Indent(v: n) => n
        case _ => -1
    res

def parse_program(toks: List<Token>, pos: int) -> (List<str>, int) =
    // 顶层即缩进 -1 的块：行首 Indent(0) 视为顶层语句（v176 缩进块版）
    parse_block(toks, pos, -1)

// ── main：解析一段含字典字面量 AST 的多行源码并输出 ──

def main() =
    let src = "// combo-syntax（绿色回归测试）：enum + match + guard let 模式守卫\nenum Shape:\n    Circle(f64)\n    Rect(f64, f64)\n\n// guard let 在 match 之外做模式守卫\ndef describe(s: Shape) -> str =\n    guard let Circle(r) = s else:\n        return \"not a circle\"\n    f\"circle r={r}\"\n\ndef main() =\n    let c = Shape.Circle(2.0)\n    let name = match c:\n        case Circle(r) => f\"circle {r}\"\n        case Rect(w, h) => f\"rect {w}x{h}\"\n    print(name)                       // circle 2\n    print(describe(c))                // circle r=2\n    print(describe(Shape.Rect(3.0, 4.0)))   // not a circle\n"
    let toks = tokenize(src)
    let r = parse_program(toks, 0)
    let stmts = r.0
    for idx in 0..stmts.len():
        print(stmts[idx])

