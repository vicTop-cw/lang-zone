// ============================
// LZ Macros — macro & template
// ============================

// Macro and template definitions require a #!bin macro module.
// This file shows the syntax in a comment-only form since
// macro modules must be separate files with #!bin macro as first line.

// --- 1. #!bin macro module declaration ---
// Must be the first line of the .lz file:
// #!bin macro

// --- 2. macro definition ---
// macro name(param: Tokens) -> Tokens = body
// macro id(input: Tokens) -> Tokens = input

// --- 3. macro body with quote() ---
// macro const_i64(name: Tokens, value: Tokens) -> Tokens =
//     quote("const " + name + ": i64 = " + value + ";")

// --- 4. Backtick syntax sugar for quote() ---
// f``` — interpolation mode: $(expr) is evaluated and substituted
// r``` — raw mode: all characters preserved literally
//
// macro debug_log(msg: Tokens) -> Tokens =
//     f```
//     if DEBUG:
//         print($(msg))
//     ```

// --- 5. Macro call syntax ---
// @name! must be on its own line (cannot be inline in an expression)
// @id!
// def f() = 42

// --- 6. template definition ---
// template name!<T>(params) -> Tokens = body
// template ends with ! suffix, call uses name! (no @ prefix)
//
// template make!<T>(name: Tokens, fields..: Tokens) -> Tokens =
//     f```
//     struct $(name) =
//         $(fields)
//     ```

// --- 7. Template call ---
// make!(MyStruct,
//     x: int
//     y: int
// )
// Expands to:
// struct MyStruct =
//     x: int
//     y: int

// --- 8. Built-in macro functions ---
// quote(s)          → string to Tokens
// merge_tokens(a,b) → concatenate tokens
// token_count(stream) → count tokens
// filter_tokens(src, kind) → filter by token type
// error(msg)        → compile-time error
// assert_eq(a, b)   → compile-time assertion

// --- 9. Attribute macro list ---
// #!bin macro       → declare macro module
// #!export(Rust)    → export to Rust cdylib
// #!export(Python)  → export to PyO3 module
// #!no_std          → disable standard library

// --- 10. Macro expansion pipeline ---
// Source → Lexer → MacroExpander → Parser → AST → CodeGen
//                ↑ (only lexical scan)  ↑ (full syntax analysis)

// --- 11. Macro invocation rules ---
// @name! must be on its own line
// template name! can be inline in expressions
// Backtick blocks only get lexical scanning, not full syntax checking

def main() =
    print("macro and template syntax demonstrated")
    // Runtime macro replacement results are baked in at compile time
