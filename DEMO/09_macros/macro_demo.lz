// ============================
// LZ Macros — macro & template (macro module)
// ============================

// This file is a macro module. #!bin macro must be the first line.

// --- 1. macro definition ---
macro id(input: Tokens) -> Tokens = input

macro const_i64(name: Tokens, value: Tokens) -> Tokens =
    quote("const " + name + ": i64 = " + value + ";")

// --- 2. Backtick syntax sugar for quote() ---
macro debug_log(msg: Tokens) -> Tokens =
    f```
    if DEBUG:
        print($(msg))
    ```

macro raw_text(input: Tokens) -> Tokens =
    r```
    Raw text block — $(x) is not interpolated
    ```

// --- 3. Multi-step macro with built-in functions ---
macro pub_fns(input: Tokens) -> Tokens =
    let fns = filter_tokens(input, "FnDef")
    merge_tokens(quote("// public functions:\n"), fns)

// --- 4. Compile-time validation macro ---
macro checked_add(a: int, b: int) -> Tokens =
    guard a + b < 1000 else:
        error("overflow")
    quote("let result: i64 = " + a + "+" + b + ";")

// --- 5. template definition ---
template make!<T>(name: Tokens, fields..: Tokens) -> Tokens =
    f```
    struct $(name) =
        $(fields)
    ```

template assert_eq!<T>(a: Tokens, b: Tokens) -> Tokens =
    quote("assert_eq!(" + a + ", " + b + ")")

// --- 6. Macro call examples (in regular code, these would be used as: ---
// @id!
// def f() = 42
//
// @debug_log!("running...")
//
// make!(MyStruct,
//     x: int
//     y: int
// )
