// ============================
// LZ Expressions — Operators
// ============================

def main() =
    // --- Arithmetic ---
    let a = 10 + 20       // 30
    let b = 20 - 10       // 10
    let c = 5 * 6         // 30
    let d = 30 / 5        // 6
    let e = 17 % 5        // 2 (remainder, not modulo)
    let f = 2 ** 10       // 1024 (power)
    let g = -a            // -30 (negation)

    // --- Comparison ---
    let eq = 1 == 1       // True
    let ne = 1 != 2       // True
    let lt = 1 < 2        // True
    let gt = 2 > 1        // True
    let le = 1 <= 1       // True
    let ge = 2 >= 1       // True

    // chained comparison (a < b < c → a < b and b < c)
    let chain = 1 < 5 < 10  // True

    // --- Logical (keyword form) ---
    let land = True and False   // False (short-circuit)
    let lor = True or False     // True (short-circuit)
    let lnot = not True         // False

    // --- Logical (symbol form, equivalent) ---
    let sand = True && False    // same as and
    let sor = True || False     // same as or
    let snot = !True            // same as not

    // --- Bitwise ---
    let band = 5 & 3        // 1  (101 & 011 = 001)
    let bor = 5 | 3         // 7  (101 | 011 = 111)
    let bxor = 5 ^ 3        // 6  (101 ^ 011 = 110)
    let shl = 1 << 3        // 8
    let shr = 8 >> 2        // 2
    // let binv = ~5        // bitwise not (design stage)

    // --- Identity & membership ---
    let is_type = 42 is int      // True
    let contains = "llo" in "hello"  // True (substring)
    let in_list = 3 in [1, 2, 3]    // True

    // --- Compound assignment ---
    x = 10
    x += 5            // x = 15
    x -= 3            // x = 12
    x *= 2            // x = 24
    x /= 4            // x = 6
    x %= 5            // x = 1

    print(a, b, c, d, e, f, g, eq, ne)
