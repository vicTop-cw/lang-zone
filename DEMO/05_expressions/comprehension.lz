// ================================================================
// LZ Expressions — Comprehensions (list / dict / set,
// multiple filters, multiple iterators, filters with dict)
// ================================================================

def main() =
    // ---- 16  List comprehension  ----
    let squares = [x * x for x in 1..10]
    // [1, 4, 9, 16, 25, 36, 49, 64, 81]

    // ---- 16  With single filter  ----
    let even_squares = [x * x for x in 1..10 if x % 2 == 0]
    // [4, 16, 36, 64]

    // ---- 16  Multiple filters  ----
    let filtered = [x for x in 1..20 if x > 5 if x < 15]
    // [6, 7, 8, 9, 10, 11, 12, 13, 14]

    // ---- 16  Multiple iterators  ----
    let pairs = [x + y for x in [1, 2] for y in [10, 20]]
    // [11, 21, 12, 22]

    // ---- 16  Dict comprehension  ----
    let squares_dict = {k: k * k for k in 1..5}
    // {1: 1, 2: 4, 3: 9, 4: 16}

    // ---- 16  Dict comprehension with filter  ----
    let filtered_dict = {k: v for (k, v) in squares_dict if v > 5}
    // {3: 9, 4: 16}

    // ---- 16  Set comprehension  ----
    let unique_squares = {x * x for x in [1, 2, 2, 3, 3, 3]}
    // {1, 4, 9}

    // ---- 16  Set comprehension with filter  ----
    let evens_set = {x for x in 1..10 if x % 2 == 0}
    // {2, 4, 6, 8}

    // ---- 16  List comprehension with tuple unpack  ----
    let pairs_list = [(k, v) for (k, v) in squares_dict if k > 2]
    // [(3, 9), (4, 16)]

    print(squares)
    print(even_squares)
    print(filtered)
    print(pairs)
    print(squares_dict)
    print(filtered_dict)
    print(unique_squares)
    print(evens_set)
    print(pairs_list)
