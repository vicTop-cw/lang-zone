// ================================================================
// LZ Expressions — Pipe |>
// ================================================================

def double(x: int) -> int = x * 2
def add_one(x: int) -> int = x + 1

def main() =
    // data |> f  ===  f(data)
    let r1 = 5 |> double
    print(r1)

    // Chain: data |> f |> g  ===  g(f(data))
    let r2 = 5 |> double |> add_one
    print(r2)

    // Lambda pipe equivalence
    let r3 = |x| x * x
    print(r3(10))
