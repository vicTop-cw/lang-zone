// find_bug/codegen/bug-codegen-call-magic.lz
// BUG-CG-002: __call__ 魔法方法编译到 Rust
// __call__ 方法让 struct 实例可调用

struct Adder =
  x: int

def __init__(mut self: Adder, x: int) =
  self.x = x

def __call__(self: Adder, y: int) -> int =
  self.x + y

def main() =
  add5 = Adder { x: 5 }
  result = add5(10)  // __call__ 接线
  print("Adder(5)(10):", result)
  assert result == 15
  print("bug-codegen-call-magic.lz done")
