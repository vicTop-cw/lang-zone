// [夜巡 R1-寻虫 · 对抗样例 nb02] 窗口日 2026-10-23
// 期望：负 bigint 字面量与除法/取模应通过。
//   数学语义（截断除法）：-1000000000000000000000000000 / 7 = -142857142857142857142857142
//   取模符号随被除数（Rust num-bigint 语义）：-1000000000000000000000000000 % 7 = -6
// 先写期望再实跑。
let a: bigint = -1000000000000000000000000000
let b: bigint = 7
println(a / b)
println(a % b)
