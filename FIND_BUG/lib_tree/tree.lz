// lib_tree — 二叉树（修复版）
// 修复：用空格分隔参数避免泛型解析问题

enum BinaryTree:
    Node(int, BinaryTree, BinaryTree)
    Empty

def inorder(tree: BinaryTree) -> List<int> =
    match tree:
        case BinaryTree.Empty:
            []
        case BinaryTree.Node(val, left, right):
            inorder(left) + [val] + inorder(right)

def preorder(tree: BinaryTree) -> List<int> =
    match tree:
        case BinaryTree.Empty:
            []
        case BinaryTree.Node(val, left, right):
            [val] + preorder(left) + preorder(right)

def postorder(tree: BinaryTree) -> List<int> =
    match tree:
        case BinaryTree.Empty:
            []
        case BinaryTree.Node(val, left, right):
            let result: List<int> = []
            let result = result + postorder(left)
            let result = result + postorder(right)
            result + [val]

def fold(tree: BinaryTree, acc: int, ref f: fn(int, int) -> int) -> int =
    match tree:
        case BinaryTree.Empty:
            acc
        case BinaryTree.Node(val, left, right):
            let acc1 = fold(left, acc, f)
            let acc2 = f(acc1, val)
            fold(right, acc2, f)

def find(tree: BinaryTree, ref pred: fn(int) -> bool) -> Option<int> =
    match tree:
        case BinaryTree.Empty:
            None
        case BinaryTree.Node(val, left, right):
            if pred(val):
                Some(val)
            else:
                let found_left = find(left, pred)
                if found_left is Some:
                    found_left
                else:
                    find(right, pred)

def add(acc: int, x: int) -> int =
    acc + x

def sum_tree(tree: BinaryTree) -> int =
    fold(tree, 0, add)

def make_node(val: int, left: BinaryTree, right: BinaryTree) -> BinaryTree =
    BinaryTree.Node(val, left, right)

def make_empty() -> BinaryTree =
    BinaryTree.Empty

def eq_5(x: int) -> bool =
    x == 5

def eq_99(x: int) -> bool =
    x == 99

def height(tree: BinaryTree) -> int =
    match tree:
        case BinaryTree.Empty:
            0
        case BinaryTree.Node(_, left, right):
            let left_h = height(left)
            let right_h = height(right)
            if left_h > right_h: left_h + 1 else: right_h + 1

def size(tree: BinaryTree) -> int =
    match tree:
        case BinaryTree.Empty:
            0
        case BinaryTree.Node(_, left, right):
            size(left) + size(right) + 1

def main() =
    //       1
    //      / \
    //     2   3
    //    / \
    //   4   5
    let n4 = make_node(4, make_empty(), make_empty())
    let n5 = make_node(5, make_empty(), make_empty())
    let n2 = make_node(2, n4, n5)
    let n3 = make_node(3, make_empty(), make_empty())
    let tree = make_node(1, n2, n3)

    // traversals
    assert inorder(tree) == [4, 2, 5, 1, 3]
    assert preorder(tree) == [1, 2, 4, 5, 3]
    assert postorder(tree) == [4, 5, 2, 3, 1]

    // fold
    let sum = fold(tree, 0, add)
    assert sum == 15

    // sum_tree helper
    assert sum_tree(tree) == 15

    // height and size
    assert height(tree) == 3
    assert size(tree) == 5

    // find
    let found = find(tree, eq_5)
    assert found == Some(5)

    let not_found = find(tree, eq_99)
    assert not_found == None

    // empty tree
    let empty: BinaryTree = make_empty()
    assert inorder(empty) == []
    assert height(empty) == 0
    assert size(empty) == 0
    assert sum_tree(empty) == 0

    print("lib_tree OK")
