// ============================================================
// 轮10: set/tuple — 集合运算（并/交/差/包含）、元组（构造/解构/索引）
// 每项用 assert 确保正确
// ============================================================

def main() =
    // ── 元组构造与索引 ──
    let t = (1, "two", 3.0)
    assert t[0] == 1
    assert t[1] == "two"
    assert t[2] == 3.0

    // ── 元组解构 ──
    let (a, b, c) = (10, 20, 30)
    assert a == 10
    assert b == 20
    assert c == 30

    // ── 二元组（pair） ──
    let pair = (5, "five")
    assert pair[0] == 5
    assert pair[1] == "five"

    // ── set 字面量与包含 ──
    let s = {1, 2, 3}
    assert 1 in s
    assert 3 in s
    assert 9 not in s
    assert len(s) == 3

    // ── set 添加与删除 ──
    mut ms = {1, 2}
    ms.add(3)
    assert 3