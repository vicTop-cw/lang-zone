// ══════════════════════════════════════════════════════════════════════
// 七、禁止形式（编译应报错，实现后加入 reject_errors）
// ══════════════════════════════════════════════════════════════════════

// 禁止 7.1：#[embed(tnr)] 缩进块内插值 → 编译错误
// let extra = "let D = C × W"
// #[embed(tnr)]
// fn bad_interp(A, B)
//     let C = A × B
//     $(extra)              // ❌ 禁止：缩进式原样不得插值
//     relu(D)

// 禁止 7.2：用户宏用保留语言宏名 → 编译错误
// macro rust(input: Tokens) -> Tokens = input   // ❌ rust 是保留语言宏名

// ══════════════════════════════════════════════════════════════════════
// 八、预期产物（实现后验证）
// ══════════════════════════════════════════════════════════════════════

// 编译本文件 → 生成：
//   embed-tnr-test-corpus.tnr（含 tnr_add/tnr_matmul_relu/tnr_sum_and_grad/
//                              tnr_parallel/tnr_softmax/tnr_dot/tnr_dense）
//   → tnr 编译 → embed-tnr-test-corpus_tnr.rs
//   → LZ codegen 生成：
//     #[path = "embed-tnr-test-corpus_tnr.rs"] mod embed_tnr_test_corpus_tnr;
//     use embed_tnr_test_corpus_tnr::*;
//     use tnr::tensor::Tensor;
//
// 运行 main() → 调 tnr_add(A, B) 等 → 输出张量结果
