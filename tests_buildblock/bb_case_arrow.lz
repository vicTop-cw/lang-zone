// match case 改用 => ：支持内联（无需额外缩进）或换行缩进两种写法
def classify(n: int)-> str =
    match n:
        case 0 => "zero"
        case _ => "other"

// 换行缩进形式 + 守卫 if
def bucket(n: int)-> str =
    match n:
        case x if x < 0 =>
            "neg"
        case 0 => "zero"
        case _ => "pos"

def main() =
    print(f"case inline 0={classify(0)}")   // 期望 zero
    print(f"case inline 5={classify(5)}")   // 期望 other
    print(f"case guard -3={bucket(-3)}")    // 期望 neg
    print(f"case guard 0={bucket(0)}")      // 期望 zero
    print(f"case guard 9={bucket(9)}")      // 期望 pos
