// 生成器调用构建块 (*:) — 对每个 yield 逐步产出的参数包自动拆包并调用上层函数
// 结果收集为 Vec（惰性迭代器的一次性消费）。验证：元组 *args 拆包、空参数包、嵌套 for 内 yield。

// 消费每个 yield 出的元组参数包（自动拆包为位置实参）
def show(a: int, b: int)-> str =
    f"({a},{b})"

// 消费空参数包（无参函数）
def tick()-> str =
    "tick"

def main() =
    print("=== generator build block (tuple unpack per yield) ===")
    xs = show *:
        for i in [1, 2, 3]:
            yield (i^, i^)
    for v in xs:
        print(f"  gen unpack: {v}")   // 期望 (1,1) (2,2) (3,3)

    print("=== generator build block (empty packs) ===")
    ys = tick *:
        yield
        yield
    for v in ys:
        print(f"  {v}")               // 期望 tick tick
