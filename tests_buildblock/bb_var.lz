// 变量构建块 (=:) — 内部默认 unsafe，支持提前 return 与 guard 语句
// 验证：词法识别、缩进作用域、提前返回控制流、guard 控制流

def main() =
    // 提前 return：y=10 > 3 → y-=1=9 → return 9
    x =:
        y = 10
        if y > 3:
            y -= 1
            return y^
        y
    print(f"var-block x = {x}")          // 期望 9

    // guard 语句：条件不满足时走 else 分支（提前返回）
    z =:
        v = -5
        guard v >= 0 else:
            return -1
        v * 2
    print(f"var-block z = {z}")          // 期望 -1

    // 嵌套控制流 + 尾部表达式自动返回
    w =:
        mut total = 0
        for i in 1..4:
            total += i
        total
    print(f"var-block w = {w}")          // 期望 6
