// 三元控制流 if cond: a else: b —— 冒号后为内联表达式（保留空白即可，不强制缩进）
// 等价于直接调用，构建块应与其结果一致
def max(a: int, b: int)-> int =
    if a > b: a else: b

def sign(n: int)-> int =
    if n > 0: 1 else: if n < 0: -1 else: 0

def main() =
    print(f"ternary max(3,7)={max(3, 7)}")   // 期望 7
    print(f"ternary sign(-5)={sign(-5)}")    // 期望 -1
    print(f"ternary sign(0)={sign(0)}")      // 期望 0
    print(f"ternary sign(9)={sign(9)}")      // 期望 1
