// 调用构建块 (~:) — 结构体参数包（BuildParams 语义）整体作为单参数传递
// 验证：词法识别、缩进作用域、提前 return、guard、结构体包整体拆包（Single 分支）

struct Point =
    x: int
    y: int

// 被调函数接收构建出的参数包（此处为 Point 结构体，整体单参）
def make_point(p: Point)-> Point =
    p

// 字典 key 与参数名一致的 **kwargs 拆包演示
def person(name: str, age: int)-> str =
    f"{name}({age})"

def main() =
    pt = make_point ~:
        a = 3
        b = 4
        if a > 100:
            return Point(x: 0, y: 0)
        return Point(x: a^, y: b^)
    print(f"call-block pt = ({pt.x}, {pt.y})")   // 期望 (3, 4)

    // 字典 key 与函数参数名对应 → 自动 **kwargs 拆包
    s = person ~:
        return {name: "tom", age: 7}
    print(f"call-block person = {s}")             // 期望 tom(7)
