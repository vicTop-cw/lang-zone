// 调用构建块(~:) — 元组参数包自动拆包为位置实参（类似 Python *args）
def add(a: int, b: int)-> int =
    a + b

def main() =
    // 块返回元组 (x^, y^) → 自动拆包为 add(x, y)
    s = add ~:
        x = 10
        y = 20
        if x > 5:
            return (x^, y^)
        return (x^, y^)
    print(f"unpack tuple (*args)-> {s}")   // 期望 30

    // 嵌套控制流内的提前 return 同样拆包
    t = add ~:
        x = 3
        return (x^, (x + 4)^)
    print(f"unpack tuple early-return: {t}")   // 期望 10（直接调用 add(3,7)=10，构建块等价于直接调用）
