// auto-mut 推断探针：ref self 改字段应自动升级为 &mut self
struct CountDown =
    n: int

impl CountDown =
    def __next__(ref self) -> Option<int> =
        if self.n <= 0:
            return None
        let v = self.n
        self.n = self.n - 1
        return Some(v)

def main() =
    cd = CountDown(n: 3)
    print(cd.next().unwrap())
    print(cd.next().unwrap())
    print(cd.next().unwrap())
    print(cd.next().unwrap())
    print(cd.next().unwrap())
