// __iter_strategy__ 现状盘点探针
struct MyRange =
    start: int
    stop: int

impl MyRange =
    def __iter_strategy__(ref self) -> List<str> =
        return ["range", "list"]

    def __iter__(ref self) -> List<int> =
        let result: List<int> = []
        let i = self.start
        while i < self.stop:
            result.append(i)
            i = i + 1
        return result

def main() =
    r = MyRange(start: 1, stop: 4)
    print(r.__iter_strategy__())
    for x in r:
        print(x)
