// ============================================================
// neg_error_uncaught_panic_ok.lz — 反例探针（必须编译失败）
//
// 测什么：函数体内出现【类型化 raise】而签名未声明 raises。
// 期望：rc != 0，诊断为语义错误
//       「函数 <名> 体内使用了 raise 但未在签名中声明 raises」。
//
// 为什么从字符串 raise 改成类型化 raise：
//   `raise "msg"` 是消息式错误，实现有意豁免 raises 声明
//   （见 SYNTAX/09-错误处理.md §2.2.1「字符串字面量 raise 的豁免」）。
//   旧版探针写的正是字符串字面量 raise，于是恒 rc=0：既过不了
//   「反例必须失败」的判据，也测不到文档承诺的那条边界。
//   类型化 raise 不享受豁免，才能继续守住这条边界。
// ============================================================

enum AppError:
    Boom(str)

// 类型化 raise + 未声明 raises —— 应编译失败
def main() =
    raise AppError.Boom("boom")
