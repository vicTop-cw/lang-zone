// p38_while_let_cast.lz：验证 while 循环内 `let num: str = r.0` 的变量 cast
// 是否走 as i64（vs p37 main 内走 parse）——builder 循环作用域类型注册疑点
enum Token:
    IntLit(v: int)

def char_at(s: str, idx: int) -> str =
    s[idx..(idx + 1)]

def scan_int(src: str, start: int) -> (str, int) =
    let mut i = start
    while i < src.len() && char_at(src, i) >= "0" and char_at(src, i) <= "9":
        i = i + 1
    (src[start..i], i)

def main() =
    let mut toks: List<Token> = []
    let mut i = 0
    while i < 1:
        let r = scan_int("42abc", 0)
        let num: str = r.0
        toks = toks + [Token.IntLit(v: num as int)]
        i = i + 1
    let t = toks[0].clone()
    match t:
        case Token.IntLit(v: n) => print("val=" + n.to_string())
