def scan_int(src: str, start: int) -> (str, int) =
    let mut i = start
    while i < src.len() && src[i..(i + 1)] >= "0" and src[i..(i + 1)] <= "9":
        i = i + 1
    (src[start..i], i)

def main() =
    let r = scan_int("123abc", 0)
    let num: str = r.0
    let n = num as int
    print(n.to_string())
