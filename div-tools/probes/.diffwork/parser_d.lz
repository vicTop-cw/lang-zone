// ═══════════════════════════════════════════════════════════════
// 自举试点 4：用 LZ 实现递归下降表达式解析器（Parser 前端 LZ 化起步）
// 基于词法试点（lexer.lz）的 Token 流：tokenize → parse_expr → 求值
// 覆盖：+ - * / 优先级、括号、整数/标识符；验证「LZ 写语法前端」可行性
// ═══════════════════════════════════════════════════════════════

// ── Token（词法试点精简子集）──
enum Token:
    IntLit(v: int)
    Ident(name: str)
    Plus
    Minus
    Star
    Slash
    LParen
    RParen
    Eof

// ── 字符工具 ──
def char_at(s: str, idx: int) -> str =
    s[idx..(idx + 1)]

def str_len(s: str) -> int =
    s.len()

def is_digit(c: str) -> bool =
    c >= "0" and c <= "9"

def is_alpha(c: str) -> bool =
    (c >= "a" and c <= "z") or (c >= "A" and c <= "Z") or c == "_"

// ── 扫描（数字/标识符/运算符）──
def scan_int(src: str, start: int) -> (str, int) =
    let mut i = start
    while i < str_len(src) && is_digit(char_at(src, i)):
        i = i + 1
    (src[start..i], i)

def scan_ident(src: str, start: int) -> (str, int) =
    let mut i = start
    while i < str_len(src) && (is_alpha(char_at(src, i)) or is_digit(char_at(src, i))):
        i = i + 1
    (src[start..i], i)

// ── tokenize：完整扫描表达式源码 ──
def tokenize(src: str) -> List<Token> =
    let mut tokens: List<Token> = []
    let mut i = 0
    while i < str_len(src):
        let c = char_at(src, i)
        if c == " " || c == "\t":
            i = i + 1
        elif c == "+":
            tokens = tokens + [Token.Plus]
            i = i + 1
        elif c == "-":
            tokens = tokens + [Token.Minus]
            i = i + 1
        elif c == "*":
            tokens = tokens + [Token.Star]
            i = i + 1
        elif c == "/":
            tokens = tokens + [Token.Slash]
            i = i + 1
        elif c == "(":
            tokens = tokens + [Token.LParen]
            i = i + 1
        elif c == ")":
            tokens = tokens + [Token.RParen]
            i = i + 1
        elif is_digit(c):
            let r = scan_int(src, i)
            i = r.1
            let num: str = r.0
            tokens = tokens + [Token.IntLit(v: num as int)]
        elif is_alpha(c):
            let r = scan_ident(src, i)
            i = r.1
            tokens = tokens + [Token.Ident(name: r.0)]
        else:
            i = i + 1
    tokens = tokens + [Token.Eof]
    tokens

// ── Token 流位置工具 ──
def tok_at(toks: List<Token>, idx: int) -> Token =
    toks[idx].clone()

def tok_is(toks: List<Token>, idx: int, want: Token) -> bool =
    tok_at(toks, idx) == want

// ── 递归下降解析器（返回 (结果, 新位置)）──
// parse_atom: 整数 | 标识符(占位 0) | ( expr )
def parse_atom(toks: List<Token>, pos: int) -> (int, int) =
    let t = tok_at(toks, pos)
    match t:
        case Token.IntLit(v: n) => (n, pos + 1)
        case Token.LParen =>
            let r = parse_expr(toks, pos + 1)
            (r.0, r.1 + 1)
        case _ =>
            // 标识符或未知：占位 0，跳过
            (0, pos + 1)

// parse_term: atom (* atom)* / atom
def parse_term(toks: List<Token>, pos: int) -> (int, int) =
    let mut value = 0
    let mut p = 0
    let first = parse_atom(toks, pos)
    value = first.0
    p = first.1
    let mut done = false
    while not done:
        let t = tok_at(toks, p)
        if t == Token.Star:
