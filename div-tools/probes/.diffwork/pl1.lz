// ═══════════════════════════════════════════════════════════════
// 自举试点 4：用 LZ 实现递归下降表达式解析器（Parser 前端 LZ 化起步）
// 基于词法试点（lexer.lz）的 Token 流：tokenize → parse_expr → 求值
// 覆盖：+ - * / 优先级、括号、整数/标识符；验证「LZ 写语法前端」可行性
//
// 规避（p29 定位的 LZ 缺陷）：
//   A. tokenize 运算符分支用查表法（List 数据驱动），避免 9 层 elif 链
//      触发 lang-zone 编译栈溢出（p27 同类：深层 elif 链）
//   B. 递归下降返回元组先绑定中间变量（let r = (...) 再 return r），
//      避免「let 语句后跟元组字面量」被 codegen 拼成调用（E0618）
// ═══════════════════════════════════════════════════════════════

// ── Token（词法试点精简子集，v171 加语句关键字）──
enum Token:
    IntLit(v: int)
    Ident(name: str)
    Plus
    Minus
    Star
    Slash
    LParen
    RParen
    Colon
    Return
    If
    Else
    Def
    Indent(v: int)
    Newline
    Eof

// ── 字符工具 ──
def char_at(s: str, idx: int) -> str =
    s[idx..(idx + 1)]

def str_len(s: str) -> int =
    s.len()

def is_digit(c: str) -> bool =
    c >= "0" and c <= "9"

def is_alpha(c: str) -> bool =
    (c >= "a" and c <= "z") or (c >= "A" and c <= "Z") or c == "_"

// ── 扫描（数字/标识符）──
// 数字直接返回 int（切片表达式 s[a..b] as int 走 codegen parse 分支；
// tokenize 函数级上下文中 `num as int` 变量 cast 仍走 as i64——p33-p38
// 证明枚举构造/List 拼接/while 循环场景均已走 parse（v170 覆盖），
// 仅 tokenize 复杂函数上下文差异登记待修）
def scan_int(src: str, start: int) -> (int, int) =
    let mut i = start
    while i < str_len(src) && is_digit(char_at(src, i)):
        i = i + 1
    let v = src[start..i] as int
    let res: (int, int) = (v, i)
    res

def scan_ident(src: str, start: int) -> (str, int) =
    let mut i = start
    while i < str_len(src) && (is_alpha(char_at(src, i)) or is_digit(char_at(src, i))):
        i = i + 1
    (src[start..i], i)

// ── 关键字 → Token（查表，规避深层 elif 链）──
def keyword_token(w: str) -> (bool, Token) =
    let table: List<(str, Token)> = [
        ("return", Token.Return),
        ("if", Token.If),
        ("else", Token.Else),
        ("def", Token.Def),
    ]
    let mut result: (bool, Token) = (false, Token.Ident(name: w.clone()))
    for idx in 0..table.len():
        let pair = table[idx].clone()
        if pair.0 == w:
            result = (true, pair.1)
    result

// ── 单字符运算符查表（规避深层 elif 链）──
def op_token(c: str) -> (bool, Token) =
    let table: List<(str, Token)> = [
        ("+", Token.Plus),
        ("-", Token.Minus),
        ("*", Token.Star),
        ("/", Token.Slash),
        ("(", Token.LParen),
        (")", Token.RParen),
    ]
    let mut result: (bool, Token) = (false, Token.Plus)
    for idx in 0..table.len():
        let pair = table[idx].clone()
        if pair.0 == c:
            result = (true, pair.1)
    result

// ── tokenize：完整扫描表达式源码（行首缩进 → Indent(v)）──
def tokenize(src: str) -> List<Token> =
    let mut tokens: List<Token> = []
    let mut i = 0
    let mut line_start = true
    while i < str_len(src):
        let c = char_at(src, i)
        // 行首空格 → 缩进计数
        if line_start && (c == " " || c == "\t"):
            let mut j = i
            while j < str_len(src) && (char_at(src, j) == " " or char_at(src, j) == "\t"):
                j = j + 1
            let n = j - i
            tokens = tokens + [Token.Indent(v: n)]
            i = j
            line_start = false
        elif c == " " || c == "\t":
            i = i + 1
        elif c == "\n":
            tokens = tokens + [Token.Newline]
            i = i + 1
            line_start = true
        elif is_digit(c):
            let r = scan_int(src, i)
            i = r.1
            tokens = tokens + [Token.IntLit(v: r.0)]
            line_start = false
        elif is_alpha(c):
            let r = scan_ident(src, i)
            i = r.1
            let kw = keyword_token(r.0)
            if kw.0:
                tokens = tokens + [kw.1]
            else:
                tokens = tokens + [Token.Ident(name: r.0)]
            line_start = false
        elif c == ":":
            tokens = tokens + [Token.Colon]
            i = i + 1
            line_start = false
        else:
            let r = op_token(c)
            let found = r.0
            let tok = r.1
            if found:
                tokens = tokens + [tok]
                i = i + 1
            else:
                i = i + 1
            line_start = false
    tokens = tokens + [Token.Eof]
    tokens

