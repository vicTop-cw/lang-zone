// p35_listlit_cast.lz：验证 List 字面量元素中的 cast 是否走 as i64（vs p34 直接绑定走 parse）
enum Token:
    IntLit(v: int)

def get_pair() -> (str, int) =
    let res: (str, int) = ("42", 1)
    res

def main() =
    let r = get_pair()
    let num: str = r.0
    // List 字面量元素中的枚举构造 + cast
    let toks: List<Token> = [Token.IntLit(v: num as int)]
    let t = toks[0].clone()
    match t:
        case Token.IntLit(v: n) => print("val=" + n.to_string())
