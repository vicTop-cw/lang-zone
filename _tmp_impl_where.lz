trait Iterator =
    type Item
    def __next__(mut self) -> Option<Self.Item> = ...

struct FlatMap<I, J, B> =
    outer: I

impl<I: Iterator, J: Iterator, B> Iterator for FlatMap<I, J, B>
    where J: Iterator<Item = B>
    =
    type Item = B

    def __next__(mut self) -> Option<B> =
        None
