// LZSTD — 内建函数与装饰器桩
// 用户无需 import，编译期自动注入
// 函数已由编译器前端直接识别，此文件为规范参考

// =============================================================
// 内建函数
// =============================================================

/// 输出到 stdout
def print(value: str) = rust.std.io.println(value)

/// 异常终止程序
def abort(msg: str) =
    rust.std.process.abort(msg)

/// 断言
def check(cond: bool, msg: str = "") =
    if not cond:
        raise msg

/// 编译期求值
def compval(expr) =
    rust.std.compiler.eval(expr)

/// 返回长度
def len(x) -> int =
    x.__len__()

/// 运行时类型查询
def typeof(x) -> int = 0

/// 类型判断
def isinstance(x, T) -> bool =
    rust.std.any.instance_of(x, T)

// =============================================================
// 内建装饰器（编译器内建，此文件仅为规范参考）
// 装饰器由编译器前端直接识别并处理代码生成
// =============================================================

/// 函数记忆化缓存
def memoize(f) = f

/// 自动并行化（CPU 密集任务）
def parallel(f) = f

/// 柯里化
def curry(f) = f

/// 函数重载
def overload(f) = f

/// 自动派生 trait 实现
def derive(traits) = f => f

/// 尾调用优化
def tail_call(f) = f

/// 多后端导出
def export(backend) = f => f

/// 模块初始化钩子
def init(f) = f
