// LZSTD — 特征定义（规范参考）
// 实现对应 __xxx__ 即获得该能力

trait Iterable =
    def __iter__(self) = self

trait Iterator =
    def __next__(self) = 0

trait Index =
    def __getitem__(self, key) = 0

trait Callable =
    def __call__(self, args) = 0

trait Str =
    def __str__(self) -> str = ""

trait Eq =
    def __eq__(self, other) -> bool = True

trait Ord =
    def __cmp__(self, other) -> int = 0

trait Drop =
    def __drop__(self) = ()

trait Sized =
    def __len__(self) -> int = 0
