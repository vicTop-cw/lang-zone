// Lang-Zong 基准测试
// 素数筛法 + 递归 Fibonacci

def fib(n: int)-> int =
    if n <= 1: n
    else: fib(n - 1) + fib(n - 2)

def sieve(n: int)-> int =
    mut count = 0
    mut is_prime: List<bool> = []
    for i in range(n + 1):
        is_prime.push(true)
    is_prime[0] = false
    is_prime[1] = false
    mut p = 2
    while p * p <= n:
        if is_prime[p]:
            mut multiple = p * p
            while multiple <= n:
                is_prime[multiple] = false
                multiple = multiple + p
        p = p + 1
    for i in range(n + 1):
        if is_prime[i]:
            count = count + 1
    count

def main() =
    let r = fib(35)
    print(f"fib(35) = {r}")
    let c = sieve(500000)
    print(f"sieve(500000) = {c} primes")
