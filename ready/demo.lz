// Lang-Zong 完整示例 — Phase 2 + Phase 3
// Phase 2：泛型函数、int? 语法糖、trait = ... 抽象方法、guard 语句
// Phase 3：管道 |>、安全导航 ?.、null 合并 ??、guard let、import 模块、f-string 重解析

// ──────────────── 1. 常量 ────────────────

const PI: f64 = 3.14
const MAX_SIZE: int = 100

// ──────────────── 1b. 模块导入（生成 Rust use 语句）────────────────
import std::collections::HashMap

// ──────────────── 2. 函数（含泛型）────────────────

def add(a: int, b: int)-> int =
    a + b

def greet(name: str) =
    print(f"Hello, {name}")

def power(base: int, exp: int)-> int =
    if exp == 0: 1
    else: base * power(base, exp - 1)

def fib(n: int)-> int =
    if n <= 1: n
    else: fib(n - 1) + fib(n - 2)

def factorial(n: int)-> int =
    if n <= 1: 1
    else: n * factorial(n - 1)

// 泛型函数
def identity<T>(x: T)-> T =
    x

// int? 语法糖 = Option<int>
def safe_divide(a: int, b: int)-> int? =
    if b == 0: None
    else: Some(a / b)

// guard 语句（else 后直接写表达式，不能写 return）
def safe_sqrt(x: f64)-> f64? =
    guard x >= 0.0 else: None
    Some(x.sqrt())

// ──────────────── 3. trait + impl ────────────────

trait Drawable =
    def draw(self: Self) = ...

impl Drawable for Circle =
    def draw(self: Circle) =
        print(f"Circle at ({self.x}, {self.y})")

// ──────────────── 4. 结构体与方法 ────────────────

struct Point =
    x: f64
    y: f64

    def distance(self: Point, other: Point)-> f64 =
        dx = self.x - other.x
        dy = self.y - other.y
        (dx * dx + dy * dy).sqrt()

    def translate(self: Point, dx: f64, dy: f64)-> Point =
        Point(self.x + dx, self.y + dy)

struct Circle =
    x: f64
    y: f64
    radius: f64

    def area(self: Circle)-> f64 =
        PI * self.radius * self.radius

// ──────────────── 5. 枚举与模式匹配 ────────────────

enum Shape =
    Circle_(f64, f64, f64)
    Rect(f64, f64)
    Square(f64)

def shape_area(s: Shape)-> f64 =
    match s:
        case Circle_(_, _, r)=>
            PI * r * r
        case Rect(w, h)=>
            w * h
        case Square(side)=>
            side * side

// ──────────────── 6. 控制流 ────────────────

def classify(n: int)-> str =
    if n > 0: "positive"
    elif n < 0: "negative"
    else: "zero"

def sum_range(start: int, end: int)-> int =
    mut total = 0
    for i in start..end:
        total += i
    total

def countdown(n: int) =
    mut i = n
    while i > 0:
        print(f"  {i}...")
        i -= 1
    print("  Liftoff!")

// ──────────────── 6b. Phase 3：管道 / 安全导航 / null 合并 / guard let ────────────────

def pipe_double(x: int)-> int = x * 2
def pipe_add_one(x: int)-> int = x + 1
def pipe_add3(a: int, b: int, c: int)-> int = a + b + c

struct Person =
    name: str
    tag: int?

// 安全导航 ?. + null 合并 ??
def person_name(p: Person?)-> str =
    p?.name ?? "anonymous"

// guard let 模式守卫（转译为 Rust let...else）
def greet_person(p: Person?)-> str =
    guard let Some(pp) = p else: "no person"
    guard let Some(t) = pp.tag else: f"hi {pp.name}"
    f"hi {pp.name} (tag {t})"

// owned 形参：调用方必须用 ^ 显式转移所有权
def consume_person(owned p: Person)-> str =
    f"owned: {p.name}"

// 中缀 ^ = 按位异或（与后缀 move 靠位置消歧）
def xor_demo(a: int, b: int)-> int =
    a ^ b

// ──────────────── 7. 程序入口 ────────────────

def main() =
    print("=== Lang-Zong Demo (Phase 2 + 3) ===")

    print(f"add(3, 4) = {add(3, 4)}")
    print(f"power(2, 10) = {power(2, 10)}")
    print(f"fib(10) = {fib(10)}")
    print(f"factorial(5) = {factorial(5)}")
    print(f"identity(99) = {identity(99)}")

    greet("World")

    print(f"classify(5) = {classify(5)}")
    print(f"classify(-3) = {classify(-3)}")
    print(f"classify(0) = {classify(0)}")

    print(f"sum_range(1, 100) = {sum_range(1, 100)}")

    print("Countdown:")
    countdown(3)

    p1 = Point(0.0, 0.0)
    p2 = Point(3.0, 4.0)
    d = p1.distance(p2)
    print(f"distance = {d}")

    p3 = p1.translate(1.0, 2.0)
    print(f"translated = ({p3.x}, {p3.y})")

    c = Circle(0.0, 0.0, 5.0)
    print(f"circle area = {c.area()}")
    c.draw()

    s1 = Circle_(0.0, 0.0, 3.0)
    s2 = Rect(4.0, 5.0)
    s3 = Square(6.0)
    print(f"circle area = {shape_area(s1)}")
    print(f"rect area = {shape_area(s2)}")
    print(f"square area = {shape_area(s3)}")

    // int? / Option 测试
    match safe_divide(10, 2):
        case Some(v)=>
            print(f"10 / 2 = {v}")
        case None=>
            print("division by zero")

    match safe_divide(10, 0):
        case Some(v)=>
            print(f"10 / 0 = {v}")
        case None=>
            print("10 / 0 = division by zero")

    // guard 测试
    match safe_sqrt(16.0):
        case Some(v)=>
            print(f"sqrt(16) = {v}")
        case None=>
            print("sqrt of negative")

    // ── Phase 3: 管道 / 安全导航 / null 合并 / guard let / import ──
    print("--- Phase 3 features ---")

    pc = 5 |> pipe_double |> pipe_add_one |> pipe_add_one
    print(f"pipe-chain: {pc}")              // 5*2=10 -> +1=11 -> +1=12
    pm = 1 |> pipe_add3(2, 3)
    print(f"pipe-multi: {pm}")              // add3(1, 2, 3) = 6

    // copy-by-default：单个绑定可多次拷贝传入，无需像 Rust 那样写两份
    bob = Person(name: "Bob", tag: Some(7))
    print(f"person_name Some: {person_name(Some(bob))}")   // Bob（拷贝）
    print(f"person_name None: {person_name(None)}")          // anonymous
    print(f"greet with tag: {greet_person(Some(bob))}")    // hi Bob (tag 7)（再拷贝一份）
    print(f"greet none: {greet_person(None)}")               // no person

    // ^ 显式转移所有权 + owned 形参：bob 被 move，之后不可再用
    print(f"owned consume: {consume_person(bob^)}")          // owned: Bob
    // 中缀 ^ = 按位异或
    print(f"xor 5 ^ 3 = {xor_demo(5, 3)}")                   // 6

    // import 验证：HashMap 可用且类型推导正确
    registry: Dict<str, int> = HashMap::new()
    print(f"import HashMap ok: len={registry.len()}")

    print("=== Done ===")
