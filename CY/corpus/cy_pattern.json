{
  "op": "cy_pattern",
  "version": "1.0",
  "definition": {
    "signature": "gen_pattern(pat: Pattern) -> (cond: String, bindings: Vec<(String, IrType)>)",
    "note": "Pattern → Cython 匹配条件 + 绑定变量列表。用于 Match 语句的 if/elif 链解构。"
  },
  "preconditions": ["pat 必须是合法 Pattern 变体"],
  "laws": ["L1", "L4"],
  "tests": [
    {"input": {"pat": "_"}}, "expected": {"cond": "True", "bindings": []}},
    {"input": {"pat": {"Binding": "x"}}, "expected": {"cond": "True", "bindings": [["x", "Any"]]}},
    {"input": {"pat": {"Literal": "42"}}, "expected": {"cond": "scrutinee == 42", "bindings": []}},
    {"input": {"pat": {"Tuple": ["a", "b"]}}, "expected": {"cond": "isinstance(scrutinee, tuple) and len(scrutinee) == 2", "bindings": [["a", "Any"], ["b", "Any"]]}},
    {"input": {"pat": {"List": ["first", {"Rest": "rest"}]}}, "expected": {"cond": "isinstance(scrutinee, list) and len(scrutinee) >= 1", "bindings": [["first", "Any"], ["rest", "Any"]]}}
  ],
  "fingerprint": "fnv1a64:cy_pattern_v1"
}
