// ==== Operators ====
def main() =
    let a = 10
    let b = 3
    // arithmetic
    let sum = a + b
    let diff = a - b
    let prod = a * b
    let quot = a / b
    let rem = a % b
    let neg = -a
    let pow = a ** b
    // comparison
    let eq = a == b
    let ne = a != b
    let lt = a < b
    let gt = a > b
    // logical
    let and_val = eq and lt
    let or_val = eq or lt
    let not_val = not eq
    // compound
    x = 5
    x += 3
    x -= 1
    print(f"sum={sum} neg={neg} pow={pow}")
