// ==== Build Block Error Examples ====

def add(a: int, b: int) -> int = a + b

// ❌ =: inline body — must newline+indent
// x =: 42

// ❌ ~: operator spacing — must have whitespace around
// xs=add~:yield(1,2)

// ✅ correct =: usage
def main() =
    x =:
        y = 1
        y + 2
    print(x)
    // ✅ correct ~: usage
    xs = add ~:
        yield (1, 2)
        yield (3, 4)
    for val in xs:
        print(val)
