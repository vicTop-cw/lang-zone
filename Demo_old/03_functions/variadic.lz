// ==== Variadic Parameters ====
// Safe collection (no ..) vs .. separator mode

// ---- §1 Safe Collection: lst: List<T> ----
def sum_all(values: List<int>) -> int =
    total = 0
    for v in values:
        total += v
    total

// ---- §2 .. Separator ----
// .. controls HOW params are passed (position vs keyword)

// lst: position or keyword — .. at end doesn't affect lst
def proc<T>(lst: List<T>, ..) =
    for x in lst:
        print(x)
    for (k, v) in kwargs:
        print(f"{k}: {v}")

// lst: keyword-only — .. before lst
def kw_proc<T>(.., lst: List<T>) =
    for x in lst:
        print(x)

// a: position-only, b: keyword-only, extras → args + kwargs
def log(level: str, .., messages: List<str>, ..) =
    for msg in messages:
        print(f"[{level}] {msg}")

// .. type annotations: constrain args/kwargs element types
def typed(..: tuple(str, int), ..: dict<str, str | int>) =
    for v in args:
        print(v)
    for (k, v) in kwargs:
        print(f"{k}: {v}")

def main() =
    // safe collection
    print(f"sum_all(1,2,3) = {sum_all(1, 2, 3)}")
    print(f"sum_all() = {sum_all()}")

    // lst position or keyword
    proc([1, 2, 3], extra=42)
    proc(lst=[1, 2, 3], extra=99)

    // lst keyword-only
    kw_proc(lst=[10, 20, 30])

    // mixed
    log("INFO", messages=["started", "ready"])
