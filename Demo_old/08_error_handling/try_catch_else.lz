// ==== Try/Catch/Else/Finally ====
def read_config(path: str) -> str =
    try:
        let data = read_file(path)
        data
    catch IOError:
        "default config"
    else:
        print("file loaded successfully")
    finally:
        print("cleanup done")

def main() =
    let cfg = read_config("config.txt")
    print(cfg)
