#!bin macro
// ==== Template Demo ====

// use quote()
template getter!<T>(field: str) -> Tokens =
    quote("fn get_" + field + "(self) -> T { self." + field + " }")

// f``` sugar
template struct!<T>(name: Tokens, fields..: Tokens) -> Tokens =
    f```
    struct $(name) =
        $(fields)
    ```

template new!<T>() -> Tokens =
    f```
    fn new() -> Self { Self::default() }
    ```
