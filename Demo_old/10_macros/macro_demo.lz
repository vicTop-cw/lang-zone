#!bin macro
// ==== Macro Demo ====

// simplest: return parameter directly
macro id(input: Tokens) -> Tokens = input

// use quote() function
macro const_i64(name: Tokens, value: Tokens) -> Tokens =
    quote("const " + name + ": i64 = " + value + ";")

// f``` sugar
macro debug_log(msg: Tokens) -> Tokens =
    f```
    if DEBUG:
        print($(msg))
    ```

// r``` no interpolation
macro raw(input: Tokens) -> Tokens =
    r```
    // no interpolation here
    ```

// compose with builtins
macro greet(name: Tokens) -> Tokens =
    merge_tokens(quote("fn hello_"), name, quote("() { println!(\"Hi!\"); }"))
