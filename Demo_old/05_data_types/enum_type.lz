// ==== Enum ====
enum Shape:
    Circle(x: f64, y: f64, radius: f64)
    Rect(x: f64, y: f64, w: f64, h: f64)

def area(s: Shape) -> f64 =
    match s:
        case Shape.Circle(radius: r) => 3.14 * r * r
        case Shape.Rect(w: w, h: h1) => w * h1

enum Option<T>:
    Some(T)
    None

def main() =
    let c = Shape.Circle(x: 0.0, y: 0.0, radius: 5.0)
    print(f"area={area(c)}")
