# 特征组合测试: 同时使用 struct + class + enum + func + match + guard
# 测试多个特性在同一个编译单元中的交互

struct Point:
    x: int = 0
    y: int = 0

class Data:
    value: int = 0
    def get_value(self) -> int:
        return self.value

enum Color:
    Red
    Green
    Blue

def test_struct_literal() -> Point:
    return Point{x: 1, y: 2}

def test_enum_match(c: Color) -> int:
    match c:
        case Color.Red:
            return 1
        case Color.Green:
            return 2
        case _:
            return 0

def test_combined(p: Point, c: Color) -> int:
    let result: int = p.x + p.y
    guard result >= 0 else:
        return -1
    match c:
        case Color.Blue:
            return result * 3
        case _:
            return result

def main() -> int:
    return 0