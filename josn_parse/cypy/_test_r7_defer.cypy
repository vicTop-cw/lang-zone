# Test: defer blocks
def test_single_defer() -> int:
    defer:
        let x: int = 1
    return 0

def test_multi_defer() -> int:
    defer:
        let x: int = 1
    defer:
        let y: int = 2
    return 0

def test_defer_with_return() -> int:
    defer:
        let x: int = 1
    return 42

def main() -> int:
    return 0