# ============================================================
# JSON Parser in Cypy — Unified Approach
# ============================================================
# Avoids mutual recursion by using a single parse_value function
# that handles all types including arrays and objects inline.
# ============================================================

# ============================================================
# ParseResult struct
# ============================================================
struct ParseResult:
    success: int
    value: str
    pos: int

def ok_result(value: str, pos: int) -> ParseResult:
    return ParseResult {success: 1, value: value, pos: pos}

def fail_result(pos: int) -> ParseResult:
    return ParseResult {success: 0, value: "", pos: pos}

# ============================================================
# is_digit
# ============================================================
def is_digit(ch: str) -> int:
    if ch >= "0":
        if ch <= "9":
            return 1
    return 0

# ============================================================
# skip_ws
# ============================================================
def skip_ws(input: str, pos: int) -> int:
    let end: int = len(input)
    for unused in input:
        if pos >= end:
            break
        let ch: str = input[pos] as str
        if ch == " ":
            pos = pos + 1
        elif ch == "\n":
            pos = pos + 1
        elif ch == "\r":
            pos = pos + 1
        elif ch == "\t":
            pos = pos + 1
        else:
            break
    return pos

# ============================================================
# parse_null
# ============================================================
def parse_null(input: str, pos: int) -> ParseResult:
    let end: int = len(input)
    if pos + 4 > end:
        return fail_result(pos)
    if input[pos] != "n":
        return fail_result(pos)
    if input[pos + 1] != "u":
        return fail_result(pos)
    if input[pos + 2] != "l":
        return fail_result(pos)
    if input[pos + 3] != "l":
        return fail_result(pos)
    return ok_result("null", pos + 4)

# ============================================================
# parse_bool
# ============================================================
def parse_bool(input: str, pos: int) -> ParseResult:
    let end: int = len(input)
    if pos + 4 <= end:
        if input[pos] == "t":
            if input[pos + 1] == "r":
                if input[pos + 2] == "u":
                    if input[pos + 3] == "e":
                        return ok_result("true", pos + 4)
    if pos + 5 <= end:
        if input[pos] == "f":
            if input[pos + 1] == "a":
                if input[pos + 2] == "l":
                    if input[pos + 3] == "s":
                        if input[pos + 4] == "e":
                            return ok_result("false", pos + 5)
    return fail_result(pos)

# ============================================================
# parse_number
# ============================================================
def parse_number(input: str, pos: int) -> ParseResult:
    let end: int = len(input)
    let start: int = pos
    let num_str: str = ""
    if pos >= end:
        return fail_result(pos)
    if input[pos] == "-":
        num_str = "-"
        pos = pos + 1
        if pos >= end:
            return fail_result(start)
    if pos >= end:
        return fail_result(start)
    if is_digit(input[pos]) == 0:
        return fail_result(start)
    for unused1 in input:
        if pos >= end:
            break
        let ch_d: str = input[pos] as str
        if is_digit(ch_d) == 0:
            break
        num_str = num_str + ch_d
        pos = pos + 1
    if pos < end:
        if input[pos] == ".":
            pos = pos + 1
            num_str = num_str + "."
            if pos >= end:
                return fail_result(start)
            if is_digit(input[pos]) == 0:
                return fail_result(start)
            for unused2 in input:
                if pos >= end:
                    break
                let ch_f: str = input[pos] as str
                if is_digit(ch_f) == 0:
                    break
                num_str = num_str + ch_f
                pos = pos + 1
    if pos < end:
        if input[pos] == "e":
            pos = pos + 1
            num_str = num_str + "e"
            if pos < end:
                if input[pos] == "+":
                    num_str = num_str + "+"
                    pos = pos + 1
                elif input[pos] == "-":
                    num_str = num_str + "-"
                    pos = pos + 1
            if pos >= end:
                return fail_result(start)
            if is_digit(input[pos]) == 0:
                return fail_result(start)
            for unused3 in input:
                if pos >= end:
                    break
                let ch_e: str = input[pos] as str
                if is_digit(ch_e) == 0:
                    break
                num_str = num_str + ch_e
                pos = pos + 1
        elif input[pos] == "E":
            pos = pos + 1
            num_str = num_str + "E"
            if pos < end:
                if input[pos] == "+":
                    num_str = num_str + "+"
                    pos = pos + 1
                elif input[pos] == "-":
                    num_str = num_str + "-"
                    pos = pos + 1
            if pos >= end:
                return fail_result(start)
            if is_digit(input[pos]) == 0:
                return fail_result(start)
            for unused4 in input:
                if pos >= end:
                    break
                let ch_e2: str = input[pos] as str
                if is_digit(ch_e2) == 0:
                    break
                num_str = num_str + ch_e2
                pos = pos + 1
    return ok_result(num_str, pos)

# ============================================================
# parse_string
# ============================================================
def parse_string(input: str, pos: int) -> ParseResult:
    let end: int = len(input)
    if pos >= end:
        return fail_result(pos)
    if input[pos] != "\"":
        return fail_result(pos)
    pos = pos + 1
    let acc: str = ""
    for unused in input:
        if pos >= end:
            break
        let ch: str = input[pos] as str
        if ch == "\"":
            pos = pos + 1
            return ok_result("\"" + acc + "\"", pos)
        if ch == "\\":
            pos = pos + 1
            if pos >= end:
                break
            let esc: str = input[pos] as str
            acc = acc + "\\" + esc
            pos = pos + 1
        else:
            acc = acc + ch
            pos = pos + 1
    return fail_result(pos)

# ============================================================
# parse_value — THE ONE parser function
# Handles ALL JSON types including arrays and objects inline.
# Uses self-recursion for nested structures.
# ============================================================
def parse_value(input: str, pos: int) -> ParseResult:
    pos = skip_ws(input, pos)
    let end: int = len(input)
    if pos >= end:
        return fail_result(pos)
    let ch: str = input[pos] as str

    # --- Simple types ---
    if ch == "n":
        return parse_null(input, pos)
    elif ch == "t":
        return parse_bool(input, pos)
    elif ch == "f":
        return parse_bool(input, pos)
    elif ch == "\"":
        return parse_string(input, pos)
    elif ch == "-":
        return parse_number(input, pos)
    elif is_digit(ch) == 1:
        return parse_number(input, pos)

    # --- Array: [ ... ] ---
    elif ch == "[":
        pos = pos + 1
        let arr_acc: str = "["
        let arr_first: int = 1
        for arr_loop in input:
            pos = skip_ws(input, pos)
            if pos >= end:
                break
            if input[pos] == "]":
                pos = pos + 1
                arr_acc = arr_acc + "]"
                return ok_result(arr_acc, pos)
            if arr_first == 0:
                if input[pos] != ",":
                    break
                pos = pos + 1
                arr_acc = arr_acc + ", "
            arr_first = 0
            pos = skip_ws(input, pos)
            if pos >= end:
                break
            let elem_r = parse_value(input, pos)
            if elem_r.success == 0:
                break
            arr_acc = arr_acc + elem_r.value
            pos = elem_r.pos
        return fail_result(pos)

    # --- Object: { ... } ---
    elif ch == "{":
        pos = pos + 1
        let obj_acc: str = "{"
        let obj_first: int = 1
        for obj_loop in input:
            pos = skip_ws(input, pos)
            if pos >= end:
                break
            if input[pos] == "}":
                pos = pos + 1
                obj_acc = obj_acc + "}"
                return ok_result(obj_acc, pos)
            if obj_first == 0:
                if input[pos] != ",":
                    break
                pos = pos + 1
                obj_acc = obj_acc + ", "
            obj_first = 0
            pos = skip_ws(input, pos)
            if pos >= end:
                break
            let key_r = parse_string(input, pos)
            if key_r.success == 0:
                break
            obj_acc = obj_acc + key_r.value
            pos = key_r.pos
            pos = skip_ws(input, pos)
            if pos >= end:
                break
            if input[pos] != ":":
                break
            pos = pos + 1
            obj_acc = obj_acc + ": "
            let val_r = parse_value(input, pos)
            if val_r.success == 0:
                break
            obj_acc = obj_acc + val_r.value
            pos = val_r.pos
        return fail_result(pos)

    return fail_result(pos)

# ============================================================
# parse — top-level entry
# ============================================================
def parse(input: str) -> str:
    let result: ParseResult = parse_value(input, 0)
    if result.success == 1:
        let final_pos: int = skip_ws(input, result.pos)
        if final_pos >= len(input):
            return result.value
        return "EXTRA_CHARS: " + result.value
    return "ERROR: invalid JSON"

# ============================================================
# test_one — helper
# ============================================================
def test_one(name: str, json_str: str) -> int:
    let result: str = parse(json_str)
    print(name + ": " + result)
    return 0

# ============================================================
# main — test all JSON types
# ============================================================
def main() -> int:
    print("=== JSON Parser Tests ===")
    print("")
    test_one("Test 1  (null)  ", "null")
    test_one("Test 2  (true)  ", "true")
    test_one("Test 3  (false) ", "false")
    test_one("Test 4  (42)    ", "42")
    test_one("Test 5  (-17)   ", "-17")
    test_one("Test 6  (3.14)  ", "3.14")
    test_one("Test 7  (1.5e10)", "1.5e10")
    test_one("Test 8  (string)", "\"hello world\"")
    test_one("Test 9  (empty[])","[]")
    test_one("Test 10 ([1,2,3])", "[1, 2, 3]")
    test_one("Test 11 (mixed) ", "[1, \"two\", true, null]")
    test_one("Test 12 (empty{})", "{}")
    test_one("Test 13 (obj)   ", "{\"name\": \"Alice\", \"age\": 30}")
    test_one("Test 14 (nested)", "{\"user\": {\"name\": \"Bob\", \"active\": true}}")
    test_one("Test 15 (arrObj)", "[{\"x\": 1}, {\"y\": 2}]")
    test_one("Test 16 (ws)    ", "  {  \"a\"  :  1  }  ")
    test_one("Test 17 (invalid)","not json")
    print("")
    print("=== Done ===")
    return 0