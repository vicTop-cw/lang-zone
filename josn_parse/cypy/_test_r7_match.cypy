# Test: match/case patterns
def test_match_int() -> int:
    match 1:
        case 1:
            return 1
        case _:
            return 0

def test_match_multi() -> int:
    match 2:
        case 1:
            return 1
        case 2:
            return 2
        case 3:
            return 3
        case _:
            return 0

def test_match_wildcard() -> int:
    match 99:
        case _:
            return 1

def test_match_str() -> int:
    match "hello":
        case "hello":
            return 1
        case _:
            return 0

def test_match_bool() -> int:
    match True:
        case True:
            return 1
        case _:
            return 0

def test_match_tuple() -> int:
    match (1, 2):
        case (1, 2):
            return 1
        case _:
            return 0

def main() -> int:
    return 0