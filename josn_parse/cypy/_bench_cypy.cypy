def fib_cycle(n: int) -> int:
    if n <= 1:
        return n
    let a: int = 0
    let b: int = 1
    let i: int = 2
    let temp: int = 0
    while i <= n:
        temp = a + b
        a = b
        b = temp
        i = i + 1
    return b

def fib_recursive(n: int) -> int:
    if n <= 1:
        return n
    return fib_recursive(n - 1) + fib_recursive(n - 2)

def loop_sum(n: int) -> int:
    let total: int = 0
    let i: int = 0
    while i < n:
        total = total + i
        i = i + 1
    return total

def matrix_multiply(n: int) -> int:
    let size: int = n
    let total: int = 0
    let i: int = 0
    let j: int = 0
    let k: int = 0
    while i < size:
        j = 0
        while j < size:
            k = 0
            while k < size:
                total = total + i * j * k
                k = k + 1
            j = j + 1
        i = i + 1
    return total

struct Point:
    x: int = 0
    y: int = 0

def struct_ops(n: int) -> int:
    let total: int = 0
    let i: int = 0
    while i < n:
        let p: Point = Point{x: i, y: i + 1}
        total = total + p.x + p.y
        i = i + 1
    return total

def run_all() -> int:
    let r1: int = fib_cycle(40)
    let r2: int = fib_recursive(30)
    let r3: int = loop_sum(10000000)
    let r4: int = matrix_multiply(100)
    let r5: int = struct_ops(1000000)
    return r1 + r2 + r3 + r4 + r5

def main() -> int:
    return run_all()