"""
Round 4c: 测试 Cypy 测试框架
"""
# 1. test 函数
test def test_simple() -> int:
    assert 1 == 1
    return 0

# 2. test 带类型
test def test_with_type() -> int:
    let x: int = 42
    assert x == 42
    return 0

def main() -> int:
    print("=== Framework Test ===")
    print("test_simple: defined")
    print("test_with_type: defined")
    print("=== Done ===")
    return 0