# Bug-R6-25: 缺少大量 AST 节点的代码生成方法
# -- try/except (测试)
def test_try_cg() -> int:
    try:
        return 1
    except:
        return 0

# -- assert
def test_assert_cg() -> int:
    assert 1 == 1
    return 0

# -- raise
def test_raise_cg() -> int:
    try:
        raise "test"
    except:
        return 1
    return 0

