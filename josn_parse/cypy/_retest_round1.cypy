# ============================================================
# Bug 复测: Round 1 - 类与异常处理
# ============================================================

# Bug-R1-1: class 继承语法 class Child(Parent): 不支持
class Parent:
    x: int = 0

# class Child(Parent):  # 如果报错则 Bug-R1-1 仍存在
#     pass

# Bug-R1-2: cdef class 不支持
# cdef class CdefClass:  # 如果报错则 Bug-R1-2 仍存在
#     pass

# Bug-R1-3: class 方法中 self 参数未识别
class Simple:
    value: int = 0
    def get_value(self) -> int:
        return self.value

# Bug-R1-4: val 关键字不能作为变量名
# let val: str = "init"  # 如果报错则 Bug-R1-4 仍存在

# 正常特性验证
def test_class_basic() -> int:
    let s: Simple = Simple {value: 42}
    return s.value

def test_exception() -> int:
    try:
        raise "test error"
    except:
        return 1
    return 0