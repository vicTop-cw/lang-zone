# 特性组合测试

# 1. guard + defer + for + match 组合
def test_guard_defer_for_match() -> int:
    let result: int = 0
    for i in range(5):
        defer:
            result = result + 1
        guard i >= 0 else:
            continue
        match i:
            case 0:
                result = result + 10
            case 1:
                result = result + 20
            case 2:
                result = result + 30
    return result

# 2. let + val + struct 方法组合
struct Point:
    x: int
    y: int

def test_let_val_struct() -> int:
    val origin: Point = Point {x: 0, y: 0}
    let p: Point = Point {x: 10, y: 20}
    return p.x + p.y

# 3. pipe + build block 组合
def test_pipe_build() -> int:
    let x: int = 5
    def add_one(n: int) -> int:
        return n + 1
    def double(n: int) -> int:
        return n * 2
    let result: int = x
    result = add_one(result)
    result = double(result)
    return result

# 4. match + struct 组合
def test_match_struct() -> int:
    let p: Point = Point {x: 3, y: 4}
    match p.x:
        case 0:
            return 0
        case 3:
            return p.y
        case 99:
            return 1

# 5. defer + return 组合
def test_defer_return() -> int:
    let result: int = 0
    defer:
        result = 100
    return result

# 6. guard + match 组合
def test_guard_match(x: int) -> int:
    guard x > 0 else:
        return -1
    match x:
        case 1:
            return 10
        case 2:
            return 20
        case 99:
            return 30

# 7. for + guard + defer 组合
def test_for_guard_defer() -> int:
    let total: int = 0
    for i in range(10):
        guard i < 5 else:
            break
        defer:
            total = total + 1
        total = total + i
    return total