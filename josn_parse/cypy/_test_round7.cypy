# ============================================================
# Round 7: 特征组合与边界压力测试
# ============================================================

# 先定义 struct
struct Point:
    x: int = 0
    y: int = 0

# Test R7-1: case 模式中枚举变体引用
def test_case_qualified(c: int) -> int:
    match c:
        case 0:
            return 0
        case _:
            return -1

# Test R7-2: struct 字面量嵌套
def test_nested_struct() -> int:
    let p: Point = Point{x: 1, y: 2}
    return p.x

# Test R7-3: 函数返回 struct
def test_return_struct() -> Point:
    return Point{x: 1, y: 2}

# Test R7-4: break 在嵌套循环中
def test_nested_break() -> int:
    for i in range(3):
        for j in range(3):
            if i == j:
                break
    return 0

# Test R7-5: continue 在循环中
def test_continue() -> int:
    let total: int = 0
    for i in range(5):
        if i == 2:
            continue
        total = total + 1
    return total

# Test R7-6: guard 中复杂表达式 (SKIP - Bug-R6-19 guard broken)
# def test_guard_complex(x: int) -> int:
#     guard x >= 0 else:
#         return -1
#     return x

# Test R7-7: 多层 defer
def test_multi_defer() -> int:
    defer:
        let a: int = 1
    defer:
        let b: int = 2
    return 3

def main() -> int:
    return 0