    return 0

# --- 测试: 多行表达式 (括号内换行) ---
def test_multiline_expr() -> int:
    return (1 + 2 + 3 + 4 + 5)

# --- 测试: 嵌套函数调用 ---
def test_nested_call() -> int:
    return 0

# --- 测试: 变量在 if 分支中定义 ---
def test_var_in_if(x: int) -> int:
    if x > 0:
        let y: int = 1
        return y
    return 0

# --- 测试: 变量在 for 循环中定义 ---
def test_var_in_for() -> int:
    let total: int = 0
    for i in range(3):
        let temp: int = i * 2
        total = total + temp
    return total

# --- 测试: 类型推断: 字面量列表 ---
