# R7-8: and 不工作 (Expected COLON, got IDENTIFIER)
# R7-9: or 不工作 (Expected COLON, got IDENTIFIER)
# R7-10: not 不工作 (Undefined name 'not')

# --- 测试: 嵌套 if/elif/else 中的复杂条件 ---
def test_if_elif(x: int) -> int:
    if x > 10:
        return 3
    elif x > 5:
        return 2
    elif x > 0:
        return 1
    else:
        return 0

# --- 测试: return 后代码是否被忽略 ---
def test_return_unreachable() -> int:
    return 1
    # let dead: int = 0  # unreachable

