# Test: trait constraint
trait Comparable:
    def compare(other) -> int:
        pass

struct Point:
    x: int
    y: int

impl Comparable for Point:
    def compare(self, other: Point) -> int:
        return 0

struct Rectangle:
    width: int
    height: int

# Generic function with trait constraint
def find_max[T: Comparable](a: T, b: T) -> T:
    return a if a.compare(b) > 0 else b

def main() -> int:
    p1 = Point {x: 1, y: 2}
    p2 = Point {x: 3, y: 4}
    max_p = find_max(p1, p2)  # OK: Point implements Comparable
    
    r1 = Rectangle {width: 10, height: 20}
    r2 = Rectangle {width: 15, height: 25}
    max_r = find_max(r1, r2)  # Should fail: Rectangle does not implement Comparable
    
    return 0