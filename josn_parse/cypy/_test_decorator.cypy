"""
Round 4a: 测试 Cypy 装饰器与闭包
"""
# 1. 装饰器函数（无参数版本）
def simple_decorator() -> int:
    return 42

# 2. 嵌套函数（闭包）
def outer() -> int:
    let x: int = 10
    def inner() -> int:
        return x
    return inner()

# 3. 函数作为参数传递
def call_func(f) -> int:
    return 0

def main() -> int:
    print("=== Decorator/Lambda Test ===")
    print(f"outer = {outer()}")
    print("=== Done ===")
    return 0