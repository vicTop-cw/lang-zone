"""
Round 1b: 测试 Cypy 异常处理 —— try/except/raise/assert
注意：val 是 Cypy 关键字，不能用作变量名
"""

# 1. raise 简单异常
def test_raise() -> str:
    raise "test error"
    return "unreachable"

# 2. try/except 捕获
def test_try_except() -> str:
    try:
        raise "caught"
    except:
        return "caught_exception"
    return "no_exception"

# 3. try/except/finally
def test_finally() -> str:
    let result: str = "start"
    try:
        result = "try_block"
    except:
        result = "except_block"
    finally:
        result = result + "_finally"
    return result

# 4. try/finally（无 except）
def test_try_finally() -> str:
    let value: str = "init"
    try:
        value = "try"
    finally:
        value = value + "_cleanup"
    return value

# 5. assert 语句
def test_assert_pass() -> int:
    assert 1 == 1
    return 0

# 6. 嵌套 try/except
def test_nested_try() -> str:
    try:
        try:
            raise "inner"
        except:
            return "inner_caught"
    except:
        return "outer_caught"
    return "none"

def main() -> int:
    print("=== Exception Test ===")
    print("test_try_except: " + test_try_except())
    print("test_finally: " + test_finally())
    print("test_try_finally: " + test_try_finally())
    print("test_nested_try: " + test_nested_try())
    print("=== Done ===")
    return 0