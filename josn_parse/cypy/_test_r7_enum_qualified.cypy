# Test: enum 限定名访问 (Color.Red)
enum Color:
    Red
    Green
    Blue

def test_enum_qualified() -> int:
    let c: Color = Color.Red
    return 0

def test_enum_in_match() -> int:
    let c: Color = Color.Red
    match c:
        case Color.Red:
            return 1
        case _:
            return 0

def main() -> int:
    return 0