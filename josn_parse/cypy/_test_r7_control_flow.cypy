# Test: control flow boundary
def test_empty_if() -> int:
    if 1:
        return 1
    return 0

def test_empty_else() -> int:
    if 0:
        return 1
    else:
        return 0

def test_while_true() -> int:
    let i: int = 0
    while i < 3:
        i = i + 1
    return i

def test_while_break() -> int:
    let i: int = 0
    while 1:
        i = i + 1
        if i == 3:
            break
    return i

def test_while_continue() -> int:
    let i: int = 0
    let total: int = 0
    while i < 5:
        i = i + 1
        if i == 3:
            continue
        total = total + 1
    return total

def test_nested_while() -> int:
    let i: int = 0
    let total: int = 0
    while i < 3:
        let j: int = 0
        while j < 3:
            total = total + 1
            j = j + 1
        i = i + 1
    return total

def test_for_range() -> int:
    let total: int = 0
    for i in range(5):
        total = total + i
    return total

def test_for_break() -> int:
    let total: int = 0
    for i in range(5):
        if i == 3:
            break
        total = total + i
    return total

def test_for_continue() -> int:
    let total: int = 0
    for i in range(5):
        if i == 2:
            continue
        total = total + 1
    return total

def test_nested_for() -> int:
    let total: int = 0
    for i in range(3):
        for j in range(3):
            total = total + 1
    return total

def main() -> int:
    return 0