# Bug-R1-1: class 继承语法 class Child(Parent): 不支持
class Parent:
    x: int = 0

# class Child(Parent):  # 取消注释测试 Bug-R1-1
#     pass

# Bug-R1-2: cdef class 不支持
# cdef class CdefClass:  # 取消注释测试 Bug-R1-2
#     x: int = 0

# Bug-R1-3: class 方法中 self 参数未识别
class Simple:
    value: int = 0
    def get_value(self) -> int:
        return self.value

# Bug-R1-4: val 关键字不能作为变量名
# let val: str = "init"  # 取消注释测试 Bug-R1-4

def main() -> int:
    return 0