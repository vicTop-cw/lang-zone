# Test: Cypy Advanced Features
# macro, comptime, implicit, test/suite, async/await

# ============================================================
# 1. Macro test
# According to CYPY_SYNTAX.md:
#   macro twice(input: Tokens) -> Tokens = f```$input + $input```
#   result = @twice!(x)
# Variation A: with Tokens type annotation
# Variation B: simpler macro without type
# ============================================================
macro twice(input: Tokens) -> Tokens =
    f```$input + $input```

# Simpler macro variation
macro add_one(input: Tokens) -> Tokens =
    f```$input + 1```

def test_macro() -> int:
    let x: int = 10
    result = @twice!(x)
    print(f"Macro result (twice): {result}")
    return 0

# ============================================================
# 2. Comptime test
# According to CYPY_SYNTAX.md:
#   result: int = comptime: 2 + 3 * 4
# Variation A: inline comptime: expr
# Variation B: comptime block with newline
# ============================================================
def test_comptime() -> int:
    # Inline form
    result: int = comptime: 2 + 3 * 4
    print(f"Comptime result: {result}")
    return 0

# ============================================================
# 3. Implicit test
# According to CYPY_SYNTAX.md:
#   implicit struct Config: ...
#   implicit ctx: Config = Config {debug: False, timeout: 60}
# ============================================================
implicit struct Config:
    debug: bool = True
    timeout: int = 30
    url: str = "http://localhost"

implicit ctx: Config = Config {debug: False, timeout: 60}

def test_implicit() -> int:
    print(f"Implicit config debug: {ctx.debug}")
    print(f"Implicit config timeout: {ctx.timeout}")
    return 0

# ============================================================
# 4. Test/Suite framework
# RESULT: 'test' and 'suite' are NOT in lexer KEYWORDS dict.
#   Error: "Unexpected token COLON at 55:17" on 'suite "My Tests":'
#   The lexer doesn't recognize 'suite'/'test' as keywords,
#   so they're treated as identifiers, and the `:` after string
#   is unexpected in expression context.
# ============================================================
def test_suite_run() -> int:
    print("Test suite: 'test' and 'suite' keywords not in lexer")
    return 0

# ============================================================
# 5. Async/Await test
# According to docs:
#   async def f() -> T: ...
#   await expr
# ============================================================
async def async_fetch(value: int) -> int:
    result = value * 2
    return result

async def test_async_demo() -> int:
    result = await async_fetch(21)
    print(f"Async result: {result}")
    return 0

def test_async() -> int:
    print("Async function defined")
    return 0

# ============================================================
# Main - calls all tests
# ============================================================
def main() -> int:
    print("=== Testing Advanced Cypy Features ===")
    test_macro()
    test_comptime()
    test_implicit()
    test_suite_run()
    test_async()
    print("=== All tests completed ===")
    return 0