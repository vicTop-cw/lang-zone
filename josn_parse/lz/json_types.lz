// 简化版 json_types — 逐步测试

enum JsonValue =
    Null
    Bool(bool)
    Number(f64)
    String(str)
    Array(List<JsonValue>)
    Object(Dict<str, JsonValue>)

// 解析器状态
struct Parser =
    input: str
    pos: int

    def new(input: str)-> Parser =
        Parser(input, 0)

    // 查看当前字符（不前进）
    def peek(self: Parser)-> str? =
        if self.pos < self.input.len():
            Some(self.input[self.pos])
        else:
            None

    // 检查是否到达末尾
    def is_eof(self: Parser)-> bool =
        self.pos >= self.input.len()

def main() =
    p = Parser.new("{}")
    print("parser created")
    print(p.pos)