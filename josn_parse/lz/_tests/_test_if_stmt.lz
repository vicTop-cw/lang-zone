// Test: statement before if/else
struct Parser =
    input: str
    pos: int

    def new(input: str)-> Parser =
        Parser(input, 0)

    def skip_whitespace(mut self: Parser) =
        self.pos += 0

// Test 1: statement before if/else (should fail)
def test1(mut parser: Parser)-> (Parser, int) =
    parser.skip_whitespace()
    if parser.pos > 0:
        (parser, 1)
    else:
        (parser, 0)

// Test 2: if/else only (should work)
def test2(mut parser: Parser)-> (Parser, int) =
    if parser.pos > 0:
        (parser, 1)
    else:
        (parser, 0)

def main() =
    print("ok")