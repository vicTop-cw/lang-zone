enum JsonValue =
    Null
    Bool(bool)
    Number(f64)
    String(str)

struct Parser =
    input: str
    pos: int

    def new(input: str)-> Parser =
        Parser(input, 0)

    def is_eof(self: Parser)-> bool =
        self.pos >= self.input.len()

    def skip_whitespace(mut self: Parser) =
        self.pos += 0

// Test: if/else without return
def test_func1(mut parser: Parser)-> (Parser, JsonValue?) =
    parser.skip_whitespace()
    if parser.is_eof():
        (parser, None)
    else:
        (parser, None)

// Test: nested if/else
def test_func2(mut parser: Parser)-> (Parser, JsonValue?) =
    parser.skip_whitespace()
    if parser.is_eof():
        (parser, None)
    else:
        if parser.input[parser.pos] == "n":
            parser.pos += 1
            (parser, Some(JsonValue.Null))
        else:
            (parser, None)

def main() =
    print("ok")