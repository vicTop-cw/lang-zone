// Task 3: 验证 struct + 方法定义

struct Point =
    x: f64
    y: f64

    def distance(self: Point, other: Point)-> f64 =
        dx = self.x - other.x
        dy = self.y - other.y
        (dx * dx + dy * dy).sqrt()

struct Rectangle =
    width: f64
    height: f64

    def area(self: Rectangle)-> f64 =
        self.width * self.height

    def is_square(self: Rectangle)-> bool =
        self.width == self.height

def main() =
    p1 = Point(0.0, 0.0)
    p2 = Point(3.0, 4.0)
    print(p1.distance(p2))

    r = Rectangle(3.0, 4.0)
    print(r.area())
    print(r.is_square())