enum JsonValue =
    Null
    Bool(bool)
    String(String)
    Number(i64)

def describe(v: JsonValue)-> str =
    match v:
        case Some(_): "wrapped"
        case Null: "null"
        case String(s): "str: " + s
        case JsonValue.String(key): "qualified: " + key
        case Bool(b): "bool"
        case Number(n): "num"
