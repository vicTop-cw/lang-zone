// Fuzz 10: 错误处理与控制流

// ── 10.1 简单 Result 模式 ──
enum SimpleResult =
    Success(i64)
    Failure(str)

def test_result_match() =
    r = Success(42)
    match r:
        case Success(v):
            print("Success: ")
            print(v)
        case Failure(msg):
            print("Failure: ")
            print(msg)

// ── 10.2 嵌套 if-elif-else ──
def test_nested_if() =
    x = 75
    if x >= 90:
        print("A")
    elif x >= 80:
        print("B")
    elif x >= 70:
        print("C")
    elif x >= 60:
        print("D")
    else:
        print("F")

// ── 10.3 提前返回 ──
def test_early_return() =
    x = 50
    if x < 0:
        print("negative")
        return
    if x > 100:
        print("too large")
        return
    print("valid: ")
    print(x)

// ── 入口 ──
def main() =
    print("=== Fuzz Result ===")
    test_result_match()
    test_nested_if()
    test_early_return()
    print("=== Fuzz Result Complete ===")