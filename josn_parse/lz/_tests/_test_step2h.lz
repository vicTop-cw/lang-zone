enum JsonValue =
    Null
    Bool(bool)
    Number(f64)
    String(str)
    Array(List<JsonValue>)
    Object(Dict<str, JsonValue>)

struct Parser =
    input: str
    pos: int

    def new(input: str)-> Parser =
        Parser(input, 0)

def parse_true(parser: Parser)-> (Parser, JsonValue?) =
    return (parser, Some(JsonValue.Bool(True)))

def main() =
    print("ok")