// _test_string_methods.lz — 阶段 8: 字符串方法深度测试

// ── 8.1 字符串基本方法 ──

def test_string_len() =
    s = "hello world"
    print("Length: ")
    print(s.len())

def test_string_is_empty() =
    s = ""
    empty = s.is_empty()
    print("Is empty: ")
    print(empty)

// ── 8.2 字符串比较 ──

def test_string_compare() =
    a = "hello"
    b = "world"
    if a == b:
        print("Equal")
    else:
        print("Not equal")

    if a != b:
        print("Not equal (ne)")

// ── 8.3 字符串拼接 ──

def test_string_concat_multi() =
    prefix = "Hello"
    suffix = "World"
    combined = prefix + " " + suffix
    print("Combined: ")
    print(combined)

// ── 8.4 字符串索引 ──

def test_string_chars() =
    s = "abc"
    i = 0
    while i < s.len():
        print("Char: ")
        print(s[i])
        i = i + 1

// ── 主入口 ──
def main() =
    print("=== String Methods Test ===")
    test_string_len()
    test_string_is_empty()
    test_string_compare()
    test_string_concat_multi()
    test_string_chars()
    print("=== String Methods Test Complete ===")