// _test_module_import.lz — 阶段 2: 模块系统测试
// 测试多文件 import、from-import、循环导入、可见性

// ── 2.1 多文件 import ──

// 测试 import 模块名（导入同目录 .lz 文件）
import _test_module_a

// 测试 from 模块 import 项目
from _test_module_a import add, greet, Point, make_point

// ── 2.2 模块函数调用 ──
def test_import_module() =
    result = _test_module_a.add(1, 2)
    print("Module add result: ")
    print(result)

def test_from_import() =
    sum = add(3, 4)
    print("From-import add: ")
    print(sum)

def test_greet() =
    msg = greet("World")
    print("Greet: ")
    print(msg)

def test_struct_from_module() =
    p = make_point(10, 20)
    print("Point from module: ")
    print(p.x)
    print(p.y)

// ── 2.3 泛型函数 ──
def test_generic_from_module() =
    val = _test_module_a.identity(42)
    print("Generic identity: ")
    print(val)

// ── 2.4 模块可见性 ──
// 测试 __module_magic 属性是否可访问
def test_module_magic() =
    print("Module name: ")
    print(__name__)
    print("Module deps: ")
    print(__deps__)

// ── 主入口 ──
def main() =
    print("=== Module Import Test ===")
    test_import_module()
    test_from_import()
    test_greet()
    test_struct_from_module()
    test_generic_from_module()
    test_module_magic()
    print("=== Module Import Test Complete ===")