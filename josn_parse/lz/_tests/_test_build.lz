enum JsonValue =
    Null
    Bool(bool)
    Number(f64)
    String(str)
    Array(List<JsonValue>)
    Object(Dict<str, JsonValue>)

struct Parser =
    input: str
    pos: int

    def new(input: str)-> Parser =
        Parser(input, 0)

    def peek(self: Parser)-> str? =
        if self.pos < self.input.len():
            Some(self.input[self.pos])
        else:
            None

    def advance(mut self: Parser)-> str? =
        if self.pos < self.input.len():
            ch = self.input[self.pos]
            self.pos += 1
            Some(ch)
        else:
            None

    def skip_whitespace(mut self: Parser) =
        while self.pos < self.input.len():
            ch = self.input[self.pos]
            if ch == " " or ch == "\n" or ch == "\r" or ch == "\t":
                self.pos += 1
            else:
                break

    def is_eof(self: Parser)-> bool =
        self.pos >= self.input.len()

def parse_null(mut parser: Parser)-> (Parser, JsonValue?) =
    parser.skip_whitespace()
    if parser.pos + 4 <= parser.input.len():
        if parser.input[parser.pos..parser.pos + 4] == "null":
            parser.pos += 4
            return (parser, Some(JsonValue.Null))
    (parser, None)

def parse_true(mut parser: Parser)-> (Parser, JsonValue?) =
    parser.skip_whitespace()
    if parser.pos + 4 <= parser.input.len():
        if parser.input[parser.pos..parser.pos + 4] == "true":
            parser.pos += 4
            return (parser, Some(JsonValue.Bool(True)))
    (parser, None)

def parse_false(mut parser: Parser)-> (Parser, JsonValue?) =
    parser.skip_whitespace()
    if parser.pos + 5 <= parser.input.len():
        if parser.input[parser.pos..parser.pos + 5] == "false":
            parser.pos += 5
            return (parser, Some(JsonValue.Bool(False)))
    (parser, None)

def main() =
    print("ok")