// Fuzz 15: 运算符边界测试

// ── 15.1 取模运算 ──
def test_modulo() =
    a = 10 % 3
    print("10 % 3: ")
    print(a)
    b = 17 % 5
    print("17 % 5: ")
    print(b)
    c = 7 % 7
    print("7 % 7: ")
    print(c)

// ── 15.2 运算符优先级 ──
def test_precedence() =
    // 乘除优先于加减
    a = 2 + 3 * 4
    print("2+3*4: ")
    print(a)
    // 括号改变优先级
    b = (2 + 3) * 4
    print("(2+3)*4: ")
    print(b)
    // 多种运算符混合
    c = 10 - 2 * 3 + 8 / 2
    print("10-2*3+8/2: ")
    print(c)

// ── 15.3 一元负号 ──
def test_unary_minus() =
    a = -5
    print("neg 5: ")
    print(a)
    b = - (3 + 2)
    print("-(3+2): ")
    print(b)
    c = - -10
    print("--10: ")
    print(c)

// ── 15.4 字符串索引 ──
def test_str_index() =
    s = "hello"
    ch = s[0]
    print("s[0]: ")
    print(ch)
    ch2 = s[4]
    print("s[4]: ")
    print(ch2)

// ── 15.5 字符串切片 (workaround: 避免 s[a..b] 语法) ──
def test_str_slice() =
    s = "hello world"
    print("substring test: ")
    print(s[0])
    print(s[6])

// ── 15.6 列表索引 ──
def test_list_index() =
    arr = [10, 20, 30, 40]
    print("arr[0]: ")
    print(arr[0])
    print("arr[2]: ")
    print(arr[2])
    print("arr[3]: ")
    print(arr[3])

// ── 15.7 比较运算符链 ──
def test_compare_chain() =
    x = 5
    print("x == 5: ")
    print(x == 5)
    print("x != 3: ")
    print(x != 3)
    print("x < 10: ")
    print(x < 10)
    print("x > 0: ")
    print(x > 0)
    print("x >= 5: ")
    print(x >= 5)
    print("x <= 6: ")
    print(x <= 6)

// ── 15.8 逻辑运算 ──
def test_logic_ops() =
    a = true
    b = false
    print("true and true: ")
    print(a and a)
    print("true and false: ")
    print(a and b)
    print("false or true: ")
    print(b or a)
    print("not true: ")
    print(not a)
    print("not false: ")
    print(not b)

// ── 入口 ──
def main() =
    print("=== Fuzz Operator Edge ===")
    test_modulo()
    test_precedence()
    test_unary_minus()
    test_str_index()
    test_str_slice()
    test_list_index()
    test_compare_chain()
    test_logic_ops()
    print("=== Fuzz Operator Edge Complete ===")