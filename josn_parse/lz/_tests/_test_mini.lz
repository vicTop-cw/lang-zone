enum TokenType =
    Keyword(str)
    IntLiteral(int)
    FloatLiteral(f64)
    StringLiteral(str)
    Ident(str)
    Plus
    Minus
    Star
    Slash
    Percent
    Eq
    EqEq
    NotEq
    Lt
    Gt
    Le
    Ge
    Colon
    ColonEq
    Arrow
    FatArrow
    Dot
    DotDot
    DotDotEq
    Comma
    LParen
    RParen
    LBracket
    RBracket
    LBrace
    RBrace
    At
    Question
    Newline
    EOF
    Unknown(str)

struct Token =
    kind: TokenType
    lexeme: str
    line: int
    col: int

