// ═══════════════════════════════════════════════════════
// LZ 语言特性综合测试: guard, defer, try/catch, with
// ═══════════════════════════════════════════════════════

// ── Test 1: guard with simple condition ──
def test_guard_cond(x: int) =
    guard x > 0 else:
        print("guard failed: x <= 0")
    print("guard passed")

// ── Test 2: guard let Option unwrap ──
def test_guard_let(opt: int?) =
    guard let Some(val) = opt else:
        print("guard let failed: None")
    print(val)

// ── Test 3: defer (no colon) ──
def test_defer_simple() =
    defer print("defer cleanup")
    print("defer body")

// ── Test 4: defer (with colon, block form) ──
def test_defer_block() =
    defer:
        print("defer block cleanup")
    print("defer body")

// ── Test 5: multiple defer (LIFO) ──
def test_multi_defer() =
    defer print("defer 1")
    defer print("defer 2")
    print("defer body")

// ── Test 6: try/catch ──
def test_try_catch() =
    try:
        print("try body")
    catch e:
        print(e)

// ── Test 7: try/else/finally ──
def test_try_else_finally() =
    try:
        print("try body")
    else:
        print("no error")
    finally:
        print("finally cleanup")

// ── Test 8: try/catch/finally ──
def test_try_catch_finally() =
    try:
        print("try body")
    catch e:
        print(e)
    finally:
        print("finally cleanup")

// ── Test 9: with ──
def test_with() =
    with Some(42) as f:
        print("with body")

// ── Test 10: guard inside loop ──
def test_guard_loop() =
    i = 0
    loop:
        guard i < 3 else:
            break
        i += 1

// ── Test 11: guard + defer combination ──
def test_guard_defer(x: int) =
    defer print("defer")
    guard x > 0 else:
        print("guard fail")
    print("body")

// ── Test 12: with + guard + defer ──
def test_with_guard_defer() =
    with Some(42) as f:
        defer print("with defer")
        guard f > 0 else:
            print("none")
        print("with body")

def main() =
    test_guard_cond(1)
    test_guard_let(Some(42))
    test_defer_simple()
    test_defer_block()
    test_multi_defer()
    test_try_catch()
    test_try_else_finally()
    test_try_catch_finally()
    test_with()
    test_guard_loop()
    test_guard_defer(1)
    test_with_guard_defer()