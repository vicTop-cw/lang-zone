// ============================================================
// Test: trait + impl 综合测试
// ============================================================

// Test 1: trait 定义 (抽象方法)
trait Drawable =
    def draw(self: Self) = ...

// Test 2: trait 带默认方法
trait Describable =
    def describe(self: Self) = ...
    def default_method(self: Self) =
        print("default from Describable")

// Test 3: struct 定义
struct Circle =
    x: f64
    y: f64
    radius: f64

// Test 4: impl for struct (非 trait impl)
impl Circle =
    def area(self: Circle) -> f64 =
        3.14159 * self.radius * self.radius

// Test 5: trait impl
impl Drawable for Circle =
    def draw(self: Circle) =
        print("drawing Circle")

// Test 6: 第二个 trait impl
impl Describable for Circle =
    def describe(self: Circle) =
        print("a Circle")

// Test 7: struct 内嵌方法
struct Rectangle =
    width: f64
    height: f64

    def area(self: Rectangle) -> f64 =
        self.width * self.height

impl Drawable for Rectangle =
    def draw(self: Rectangle) =
        print("drawing Rectangle")

impl Describable for Rectangle =
    def describe(self: Rectangle) =
        print("a Rectangle")

def main() =
    c = Circle(0.0, 0.0, 5.0)
    print("Circle area:")
    print(c.area())
    print("Circle draw:")
    c.draw()
    print("Circle describe:")
    c.describe()
    print("Circle default_method:")
    c.default_method()

    r = Rectangle(3.0, 4.0)
    print("Rectangle area:")
    print(r.area())
    print("Rectangle draw:")
    r.draw()
    print("Rectangle describe:")
    r.describe()
    print("Rectangle default_method:")
    r.default_method()