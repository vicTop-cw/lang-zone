struct Parser =
    input: str
    pos: int

    def new(input: str)-> Parser =
        Parser(input, 0)

    def skip_whitespace(mut self: Parser) =
        self.pos += 0

    def is_eof(self: Parser)-> bool =
        self.pos >= self.input.len()

// Test 1: if with method call
def test1(mut parser: Parser)-> (Parser, int) =
    parser.skip_whitespace()
    if parser.is_eof():
        (parser, 0)
    else:
        (parser, 1)

// Test 2: if with field access
def test2(mut parser: Parser)-> (Parser, int) =
    parser.skip_whitespace()
    if parser.pos > 0:
        (parser, 0)
    else:
        (parser, 1)

// Test 3: if with simple condition
def test3(mut parser: Parser)-> (Parser, int) =
    parser.skip_whitespace()
    if True:
        (parser, 0)
    else:
        (parser, 1)

def main() =
    print("ok")