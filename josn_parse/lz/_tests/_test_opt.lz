enum JsonValue =
    Null
    Bool(bool)

struct Parser =
    input: str
    pos: int

    def new(input: str)-> Parser =
        Parser(input, 0)

    def skip_whitespace(mut self: Parser) =
        self.pos += 0

    def is_eof(self: Parser)-> bool =
        self.pos >= self.input.len()

// Test: if/else with Option<JsonValue> in tuple
def test1(mut parser: Parser)-> (Parser, JsonValue?) =
    parser.skip_whitespace()
    if parser.is_eof():
        (parser, None)
    else:
        (parser, None)

def main() =
    print("ok")