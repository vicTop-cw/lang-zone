{
  "comments": {
    "lineComment": "//",
    "blockComment": ["/*", "*/"]
  },
  "brackets": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"]
  ],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "{", "close": "}" },
    { "open": "\"", "close": "\"", "notIn": ["string"] },
    { "open": "'", "close": "'", "notIn": ["string"] }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(if|for|while|loop|match|guard|try|with|def|struct|enum|trait|impl|magic|macro|template|comptime|suite|test|setup|teardown|defer)\\b.*:\\s*$",
    "decreaseIndentPattern": "^\\s*(elif|else|case|catch|finally)\\b.*:\\s*$"
  },
  "wordPattern": "[a-zA-Z_][a-zA-Z0-9_]*"
}