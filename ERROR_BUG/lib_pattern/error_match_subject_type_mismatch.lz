// ============================================================
// error_match_subject_type_mismatch.lz — 负向测试用例（ERROR_BUG）
// 所属：lib_pattern | 期望检查点：对 int 值 99 做 Shape 模式匹配，应报类型错误
// 级别：L2
//   L1 = 完全漏放行（lang-zone 放行且生成的 Rust 也通过，最严重）
//   L2 = 前端漏检（lang-zone 放行，生成的 Rust 被 rustc 拒绝）
// 实际：lang-zone 放行（EXIT 0）| rustc 拒绝 E0308
// 验证：lang-zone <本文件> 当前返回 0；修复后应返回非 0 并报错
// ============================================================
enum Shape:
    Circle(int)
    Rect(int, int)

def area(s: Shape) -> int =
    match s:
        case Circle(r):
            r * r
        case Rect(w, h):
            w * h

def main() =
    let s = Circle(3)
    let x = area(s)
    let y = area(99)
    print(x + y)
