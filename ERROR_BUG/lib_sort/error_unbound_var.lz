// error_unbound_var.lz — 负向测试用例（ERROR_BUG）
// 所属：lib_sort | 期望检查点：引用未定义变量 missing_var，应报未绑定错误
// 级别：L2
//   L1 = 完全漏放行（lang-zone 放行且生成的 Rust 也通过，最严重）
//   L2 = 前端漏检（lang-zone 放行，生成的 Rust 被 rustc 拒绝）
// 实际：lang-zone 放行（EXIT 0）| rustc 拒绝 E0425
// 验证：lang-zone <本文件> 当前返回 0；修复后应返回非 0 并报错
// ============================================================
def sort_unbound(list: List<int>) -> List<int> =
    let n = list.len()
    mut result = list.clone()
    for i in 0..n:
        for j in 0..(n - i - 1):
            if result[j] > result[j + 1]:
                let tmp = result[j]
                result[j] = result[j + 1]
                result[j + 1] = tmp
    result

