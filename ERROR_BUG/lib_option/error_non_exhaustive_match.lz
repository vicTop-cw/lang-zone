// ============================================================
// error_non_exhaustive_match.lz — 负向测试用例（ERROR_BUG）
// 所属：lib_option | 期望检查点：match 未覆盖所有枚举变体（漏 Blue），应报非穷尽错误
// 级别：L2
//   L1 = 完全漏放行（lang-zone 放行且生成的 Rust 也通过，最严重）
//   L2 = 前端漏检（lang-zone 放行，生成的 Rust 被 rustc 拒绝）
// 实际：lang-zone 放行（EXIT 0）| rustc 拒绝 E0004
// 验证：lang-zone <本文件> 当前返回 0；修复后应返回非 0 并报错
// ============================================================
enum Color:
    Red
    Green
    Blue

def name(c: Color) -> str =
    match c:
        case Red:
            "red"
        case Green:
            "green"

def main() =
    let c = Red
    print(name(c))
