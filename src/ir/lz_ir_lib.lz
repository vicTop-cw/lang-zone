// ═══════════════════════════════════════════════════════════════
// LZ IR 库（lzc --emit=ir-lz 后端内嵌）：用 LZ 实现的 LZIR display
// 对齐 src/ir/display.rs；由 src/ir/lz_codegen.rs include_str! 嵌入，
// 生成的 .lz = 本库 + main 构造（bootstrap/work/lz_ir/ir_module.lz 为其开发镜像）
// ═══════════════════════════════════════════════════════════════

// ── IrType（17 变体，含 Duck）──
enum IrType:
    Int
    F64
    Str
    Bool
    Unit
    Never
    Any
    Self_
    Named(path: str, args: List<IrType>)
    Opt(inner: IrType)
    Res(ok: IrType, err: IrType)
    Tuple(elems: List<IrType>)
    FnType(params: List<IrType>, ret: IrType)
    Ref(inner: IrType)
    MutRef(inner: IrType)
    Generic(name: str)
    Duck(fields: List<(str, IrType)>)

// ── Expr（单 enum 带 ty 字段）──
enum Expr:
    LitInt(v: int, ty: IrType)
    LitF64(v: f64, ty: IrType)
    LitStr(s: str, ty: IrType)
    LitFStr(s: str, ty: IrType)
    LitBool(b: bool, ty: IrType)
    LitUnit(ty: IrType)
    LitNone(ty: IrType)
    Var(name: str, ty: IrType)
    Call(callee: Expr, args: List<Expr>, ty: IrType)
    MethodCall(receiver: Expr, method: str, args: List<Expr>, ty: IrType)
    FieldAccess(base: Expr, field: str, ty: IrType)
    IndexGet(base: Expr, key: Expr, ty: IrType)
    IndexSet(base: Expr, key: Expr, value: Expr, ty: IrType)
    BinOp(op: str, lhs: Expr, rhs: Expr, ty: IrType)
    UnOp(op: str, operand: Expr, ty: IrType)
    StructCtor(name: str, fields: List<(str, Expr)>, ty: IrType)
    EnumCtor(enum_name: str, variant: str, args: List<Expr>, ty: IrType)
    Cast(inner: Expr, target: IrType, ty: IrType)
    MagicCall(magic: str, args: List<Expr>, ty: IrType)
    IfExpr(cond: Expr, then: Expr, els: Expr, ty: IrType)
    Lambda(params: List<str>, body: Expr, ty: IrType)
    Pipe(receiver: Expr, callee: Expr, args: List<Expr>, ty: IrType)
    TupleLit(elems: List<Expr>, ty: IrType)
    ListLit(items: List<Expr>, ty: IrType)
    BlockExpr(stmts: List<Stmt>, ty: IrType)
    GenExpr(yield_of: Expr, ty: IrType)
    // Rust display.rs 落进 `_ => "<expr>"` 的节点：显示 `<expr>` 逐字符对齐
    Paren(inner: Expr, ty: IrType)
    Range(end: Expr, inclusive: bool, ty: IrType)
    Dict(pairs: List<(Expr, Expr)>, ty: IrType)
    AssignExpr(target: Expr, value: Expr, ty: IrType)
    ImplicitConvert(source: Expr, target_ty: IrType, ty: IrType)

// ── BlockIR：带类型标注的块（Rust Block Display = `{ [ty]\n ... }`）──
// 单变体 enum（而非 struct）：codegen 对 enum 自动 derive PartialEq，
// struct 只 derive Debug/Clone —— Stmt 枚举含 BlockIR 字段，缺 PartialEq 会 E0369
enum BlockIR:
    Block(stmts: List<Stmt>, ty: IrType)

// ── Maybe*：替代 Option<X> 的构造枚举 ──
// 裸 Option.None 的 expr.ty 被 LZ codegen 硬编码为 i64（Option::<i64>::None，
// 即使在具名返回类型函数内也如此），无法构造 Option<Expr> 等；
// 改用自有单位变体枚举（MaybeExpr.NoExpr 等），避免元素类型推断。
enum MaybeExpr:
    NoExpr
    YesExpr(value: Expr)

enum MaybeBlock:
    NoBlock
    YesBlock(value: BlockIR)

enum MaybeStr:
    NoStr
    YesStr(value: str)

enum MaybeIrType:
    NoTy
    YesTy(value: IrType)

enum MaybePattern:
    NoPat
    YesPat(value: Pattern)

// ── Stmt ──
enum Stmt:
    Let(name: str, ty: IrType, value: Expr, is_mut: bool, is_ref: bool)
    Assign(target: Expr, value: Expr)
    Return(value: MaybeExpr)
    ExprStmt(expr: Expr)
    If(cond: Expr, then: BlockIR, els: MaybeBlock)
    For(var: str, iter: Expr, guard_e: MaybeExpr, body: BlockIR, else_body: MaybeBlock)
    While(cond: Expr, guard_e: MaybeExpr, body: BlockIR, else_body: MaybeBlock)
    Block(stmts: List<Stmt>)
    Match(scrutinee: Expr, arms: List<(Pattern, MaybeExpr, BlockIR)>)
    Yield(value: Expr)
    YieldFrom(iter: Expr)
    Break
    BreakLabel(label: str, value: MaybeExpr)
    Continue
    BlockLabel(label: str, body: BlockIR)
    Defer(body: BlockIR)
    TryCatch(body: BlockIR, catches: List<(MaybePattern, BlockIR)>, else_body: MaybeBlock, finally_body: MaybeBlock)
    WhileLet(pattern: Pattern, expr: Expr, guard_e: MaybeExpr, body: BlockIR)
    Raise(value: Expr)
    Assert(cond: Expr)
    TypeAlias(name: str, ty: IrType)
    CheckerBlock(label: str, ps_name: MaybeStr)
    Pass

// ── Pattern ──
enum Pattern:
    Wildcard
    Ident(name: str)
    RefMutIdent(name: str)
    LitInt(v: int)
    LitStr(s: str)
    LitBool(b: bool)
    LitF64(v: f64)
    Tuple(elems: List<Pattern>)
    List(elems: List<Pattern>)
    Struct(name: str, fields: List<(str, Pattern)>)
    Enum(enum_name: str, variant: str, args: List<Pattern>)
    Rest(name: MaybeStr)
    Range(start: int, end: int, inclusive: bool)

// ── Item ──
enum Item:
    FnDef(name: str, generics: List<str>, params: List<(str, IrType, bool, bool, bool)>, ret: IrType, body: List<Stmt>)
    Const(name: str, ty: IrType, value: Expr)
    StructDef(name: str, generics: List<str>, fields: List<(str, IrType)>)
    EnumDef(name: str, generics: List<str>, variants: List<(str, List<IrType>)>)
    TraitDef(name: str, supertraits: List<IrType>, methods: List<(str, List<IrType>, IrType)>)
    DuckDef(name: str, method_count: int)
    UseStmt(path: List<str>, alias: MaybeStr, items: List<str>, is_from: bool)
    TypeAlias(name: str, ty: IrType)
    Impl(trait_: MaybeIrType, for_type: IrType, method_names: List<str>)
    CheckerBlock(name: str, ps_name: MaybeStr)
    Test(name: str, body: List<Stmt>)

// ── IrModule 顶层 ──
struct IrModule =
    name: str
    items: List<Item>
    prelude: List<str>
    version: int

// ── display_type：IrType → str ──
def display_type(t: IrType) -> str =
    match t:
        case IrType.Int => "int"
        case IrType.F64 => "f64"
        case IrType.Str => "str"
        case IrType.Bool => "bool"
        case IrType.Unit => "()"
        case IrType.Never => "!"
        case IrType.Any => "?"
        case IrType.Self_ => "Self"
        case IrType.Generic(name: g) => g
        case IrType.Named(path: p, args: a) =>
            p + ("<" + type_list(a) + ">" if a.len() > 0 else "")
        case IrType.Opt(inner: x) => "Option<" + display_type(x) + ">"
        case IrType.Res(ok: o, err: e) => "Result<" + display_type(o) + ", " + display_type(e) + ">"
        case IrType.Tuple(elems: es) =>
            "(" + type_list(es) + ")"
        case IrType.FnType(params: ps, ret: r) =>
            "fn(" + type_list(ps) + ") -> " + display_type(r)
        case IrType.Ref(inner: x) => "&" + display_type(x)
        case IrType.MutRef(inner: x) => "&mut " + display_type(x)
        case IrType.Duck(fields: fs) =>
            "duck {" + duck_fields(fs) + "}"

def type_list(ts: List<IrType>) -> str =
    if ts.len() == 0:
        ""
    else:
        let head = display_type(ts[0].clone())
        if ts.len() > 1:
            head + ", " + type_list(tail_t(ts))
        else:
            head

def tail_t(ts: List<IrType>) -> List<IrType> =
    let mut out: List<IrType> = []
    for idx in 1..ts.len():
        out.push(ts[idx].clone())
    out

def duck_fields(fs: List<(str, IrType)>) -> str =
    let mut out = ""
    for idx in 0..fs.len():
        let f = fs[idx].clone()
        out = out + (", " if idx > 0 else "") + f.0 + ": " + display_type(f.1)
    out

// ── display_expr：Expr → str（带 [ty] 前缀）──
def display_expr(e: Expr) -> str =
    match e:
        case Expr.LitInt(v: n, ty: t) => "[" + display_type(t) + "] " + n.to_string() + "_i64"
        case Expr.LitF64(v: n, ty: t) => "[" + display_type(t) + "] " + n.to_string() + "_f64"
        case Expr.LitStr(s: s, ty: t) => "[" + display_type(t) + "] \"" + s + "\""
        case Expr.LitFStr(s: s, ty: t) => "[" + display_type(t) + "] f\"" + s + "\""
        case Expr.LitBool(b: b, ty: t) => "[" + display_type(t) + "] " + b.to_string()
        case Expr.LitUnit(ty: t) => "[" + display_type(t) + "] ()"
        case Expr.LitNone(ty: t) => "[" + display_type(t) + "] None"
        case Expr.Var(name: n, ty: t) => "[" + display_type(t) + "] " + n
        case Expr.Call(callee: c, args: a, ty: t) =>
            "[" + display_type(t) + "] call " + display_expr(c) + arg_list(a)
        case Expr.MethodCall(receiver: r, method: m, args: a, ty: t) =>
            "[" + display_type(t) + "] method " + display_expr(r) + "." + m + arg_list(a)
        case Expr.FieldAccess(base: b, field: f, ty: t) =>
            "[" + display_type(t) + "] field " + display_expr(b) + "." + f
        case Expr.IndexGet(base: b, key: k, ty: t) =>
            "[" + display_type(t) + "] index " + display_expr(b) + "[" + display_expr(k) + "]"
        case Expr.IndexSet(base: b, key: k, value: v, ty: t) =>
            "[" + display_type(t) + "] index_set " + display_expr(b) + "[" + display_expr(k) + "] = " + display_expr(v)
        case Expr.BinOp(op: o, lhs: l, rhs: r, ty: t) =>
            "[" + display_type(t) + "] binop " + display_expr(l) + " " + o + " " + display_expr(r)
        case Expr.UnOp(op: o, operand: p, ty: t) =>
            "[" + display_type(t) + "] unop " + o + " " + display_expr(p)
        case Expr.StructCtor(name: n, fields: fs, ty: t) =>
            "[" + display_type(t) + "] new " + n + field_pairs(fs)
        case Expr.EnumCtor(enum_name: en, variant: v, args: a, ty: t) =>
            "[" + display_type(t) + "] " + en + "::" + v + arg_list(a)
        case Expr.Cast(inner: i, target: tg, ty: t) =>
            "[" + display_type(t) + "] cast " + display_expr(i) + " as " + display_type(tg)
        case Expr.MagicCall(magic: m, args: a, ty: t) =>
            "[" + display_type(t) + "] magic " + m + arg_list(a)
        case Expr.IfExpr(cond: c, then: th, els: el, ty: t) =>
            "[" + display_type(t) + "] if " + display_expr(c) + " then " + display_expr(th) + " else " + display_expr(el)
        case Expr.Lambda(params: ps, body: b, ty: t) =>
            "[" + display_type(t) + "] |" + str_join(ps) + "| " + display_expr(b)
        case Expr.Pipe(receiver: r, callee: c, args: a, ty: t) =>
            "[" + display_type(t) + "] pipe " + display_expr(r) + " |> " + display_expr(c) + arg_list(a)
        case Expr.TupleLit(elems: es, ty: t) =>
            "[" + display_type(t) + "] (" + expr_list(es) + ")"
        case Expr.ListLit(items: xs, ty: t) =>
            "[" + display_type(t) + "] [" + expr_list(xs) + "]"
        case Expr.BlockExpr(stmts: ss, ty: t) =>
            "[" + display_type(t) + "] block " + block_with_ty(ss, t)
        case Expr.GenExpr(yield_of: y, ty: t) =>
            "[" + display_type(t) + "] gen " + display_expr(y)
        case Expr.Paren(inner: i, ty: t) =>
            "[" + display_type(t) + "] (" + display_expr(i) + ")"
        case Expr.Range(end: en, inclusive: inc, ty: t) =>
            "[" + display_type(t) + "] <expr>"
        case Expr.Dict(pairs: ps, ty: t) =>
            "[" + display_type(t) + "] <expr>"
        case Expr.AssignExpr(target: tg, value: v, ty: t) =>
            "[" + display_type(t) + "] <expr>"
        case Expr.ImplicitConvert(source: s, target_ty: tt, ty: t) =>
            "[" + display_type(t) + "] <expr>"

def arg_list(as_: List<Expr>) -> str =
    if as_.len() == 0:
        ""
    else:
        "(" + expr_list(as_) + ")"

def expr_list(es: List<Expr>) -> str =
    if es.len() == 0:
        ""
    else:
        let head = display_expr(es[0].clone())
        if es.len() > 1:
            head + ", " + expr_list(tail_e(es))
        else:
            head

def tail_e(es: List<Expr>) -> List<Expr> =
    let mut out: List<Expr> = []
    for idx in 1..es.len():
        out.push(es[idx].clone())
    out

def field_pairs(fs: List<(str, Expr)>) -> str =
    if fs.len() == 0:
        ""
    else:
        let mut out = "{ "
        for idx in 0..fs.len():
            out = out + (", " if idx > 0 else "") + pair_str(fs[idx].clone())
        out + " }"

def pair_str(p: (str, Expr)) -> str =
    p.0 + ": " + display_expr(p.1)

// ── display_stmt：Stmt → str ──
def display_stmt(s: Stmt) -> str =
    match s:
        case Stmt.Let(name: n, ty: t, value: v, is_mut: m, is_ref: r) =>
            let_kw(m, r) + n + ": " + display_type(t) + " = " + display_expr(v)
        case Stmt.Assign(target: t, value: v) =>
            display_expr(t) + " = " + display_expr(v)
        case Stmt.Return(value: v) =>
            match v:
                case MaybeExpr.YesExpr(value: inner) => "return " + display_expr(inner)
                case MaybeExpr.NoExpr => "return"
        case Stmt.ExprStmt(expr: e) => display_expr(e)
        case Stmt.If(cond: c, then: t, els: e) =>
            let base = "if " + display_expr(c) + " " + block_disp(t)
            match e:
                case MaybeBlock.YesBlock(value: es) => base + " else " + block_disp(es)
                case MaybeBlock.NoBlock => base
        case Stmt.For(var: v, iter: it, guard_e: g, body: b, else_body: eb) =>
            "for " + v + " in " + display_expr(it) + guard_s(g) + " " + block_disp(b) + else_s(eb)
        case Stmt.While(cond: c, guard_e: g, body: b, else_body: eb) =>
            "while " + display_expr(c) + guard_s(g) + " " + block_disp(b) + else_s(eb)
        case Stmt.Block(stmts: b) =>
            stmt_block(b)
        case Stmt.Match(scrutinee: s, arms: as_) =>
            match_block(s, as_)
        case Stmt.Yield(value: v) =>
            "yield " + display_expr(v)
        case Stmt.YieldFrom(iter: it) =>
            "yield from " + display_expr(it)
        case Stmt.Break => "break"
        case Stmt.BreakLabel(label: l, value: v) =>
            let base = "break '" + l
            match v:
                case MaybeExpr.YesExpr(value: inner) => base + " " + display_expr(inner)
                case MaybeExpr.NoExpr => base
        case Stmt.Continue => "continue"
        case Stmt.BlockLabel(label: l, body: b) =>
            "block '" + l + " " + block_disp(b)
        case Stmt.Defer(body: b) =>
            "defer " + block_disp(b)
        case Stmt.TryCatch(body: b, catches: cs, else_body: eb, finally_body: fb) =>
            let mut out = "try " + block_disp(b)
            out = out + try_catches_str(cs)
            out = out + else_s(eb)
            out = out + finally_s(fb)
            out
        case Stmt.WhileLet(pattern: p, expr: e, guard_e: g, body: b) =>
            "while let " + display_pattern(p) + " = " + display_expr(e) + guard_s(g) + " " + block_disp(b)
        case Stmt.CheckerBlock(label: l, ps_name: p) =>
            "block '" + l + "[ps:" + opt_debug(p) + "]"
        case Stmt.Raise(value: v) => "<stmt>"
        case Stmt.Assert(cond: c) => "<stmt>"
        case Stmt.TypeAlias(name: n, ty: t) => "<stmt>"
        case Stmt.Pass => "<stmt>"

def let_kw(m: bool, r: bool) -> str =
    ("let mut ref " if (m && r) else ("let ref " if r else ("let mut " if m else "let ")))

def guard_s(g: MaybeExpr) -> str =
    match g:
        case MaybeExpr.YesExpr(value: e) => " if " + display_expr(e)
        case MaybeExpr.NoExpr => ""

def else_s(eb: MaybeBlock) -> str =
    match eb:
        case MaybeBlock.YesBlock(value: b) => " else " + block_disp(b)
        case MaybeBlock.NoBlock => ""

def finally_s(fb: MaybeBlock) -> str =
    match fb:
        case MaybeBlock.YesBlock(value: b) => " finally " + block_disp(b)
        case MaybeBlock.NoBlock => ""

def try_catches_str(cs: List<(MaybePattern, BlockIR)>) -> str =
    let mut out = ""
    for idx in 0..cs.len():
        let c = cs[idx].clone()
        out = out + catch_str(c)
    out

def catch_str(c: (MaybePattern, BlockIR)) -> str =
    match c.0:
        case MaybePattern.YesPat(value: p) => " catch(" + display_pattern(p) + ") " + block_disp(c.1)
        case MaybePattern.NoPat => " catch " + block_disp(c.1)

// ── display_pattern：Pattern → str ──
def display_pattern(p: Pattern) -> str =
    match p:
        case Pattern.Wildcard => "_"
        case Pattern.Ident(name: n) => n
        case Pattern.RefMutIdent(name: n) => "ref mut " + n
        case Pattern.LitInt(v: n) => n.to_string() + "_i64"
        case Pattern.LitStr(s: s) => "\"" + s + "\""
        case Pattern.LitBool(b: b) => b.to_string()
        case Pattern.LitF64(v: n) => n.to_string() + "_f64"
        case Pattern.Tuple(elems: es) =>
            "(" + pat_list(es) + ")"
        case Pattern.List(elems: es) =>
            "[" + pat_list(es) + "]"
        case Pattern.Struct(name: n, fields: fs) =>
            n + pat_struct_fields(fs)
        case Pattern.Enum(enum_name: en, variant: v, args: a) =>
            en + "::" + v + arg_pat_list(a)
        case Pattern.Rest(name: rn) =>
            match rn:
                case MaybeStr.YesStr(value: n2) => ".." + n2
                case MaybeStr.NoStr => ".."
        case Pattern.Range(start: st, end: en, inclusive: inc) =>
            st.to_string() + ("..=" if inc else "..") + en.to_string()

def pat_list(ps: List<Pattern>) -> str =
    if ps.len() == 0:
        ""
    else:
        let head = display_pattern(ps[0].clone())
        if ps.len() > 1:
            head + ", " + pat_list(tail_pat(ps))
        else:
            head

def tail_pat(ps: List<Pattern>) -> List<Pattern> =
    let mut out: List<Pattern> = []
    for idx in 1..ps.len():
        out.push(ps[idx].clone())
    out

def arg_pat_list(ps: List<Pattern>) -> str =
    if ps.len() == 0:
        ""
    else:
        "(" + pat_list(ps) + ")"

def pat_struct_fields(fs: List<(str, Pattern)>) -> str =
    if fs.len() == 0:
        ""
    else:
        let mut out = "{ "
        for idx in 0..fs.len():
            let f = fs[idx].clone()
            out = out + (", " if idx > 0 else "") + f.0 + ": " + display_pattern(f.1)
        out + " }"

// ── match_block：Stmt::Match → str ──
def match_block(s: Expr, as_: List<(Pattern, MaybeExpr, BlockIR)>) -> str =
    let mut out = "match " + display_expr(s) + " {"
    for idx in 0..as_.len():
        let arm = as_[idx].clone()
        out = out + " " + display_pattern(arm.0) + guard_s(arm.1) + " => " + block_disp(arm.2)
    out + " }"

def stmt_block(ss: List<Stmt>) -> str =
    if ss.len() == 0:
        "{ }"
    else:
        let mut out = "{\n"
        for idx in 0..ss.len():
            out = out + "  " + display_stmt(ss[idx].clone()) + "\n"
        out + "}"

// Block Display（Rust 版带 [ty]）：{ [ty]\n  stmt\n} / { } [ty]
// BlockIR 为单变体 enum，字段访问走 match 解构（LZ 不支持 enum 变体直接 .field）
def block_disp(b: BlockIR) -> str =
    match b:
        case BlockIR.Block(stmts: ss, ty: t) =>
            if ss.len() == 0:
                "{ } [" + display_type(t) + "]"
            else:
                let mut out = "{ [" + display_type(t) + "]\n"
                for idx in 0..ss.len():
                    out = out + "  " + display_stmt(ss[idx].clone()) + "\n"
                out + "}"

// Expr::BlockExpr 的块显示（ty 用表达式自身类型）
def block_with_ty(ss: List<Stmt>, t: IrType) -> str =
    if ss.len() == 0:
        "{ } [" + display_type(t) + "]"
    else:
        let mut out = "{ [" + display_type(t) + "]\n"
        for idx in 0..ss.len():
            out = out + "  " + display_stmt(ss[idx].clone()) + "\n"
        out + "}"

def opt_debug(o: MaybeStr) -> str =
    match o:
        case MaybeStr.YesStr(value: s) => "Some(\"" + s + "\")"
        case MaybeStr.NoStr => "None"

// FnDef body：每行 2 空格缩进（对齐 display.rs Item::FnDef）
def stmt_lines(ss: List<Stmt>) -> str =
    let mut out = ""
    for idx in 0..ss.len():
        out = out + "  " + display_stmt(ss[idx].clone()) + "\n"
    out

// ── display_item：Item → str ──
def display_item(it: Item) -> str =
    match it:
        case Item.FnDef(name: n, generics: gs, params: ps, ret: r, body: b) =>
            "fn " + n + generic_sig(gs) + param_sig(ps) + " -> " + display_type(r) + ":\n" + stmt_lines(b)
        case Item.Const(name: n, ty: t, value: v) =>
            "const " + n + ": " + display_type(t) + " = " + display_expr(v)
        case Item.StructDef(name: n, generics: gs, fields: fs) =>
            "struct " + n + generic_sig(gs) + " {\n" + field_lines(fs) + "}"
        case Item.EnumDef(name: n, generics: gs, variants: vs) =>
            "enum " + n + generic_sig(gs) + " {\n" + variant_lines(vs) + "}"
        case Item.TraitDef(name: n, supertraits: ss, methods: ms) =>
            "trait " + n + super_join(ss) + " {\n" + method_lines(ms) + "}"
        case Item.DuckDef(name: n, method_count: c) =>
            "duck " + n + " { " + c.to_string() + " methods }"
        case Item.UseStmt(path: p, alias: a, items: xs, is_from: f) =>
            (("from " + dot_join(p) + " import " + str_join(xs)) if f else ("import " + dot_join(p)))
        case Item.TypeAlias(name: n, ty: t) =>
            "type " + n + " = " + display_type(t)
        case Item.Impl(trait_: tr, for_type: fty, method_names: ms) =>
            let mut out = "impl " + impl_head(tr) + display_type(fty) + " {\n"
            for idx in 0..ms.len():
                out = out + "  fn " + ms[idx].clone() + " ...\n"
            out + "}"
        case Item.CheckerBlock(name: n, ps_name: p) =>
            "checker block '" + n + "[ps:" + opt_debug(p) + "]"
        case Item.Test(name: n, body: b) =>
            "test " + n + " " + stmt_block(b)

def generic_sig(gs: List<str>) -> str =
    if gs.len() == 0:
        ""
    else:
        "<" + str_join(gs) + ">"

def variant_lines(vs: List<(str, List<IrType>)>) -> str =
    let mut out = ""
    for idx in 0..vs.len():
        let v = vs[idx].clone()
        out = out + "  " + v.0 + variant_args(v.1) + "\n"
    out

def field_lines(fs: List<(str, IrType)>) -> str =
    let mut out = ""
    for idx in 0..fs.len():
        let f = fs[idx].clone()
        out = out + "  " + f.0 + ": " + display_type(f.1) + "\n"
    out

def variant_args(ts: List<IrType>) -> str =
    if ts.len() == 0:
        ""
    else:
        "(" + type_list(ts) + ")"

def super_join(ss: List<IrType>) -> str =
    if ss.len() == 0:
        ""
    else:
        let mut out = " : " + display_type(ss[0].clone())
        for idx in 1..ss.len():
            out = out + " + " + display_type(ss[idx].clone())
        out

def method_lines(ms: List<(str, List<IrType>, IrType)>) -> str =
    let mut out = ""
    for idx in 0..ms.len():
        let m = ms[idx].clone()
        out = out + "  fn " + m.0 + "(" + type_list(m.1) + ") -> " + display_type(m.2) + "\n"
    out

def param_sig(ps: List<(str, IrType, bool, bool, bool)>) -> str =
    if ps.len() == 0:
        "()"
    else:
        "(" + param_list(ps) + ")"

def param_list(ps: List<(str, IrType, bool, bool, bool)>) -> str =
    if ps.len() == 0:
        ""
    else:
        let p0 = ps[0].clone()
        param_str(p0) + (", " + param_list(tail_p(ps)) if ps.len() > 1 else "")

def param_str(p: (str, IrType, bool, bool, bool)) -> str =
    // 对齐 display.rs Item::FnDef：mut → owned → ref 前缀顺序
    ("mut " if p.3 else "") + ("owned " if p.4 else "") + ("ref " if p.2 else "") + p.0 + ": " + display_type(p.1)

def tail_p(ps: List<(str, IrType, bool, bool, bool)>) -> List<(str, IrType, bool, bool, bool)> =
    let mut out: List<(str, IrType, bool, bool, bool)> = []
    for idx in 1..ps.len():
        out.push(ps[idx].clone())
    out

def impl_head(tr: MaybeIrType) -> str =
    match tr:
        case MaybeIrType.YesTy(value: t) => display_type(t) + " for "
        case MaybeIrType.NoTy => ""

def dot_join(xs: List<str>) -> str =
    if xs.len() == 0:
        ""
    else:
        let mut out = xs[0].clone()
        for idx in 1..xs.len():
            out = out + "." + xs[idx].clone()
        out

// ── display_module：IrModule → str ──
def display_module(m: IrModule) -> str =
    let mut out = ";; LZIR v" + m.version.to_string() + " — module '" + m.name + "'\n"
    out = out + ";; " + m.items.len().to_string() + " items\n"
    if m.prelude.len() > 0:
        out = out + ";; prelude: " + str_join(m.prelude) + "\n"
    out = out + "\n"
    for idx in 0..m.items.len():
        out = out + display_item(m.items[idx].clone()) + "\n\n"
    out

def str_join(xs: List<str>) -> str =
    if xs.len() == 0:
        ""
    else:
        let mut out = xs[0].clone()
        for idx in 1..xs.len():
            out = out + ", " + xs[idx].clone()
        out
