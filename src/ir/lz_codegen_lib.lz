// ═══════════════════════════════════════════════════════════════
// LZ IR + Rust codegen 库（lzc --emit=rs-lz 后端内嵌）
// 前半部分：IR 类型 + display（与 lz_ir_lib.lz 一致，自举路线 B）
// 后半部分：codegen_* —— 用 LZ 实现的 IrModule → Rust 源码（D1 环节）
// 由 src/ir/lz_codegen.rs include_str! 嵌入，
// 生成的 .lzrs = 本库 + main 构造（bootstrap/work/lz_codegen 为其开发镜像）
// ═══════════════════════════════════════════════════════════════

// ── IrType（17 变体，含 Duck）──
enum IrType:
    Int
    F64
    Str
    Bool
    Unit
    Never
    Any
    Self_
    Named(path: str, args: List<IrType>)
    Opt(inner: IrType)
    Res(ok: IrType, err: IrType)
    Tuple(elems: List<IrType>)
    FnType(params: List<IrType>, ret: IrType)
    Ref(inner: IrType)
    MutRef(inner: IrType)
    Generic(name: str)
    Duck(fields: List<(str, IrType)>)

// ── Expr（单 enum 带 ty 字段）──
enum Expr:
    LitInt(v: int, ty: IrType)
    LitF64(v: f64, ty: IrType)
    LitStr(s: str, ty: IrType)
    LitFStr(s: str, ty: IrType)
    LitBool(b: bool, ty: IrType)
    LitUnit(ty: IrType)
    LitNone(ty: IrType)
    Var(name: str, ty: IrType)
    Call(callee: Expr, args: List<Expr>, ty: IrType)
    MethodCall(receiver: Expr, method: str, args: List<Expr>, ty: IrType)
    FieldAccess(base: Expr, field: str, ty: IrType)
    IndexGet(base: Expr, key: Expr, ty: IrType)
    IndexSet(base: Expr, key: Expr, value: Expr, ty: IrType)
    BinOp(op: str, lhs: Expr, rhs: Expr, ty: IrType)
    UnOp(op: str, operand: Expr, ty: IrType)
    StructCtor(name: str, fields: List<(str, Expr)>, ty: IrType)
    EnumCtor(enum_name: str, variant: str, args: List<Expr>, ty: IrType)
    // BUG-411：命名字段枚举的字段访问解构。Rust 不允许对枚举值直接 `.f`，须解构：
    //   match &x { E::V { f, .. } => f.clone(), _ => unreachable!() }
    // variants = 含该字段的**所有**变体名（对齐原生 BUG-407 修复后的多臂口径）。
    EnumFieldGet(base: Expr, enum_name: str, variants: List<str>, field: str, ty: IrType)
    Cast(inner: Expr, target: IrType, ty: IrType)
    MagicCall(magic: str, args: List<Expr>, ty: IrType)
    IfExpr(cond: Expr, then: Expr, els: Expr, ty: IrType)
    Lambda(params: List<str>, body: Expr, ty: IrType)
    Pipe(receiver: Expr, callee: Expr, args: List<Expr>, ty: IrType)
    TupleLit(elems: List<Expr>, ty: IrType)
    ListLit(items: List<Expr>, ty: IrType)
    BlockExpr(stmts: List<Stmt>, ty: IrType)
    GenExpr(yield_of: Expr, ty: IrType)
    // Rust display.rs 落进 `_ => "<expr>"` 的节点：显示 `<expr>` 逐字符对齐
    Paren(inner: Expr, ty: IrType)
    Range(end: Expr, inclusive: bool, ty: IrType)
    Dict(pairs: List<(Expr, Expr)>, ty: IrType)
    AssignExpr(target: Expr, value: Expr, ty: IrType)
    ImplicitConvert(source: Expr, target_ty: IrType, ty: IrType)

// ── BlockIR：带类型标注的块（Rust Block Display = `{ [ty]\n ... }`）──
// 单变体 enum（而非 struct）：codegen 对 enum 自动 derive PartialEq，
// struct 只 derive Debug/Clone —— Stmt 枚举含 BlockIR 字段，缺 PartialEq 会 E0369
enum BlockIR:
    Block(stmts: List<Stmt>, ty: IrType)

// ── Maybe*：替代 Option<X> 的构造枚举 ──
// 裸 Option.None 的 expr.ty 被 LZ codegen 硬编码为 i64（Option::<i64>::None，
// 即使在具名返回类型函数内也如此），无法构造 Option<Expr> 等；
// 改用自有单位变体枚举（MaybeExpr.NoExpr 等），避免元素类型推断。
enum MaybeExpr:
    NoExpr
    YesExpr(value: Expr)

enum MaybeBlock:
    NoBlock
    YesBlock(value: BlockIR)

enum MaybeStr:
    NoStr
    YesStr(value: str)

enum MaybeIrType:
    NoTy
    YesTy(value: IrType)

enum MaybePattern:
    NoPat
    YesPat(value: Pattern)

// ── Stmt ──
enum Stmt:
    Let(name: str, ty: IrType, value: Expr, is_mut: bool, is_ref: bool)
    Assign(target: Expr, value: Expr)
    Return(value: MaybeExpr)
    ExprStmt(expr: Expr)
    If(cond: Expr, then: BlockIR, els: MaybeBlock)
    For(var: str, iter: Expr, guard_e: MaybeExpr, body: BlockIR, else_body: MaybeBlock)
    While(cond: Expr, guard_e: MaybeExpr, body: BlockIR, else_body: MaybeBlock)
    Block(stmts: List<Stmt>)
    Match(scrutinee: Expr, arms: List<(Pattern, MaybeExpr, BlockIR)>)
    Yield(value: Expr)
    YieldFrom(iter: Expr)
    Break
    BreakLabel(label: str, value: MaybeExpr)
    Continue
    BlockLabel(label: str, body: BlockIR)
    Defer(body: BlockIR)
    TryCatch(body: BlockIR, catches: List<(MaybePattern, BlockIR)>, else_body: MaybeBlock, finally_body: MaybeBlock)
    WhileLet(pattern: Pattern, expr: Expr, guard_e: MaybeExpr, body: BlockIR)
    Raise(value: Expr)
    Assert(cond: Expr)
    TypeAlias(name: str, ty: IrType)
    CheckerBlock(label: str, ps_name: MaybeStr)
    Pass

// ── Pattern ──
enum Pattern:
    Wildcard
    Ident(name: str)
    RefMutIdent(name: str)
    LitInt(v: int)
    LitStr(s: str)
    LitBool(b: bool)
    LitF64(v: f64)
    Tuple(elems: List<Pattern>)
    List(elems: List<Pattern>)
    Struct(name: str, fields: List<(str, Pattern)>)
    Enum(enum_name: str, variant: str, args: List<Pattern>)
    // BUG-421：命名字段变体的匹配模式（Rust struct pattern `E::V { f: p, .. }`）。
    // 对 struct variant 用元组 pattern 报 E0164；序列化侧按变体定义判定后发本变体。
    EnumNamed(enum_name: str, variant: str, fields: List<(str, Pattern)>)
    Rest(name: MaybeStr)
    Range(start: int, end: int, inclusive: bool)

// BUG-422：impl 方法需带**完整定义**（名字/形参/返回/raises/函数体）。旧 schema 只带
// 方法名，LZ 侧只能发 `fn name(&self) { unimplemented!() }` 桩 ⇒ 所有用户 struct/enum
// 方法与 trait impl 在 --emit=rs-lz 下都是空壳（调用即 E0061 参数个数不符 / 返回值缺失）。
struct ImplMethod =
    name: str
    params: List<(str, IrType, bool, bool, bool)>
    ret: IrType
    exc: MaybeIrType
    body: List<Stmt>

// ── Item ──
enum Item:
    // BUG-431：FnDef 需携带 where 约束（§五 `def f<T>(x: T) where T: HasArea` →
    // Rust `fn f<T: HasArea>(...)`），否则生成的泛型函数缺边界，调用处报 E0599
    // （`no method found for type parameter T`）。与 TraitDef/Impl 同源缺口。
    // BUG-431：泛型形参携带边界（`where T: Clone` 由 builder 合并到 `GenericParam.bounds`）——
    // 旧 schema 只带名字，生成的泛型 fn/impl 无边界，调用处报 E0599。
    FnDef(name: str, generics: List<(str, List<IrType>)>, params: List<(str, IrType, bool, bool, bool)>, ret: IrType, exc: MaybeIrType, where_clause: List<(str, List<IrType>)>, body: List<Stmt>)
    Const(name: str, ty: IrType, value: Expr)
    StructDef(name: str, generics: List<(str, List<IrType>)>, fields: List<(str, IrType)>)
    EnumDef(name: str, generics: List<(str, List<IrType>)>, variants: List<(str, List<(str, IrType)>)>)
    TraitDef(name: str, generics: List<(str, List<IrType>)>, supertraits: List<IrType>, assoc_types: List<str>, methods: List<(str, List<IrType>, IrType)>)
    DuckDef(name: str, method_count: int)
    UseStmt(path: List<str>, alias: MaybeStr, items: List<str>, is_from: bool)
    TypeAlias(name: str, ty: IrType)
    // BUG-431：Impl 需携带 impl 级泛型形参、where 约束与关联类型绑定（原生
    // `impl<T> ... where I::Item: Clone { type Item = ...; }`）。此前只带方法，
    // 泛型 impl 生成 `impl Box3<T>` 报 E0425 cannot find type `T`，trait impl 缺
    // `type Item = i64` 报 E0191/E0412。
    Impl(trait_: MaybeIrType, for_type: IrType, generics: List<(str, List<IrType>)>, where_clause: List<(str, List<IrType>)>, assoc_type_bindings: List<(str, IrType)>, methods: List<ImplMethod>)
    CheckerBlock(name: str, ps_name: MaybeStr)
    Test(name: str, body: List<Stmt>)
    // BUG-410：脚本模式（无声明 main）顶层语句的合成分支，对应原生
    // codegen/mod.rs:1370 的 !has_main 合成分支（原生合成走 gen_block_inner，
    // 尾语句**带** `return ` 前缀，与声明式 main 的抑制行为不同）。
    ScriptMain(body: List<Stmt>)

// ── IrModule 顶层 ──
struct IrModule =
    name: str
    items: List<Item>
    prelude: List<str>
    version: int

// ── display_type：IrType → String ──
def display_type(t: IrType) -> String =
    match t:
        case IrType.Int => "int".to_string()
        case IrType.F64 => "f64".to_string()
        case IrType.Str => "str".to_string()
        case IrType.Bool => "bool".to_string()
        case IrType.Unit => "()".to_string()
        case IrType.Never => "!".to_string()
        case IrType.Any => "?".to_string()
        case IrType.Self_ => "Self".to_string()
        case IrType.Generic(name: g) => g.to_string()
        case IrType.Named(path: p, args: a) =>
            p + ("<".to_string() + type_list(a) + ">".to_string() if a.len() > 0 else "".to_string())
        case IrType.Opt(inner: x) => "Option<".to_string() + display_type(x) + ">".to_string()
        case IrType.Res(ok: o, err: e) => "Result<".to_string() + display_type(o) + ", ".to_string() + display_type(e) + ">".to_string()
        case IrType.Tuple(elems: es) =>
            "(".to_string() + type_list(es) + ")".to_string()
        case IrType.FnType(params: ps, ret: r) =>
            "fn(".to_string() + type_list(ps) + ") -> ".to_string() + display_type(r)
        case IrType.Ref(inner: x) => "&".to_string() + display_type(x)
        case IrType.MutRef(inner: x) => "&mut ".to_string() + display_type(x)
        case IrType.Duck(fields: fs) =>
            "duck {".to_string() + duck_fields(fs) + "}".to_string()

def type_list(ts: List<IrType>) -> String =
    if ts.len() == 0:
        "".to_string()
    else:
        let head = display_type(ts[0].clone())
        if ts.len() > 1:
            head + ", ".to_string() + type_list(tail_t(ts))
        else:
            head

def tail_t(ts: List<IrType>) -> List<IrType> =
    let mut out: List<IrType> = []
    for idx in 1..ts.len():
        out.push(ts[idx].clone())
    out

def duck_fields(fs: List<(str, IrType)>) -> String =
    let mut out: String = "".to_string()
    for idx in 0..fs.len():
        let f = fs[idx].clone()
        out = out + (", ".to_string() if idx > 0 else "".to_string()) + f.0.to_string() + ": ".to_string() + display_type(f.1)
    out

// ── display_expr：Expr → String（带 [ty] 前缀）──
def display_expr(e: Expr) -> String =
    match e:
        case Expr.LitInt(v: n, ty: t) => "[".to_string() + display_type(t) + "] ".to_string() + n.to_string() + "_i64".to_string()
        case Expr.LitF64(v: n, ty: t) => "[".to_string() + display_type(t) + "] ".to_string() + n.to_string() + "_f64".to_string()
        case Expr.LitStr(s: s, ty: t) => "[".to_string() + display_type(t) + "] \"".to_string() + s + "\"".to_string()
        case Expr.LitFStr(s: s, ty: t) => "[".to_string() + display_type(t) + "] f\"".to_string() + s + "\"".to_string()
        case Expr.LitBool(b: b, ty: t) => "[".to_string() + display_type(t) + "] ".to_string() + b.to_string()
        case Expr.LitUnit(ty: t) => "[".to_string() + display_type(t) + "] ()".to_string()
        case Expr.LitNone(ty: t) => "[".to_string() + display_type(t) + "] None".to_string()
        case Expr.Var(name: n, ty: t) => "[".to_string() + display_type(t) + "] ".to_string() + n
        case Expr.Call(callee: c, args: a, ty: t) =>
            "[".to_string() + display_type(t) + "] call ".to_string() + display_expr(c) + arg_list(a)
        case Expr.MethodCall(receiver: r, method: m, args: a, ty: t) =>
            "[".to_string() + display_type(t) + "] method ".to_string() + display_expr(r) + ".".to_string() + m + arg_list(a)
        case Expr.FieldAccess(base: b, field: f, ty: t) =>
            "[".to_string() + display_type(t) + "] field ".to_string() + display_expr(b) + ".".to_string() + f
        case Expr.IndexGet(base: b, key: k, ty: t) =>
            "[".to_string() + display_type(t) + "] index ".to_string() + display_expr(b) + "[".to_string() + display_expr(k) + "]".to_string()
        case Expr.IndexSet(base: b, key: k, value: v, ty: t) =>
            "[".to_string() + display_type(t) + "] index_set ".to_string() + display_expr(b) + "[".to_string() + display_expr(k) + "] = ".to_string() + display_expr(v)
        case Expr.BinOp(op: o, lhs: l, rhs: r, ty: t) =>
            "[".to_string() + display_type(t) + "] binop ".to_string() + display_expr(l) + " ".to_string() + o + " ".to_string() + display_expr(r)
        case Expr.UnOp(op: o, operand: p, ty: t) =>
            "[".to_string() + display_type(t) + "] unop ".to_string() + o + " ".to_string() + display_expr(p)
        case Expr.StructCtor(name: n, fields: fs, ty: t) =>
            "[".to_string() + display_type(t) + "] new ".to_string() + n + field_pairs(fs)
        case Expr.EnumCtor(enum_name: en, variant: v, args: a, ty: t) =>
            "[".to_string() + display_type(t) + "] ".to_string() + en + "::".to_string() + v + arg_list(a)
        // BUG-411：仅 Rust codegen（--emit=rs-lz）会产出该节点；IR display 不产出，
        // 此处只为 match 穷尽性补一个与字段访问同形的文本。
        case Expr.EnumFieldGet(base: b, enum_name: en, variants: vs, field: f, ty: t) =>
            "[".to_string() + display_type(t) + "] field ".to_string() + display_expr(b) + ".".to_string() + f
        case Expr.Cast(inner: i, target: tg, ty: t) =>
            "[".to_string() + display_type(t) + "] cast ".to_string() + display_expr(i) + " as ".to_string() + display_type(tg)
        case Expr.MagicCall(magic: m, args: a, ty: t) =>
            "[".to_string() + display_type(t) + "] magic ".to_string() + m + arg_list(a)
        case Expr.IfExpr(cond: c, then: th, els: el, ty: t) =>
            "[".to_string() + display_type(t) + "] if ".to_string() + display_expr(c) + " then ".to_string() + display_expr(th) + " else ".to_string() + display_expr(el)
        case Expr.Lambda(params: ps, body: b, ty: t) =>
            "[".to_string() + display_type(t) + "] |".to_string() + str_join(ps) + "| ".to_string() + display_expr(b)
        case Expr.Pipe(receiver: r, callee: c, args: a, ty: t) =>
            "[".to_string() + display_type(t) + "] pipe ".to_string() + display_expr(r) + " |> ".to_string() + display_expr(c) + arg_list(a)
        case Expr.TupleLit(elems: es, ty: t) =>
            "[".to_string() + display_type(t) + "] (".to_string() + expr_list(es) + ")".to_string()
        case Expr.ListLit(items: xs, ty: t) =>
            "[".to_string() + display_type(t) + "] [".to_string() + expr_list(xs) + "]".to_string()
        case Expr.BlockExpr(stmts: ss, ty: t) =>
            "[".to_string() + display_type(t) + "] block ".to_string() + block_with_ty(ss, t)
        case Expr.GenExpr(yield_of: y, ty: t) =>
            "[".to_string() + display_type(t) + "] gen ".to_string() + display_expr(y)
        case Expr.Paren(inner: i, ty: t) =>
            "[".to_string() + display_type(t) + "] (".to_string() + display_expr(i) + ")".to_string()
        case Expr.Range(end: en, inclusive: inc, ty: t) =>
            "[".to_string() + display_type(t) + "] <expr>".to_string()
        case Expr.Dict(pairs: ps, ty: t) =>
            "[".to_string() + display_type(t) + "] <expr>".to_string()
        case Expr.AssignExpr(target: tg, value: v, ty: t) =>
            "[".to_string() + display_type(t) + "] <expr>".to_string()
        case Expr.ImplicitConvert(source: s, target_ty: tt, ty: t) =>
            "[".to_string() + display_type(t) + "] <expr>".to_string()

def arg_list(as_: List<Expr>) -> String =
    if as_.len() == 0:
        "".to_string()
    else:
        "(".to_string() + expr_list(as_) + ")".to_string()

def expr_list(es: List<Expr>) -> String =
    if es.len() == 0:
        "".to_string()
    else:
        let head = display_expr(es[0].clone())
        if es.len() > 1:
            head + ", ".to_string() + expr_list(tail_e(es))
        else:
            head

def tail_e(es: List<Expr>) -> List<Expr> =
    let mut out: List<Expr> = []
    for idx in 1..es.len():
        out.push(es[idx].clone())
    out

def field_pairs(fs: List<(str, Expr)>) -> String =
    if fs.len() == 0:
        "".to_string()
    else:
        let mut out: String = "{ ".to_string()
        for idx in 0..fs.len():
            out = out + (", ".to_string() if idx > 0 else "".to_string()) + pair_str(fs[idx].clone())
        out + " }".to_string()

def pair_str(p: (str, Expr)) -> String =
    p.0 + ": ".to_string() + display_expr(p.1)

// ── display_stmt：Stmt → String ──
def display_stmt(s: Stmt) -> String =
    match s:
        case Stmt.Let(name: n, ty: t, value: v, is_mut: m, is_ref: r) =>
            let_kw(m, r) + n + ": " + display_type(t) + " = " + display_expr(v)
        case Stmt.Assign(target: t, value: v) =>
            display_expr(t) + " = " + display_expr(v)
        case Stmt.Return(value: v) =>
            match v:
                case MaybeExpr.YesExpr(value: inner) => "return " + display_expr(inner)
                case MaybeExpr.NoExpr => "return"
        case Stmt.ExprStmt(expr: e) => display_expr(e)
        case Stmt.If(cond: c, then: t, els: e) =>
            let base = "if " + display_expr(c) + " " + block_disp(t)
            match e:
                case MaybeBlock.YesBlock(value: es) => base + " else " + block_disp(es)
                case MaybeBlock.NoBlock => base
        case Stmt.For(var: v, iter: it, guard_e: g, body: b, else_body: eb) =>
            "for " + v + " in " + display_expr(it) + guard_s(g) + " " + block_disp(b) + else_s(eb)
        case Stmt.While(cond: c, guard_e: g, body: b, else_body: eb) =>
            "while " + display_expr(c) + guard_s(g) + " " + block_disp(b) + else_s(eb)
        case Stmt.Block(stmts: b) =>
            stmt_block(b)
        case Stmt.Match(scrutinee: s, arms: as_) =>
            match_block(s, as_)
        case Stmt.Yield(value: v) =>
            "yield " + display_expr(v)
        case Stmt.YieldFrom(iter: it) =>
            "yield from " + display_expr(it)
        case Stmt.Break => "break"
        case Stmt.BreakLabel(label: l, value: v) =>
            let base = "break '" + l
            match v:
                case MaybeExpr.YesExpr(value: inner) => base + " " + display_expr(inner)
                case MaybeExpr.NoExpr => base
        case Stmt.Continue => "continue"
        case Stmt.BlockLabel(label: l, body: b) =>
            "block '" + l + " " + block_disp(b)
        case Stmt.Defer(body: b) =>
            "defer " + block_disp(b)
        case Stmt.TryCatch(body: b, catches: cs, else_body: eb, finally_body: fb) =>
            let mut out = "try " + block_disp(b)
            out = out + try_catches_str(cs)
            out = out + else_s(eb)
            out = out + finally_s(fb)
            out
        case Stmt.WhileLet(pattern: p, expr: e, guard_e: g, body: b) =>
            "while let " + display_pattern(p) + " = " + display_expr(e) + guard_s(g) + " " + block_disp(b)
        case Stmt.CheckerBlock(label: l, ps_name: p) =>
            "block '" + l + "[ps:" + opt_debug(p) + "]"
        case Stmt.Raise(value: v) => "<stmt>"
        case Stmt.Assert(cond: c) => "<stmt>"
        case Stmt.TypeAlias(name: n, ty: t) => "<stmt>"
        case Stmt.Pass => "<stmt>"

def let_kw(m: bool, r: bool) -> String =
    ("let mut ref ".to_string() if (m && r) else ("let ref ".to_string() if r else ("let mut ".to_string() if m else "let ".to_string())))

def guard_s(g: MaybeExpr) -> String =
    match g:
        case MaybeExpr.YesExpr(value: e) => " if ".to_string() + display_expr(e)
        case MaybeExpr.NoExpr => "".to_string()

def else_s(eb: MaybeBlock) -> String =
    match eb:
        case MaybeBlock.YesBlock(value: b) => " else ".to_string() + block_disp(b)
        case MaybeBlock.NoBlock => "".to_string()

def finally_s(fb: MaybeBlock) -> String =
    match fb:
        case MaybeBlock.YesBlock(value: b) => " finally ".to_string() + block_disp(b)
        case MaybeBlock.NoBlock => "".to_string()

def try_catches_str(cs: List<(MaybePattern, BlockIR)>) -> String =
    let mut out: String = "".to_string()
    for idx in 0..cs.len():
        let c = cs[idx].clone()
        out = out + catch_str(c)
    out

def catch_str(c: (MaybePattern, BlockIR)) -> String =
    match c.0:
        case MaybePattern.YesPat(value: p) => " catch(".to_string() + display_pattern(p) + ") ".to_string() + block_disp(c.1)
        case MaybePattern.NoPat => " catch ".to_string() + block_disp(c.1)

// ── display_pattern：Pattern → String ──
def display_pattern(p: Pattern) -> String =
    match p:
        case Pattern.Wildcard => "_".to_string()
        case Pattern.Ident(name: n) => n
        case Pattern.RefMutIdent(name: n) => "ref mut ".to_string() + n
        case Pattern.LitInt(v: n) => n.to_string() + "_i64".to_string()
        case Pattern.LitStr(s: s) => "\"".to_string() + s + "\"".to_string()
        case Pattern.LitBool(b: b) => b.to_string()
        case Pattern.LitF64(v: n) => n.to_string() + "_f64".to_string()
        case Pattern.Tuple(elems: es) =>
            "(".to_string() + pat_list(es) + ")".to_string()
        case Pattern.List(elems: es) =>
            "[".to_string() + pat_list(es) + "]".to_string()
        case Pattern.Struct(name: n, fields: fs) =>
            let mut fields_s: String = "".to_string()
            for idx in 0..fs.len():
                if idx > 0:
                    fields_s = fields_s + ", ".to_string()
                let f = fs[idx].clone()
                fields_s = fields_s + f.0 + ": ".to_string() + display_pattern(f.1)
            n + " { ".to_string() + fields_s + " }".to_string()
        case Pattern.Enum(enum_name: en, variant: v, args: a) =>
            en + "::".to_string() + v + arg_pat_list(a)
        case Pattern.EnumNamed(enum_name: en, variant: v, fields: fs) =>
            let mut fields_s: String = " { ".to_string()
            for idx in 0..fs.len():
                if idx > 0:
                    fields_s = fields_s + ", ".to_string()
                let f = fs[idx].clone()
                fields_s = fields_s + f.0 + ": ".to_string() + display_pattern(f.1)
            en + "::".to_string() + v + fields_s + " }".to_string()
        case Pattern.Rest(name: rn) =>
            // BUG-471：对齐原生 pattern_gen.rs:187-190——具名余项发 `rest @ ..`（@ 绑定）
            // 而非 `..rest`。后者是 Rust 1.83+ 的简写，工具链 rustc 报 E0425
            // cannot find value rest in this scope。
            match rn:
                case MaybeStr.YesStr(value: n2) => n2 + " @ ..".to_string()
                case MaybeStr.NoStr => "..".to_string()
        case Pattern.Range(start: st, end: en, inclusive: inc) =>
            st.to_string() + ("..=".to_string() if inc else "..".to_string()) + en.to_string()

def pat_list(ps: List<Pattern>) -> String =
    if ps.len() == 0:
        "".to_string()
    else:
        let head = display_pattern(ps[0].clone())
        if ps.len() > 1:
            head + ", ".to_string() + pat_list(tail_pat(ps))
        else:
            head

def tail_pat(ps: List<Pattern>) -> List<Pattern> =
    let mut out: List<Pattern> = []
    for idx in 1..ps.len():
        out.push(ps[idx].clone())
    out

def arg_pat_list(ps: List<Pattern>) -> String =
    if ps.len() == 0:
        "".to_string()
    else:
        "(".to_string() + pat_list(ps) + ")".to_string()

// BUG-470：对齐原生 helpers.rs:59 pattern_is_list + stmt_gen.rs:2311——任一臂模式
// （含 Tuple/Struct/Enum/EnumNamed 嵌套）是列表模式且 scrutinee 是 List/Vec/Tuple，
// 则 scrutinee 追加 `.as_slice()`。原生把 List<int> 编为 Vec<i64>，Rust 数组模式
// `[a, ..rest]` 只能匹配 slice，否则 E0529 expected array or slice。
def pattern_is_list(p: Pattern) -> bool =
    match p:
        case Pattern.List(elems: _): true
        case Pattern.Tuple(elems: es): any_pat_is_list(es)
        case Pattern.Struct(name: _, fields: fs): any_field_pat_is_list(fs)
        case Pattern.Enum(enum_name: _, variant: _, args: as_): any_pat_is_list(as_)
        case Pattern.EnumNamed(enum_name: _, variant: _, fields: fs): any_field_pat_is_list(fs)
        case _: false

def any_pat_is_list(ps: List<Pattern>) -> bool =
    let mut found = false
    for p in ps:
        if pattern_is_list(p): found = true
    found

def any_field_pat_is_list(fs: List<(str, Pattern)>) -> bool =
    let mut found = false
    for f in fs:
        if pattern_is_list(f.1): found = true
    found

def scrut_is_list(t: IrType) -> bool =
    match t:
        case IrType.Named(path: p, args: _): p == "List" or p == "Vec" or p == "Tuple"
        case _: false

def any_arm_pat_is_list(arms: List<(Pattern, MaybeExpr, BlockIR)>) -> bool =
    let mut found = false
    for arm in arms:
        if pattern_is_list(arm.0): found = true
    found

def gen_match_arms(arms: List<(Pattern, MaybeExpr, BlockIR)>, fn_raises: MaybeIrType, user_fns: List[str], scrut_slice: bool, tbm: List[(str, List[(str, bool)])], vem: List[(str, List[(str, List[str])])]) -> String =
    let mut out: String = "".to_string()
    for idx in 0..arms.len():
        let arm = arms[idx].clone()
        out = out + gen_match_arm(arm, fn_raises, user_fns, scrut_slice, tbm, vem)
    out

// BUG-471（②）：`match xs.clone().as_slice() { [a, ..] => ... }` 里元素绑定 a 的类型是
// &T（slice 元素），而 LZ 侧 a 声明为 T；原生靠类型推断在**使用点**插
// `__implicit_from__(a.clone())`，rs-lz 无推断，需在臂体**开头**插 `let a = *a;`。
// 仅收集 List pattern 的直接 Ident 元素绑定（不含 Rest/嵌套）。
def list_elem_bindings(p: Pattern) -> List[str] =
    match p:
        case Pattern.List(elems: es) =>
            let mut out: List[str] = []
            for idx in 0..es.len():
                match es[idx]:
                    case Pattern.Ident(name: n) => out = out + [n]
                    case _ => ()
            out
        case _ => []

def gen_match_arm(arm: (Pattern, MaybeExpr, BlockIR), fn_raises: MaybeIrType, user_fns: List[str], scrut_slice: bool, tbm: List[(str, List[(str, bool)])], vem: List[(str, List[(str, List[str])])]) -> String =
    let pat = arm.0
    let gd = arm.1
    let blk = arm.2
    let pat_s = gen_pattern(pat)
    let gd_s = match gd:
        case MaybeExpr.YesExpr(v: vv) => " if ".to_string() + gen_expr(vv, MaybeIrType.NoTy, user_fns)
        case MaybeExpr.NoExpr => "".to_string()
    let blk_s = gen_value_block(blk, fn_raises, user_fns, tbm, vem)
    // BUG-471：slice scrutinee 时给元素绑定插解引用 let。
    // bindings 声明在函数级（LZ 块内声明不外泄），derefs 累积到臂体块内。
    // BUG-475：递归 enum/struct 的 Box 字段绑定同样需要解引用（`let n = *n;`），
    // 二者合并进同一 bindings 表，统一生成同形态解引用。
    let mut bindings: List[str] = (list_elem_bindings(pat) if scrut_slice else []) + boxed_bindings_of_pat(pat, tbm, vem)
    let mut derefs: String = "".to_string()
    for idx in 0..bindings.len():
        let bn1 = bindings[idx].clone()
        let bn2 = bindings[idx].clone()
        derefs = derefs + "    let " + bn1 + " = *" + bn2 + ";\n"
    // BUG-471：derefs 必须落在臂体块内（臂体形态 `pat => { prelude body }`），
    // 否则 `pat => let a = *a; { ... }` 非法（arm 后不能裸 let 语句）。
    let arm_body_s = ("{\n" + derefs + blk_s + "}\n") if bindings.len() > 0 else blk_s
    "    ".to_string() + pat_s + gd_s + " => ".to_string() + arm_body_s + ",\n".to_string()

// D2 缺口补齐：Pattern codegen（复用 display_pattern 的输出格式）
def gen_pattern(p: Pattern) -> String =
    match p:
        case Pattern.Wildcard => "_".to_string()
        case Pattern.Ident(name: n) => n
        case Pattern.RefMutIdent(name: n) => "ref mut ".to_string() + n
        case Pattern.LitInt(v: n) => n.to_string() + "_i64".to_string()
        case Pattern.LitStr(s: s) => "\"".to_string() + esc_rust(s) + "\"".to_string()
        case Pattern.LitBool(b: b) => b.to_string()
        case Pattern.LitF64(v: n) => n.to_string() + "_f64".to_string()
        case Pattern.Tuple(elems: es) => "(".to_string() + pat_list(es) + ")".to_string()
        case Pattern.List(elems: es) => "[".to_string() + pat_list(es) + "]".to_string()
        case Pattern.Struct(name: n, fields: fs) =>
            let mut fields_s: String = " { ".to_string()
            for idx in 0..fs.len():
                if idx > 0:
                    fields_s = fields_s + ", ".to_string()
                let f = fs[idx].clone()
                fields_s = fields_s + f.0 + ": ".to_string() + gen_pattern(f.1)
            fields_s + " }".to_string()
        case Pattern.Enum(enum_name: en, variant: v, args: a) => en + "::".to_string() + v + arg_pat_list(a)
        // BUG-421：命名字段变体 → struct pattern（`Shape::Circle { radius: r }`），
        // 对 struct variant 写元组 pattern 即 E0164。
        case Pattern.EnumNamed(enum_name: en, variant: v, fields: fs) =>
            let mut fields_s: String = " { ".to_string()
            for idx in 0..fs.len():
                if idx > 0:
                    fields_s = fields_s + ", ".to_string()
                let f = fs[idx].clone()
                fields_s = fields_s + f.0 + ": ".to_string() + gen_pattern(f.1)
            en + "::".to_string() + v + fields_s + " }".to_string()
        case Pattern.Rest(name: rn) =>
            // BUG-471：对齐原生 pattern_gen.rs:187-190——具名余项发 `rest @ ..`（@ 绑定）
            // 而非 `..rest`。后者是 Rust 1.83+ 的简写，工具链 rustc 报 E0425
            // cannot find value rest in this scope。
            match rn:
                case MaybeStr.YesStr(value: n2) => n2 + " @ ..".to_string()
                case MaybeStr.NoStr => "..".to_string()
        case Pattern.Range(start: st, end: en, inclusive: inc) =>
            st.to_string() + "_i64..".to_string() + en.to_string() + "_i64".to_string()

// D2 缺口补齐：BlockIR codegen
def gen_block(b: BlockIR, fn_raises: MaybeIrType, user_fns: List[str], tbm: List[(str, List[(str, bool)])], vem: List[(str, List[(str, List[str])])]) -> String =
    match b:
        case BlockIR.Block(stmts: ss, ty: t) =>
            if ss.len() == 0:
                String::new()
            else:
                // BUG-406：gen_block 用于 for/if/while/try/defer/match 分支等嵌套块，
                // 其尾表达式不是函数尾，不得发射 `return`。is_main=true 仅抑制 ExprStmt
                // 的尾 return，无其他副作用；函数体尾部仍由 gen_item 直接 gen_body。
                "{\n" + gen_body(ss, true, "".to_string(), fn_raises, user_fns, tbm, vem) + "}"

// BUG-420：**值位置块**——块的值就是尾表达式的值，尾 ExprStmt 不得带分号。
// gen_block 是语句位置块（尾表达式加分号、丢弃值），用于 for/if/while/try/defer；
// match 的分支体在「match 本身处于值位置」时必须用本函数，否则分支值被 `;` 丢弃
// （`def val(e) -> int = match e: case E2.A(x): x + 1` → 生成 `{ x + 1i64; }`
// → E0308 expected i64, found ()；原生产物为 `{ x + 1i64 }`）。
def gen_value_body(ss: List<Stmt>, fn_raises: MaybeIrType, user_fns: List[str], tbm: List[(str, List[(str, bool)])], vem: List[(str, List[(str, List[str])])]) -> String =
    let n = ss.len()
    let mut out: String = "".to_string()
    for idx in 0..n:
        let is_tail = (idx == n - 1)
        if is_tail:
            match ss[idx].clone():
                // 尾表达式：直出表达式、不加分号，块值即其值
                case Stmt.ExprStmt(expr: e) =>
                    out = out + "    ".to_string() + gen_expr(e, fn_raises, user_fns) + "\n".to_string()
                // 尾语句是 match/if/block 等：is_tail=true 让嵌套 match 走值位置形态
                case _ =>
                    out = out + "    ".to_string() + gen_stmt(ss[idx].clone(), true, true, "".to_string(), fn_raises, user_fns, tbm, vem) + "\n".to_string()
        else:
            out = out + "    ".to_string() + gen_stmt(ss[idx].clone(), false, true, "".to_string(), fn_raises, user_fns, tbm, vem) + "\n".to_string()
    out

def gen_value_block(b: BlockIR, fn_raises: MaybeIrType, user_fns: List[str], tbm: List[(str, List[(str, bool)])], vem: List[(str, List[(str, List[str])])]) -> String =
    match b:
        case BlockIR.Block(stmts: ss, ty: t) =>
            if ss.len() == 0:
                "{}".to_string()
            else:
                "{\n".to_string() + gen_value_body(ss, fn_raises, user_fns, tbm, vem) + "}".to_string()

// BUG-475 余项：递归 enum/struct 的 match 解构端，Box 字段绑定名须插 `let n = *n;`。
// 原生 stmt_gen.rs:2446「为递归枚举 Box 字段自动插入 let binding = *binding; 解引用」；
// rs-lz 无类型推断，需在 codegen_module 里**预计算**一份类型元信息：
//   tbm: (type_name, [(field_name, is_boxed)])            —— 字段盒化标记
//   vem: (enum_name, [(variant_name, [field_name...])])    —— 变体字段序（positional 用）
// 由于 LZ 无可变全局，二者须像 user_fns 一样作为参数穿透到 gen_stmt.Match。
// ────────────────────────────────────────────────────────────────────────────────────

// struct 与 enum 的字段盒化标记（type_name → [(field, is_boxed)])
def type_box_map(m: IrModule) -> List[(str, List[(str, bool)])] =
    let mut out: List[(str, List[(str, bool)])] = []
    // BUG-475：先 clone 再 match，避免 `match m.items[idx]` 的 E0507
    // （不能从 Vec 索引 move 出非 Copy 项）。
    for idx in 0..m.items.len():
        match m.items[idx].clone():
            case Item.EnumDef(name: en, generics: _, variants: vs) =>
                let mut flds: List[(str, bool)] = []
                for j in 0..vs.len():
                    let vf = vs[j].clone().1
                    for k in 0..vf.len():
                        flds = flds + [(vf[k].clone().0, field_needs_box(vf[k].clone().1, en))]
                out = out + [(en, flds)]
            case Item.StructDef(name: sn, generics: _, fields: fs) =>
                let mut flds: List[(str, bool)] = []
                for k in 0..fs.len():
                    flds = flds + [(fs[k].clone().0, field_needs_box(fs[k].clone().1, sn))]
                out = out + [(sn, flds)]
            case _ => ()
    out

// enum 变体字段序（enum_name → [(variant, [field...])])，供 positional Enum pattern
// 把位置实参映射到字段名。
def enum_variant_map(m: IrModule) -> List[(str, List[(str, List[str])])] =
    let mut out: List[(str, List[(str, List[str])])] = []
    for idx in 0..m.items.len():
        match m.items[idx].clone():
            case Item.EnumDef(name: en, generics: _, variants: vs) =>
                let mut vs_map: List[(str, List[str])] = []
                for j in 0..vs.len():
                    let v = vs[j].clone()
                    let mut names: List[str] = []
                    for k in 0..v.1.len():
                        names = names + [v.1[k].clone().0]
                    vs_map = vs_map + [(v.0, names)]
                out = out + [(en, vs_map)]
            case _ => ()
    out

def field_is_boxed(tbm: List[(str, List[(str, bool)])], type_name: str, field: str) -> bool =
    let mut found = false
    for idx in 0..tbm.len():
        if tbm[idx].clone().0 == type_name:
            let flds = tbm[idx].clone().1
            for j in 0..flds.len():
                if flds[j].clone().0 == field and flds[j].clone().1: found = true
    found

def variant_field_order(vem: List[(str, List[(str, List[str])])], enum_name: str, variant: str) -> List[str] =
    let mut out: List[str] = []
    for idx in 0..vem.len():
        if vem[idx].clone().0 == enum_name:
            let vs_map = vem[idx].clone().1
            for j in 0..vs_map.len():
                if vs_map[j].clone().0 == variant: out = vs_map[j].clone().1
    out

// BUG-475：从 pattern 收集「绑定名 → 字段名」对；positional Enum 用 vem 解字段序。
def pat_field_bindings(p: Pattern, vem: List[(str, List[(str, List[str])])]) -> List[(str, str)] =
    match p:
        case Pattern.EnumNamed(enum_name: en, variant: _, fields: fs) =>
            let mut out: List[(str, str)] = []
            for idx in 0..fs.len():
                let f = fs[idx].clone()
                match f.1:
                    case Pattern.Ident(name: bn) => out = out + [(bn, f.0)]
                    case _ => ()
            out
        case Pattern.Struct(name: _, fields: fs) =>
            let mut out: List[(str, str)] = []
            for idx in 0..fs.len():
                let f = fs[idx].clone()
                match f.1:
                    case Pattern.Ident(name: bn) => out = out + [(bn, f.0)]
                    case _ => ()
            out
        case Pattern.Enum(enum_name: en, variant: v, args: as_) =>
            let mut out: List[(str, str)] = []
            let names = variant_field_order(vem, en, v)
            for idx in 0..as_.len():
                match as_[idx].clone():
                    case Pattern.Ident(name: bn) =>
                        if idx < names.len():
                            out = out + [(bn, names[idx].clone())]
                    case _ => ()
            out
        case _ => []

// 收集本 pattern 下所有需 Box 解引用的绑定名（tbm 判定字段盒化）。
def boxed_bindings_of_pat(p: Pattern, tbm: List[(str, List[(str, bool)])], vem: List[(str, List[(str, List[str])])]) -> List[str] =
    let mut type_name: str = ""
    let pairs = pat_field_bindings(p, vem)
    match p:
        case Pattern.EnumNamed(enum_name: en, variant: _, fields: _) => type_name = en
        case Pattern.Struct(name: sn, fields: _) => type_name = sn
        case Pattern.Enum(enum_name: en, variant: _, args: _) => type_name = en
        case _ => ()
    let mut out: List[str] = []
    if type_name != "":
        for idx in 0..pairs.len():
            if field_is_boxed(tbm, type_name, pairs[idx].clone().1):
                out = out + [pairs[idx].clone().0]
    out

// ── IrType → Rust 类型 ──
def rust_type(t: IrType) -> String =
    match t:
        case IrType.Int => "i64".to_string()
        case IrType.F64 => "f64".to_string()
        case IrType.Str => "String".to_string()
        case IrType.Bool => "bool".to_string()
        case IrType.Unit => "()".to_string()
        case IrType.Never => "!".to_string()
        case IrType.Any => "i64".to_string()
        case IrType.Self_ => "Self".to_string()
        case IrType.Generic(name: g) => g.to_string()
        case IrType.Named(path: p, args: a) =>
            p + ("<" + type_rust_list(a) + ">" if a.len() > 0 else "")
        case IrType.Opt(inner: x) => "Option<" + rust_type(x) + ">".to_string()
        case IrType.Res(ok: o, err: e) => "Result<" + rust_type(o) + ", " + rust_type(e) + ">".to_string()
        case IrType.Tuple(elems: es) =>
            "(" + type_rust_list(es) + ")".to_string()
        case IrType.FnType(params: ps, ret: r) =>
            "fn(" + type_rust_list(ps) + ") -> " + rust_type(r)
        case IrType.Ref(inner: x) => "&".to_string() + rust_type(x)
        case IrType.MutRef(inner: x) => "&mut ".to_string() + rust_type(x)
        case IrType.Duck(fields: fs) =>
            "Box<dyn Any>".to_string()

def type_rust_list(ts: List<IrType>) -> String =
    if ts.len() == 0:
        "".to_string()
    else:
        let head = rust_type(ts[0].clone())
        if ts.len() > 1:
            head + ", ".to_string() + type_rust_list(tail_t(ts))
        else:
            head

// BUG-431：泛型形参表 → 名字表（struct/enum/自动 unapply 只用名字，对齐原生 `pub struct
// Box4<T>`；边界仅出现在 fn/impl/trait 上，见 generic_sig_b）。
def generic_sig(gs: List<(str, List<IrType>)>) -> String =
    if gs.len() == 0:
        "".to_string()
    else:
        let mut out: String = "<".to_string()
        for idx in 0..gs.len():
            if idx > 0:
                out = out + ", ".to_string()
            out = out + gs[idx].clone().0
        out + ">".to_string()

def str_join(xs: List<str>) -> String =
    if xs.len() == 0:
        "".to_string()
    else:
        let head = xs[0].clone()
        if xs.len() > 1:
            head + ", ".to_string() + str_join(aj_tail(xs))
        else:
            head

// ── TryCatch Result 基检测与类型推断（对齐原生 codegen/mod.rs:8724-8774）──
// 本轮纯新增，不接入 gen_stmt 主流程；为下一轮 Result 基实现打基础

def is_result_ctor(e: Expr) -> bool =
    match e:
        case Expr.Call(callee: c, args: a, ty: t) =>
            match c:
                case Expr.Var(name: n, ty: t2) => n == "Ok" || n == "Err"
                case _ => false
        case Expr.EnumCtor(enum_name: en, variant: v, args: a, ty: t) =>
            en == "Result" && (v == "Ok" || v == "Err")
        case _ => false

def block_tail_expr(b: BlockIR) -> MaybeExpr =
    match b:
        case BlockIR.Block(stmts: ss, ty: t) =>
            let mut result: MaybeExpr = MaybeExpr.NoExpr
            for si in 0..ss.len():
                match ss[si].clone():
                    case Stmt.ExprStmt(expr: e) => result = MaybeExpr.YesExpr(value: e)
                    case _ => ()
            result

def is_res_type(t: IrType) -> bool =
    match t:
        case IrType.Res(ok: o, err: e) => true
        case _ => false

def scan_result_let(ss: List<Stmt>) -> bool =
    let mut found: bool = false
    for si in 0..ss.len():
        match ss[si].clone():
            case Stmt.Let(name: n, ty: t, value: v, is_mut: m, is_ref: r) =>
                if is_res_type(t) && !is_result_ctor(v):
                    found = true
            case Stmt.ExprStmt(expr: e) =>
                if is_res_type(expr_ty(e)) && !is_result_ctor(e):
                    found = true
            case _ => ()
    found

def is_result_body(b: BlockIR) -> bool =
    match b:
        case BlockIR.Block(stmts: ss, ty: t) =>
            let tail = block_tail_expr(b)
            let tail_is_ctor = match tail:
                case MaybeExpr.YesExpr(value: e) => is_result_ctor(e)
                case _ => false
            let rule1 = is_res_type(t) && !tail_is_ctor
            if rule1:
                true
            else:
                scan_result_let(ss)

def scan_result_ty(ss: List<Stmt>) -> MaybeIrType =
    let mut result: MaybeIrType = MaybeIrType.NoTy
    for si in 0..ss.len():
        match ss[si].clone():
            case Stmt.Let(name: n, ty: t, value: v, is_mut: m, is_ref: r) =>
                match result:
                    case MaybeIrType.NoTy =>
                        match t:
                            case IrType.Res(ok: o, err: e) => result = MaybeIrType.YesTy(value: IrType.Res(ok: o, err: e))
                            case _ => ()
                    case _ => ()
            case Stmt.ExprStmt(expr: e) =>
                match result:
                    case MaybeIrType.NoTy =>
                        match expr_ty(e):
                            case IrType.Res(ok: o, err: e) => result = MaybeIrType.YesTy(value: IrType.Res(ok: o, err: e))
                            case _ => ()
                    case _ => ()
            case _ => ()
    result

def result_ty_from_body(b: BlockIR) -> MaybeIrType =
    match b:
        case BlockIR.Block(stmts: ss, ty: t) =>
            match t:
                case IrType.Res(ok: o, err: e) => MaybeIrType.YesTy(value: IrType.Res(ok: o, err: e))
                case _ => scan_result_ty(ss)

// ── expr_ty：Expr → IrType（统一类型访问器，对齐原生 expr.ty）──
// 31 变体逐一提取 ty 字段；为 TryCatch Result 基规则2 完整扫描（含 ExprStmt）打基础
def expr_ty(e: Expr) -> IrType =
    match e:
        case Expr.LitInt(v: _, ty: t) => t
        case Expr.LitF64(v: _, ty: t) => t
        case Expr.LitStr(s: _, ty: t) => t
        case Expr.LitFStr(s: _, ty: t) => t
        case Expr.LitBool(b: _, ty: t) => t
        case Expr.LitUnit(ty: t) => t
        case Expr.LitNone(ty: t) => t
        case Expr.Var(name: _, ty: t) => t
        case Expr.Call(callee: _, args: _, ty: t) => t
        case Expr.MethodCall(receiver: _, method: _, args: _, ty: t) => t
        case Expr.FieldAccess(base: _, field: _, ty: t) => t
        case Expr.IndexGet(base: _, key: _, ty: t) => t
        case Expr.IndexSet(base: _, key: _, value: _, ty: t) => t
        case Expr.BinOp(op: _, lhs: _, rhs: _, ty: t) => t
        case Expr.UnOp(op: _, operand: _, ty: t) => t
        case Expr.StructCtor(name: _, fields: _, ty: t) => t
        case Expr.EnumCtor(enum_name: _, variant: _, args: _, ty: t) => t
        case Expr.EnumFieldGet(base: _, enum_name: _, variants: _, field: _, ty: t) => t
        case Expr.Cast(inner: _, target: _, ty: t) => t
        case Expr.MagicCall(magic: _, args: _, ty: t) => t
        case Expr.IfExpr(cond: _, then: _, els: _, ty: t) => t
        case Expr.Lambda(params: _, body: _, ty: t) => t
        case Expr.Pipe(receiver: _, callee: _, args: _, ty: t) => t
        case Expr.TupleLit(elems: _, ty: t) => t
        case Expr.ListLit(items: _, ty: t) => t
        case Expr.BlockExpr(stmts: _, ty: t) => t
        case Expr.GenExpr(yield_of: _, ty: t) => t
        case Expr.Paren(inner: _, ty: t) => t
        case Expr.Range(end: _, inclusive: _, ty: t) => t
        case Expr.Dict(pairs: _, ty: t) => t
        case Expr.AssignExpr(target: _, value: _, ty: t) => t
        case Expr.ImplicitConvert(source: _, target_ty: _, ty: t) => t

// ── Expr → Rust 表达式（无 [ty] 前缀）──
// BUG-429：元组按值构造时，同一非 Copy 变量若在**后续**元素里还会被引用，
// 前面的裸引用会先把它 move 走 ⇒ E0382（`(k, k.len())`，推导值 lambda 实测 c8/c6）。
// 口径对齐原生 BUG-415：除最后一次出现外补 `.clone()`；显式排除 self；
// 已知 Copy 标量（Int/F64/Bool）不加 clone。
def gen_tuple_lit(es: List<Expr>, fn_raises: MaybeIrType, user_fns: List[str]) -> String =
    let mut parts: String = "".to_string()
    for i in 0..es.len():
        if i > 0:
            parts = parts + ", ".to_string()
        parts = parts + gen_tuple_elem(es[i].clone(), es, i, fn_raises, user_fns)
    "(".to_string() + parts + ")".to_string()

def gen_tuple_elem(e: Expr, es: List<Expr>, i: int, fn_raises: MaybeIrType, user_fns: List[str]) -> String =
    match e:
        case Expr.Var(name: n, ty: t) =>
            if n != "self" and is_noncopy_irtype(t) and name_used_later(n, es, i + 1):
                gen_expr(e, fn_raises, user_fns) + ".clone()".to_string()
            else:
                gen_expr(e, fn_raises, user_fns)
        case _ => gen_expr(e, fn_raises, user_fns)

def name_used_later(n: str, es: List<Expr>, start: int) -> bool =
    let mut found: bool = false
    for i in start..es.len():
        if expr_has_var(es[i].clone(), n):
            found = true
    found

def is_noncopy_irtype(t: IrType) -> bool =
    match t:
        case IrType.Int => false
        case IrType.F64 => false
        case IrType.Bool => false
        case _ => true

// 递归查名字（覆盖常用 Expr 变体；未覆盖的保守返回 false，即不补 clone）
def expr_has_var(e: Expr, n: str) -> bool =
    match e:
        case Expr.Var(name: vn, ty: t) => vn == n
        case Expr.MethodCall(receiver: r, method: m, args: a, ty: t) =>
            expr_has_var(r, n) || any_expr_has_var(a, n)
        case Expr.Call(callee: c, args: a, ty: t) => expr_has_var(c, n) || any_expr_has_var(a, n)
        case Expr.FieldAccess(base: b, field: f, ty: t) => expr_has_var(b, n)
        case Expr.IndexGet(base: b, key: k, ty: t) => expr_has_var(b, n) || expr_has_var(k, n)
        case Expr.IndexSet(base: b, key: k, value: v, ty: t) =>
            expr_has_var(b, n) || expr_has_var(k, n) || expr_has_var(v, n)
        case Expr.BinOp(op: o, lhs: l, rhs: r, ty: t) => expr_has_var(l, n) || expr_has_var(r, n)
        case Expr.UnOp(op: o, operand: p, ty: t) => expr_has_var(p, n)
        case Expr.TupleLit(elems: es, ty: t) => any_expr_has_var(es, n)
        case Expr.ListLit(items: xs, ty: t) => any_expr_has_var(xs, n)
        case Expr.Cast(inner: i, target: tg, ty: t) => expr_has_var(i, n)
        case Expr.Paren(inner: i, ty: t) => expr_has_var(i, n)
        case Expr.IfExpr(cond: c, then: th, els: el, ty: t) =>
            expr_has_var(c, n) || expr_has_var(th, n) || expr_has_var(el, n)
        case Expr.StructCtor(name: sn, fields: fs, ty: t) => struct_fields_have_var(fs, n)
        case _ => false

def any_expr_has_var(es: List<Expr>, n: str) -> bool =
    let mut found: bool = false
    for i in 0..es.len():
        if expr_has_var(es[i].clone(), n):
            found = true
    found

def struct_fields_have_var(fs: List<(str, Expr)>, n: str) -> bool =
    let mut found: bool = false
    for i in 0..fs.len():
        let f = fs[i].clone()
        if expr_has_var(f.1, n):
            found = true
    found

def gen_expr(e: Expr, fn_raises: MaybeIrType, user_fns: List[str]) -> String =
    match e:
        case Expr.LitInt(v: n, ty: t) => n.to_string() + "i64".to_string()
        case Expr.LitF64(v: n, ty: t) => fmt_f64(n).to_string()
        case Expr.LitStr(s: s, ty: t) => "\"".to_string() + esc_rust(s) + "\".to_string()".to_string()
        case Expr.LitFStr(s: s, ty: t) => gen_fstring(s).to_string()
        case Expr.LitBool(b: b, ty: t) => b.to_string()
        case Expr.LitUnit(ty: t) => "()".to_string()
        case Expr.LitNone(ty: t) => "None".to_string()
        case Expr.Var(name: n, ty: t) => n.to_string()
        case Expr.Call(callee: c, args: a, ty: t) => gen_call(c, a, t, fn_raises, user_fns).to_string()
        case Expr.MethodCall(receiver: r, method: m, args: a, ty: t) => gen_method_call(r, m, a, t, fn_raises, user_fns)
        case Expr.FieldAccess(base: b, field: f, ty: t) =>
            // BUG-423：基底是**类型名**时须用路径分隔符——`Light.On`（单位变体引用）
            // 在 Rust 应为 `Light::On`，用 `.` 即 E0423 expected value, found enum。
            // 与 BUG-405（方法调用侧）同口径：Var 且首字母大写视为类型名。
            // BUG-457：`self.<field>` 从 &self 借引用读取，非 Copy 字段须 `.clone()`
            // 才能取得所有权（否则 E0507 cannot move out of ... behind a shared
            // reference）。原生在 expr_gen.rs「self 参数修饰」下对 base 为 self 的
            // 字段访问一律补 `.clone()`（其 is_scalar 分支仅在 self 本身是标量时
            // 免克隆，对 struct 接收者恒不命中）。方法接收者不套此规则（见
            // gen_recv_place，避免 `self.items.push(x)` 推到临时值）。
            gen_expr(b, fn_raises, user_fns) + field_access_sep(b) + f.to_string() + (".clone()" if is_self_var(b) else "")
        case Expr.IndexGet(base: b, key: k, ty: t) =>
            // BUG-447：Rust 的 `Vec<T>`/切片下标须 `usize`，LZ 索引表达式是 `int`(i64)。
            // rs-lz 此前透传 `xs[0i64]` → E0277 cannot be indexed by `i64`；原生渲染
            // `xs[0i64 as usize]`。Dict 的下标是键（见 BUG-448），不套 usize 转换。
            if is_dict_irtype(expr_ty(b)):
                // BUG-448：原生对 Dict 的下标**不用** Rust 下标运算符（BTreeMap 的 Index
                // 实现与 LZ 键类型口径不同），而是渲染 `(d).get(&"a".to_string()).cloned().unwrap()`：
                // 键按值持有（`&<dict_insert_key_arg>`），再 .cloned() 取值。rs-lz 此前透传
                // `d["a".to_string()]` → E0308 mismatched types。
                "(".to_string() + gen_expr(b, fn_raises, user_fns) + ").get(&".to_string() + dict_insert_key_arg(k, fn_raises, user_fns) + ").cloned().unwrap()".to_string()
            else:
                gen_expr(b, fn_raises, user_fns) + "[".to_string() + gen_expr(k, fn_raises, user_fns) + " as usize]".to_string()
        case Expr.IndexSet(base: b, key: k, value: v, ty: t) => gen_expr(b, fn_raises, user_fns) + "[".to_string() + gen_expr(k, fn_raises, user_fns) + "] = ".to_string() + gen_expr(v, fn_raises, user_fns)
        case Expr.BinOp(op: o, lhs: l, rhs: r, ty: t) =>
            // BUG-459：`in`/`not in` 成员测试。Rust 无 `in` 运算符，rs-lz 旧实现透传
            // `4i64 in s` → rustc `expected '{', found keyword 'in'`。对齐原生
            // expr_gen.rs:5770-5816 四路 oracle：String → `.contains()`；Dict →
            // `.contains_key(&elem)`；List/Set/其余 → `.contains(&elem)`；`not in` 前缀 `!`。
            // String 实参统一 `&*(elem)`（字面量 &str / String 值均解引用到 &str，char 不
            // 走此分支由类型判据兜住），运行时与原生等价。
            if o == "in" or o == "not in" or o == "not_in":
                // BUG-459：`in`/`not in` 成员测试。Rust 无 `in` 运算符，rs-lz 旧实现透传
                // `4i64 in s` → rustc `expected '{', found keyword 'in'`。对齐原生
                // expr_gen.rs:5770-5816 四路 oracle：String → `.contains()`；Dict →
                // `.contains_key(&elem)`；List/Set/其余 → `.contains(&elem)`；`not in` 前缀 `!`。
                // String 实参统一 `&*(elem)`（字面量 &str / String 值均解引用到 &str，char 不
                // 走此分支由类型判据兜住），运行时与原生等价。
                let not_prefix = ("!" if (o == "not in" or o == "not_in") else "").to_string()
                let cont_s = gen_expr(r, fn_raises, user_fns)
                let elem_s = gen_expr(l, fn_raises, user_fns)
                if is_string_irtype(expr_ty(r)):
                    if is_string_irtype(expr_ty(l)):
                        not_prefix + cont_s + ".contains(&*(".to_string() + elem_s + "))".to_string()
                    else:
                        not_prefix + cont_s + ".contains(".to_string() + elem_s + ")".to_string()
                elif is_dict_irtype(expr_ty(r)):
                    not_prefix + cont_s + ".contains_key(&".to_string() + elem_s + ")".to_string()
                else:
                    not_prefix + cont_s + ".contains(&".to_string() + elem_s + ")".to_string()
            elif o == "+" and is_string_irtype(expr_ty(l)) and is_string_irtype(expr_ty(r)):
                // BUG-423：字符串拼接 `a + b` 在 Rust 需 `String + &str`（String + String
                // 无 Add impl → E0308 expected `&str`, found `String`）。两侧均为字符串
                // 类型时右侧补 `&`，对齐原生 `"hi ".to_string() + &x.clone()` 口径。
                gen_expr(l, fn_raises, user_fns) + " + &".to_string() + gen_expr(r, fn_raises, user_fns)
            else:
                gen_expr(l, fn_raises, user_fns) + " ".to_string() + o.to_string() + " ".to_string() + gen_expr(r, fn_raises, user_fns)
        case Expr.UnOp(op: o, operand: p, ty: t) => o.to_string() + gen_expr(p, fn_raises, user_fns)
        case Expr.StructCtor(name: n, fields: fs, ty: t) =>
            if n == "Range":
                gen_range_ctor(fs, user_fns)
            elif n == "Dict":
                gen_dict_ctor(fs, user_fns)
            else:
                n.to_string() + " { ".to_string() + ctor_fields_boxed(fs, n, fn_raises, user_fns) + " }".to_string()
        case Expr.EnumCtor(enum_name: en, variant: v, args: a, ty: t) =>
            // BUG-411：三种变体形态（对齐原生 decl_gen.rs:2005 + expr_gen.rs:1654/1662）
            //   单位变体（无数据）      → `Enum::Variant`（Rust 单位变体不是函数，带 () 即 E0618）
            //   命名字段变体（_KwArg）  → `Enum::Variant { f: v, ... }`
            //   元组变体                → `Enum::Variant(t, t)`
            // BUG-475：递归字段的值按 expr_ty 判同名即 `Box::new(...)` 包装
            //（对齐原生构造端 `l: Box::new(Tree::Leaf{..})`）。
            if a.len() == 0:
                en.to_string() + "::".to_string() + v.to_string()
            elif all_kwarg_args(a):
                en.to_string() + "::".to_string() + v.to_string() + " { ".to_string() + kwarg_pairs_str_boxed(a, en, fn_raises, user_fns) + " }".to_string()
            else:
                en.to_string() + "::".to_string() + v.to_string() + "(".to_string() + expr_cs_list_boxed(a, en, fn_raises, user_fns) + ")".to_string()
        case Expr.EnumFieldGet(base: b, enum_name: en, variants: vs, field: f, ty: t) =>
            "match &".to_string() + gen_expr(b, fn_raises, user_fns) + " { ".to_string() + enum_field_arms(en, vs, f) + "_ => unreachable!() }".to_string()
        case Expr.Cast(inner: i, target: tg, ty: t) => "(".to_string() + gen_expr(i, fn_raises, user_fns) + " as ".to_string() + rust_type(tg).to_string() + ")".to_string()
        case Expr.MagicCall(magic: m, args: a, ty: t) => m.to_string() + "(".to_string() + expr_cs_list(a, fn_raises, user_fns) + ")".to_string()
        case Expr.IfExpr(cond: c, then: th, els: el, ty: t) => "if ".to_string() + gen_expr(c, fn_raises, user_fns) + " { ".to_string() + gen_expr(th, fn_raises, user_fns) + " } else { ".to_string() + gen_expr(el, fn_raises, user_fns) + " }".to_string()
        case Expr.Lambda(params: ps, body: b, ty: t) => "move |".to_string() + str_join(ps).to_string() + "| ".to_string() + gen_expr(b, fn_raises, user_fns)
        case Expr.Pipe(receiver: r, callee: c, args: a, ty: t) => gen_expr(r, fn_raises, user_fns) + ".".to_string() + gen_expr(c, fn_raises, user_fns) + "(".to_string() + expr_cs_list(a, fn_raises, user_fns) + ")".to_string()
        case Expr.TupleLit(elems: es, ty: t) => gen_tuple_lit(es, fn_raises, user_fns)
        case Expr.ListLit(items: xs, ty: t) =>
            // BUG-426：LZ 列表字面量必须发 `vec![…]`——Rust 数组 `[…]` 的类型是
            // `[T; N]`，与 LZ 的 List<T>（Rust `Vec<T>`）不符 ⇒ E0308 expected Vec<T>,
            // found [T; N]；空列表发 `Vec::new()`（对齐原生）。
            if xs.len() == 0:
                "Vec::new()".to_string()
            else:
                "vec![".to_string() + expr_cs_list(xs, fn_raises, user_fns) + "]".to_string()
        case Expr.BlockExpr(stmts: ss, ty: t) => "{\n".to_string() + gen_body(ss, true, "".to_string(), fn_raises, user_fns, [], []) + "}"
        case Expr.GenExpr(yield_of: y, ty: t) => "gen ".to_string() + gen_expr(y, fn_raises, user_fns)
        case Expr.Paren(inner: i, ty: t) => "(".to_string() + gen_expr(i, fn_raises, user_fns) + ")".to_string()
        case Expr.Range(end: en, inclusive: inc, ty: t) => "0_i64..".to_string() + gen_expr(en, fn_raises, user_fns)
        case Expr.Dict(pairs: ps, ty: t) => "std::collections::BTreeMap::new()".to_string()
        case Expr.AssignExpr(target: tg, value: v, ty: t) =>
            // BUG-458：赋值目标按 place 发射（免 `.clone()`），否则 `self.n = self.n + 1`
            // 被渲染成 `self.n.clone() = self.n.clone() + 1i64` → E0070（赋给临时值）。
            gen_recv_place(tg, fn_raises, user_fns) + " = ".to_string() + gen_expr(v, fn_raises, user_fns)
        case Expr.ImplicitConvert(source: s, target_ty: tt, ty: t) => gen_expr(s, fn_raises, user_fns)
        case _ => "unimplemented!".to_string()

// ── display 辅助函数 ──
def display_item(i: Item) -> String =
    match i:
        case Item.FnDef(name: n, generics: gs, params: ps, ret: r, exc: _rs, where_clause: wc, body: b) => "fn ".to_string() + n
        case Item.Const(name: n, ty: t, value: v) => "const ".to_string() + n
        case Item.StructDef(name: n, generics: gs, fields: fs) => "struct ".to_string() + n
        case Item.EnumDef(name: n, generics: gs, variants: vs) => "enum ".to_string() + n
        case Item.TraitDef(name: n, generics: gs, supertraits: sts, assoc_types: ats, methods: ms) => "trait ".to_string() + n
        case Item.DuckDef(name: n, method_count: mc) => "duck ".to_string() + n
        case Item.UseStmt(path: pth, alias: al, items: its, is_from: fr) => "use ".to_string() + str_join(pth)
        case Item.TypeAlias(name: n, ty: t) => "type ".to_string() + n
        case Item.Impl(trait_: tr, for_type: ft, generics: gs, where_clause: wc, assoc_type_bindings: atb, methods: mns) => "impl ".to_string() + rust_type(ft)
        case Item.CheckerBlock(name: n, ps_name: p) => "checker ".to_string() + n
        case Item.Test(name: n, body: b) => "test ".to_string() + n
        case _ => "item".to_string()

def opt_debug(p: MaybeStr) -> String =
    match p:
        case MaybeStr.YesStr(value: v) => v
        case MaybeStr.NoStr => "".to_string()

def block_disp(b: BlockIR) -> String =
    match b:
        case BlockIR.Block(stmts: ss, ty: t) =>
            "{\n".to_string() + block_with_ty(ss, t) + "}".to_string()

def stmt_block(ss: List<Stmt>) -> String =
    if ss.len() == 0:
        "{}".to_string()
    else:
        let mut out: String = "{\n".to_string()
        for idx in 0..ss.len():
            out = out + display_stmt(ss[idx].clone()) + "\n".to_string()
        out + "}".to_string()

def match_block(s: Expr, arms: List<(Pattern, MaybeExpr, BlockIR)>) -> String =
    let mut out: String = "match ".to_string() + display_expr(s) + " {\n".to_string()
    for idx in 0..arms.len():
        let arm = arms[idx].clone()
        let pat_s = display_pattern(arm.0)
        let gd_s = match arm.1:
            case MaybeExpr.YesExpr(v: vv) => " if ".to_string() + display_expr(vv)
            case MaybeExpr.NoExpr => "".to_string()
        let blk_s = block_disp(arm.2)
        out = out + "    ".to_string() + pat_s + gd_s + " => ".to_string() + blk_s + ",\n".to_string()
    out + "}".to_string()

def block_with_ty(ss: List<Stmt>, ty: IrType) -> String =
    if ss.len() == 0:
        "".to_string()
    else:
        let mut out: String = "".to_string()
        for idx in 0..ss.len():
            out = out + display_stmt(ss[idx].clone()) + "\n".to_string()
        out

// ── 其他辅助函数 ──
def base_is_dict(b: Expr) -> bool =
    match b:
        case Expr.Var(name: n, ty: t) =>
            match t:
                case IrType.Named(path: p, args: a) => p == "Dict" || p == "HashMap"
                case _ => false
        case _ => false

// Range 构造：fields 可能含 start/end/inclusive（IR 中 `0..10` 被 builder 转为
// StructCtor(name="Range")，原生 codegen 渲染 `0i64..10i64` / `0i64..=9i64`）
def gen_range_ctor(fs: List<(str, Expr)>, user_fns: List[str]) -> String =
    let mut start_s: String = "".to_string()
    let mut end_s: String = "".to_string()
    let mut incl = false
    for idx in 0..fs.len():
        let f = fs[idx].clone()
        if f.0 == "start":
            start_s = gen_expr(f.1, MaybeIrType.NoTy, user_fns)
        elif f.0 == "end":
            end_s = gen_expr(f.1, MaybeIrType.NoTy, user_fns)
        elif f.0 == "inclusive":
            match f.1:
                case Expr.LitBool(b: bv, ty: tv) => incl = bv
                case _ => incl = incl
    start_s + (if incl: "..=".to_string() else: "..".to_string()) + end_s

// Dict 构造：IR 用 StructCtor(name="Dict", fields=[(_k0, v), (_v0, v), ...]) 表示字典字面量，
// 原生 codegen 渲染 std::collections::BTreeMap::from([(k, v), ...])；空字典 BTreeMap::new()
// （BUG-452：空字典 `{}` 此前误发 HashMap::new()，而 Dict 别名 = BTreeMap ⇒ E0308）。
def gen_dict_ctor(fs: List<(str, Expr)>, user_fns: List[str]) -> String =
    if fs.len() == 0:
        "std::collections::BTreeMap::new()".to_string()
    else:
        let mut pairs: String = "".to_string()
        let mut i = 0
        while i + 1 < fs.len():
            let k = fs[i].clone()
            let v = fs[i + 1].clone()
            pairs = pairs + "(".to_string() + gen_expr(k.1, MaybeIrType.NoTy, user_fns) + ", ".to_string() + gen_expr(v.1, MaybeIrType.NoTy, user_fns) + ")".to_string()
            if i + 2 < fs.len():
                pairs = pairs + ", ".to_string()
            i = i + 2
        // BUG-427：字典字面量必须有**具体类型**——`[…].into_iter().collect()` 缺目标
        // 类型 ⇒ E0282 type annotations needed（后续 `d.keys()` 处报出）。对齐原生
        // `std::collections::BTreeMap::from([...])`。
        "std::collections::BTreeMap::from([".to_string() + pairs + "])".to_string()

// BUG-405：类型名上的方法调用须用路径分隔符（`Color::Blue` / `Option::None`），
// 值接收者才用 `.`（`x.clone()`）。原生按 is_known_type_or_enum 判定，LZ 侧无类型
// 注册表，改用「接收者是 Var 且首字母大写」的等价约定（类型名大写、值变量小写）。
def method_call_sep(r: Expr) -> String =
    match r:
        case Expr.Var(name: n, ty: t2) =>
            if starts_upper(n):
                "::".to_string()
            else:
                ".".to_string()
        case _ => ".".to_string()

// BUG-424：内建方法形态改写（**str 子集**，对齐原生 expr_gen.rs 的改名表/形态适配）——
//   ① 改名：length→len、to_lower/lower→to_lowercase、to_upper/upper→to_uppercase、
//      Dict/HashMap 上的 contains→contains_key
//   ② 模式实参：split/starts_with/ends_with/replace/find/rfind（以及 str 上的 contains）
//      的 str 字面量必须发**裸字面量**——Rust 的 Pattern 由 &str 实现，`.to_string()`
//      得到的 String 不实现 ⇒ E0277 the trait bound `String: Pattern` is not satisfied
//   ③ 返回 String 的方法（trim/trim_start/trim_end/replace）按 LZ str 语义补
//      `.to_string()`（对齐原生 `s.trim().to_string()`）
// 未覆盖（另立条目）：集合迭代适配（map/filter/fold/keys/values/join/sorted…）
// 需要 `.into_iter()/.collect()` 形态改写，属同一张表的另一半。
def is_self_var(b: Expr) -> bool =
    match b:
        case Expr.Var(name: n, ty: t2) => n == "self"
        case _ => false

// BUG-457：方法接收者若是 `self.<field>`（place），不可套用「self 字段读取克隆」规则，
// 否则 `self.items.push(x)` 会被渲染成 `self.items.clone().push(x)` —— push 到一个临时
// Vec 上，数据丢失（结果与原生产物分叉）。原生 codegen 对方法接收者按 place 直发
// （expr_gen.rs 的 self 字段 clone 规则仅作用于纯字段读取表达式）。此处对
// FieldAccess 接收者走免克隆路径。
def gen_recv_place(r: Expr, fn_raises: MaybeIrType, user_fns: List[str]) -> String =
    match r:
        case Expr.FieldAccess(base: b, field: f, ty: t) =>
            // BUG-457：base 递归走 gen_recv_place，使 `self.outer.inner.push(x)` 也不克隆。
            // 原生 expr_gen.rs 用字符串 `trim_end_matches(".clone()")` 处理任意嵌套，这里
            // 用结构化递归等价对齐；非 FieldAccess 的 base 退回 gen_expr（保持原有语义）。
            gen_recv_place(b, fn_raises, user_fns) + field_access_sep(b) + f.to_string()
        case Expr.IndexGet(base: b, key: k, ty: t) =>
            // BUG-460：`self.items[0] = x` 的赋值目标须按 place 发射。IndexGet 若透传
            // gen_expr，其 base 是 `self.<field>` 时会套「字段读取克隆」规则 →
            // `self.items.clone()[0i64 as usize] = x` 赋到临时值，数据丢失
            // （g85_self_index_assign 实测 NATIVE 9 / RSLZ 1）。此处 base 递归走
            // gen_recv_place。Dict 下标是 `.get().unwrap()` 形态（非 place，见 BUG-448），
            // 且 Dict 赋值走 `.insert()`（Stmt.Assign dict 分支），故仅处理非 dict 下标。
            if is_dict_irtype(expr_ty(b)):
                gen_expr(r, fn_raises, user_fns)
            else:
                gen_recv_place(b, fn_raises, user_fns) + "[".to_string() + gen_expr(k, fn_raises, user_fns) + " as usize]".to_string()
        case _ => gen_expr(r, fn_raises, user_fns)

// NATIVE-BUG 对齐（dict 自字段插入被克隆）：嵌套 dict 链的写目标须用 `.get_mut().unwrap()`
// 拿到外层 dict 的可变引用，否则 `self.settings["theme"]["color"] = c` 被渲染成
// `(self.settings.get(&"theme").cloned().unwrap()).insert(...)` —— insert 落在克隆的内层
// dict 上，原 dict 未变（g463 实测 rs-lz 输出 red / native 输出 blue）。原生
// stmt_gen.rs 的 Assign dict 分支用 `({base}).get_mut(&k).unwrap()` 处理同款嵌套链。
def gen_dict_place(r: Expr, user_fns: List[str]) -> String =
    match r:
        case Expr.IndexGet(base: b, key: k, ty: t) =>
            if is_dict_irtype(expr_ty(b)):
                "(".to_string() + gen_dict_place(b, user_fns) + ").get_mut(&".to_string() + gen_expr(k, MaybeIrType.NoTy, user_fns) + ").unwrap()".to_string()
            else:
                gen_recv_place(r, MaybeIrType.NoTy, user_fns)
        case _ => gen_recv_place(r, MaybeIrType.NoTy, user_fns)

def gen_method_call(r: Expr, m: str, a: List[Expr], t: IrType, fn_raises: MaybeIrType, user_fns: List[str]) -> String =
    let recv0 = gen_recv_place(r, fn_raises, user_fns)
    // BUG-428：LZ 的 `.len()` 返回 int（i64），Rust 的 `len()` 是 usize ⇒ 必须补 `as i64`，
    // 否则与 i64 比较/赋值处 E0308（`k.len() > 1i64`；与自由函数 len(x) 同口径）。
    if (m == "len") || (m == "length"):
        "(".to_string() + recv0 + ".len() as i64)".to_string()
    elif m == "sum" and a.len() == 0 and is_list_irtype(expr_ty(r)):
        // BUG-435：`.sum()` 方法在 Vec/List 上不存在（原生 codegen 渲染
        // `(a).iter().copied().sum::<i64>()`，rs-lz 此前落进通用方法分支直接发
        // `a.sum()` → E0599 no method named `sum` found for struct `Vec<i64>`）。
        // 与自由函数 `sum(x)`（BUG-430）同口径，此处补方法形态以对齐原生逐字符。
        // BUG-455：**仅当接收者是 List/Vec** 才走集合归约；自定义 struct 上的同名
        // `sum` 方法（如 Point::sum）不得被集合 sum 劫持（此前 `p.sum()` 被渲染成
        // `(p).iter().copied().sum::<i64>()` → E0599 iter 不存在）。原生在
        // expr_gen.rs:4886-4911 对非 list 接收者回退到 `({recv}).{method}()`。
        "(".to_string() + recv0 + ").iter().copied().sum::<i64>()".to_string()
    elif m == "min" and a.len() == 0 and is_list_irtype(expr_ty(r)):
        "(".to_string() + recv0 + ").iter().min().cloned()".to_string()
    elif m == "max" and a.len() == 0 and is_list_irtype(expr_ty(r)):
        "(".to_string() + recv0 + ").iter().max().cloned()".to_string()
    elif m == "sorted" and a.len() == 0 and is_list_irtype(expr_ty(r)):
        // BUG-438：Rust std 无 `Vec::sorted` → E0599；lz_builtins 提供自由函数
        // `sorted(impl IntoIterator<Item=T>) -> Vec<T>`（builtins.rs），原生渲染
        // `sorted(v.clone())`（clone 保留接收者所有权，LZ 值语义）。rs-lz 此前透传
        // `v.sorted()` → E0599。
        "sorted(".to_string() + recv0 + ".clone())".to_string()
    elif m == "reversed" and a.len() == 0 and is_list_irtype(expr_ty(r)):
        // BUG-438 同族：`Vec::reversed` 不存在 → E0599；lz_builtins::reversed(IntoIterator)。
        "reversed(".to_string() + recv0 + ".clone())".to_string()
    elif m == "to_list" and a.len() == 0 and (is_list_irtype(expr_ty(r)) or is_iterator_irtype(expr_ty(r))):
        // BUG-438 同族：`.to_list()` 在迭代器链（`v.iter().cloned()`）上直发
        // `.to_list()` → E0599 no method named `to_list` on Cloned<I>；应为
        // `.collect::<Vec<_>>()`。List/Vec 接收者已是 Vec，返回 clone（非消费）。
        // 自定义 struct 上的同名 `to_list`（如 LinkedList::to_list）不满足上方守卫，
        // 自然落通用方法分支（FIND_BUG/lib_linked_list 实测）。
        if is_list_irtype(expr_ty(r)):
            "(".to_string() + recv0 + ").clone()".to_string()
        else:
            "(".to_string() + recv0 + ").collect::<Vec<_>>()".to_string()
    elif m == "iter" and a.len() == 0 and is_list_irtype(expr_ty(r)):
        // BUG-438 同族：LZ `v.iter()` 值语义产 owned 元素，但 rs-lz 透传 `v.iter()`
        // 落到 Rust std `slice::Iter`（Item=&T），后续 `.collect::<Vec<_>>()` 得
        // Vec<&T> → E0308 mismatched types。原生 expr_gen.rs 对集合 `.iter()` 补
        // `.cloned()`（无自定义 iter 时）转 T。此处对齐：`({recv}).iter().cloned()`。
        "(".to_string() + recv0 + ").iter().cloned()".to_string()
    elif m == "map" and a.len() == 1 and is_optres_irtype(expr_ty(r)):
        // BUG-439：`.map()` 在 Option/Result 接收者上是 Option::map/Result::map（直接
        // 作用于内层值），rs-lz 此前与集合共用迭代器 map 分支 → 发
        // `(r).iter().cloned().map(..).collect::<Vec<_>>()`，Option/Result 无 `.iter()`
        // → rustc E0308 mismatched types。原生 codegen 渲染 `(r).clone().map(move |n| ..)`
        //（`.clone()` 保留接收者所有权，供后续复用），此处对齐。集合接收者仍走下方
        // 迭代器 map 分支（Vec 需 `.iter().cloned().map(..).collect()`），与 flat_map
        // 在 Option/Result 上改名 and_then（BUG-433）互补。
        "(".to_string() + recv0 + ").clone().map(".to_string() + expr_cs_list(a, fn_raises, user_fns) + ")".to_string()
    elif m == "unwrap_or_else" and a.len() == 1 and is_optres_irtype(expr_ty(r)):
        // BUG-445：`unwrap_or_else` 按值消费 `self`，接收者后续复用须先 `.clone()`。
        // rs-lz 此前透传 `o.unwrap_or_else(..)`（不 clone）→ E0382/E0308；原生渲染
        // `(o).clone().unwrap_or_else(move || ..)`（与 `.map` 的 BUG-439 同族）。
        "(".to_string() + recv0 + ").clone().unwrap_or_else(".to_string() + expr_cs_list(a, fn_raises, user_fns) + ")".to_string()
    elif m == "expect" and a.len() == 1 and is_optres_irtype(expr_ty(r)):
        // BUG-445：`expect(&self, msg: &str)` 消息须 `&str`。rs-lz 原发 `expect("boom".to_string())`
        // → E0308 expected `&str`, found `String`；原生渲染 `expect("boom")`。字面量本身是
        // `&str` 裸发，String 变量须 `&msg`。
        "(".to_string() + recv0 + ").clone().expect(".to_string() + dict_key_arg(a[0].clone(), fn_raises, user_fns) + ")".to_string()
    elif m == "unwrap_or" and a.len() == 1 and is_optres_irtype(expr_ty(r)):
        // BUG-445：`unwrap_or` 按值消费 `self`，接收者后续复用须先 `.clone()`。rs-lz 此前
        // 透传 `r.unwrap_or(-1)` → E0382 use of moved value；原生 `(r).clone().unwrap_or(-1i64)`。
        "(".to_string() + recv0 + ").clone().unwrap_or(".to_string() + expr_cs_list(a, fn_raises, user_fns) + ")".to_string()
    elif m == "unwrap" and a.len() == 0 and is_optres_irtype(expr_ty(r)):
        // BUG-445：`unwrap` 按值消费 `self`（`Option::unwrap(self)`）。
        "(".to_string() + recv0 + ").clone().unwrap()".to_string()
    elif m == "ok" and a.len() == 0 and is_optres_irtype(expr_ty(r)):
        // BUG-445：`Result::ok(self)` 按值消费 `self`。
        "(".to_string() + recv0 + ").clone().ok()".to_string()
    elif m == "err" and a.len() == 0 and is_optres_irtype(expr_ty(r)):
        // BUG-445：`Result::err(self)` 按值消费 `self`。
        "(".to_string() + recv0 + ").clone().err()".to_string()
    elif m == "get" and a.len() == 1 and is_dict_irtype(expr_ty(r)):
        // BUG-440：Dict 的键实参在 Rust 端 `get(&self, key: &Q)` 需要借位。str 字面量
        // 本身就是 `&str`（Q=str），裸发 `"a"` 即可；其余（String/数值变量等）必须 `&<expr>`。
        // rs-lz 此前用 pattern_arg_of 对非字面量键直发 `k` → E0308 mismatched types
        // （expected `&_`, found `String`）。原生 codegen 渲染 `d.get(&k)` / `d.get("a")`。
        "(".to_string() + recv0 + ".get(".to_string() + dict_key_arg(a[0].clone(), fn_raises, user_fns) + ")).cloned()".to_string()
    elif m == "contains" and a.len() == 1 and is_dict_irtype(expr_ty(r)):
        // BUG-440：同上，`contains_key(&self, key: &Q)` 需借位；改名到 contains_key 见
        // lz_method_rename。原生渲染 `d.contains_key(&k)` / `d.contains_key("b")`。
        recv0 + ".contains_key(".to_string() + dict_key_arg(a[0].clone(), fn_raises, user_fns) + ")".to_string()
    elif m == "insert" and a.len() == 2 and is_dict_irtype(expr_ty(r)):
        // BUG-440：`insert(self, k: K, v: V)` 的键须**按值持有**（BTreeMap/HashMap 无
        // Borrow 借用键的 insert）。LZ 的 Dict 键统一是 str，Rust 端 `BTreeMap<String,V>`
        // ⇒ 键须 `.to_string()`（字面量与变量同理）。原生渲染
        // `m.insert("c".to_string(), 3i64)` / `m.insert(k.to_string(), v)`。
        recv0 + ".insert(".to_string() + dict_insert_key_arg(a[0].clone(), fn_raises, user_fns) + ", ".to_string() + gen_expr(a[1].clone(), fn_raises, user_fns) + ")".to_string()
    elif m == "remove" and a.len() == 1 and is_dict_irtype(expr_ty(r)):
        // BUG-442：`remove(&self, key: &Q)` 键须借位（与 BUG-440 的 get/contains 同族）。
        // rs-lz 原发 `d.remove("a".to_string())` → E0308 expected `&_`, found `String`；
        // 原生渲染 `d.remove("a")` / `d.remove(&k)`（remove 返回 `Option<V>`，无需 .cloned()）。
        recv0 + ".remove(".to_string() + dict_key_arg(a[0].clone(), fn_raises, user_fns) + ")".to_string()
    elif m == "remove" and a.len() == 1 and is_set_irtype(expr_ty(r)):
        // BUG-451：`HashSet::remove(&mut self, value: &T)` 实参须借位。rs-lz 落到通用分支
        // 直发 `s.remove(2i64)` → E0308 expected `&i64`, found `i64`；原生渲染
        // `s.remove(&2i64)`（与 BUG-449 的 Set.contains 同族）。
        "(".to_string() + recv0 + ").remove(&".to_string() + gen_expr(a[0].clone(), fn_raises, user_fns) + ")".to_string()
    elif m == "filter" and a.len() == 1 and is_range_irtype(expr_ty(r)):
        // BUG-436：Range 已是 Iterator，直接 .filter() 后 .collect::<Vec<_>>()；
        // 不得插 .iter().cloned()（Range 无 .iter() → E0599）。filter 闭包参数是
        // &Item → filter_lambda_src 已按 elem（Range→Int，Copy）生成 |&x|。
        "(".to_string() + recv0 + ").filter(".to_string() + filter_lambda_src(a[0].clone(), elem_irtype(r), fn_raises, user_fns) + ").collect::<Vec<_>>()".to_string()
    elif m == "map" and a.len() == 1 and is_range_irtype(expr_ty(r)):
        "(".to_string() + recv0 + ").map(".to_string() + expr_cs_list(a, fn_raises, user_fns) + ").collect::<Vec<_>>()".to_string()
    elif m == "filter" and a.len() == 1 and is_list_irtype(expr_ty(r)):
        // BUG-455：集合迭代家族（filter/map/fold/join）只在 List/Vec 接收者上生效，
        // 自定义 struct 上的同名方法不得被劫持（与 sum/min/max 同族，原生 expr_gen.rs
        // 对非 list 接收者一律回退到 `({recv}).{method}(...)` 普通方法调用）。
        "(".to_string() + recv0 + ").iter().cloned().filter(".to_string() + filter_lambda_src(a[0].clone(), elem_irtype(r), fn_raises, user_fns) + ").collect::<Vec<_>>()".to_string()
    elif m == "map" and a.len() == 1 and is_list_irtype(expr_ty(r)):
        "(".to_string() + recv0 + ").iter().cloned().map(".to_string() + expr_cs_list(a, fn_raises, user_fns) + ").collect::<Vec<_>>()".to_string()
    elif m == "fold" and a.len() == 2 and is_list_irtype(expr_ty(r)):
        "(".to_string() + recv0 + ".clone()).into_iter().fold(".to_string() + expr_cs_list(a, fn_raises, user_fns) + ")".to_string()
    elif m == "join" and a.len() == 1 and is_list_irtype(expr_ty(r)):
        "(".to_string() + recv0 + ").iter().map(|x| x.to_string()).collect::<Vec<_>>().join(".to_string() + pattern_arg_of(a[0].clone(), fn_raises, user_fns) + ")".to_string()
    elif m == "keys" and a.len() == 0 and is_dict_irtype(expr_ty(r)):
        recv0 + ".keys().cloned().collect::<Vec<_>>()".to_string()
    elif m == "values" and a.len() == 0 and is_dict_irtype(expr_ty(r)):
        recv0 + ".values().cloned().collect::<Vec<_>>()".to_string()
    elif m == "get" and a.len() == 1 and is_dict_irtype(expr_ty(r)):
        "(".to_string() + recv0 + ".get(".to_string() + pattern_arg_of(a[0].clone(), fn_raises, user_fns) + ")).cloned()".to_string()
    elif m == "contains" and a.len() == 1 and (is_list_irtype(expr_ty(r)) or is_set_irtype(expr_ty(r))):
        // BUG-437：List/Vec 的 `.contains(x)` 在 Rust 端签名是 `contains(&self, x: &T)`
        // —— 实参必须按引用传入。rs-lz 此前落到通用方法分支直发 `v.contains(3i64)`
        // → rustc E0308 mismatched types；原生 codegen 渲染 `v.contains(&3i64)`。
        // 注意 Dict（→ contains_key）与 str（→ Pattern 位，is_pattern_method）走各自
        // 既有分支，此处只接管集合（List/Vec）接收者。
        // BUG-449：`Set`（→ HashSet）接收者同签名 `contains(&self, x: &T)`，同族缺口
        // （`s.contains(1i64)` → E0308 expected `&i64`, found `i64`）。
        "(".to_string() + recv0 + ").contains(&".to_string() + gen_expr(a[0].clone(), fn_raises, user_fns) + ")".to_string()
    else:
        let name = lz_method_rename(m, r)
        let args_s = if is_pattern_method(m, r):
            pattern_args_list(a, fn_raises, user_fns)
        else:
            expr_cs_list(a, fn_raises, user_fns)
        let call = gen_recv_place(r, fn_raises, user_fns) + method_call_sep(r) + name + "(".to_string() + args_s + ")".to_string()
        if (m == "find" or m == "rfind") and is_string_irtype(expr_ty(r)):
            // BUG-453：LZ `s.find(..)` 语义为「找不到返回 -1」，原生 codegen 在
            // `lz_find(..)`（Option<i64>）后接 `.unwrap_or(-1i64)` 物化为 i64。
            call + ".unwrap_or(-1i64)".to_string()
        elif is_str_returning_method(m):
            call + ".to_string()".to_string()
        elif m == "split" and is_list_irtype(t):
            // LZ `s.split(sep)` 返回 List<str>，而 Rust 的 split 返回迭代器 ⇒ 物化
            //（对齐原生 `…split(",").map(|s| s.to_string()).collect::<Vec<_>>()`）。
            call + ".map(|s| s.to_string()).collect::<Vec<_>>()".to_string()
        else:
            call

def is_list_irtype(t: IrType) -> bool =
    match t:
        case IrType.Named(path: p, args: a) => p == "List" || p == "Vec"
        case _ => false

// BUG-436：`0..n` 的 IR 类型是 Named("Range")（无 args，元素恒为 int）。Range 本身已是
// Rust Iterator，`.filter()`/`.map()` 直接可调，无需 `.iter().cloned()`（Range 无 .iter()
// → E0599）；但结果须 `.collect::<Vec<_>>()`（赋 List 返回/变量时 Filter 迭代器 ≠ Vec，
// → E0308）。
def is_range_irtype(t: IrType) -> bool =
    match t:
        case IrType.Named(path: p, args: a) => p == "Range" || p == "RangeInclusive"
        case _ => false

def elem_irtype(r: Expr) -> IrType =
    match expr_ty(r):
        case IrType.Named(path: p, args: ar) =>
            if ar.len() > 0:
                ar[0].clone()
            else:
                // BUG-436：Range 无 args，元素恒为 int（infer.rs 同口径）——
                // filter_lambda_src 依赖 is_copy_elem 决定 `|&x|` 模式。
                if p == "Range" || p == "RangeInclusive":
                    IrType.Int
                else:
                    IrType.Any
        case _ => IrType.Any

def is_copy_elem(t: IrType) -> bool =
    match t:
        case IrType.Int => true
        case IrType.F64 => true
        case IrType.Bool => true
        case _ => false

def amp_join(ps: List<str>) -> String =
    let mut out: String = "".to_string()
    for idx in 0..ps.len():
        if idx > 0:
            out = out + ", ".to_string()
        out = out + "&".to_string() + ps[idx].clone()
    out

def filter_lambda_src(e: Expr, elem: IrType, fn_raises: MaybeIrType, user_fns: List[str]) -> String =
    match e:
        case Expr.Lambda(params: ps, body: b, ty: t) =>
            if is_copy_elem(elem):
                "move |".to_string() + amp_join(ps) + "| ".to_string() + gen_expr(b, fn_raises, user_fns)
            else:
                gen_expr(e, fn_raises, user_fns)
        case _ => gen_expr(e, fn_raises, user_fns)

def lz_method_rename(m: str, r: Expr) -> String =
    if m == "length":
        "len".to_string()
    elif m == "to_lower" or m == "lower":
        "to_lowercase".to_string()
    elif m == "to_upper" or m == "upper":
        "to_uppercase".to_string()
    elif m == "contains" and is_dict_irtype(expr_ty(r)):
        "contains_key".to_string()
    elif m == "flat_map" and is_optres_irtype(expr_ty(r)):
        // BUG-433：LZ `opt.flat_map(|v| Some(..))` 对 Option/Result 语义是 `and_then`
        //（Rust 的 flat_map 只存在于 Iterator，Option/Result 无该方法 ⇒ E0599）。
        // 集合（List/Vec）接收者保持 flat_map（走迭代器链）。
        "and_then".to_string()
    elif (m == "find" or m == "rfind") and is_string_irtype(expr_ty(r)):
        // BUG-453：原生把 str 的 find/rfind 渲染成 `s.lz_find(..)` —— lz_builtins 的扩展
        // 方法（返回 Option<i64>）。rs-lz 直发 Rust 内建 `str::find`（返回 Option<usize>）
        // 与原生字节不一致，且后续 `.unwrap_or(-1i64)` 无法编译。
        if m == "find":
            "lz_find".to_string()
        else:
            "lz_rfind".to_string()
    elif m == "add" and is_set_irtype(expr_ty(r)):
        // BUG-435：对齐原生 expr_gen.rs —— HashSet 无 add，`{1,2}.add(x)` → insert。
        // 自定义 Set 扩展（lz_std/set.lz）已提供 add 则保留（守卫在 type 判定之外）。
        "insert".to_string()
    else:
        m.to_string()

def is_optres_irtype(t: IrType) -> bool =
    match t:
        case IrType.Opt(inner: i) => true
        case IrType.Res(ok: o, err: e) => true
        case IrType.Named(path: p, args: a) => p == "Option" || p == "Result"
        case _ => false

def is_set_irtype(t: IrType) -> bool =
    match t:
        case IrType.Named(path: p, args: a) => p == "Set" || p == "HashSet"
        case _ => false

def is_dict_irtype(t: IrType) -> bool =
    match t:
        case IrType.Named(path: p, args: a) => p == "Dict" || p == "HashMap"
        case _ => false

def is_iterator_irtype(t: IrType) -> bool =
    // BUG-438：`.iter()`（infer.rs:1196）返回 IrType::Named { path:"Iterator" }，
    // Range 亦是 Iterator。识别这两种类型以决定 `.to_list()` 是否发
    // `.collect::<Vec<_>>()`（自定义 struct 如 LinkedList 有自己的 to_list，不得
    // 被劫持 —— FIND_BUG/lib_linked_list 实测 `ll.to_list()` 非 Iterator）。
    match t:
        case IrType.Named(path: p, args: a) => p == "Iterator" || p == "Range" || p == "RangeInclusive"
        case _ => false

def is_str_returning_method(m: str) -> bool =
    (m == "trim") || (m == "trim_start") || (m == "trim_end") || (m == "replace")

def is_pattern_method(m: str, r: Expr) -> bool =
    if (m == "split") || (m == "starts_with") || (m == "ends_with") || (m == "replace") || (m == "find") || (m == "rfind"):
        true
    elif m == "contains":
        is_string_irtype(expr_ty(r))
    else:
        false

// 模式位实参：str 字面量发裸 `"…"`（&str 实现 Pattern），其余沿用 gen_kwarg_value
def pattern_args_list(es: List<Expr>, fn_raises: MaybeIrType, user_fns: List[str]) -> String =
    if es.len() == 0:
        "".to_string()
    else:
        let head = pattern_arg_of(es[0].clone(), fn_raises, user_fns)
        if es.len() > 1:
            head + ", ".to_string() + pattern_args_list(ec_tail(es), fn_raises, user_fns)
        else:
            head

def pattern_arg_of(e: Expr, fn_raises: MaybeIrType, user_fns: List[str]) -> String =
    match e:
        case Expr.LitStr(s: sv, ty: t) => "\"".to_string() + esc_rust(sv) + "\"".to_string()
        case _ => gen_kwarg_value(e, fn_raises, user_fns)

// BUG-440：Dict 键实参（借位）。Rust 的 `get(&self, key: &Q)` / `contains_key(&self, key: &Q)`
// 要求 `K: Borrow<Q>` 的借用键。str 字面量本身是 `&str`（Q=str，`String: Borrow<str>`），
// 裸发 `"a"` 即可；其余（String/数值变量/表达式）必须 `&<expr>`（`String: Borrow<String>`）。
// 与 List/Vec 的 `.contains`（BUG-437，一实参 `&` 直发）同族，但 dict 键需区分字面量。
def dict_key_arg(e: Expr, fn_raises: MaybeIrType, user_fns: List[str]) -> String =
    match e:
        case Expr.LitStr(s: sv, ty: t) => "\"".to_string() + esc_rust(sv) + "\"".to_string()
        case _ => "&".to_string() + gen_expr(e, fn_raises, user_fns)

// BUG-440：Dict 键实参（按值持有）。`insert(self, k: K, v: V)` 的键须按值传给
// `BTreeMap<String,V>`，故 str 键一律补 `.to_string()`（字面量 `"a".to_string()`、
// 变量 `k.to_string()`）；非 str 键（如 Dict<int, V>）原样发。
def dict_insert_key_arg(e: Expr, fn_raises: MaybeIrType, user_fns: List[str]) -> String =
    let base = match e:
        case Expr.LitStr(s: sv, ty: t) => "\"".to_string() + esc_rust(sv) + "\"".to_string()
        case _ => gen_expr(e, fn_raises, user_fns)
    if is_string_irtype(expr_ty(e)):
        base + ".to_string()".to_string()
    else:
        base

// BUG-441：用户函数调用的按值语义。LZ 的集合/字符串/Option/Result/Dict 实参在两次及
// 多次使用同一变量时，Rust 端第二次传递即 `E0382 use of moved value`（g13_dictkey /
// g14_listarg 实测：`sumv(xs); lenv(xs)` → 原生 `sumv(xs.clone())`）。原生 codegen 对
// 每个**非 Copy 类型的左值实参**在调用点补 `.clone()`，rs-lz 此前原样透传。此处补同一
// 规则；仅对左值表达式（变量/字段访问/下标）克隆——字面量与调用结果本身就是新值，
// 原生对 `f("a".to_string())` 亦不克隆，故不克隆以对齐逐字符形态。
// 已知堆类型（需 clone）。Generic/Any/FnType/Duck 一律不动：泛型实参克隆需要 `T: Clone`
// 约束、闭包/`Box<dyn Fn>` 通常不可 Clone，保守不克隆以避免 E0599/新约束缺失。
def is_heap_irtype(t: IrType) -> bool =
    match t:
        case IrType.Str => true
        case IrType.Opt(inner: i) => true
        case IrType.Res(ok: o, err: e) => true
        case IrType.Named(path: p, args: a) => true
        case IrType.Tuple(elems: es) => not all_copy_irtype(es)
        case _ => false

def is_copy_irtype(t: IrType) -> bool =
    match t:
        case IrType.Int => true
        case IrType.F64 => true
        case IrType.Bool => true
        case IrType.Unit => true
        case IrType.Never => true
        case IrType.Ref(inner: i) => true
        case IrType.MutRef(inner: i) => true
        case IrType.Tuple(elems: es) => all_copy_irtype(es)
        case _ => false

def all_copy_irtype(ts: List[IrType]) -> bool =
    if ts.len() == 0:
        true
    else:
        is_copy_irtype(ts[0].clone()) && all_copy_irtype(tail_t(ts))

// 左值表达式（可被复用、会被移动）：变量、字段访问、下标、枚举变体字段访问。
def is_place_expr(e: Expr) -> bool =
    match e:
        case Expr.Var(name: n, ty: t) => true
        case Expr.FieldAccess(base: b, field: f, ty: t) => true
        case Expr.IndexGet(base: b, key: k, ty: t) => true
        case Expr.EnumFieldGet(base: b, enum_name: en, variants: vs, field: f, ty: t) => true
        case _ => false

def call_arg_src(e: Expr, fn_raises: MaybeIrType, user_fns: List[str]) -> String =
    if is_place_expr(e) && is_heap_irtype(expr_ty(e)):
        gen_expr(e, fn_raises, user_fns) + ".clone()".to_string()
    else:
        gen_expr(e, fn_raises, user_fns)

def call_args_list(a: List[Expr], fn_raises: MaybeIrType, user_fns: List[str]) -> String =
    if a.len() == 0:
        String::new()
    else:
        let head = call_arg_src(a[0].clone(), fn_raises, user_fns)
        if a.len() > 1:
            head + ", ".to_string() + call_args_list(ec_tail(a), fn_raises, user_fns)
        else:
            head

// BUG-423：字段访问的分隔符——基底是类型名（Var 且首字母大写，如 `Light.On`）时
// 用 `::`（单位变体/关联项引用），否则用 `.`（真实字段访问）。与 method_call_sep 同口径。
def field_access_sep(b: Expr) -> String = method_call_sep(b)

def starts_upper(s: str) -> bool =
    let c = s[0..1]
    (c == "A") || (c == "B") || (c == "C") || (c == "D") || (c == "E") || (c == "F") || (c == "G") || (c == "H") || (c == "I") || (c == "J") || (c == "K") || (c == "L") || (c == "M") || (c == "N") || (c == "O") || (c == "P") || (c == "Q") || (c == "R") || (c == "S") || (c == "T") || (c == "U") || (c == "V") || (c == "W") || (c == "X") || (c == "Y") || (c == "Z")

// BUG-427：推导宏展开。原生 codegen 在 Rust 侧展开 comp!/dict_comp!/set_comp! 及其多 for
// 链（comp_outer!/comp_mid!/comp_leaf!，dict_/set_ 前缀同族）；LZ 版 codegen 此前不认这些
// 名字、原样透传 ⇒ rustc `cannot find macro comp`（i7_dict_comp_iter 实测）。
// 形态对齐原生：单 for 用 map、多 for 链 outer/mid=flat_map、leaf=map，
// 仅最外层（单 for 或 *_outer!）collect；带条件时先 filter。
def comp_macro_kind(n: str) -> str =
    if (n == "comp!") || (n == "comp_outer!") || (n == "comp_mid!") || (n == "comp_leaf!"):
        "vec".to_string()
    elif (n == "dict_comp!") || (n == "dict_comp_outer!") || (n == "dict_comp_mid!") || (n == "dict_comp_leaf!"):
        "dict".to_string()
    elif (n == "set_comp!") || (n == "set_comp_outer!") || (n == "set_comp_mid!") || (n == "set_comp_leaf!"):
        "set".to_string()
    else:
        "none".to_string()

def is_comp_macro(n: str) -> bool = comp_macro_kind(n) != "none"

def is_comp_chain_node(n: str) -> bool =
    (n == "comp_outer!") || (n == "comp_mid!") || (n == "comp_leaf!") || (n == "dict_comp_outer!") || (n == "dict_comp_mid!") || (n == "dict_comp_leaf!") || (n == "set_comp_outer!") || (n == "set_comp_mid!") || (n == "set_comp_leaf!")

def comp_collect_ty_of(n: str) -> String =
    let k = comp_macro_kind(n)
    if k == "dict":
        "std::collections::HashMap<_,_>".to_string()
    elif k == "set":
        "std::collections::HashSet<_>".to_string()
    else:
        "Vec<_>".to_string()

def gen_comp_macro(n: str, a: List<Expr>, fn_raises: MaybeIrType, user_fns: List[str]) -> String =
    if a.len() < 2:
        "vec![]".to_string()
    else:
        let lambda_s = gen_expr(a[0].clone(), fn_raises, user_fns)
        let iter_e = a[1].clone()
        let iter_s = gen_expr(iter_e.clone(), fn_raises, user_fns)
        let iter_m = if is_string_irtype(expr_ty(iter_e.clone())):
            ".chars()".to_string()
        else:
            ".into_iter()".to_string()
        let is_leaf = (n == "comp_leaf!") || (n == "dict_comp_leaf!") || (n == "set_comp_leaf!")
        let is_single = (n == "comp!") || (n == "dict_comp!") || (n == "set_comp!")
        let op = if is_leaf || is_single:
            "map".to_string()
        else:
            "flat_map".to_string()
        let mut base = "(".to_string() + iter_s + ")" + iter_m
        if a.len() >= 3:
            base = base + ".filter(".to_string() + filter_lambda_src(a[2].clone(), elem_irtype(iter_e.clone()), fn_raises, user_fns) + ")".to_string()
        base = base + ".".to_string() + op + "(".to_string() + lambda_s + ")".to_string()
        // 仅 mid/leaf 是链内节点（不 collect）；单 for 与 *_outer! 都要 collect
        //（对齐原生 expr_gen.rs：`if suffix == "outer!" { chain.collect() }`）。
        let is_mid_or_leaf = (n == "comp_mid!") || (n == "comp_leaf!") || (n == "dict_comp_mid!") || (n == "dict_comp_leaf!") || (n == "set_comp_mid!") || (n == "set_comp_leaf!")
        if is_mid_or_leaf:
            base
        else:
            base + ".collect::<".to_string() + comp_collect_ty_of(n) + ">()".to_string()

def gen_call(c: Expr, a: List<Expr>, t: IrType, fn_raises: MaybeIrType, user_fns: List[str]) -> String =
    match c:
        case Expr.Var(name: n, ty: t2) =>
            // BUG-478：用户定义的顶层函数可遮蔽标准库魔法（如 `fn sum(xs)`）。
            // 原生用 fn_param_types.contains_key 守卫；rs-lz 用 user_fns 列表。
            // print/len 是语言内建关键字不可遮蔽，但 min/max/sum/abs/zip/sorted/
            // reversed/set! 走魔法分支时会吞掉用户同名函数 → 须先判 is_user_fn。
            if not is_user_fn(user_fns, n):
                if n == "print":
                    "println!(".to_string() + print_fmt(a) + print_args_list(a, fn_raises, user_fns) + ")".to_string()
                elif n == "len":
                    "(".to_string() + expr_cs_list(a, fn_raises, user_fns) + ".len() as i64)".to_string()
                elif n == "set!":
                    // BUG-434：对齐原生 `std::collections::HashSet::from([..])`。
                    // 此前生成 `[..].into_iter().collect()` 无类型标注 ⇒ E0282。
                    "std::collections::HashSet::from([".to_string() + expr_cs_list(a, fn_raises, user_fns) + "])".to_string()
                elif n == "sorted" and a.len() == 1:
                    "{ let mut _tmp = ".to_string() + gen_expr(a[0].clone(), fn_raises, user_fns) + ".clone(); _tmp.sort(); _tmp }".to_string()
                elif n == "reversed" and a.len() == 1:
                    "{ let mut _tmp = ".to_string() + gen_expr(a[0].clone(), fn_raises, user_fns) + ".clone(); _tmp.reverse(); _tmp }".to_string()
                // BUG-430：标准库自由函数形态。Rust 没有同名自由函数（sum/abs 缺失，min/max 为迭代器
                // 方法），rs-lz 此前原样透传 ⇒ E0061/E0425。形态对齐原生 expr_gen.rs 的 stdlib 表：
                //   min/max  → (&xs).iter().min().cloned()
                //   sum      → xs.iter().copied().sum::<i64>()
                //   abs      → lz_abs(x)（lz_builtins 内建，原生同）
                //   zip(a,b) → a.into_iter().zip(b.into_iter()).collect::<Vec<_>>()
                elif n == "min" and a.len() == 1:
                    "(&".to_string() + gen_expr(a[0].clone(), fn_raises, user_fns) + ").iter().min().cloned()".to_string()
                elif n == "max" and a.len() == 1:
                    "(&".to_string() + gen_expr(a[0].clone(), fn_raises, user_fns) + ").iter().max().cloned()".to_string()
                elif n == "sum" and a.len() == 1:
                    gen_expr(a[0].clone(), fn_raises, user_fns) + ".iter().copied().sum::<i64>()".to_string()
                elif n == "abs" and a.len() == 1:
                    "lz_abs(".to_string() + gen_expr(a[0].clone(), fn_raises, user_fns) + ")".to_string()
                elif n == "zip" and a.len() == 2:
                    "(".to_string() + gen_expr(a[0].clone(), fn_raises, user_fns) + ").into_iter().zip((".to_string() + gen_expr(a[1].clone(), fn_raises, user_fns) + ").into_iter()).collect::<Vec<_>>()".to_string()
                // BUG-443：空 `Dict()` 构造（builder 把 `Dict()` 生成 Call(Var("Dict"), [])，
                // 与字面量 `{..}` 的 StructCtor(name="Dict") 不同路径）。rs-lz 原发 `Dict()`，
                // 而 `Dict` 只是 lz_builtins 里的类型别名（`Dict<K,V> = BTreeMap<K,V>`），
                // 不能当函数调用 ⇒ E0423 expected function, found type alias `Dict`。
                // 原生渲染 `std::collections::BTreeMap::new()`。
                elif n == "Dict" and a.len() == 0:
                    "std::collections::BTreeMap::new()".to_string()
                // BUG-449：空 `Set()` 构造同 BUG-443 的 `Dict()`——builder 生成
                // `Call(Var("Set"), [])`，rs-lz 走通用分支原发 `Set()`，而 `Set` 只是
                // lz_builtins 里的类型别名（`Set<T> = HashSet<T>`）⇒ E0423 expected
                // function, found type alias `Set`。原生渲染
                // `let mut s: std::collections::HashSet<_> = std::collections::HashSet::new()`。
                elif n == "Set" and a.len() == 0:
                    "std::collections::HashSet::new()".to_string()
                // BUG-432：命名字段结构体构造 `Point(x: 3, y: 4)`。builder 把它变成
                // `Call(Var("Point"), [_KwArg(x,3), _KwArg(y,4)])`，ty=Named("Point")。
                // rs-lz 此前走通用调用分支、用 kwarg_value_of 剥掉字段名 ⇒ `Point(3i64, 4i64)`
                // → rustc E0423 expected function/tuple struct, found struct `Point`。
                // 判据：结果类型路径 == 调用名（排除「返回该 struct 的同名函数」这类伪命中，
                // Rust 也不允许 fn 与 struct 同名）+ 实参全为 _KwArg。
                elif is_struct_ctor(n, a, t):
                    n.to_string() + " { ".to_string() + kwarg_pairs_str(a, fn_raises, user_fns) + " }".to_string()
                elif is_dict_kwarg_ctor(n, a):
                    gen_dict_kwarg_ctor(a, fn_raises, user_fns)
                elif is_set_kwarg_ctor(n, a):
                    gen_set_kwarg_ctor(a, fn_raises, user_fns)
                elif is_comp_macro(n):
                    gen_comp_macro(n, a, fn_raises, user_fns)
                elif is_cast_call(n, a):
                    gen_cast_call(n, a, fn_raises, user_fns)
                else:
                    n.to_string() + "(".to_string() + call_args_list(a, fn_raises, user_fns) + ")".to_string()
            else:
                // 用户同名函数：走通用调用分支（不发魔法形态）
                n.to_string() + "(".to_string() + call_args_list(a, fn_raises, user_fns) + ")".to_string()
        case _ => gen_expr(c, fn_raises, user_fns) + "(".to_string() + call_args_list(a, fn_raises, user_fns) + ")".to_string()

def is_struct_ctor(n: str, a: List<Expr>, t: IrType) -> bool =
    starts_upper(n) and all_kwarg_args(a) and irtype_named_path(t, n)

// BUG-478：判断 n 是否为模块顶层用户函数名（遮蔽标准库魔法）。List[str] 无 contains，
// 线性扫描即可（模块函数数远小于魔法分支调用次数）。
def is_user_fn(user_fns: List[str], n: str) -> bool =
    let mut found: bool = false
    for idx in 0..user_fns.len():
        if user_fns[idx] == n:
            found = true
    found

// `Dict(a: 1, b: 2)` 关键字字面量（`{ "a": 1 }` 之外的字形，builder 生成
// `Call(Var("Dict"), [_KwArg(a,1), _KwArg(b,2)])`）。is_struct_ctor 判据要求结果类型
// 路径 == 调用名，而此类字面量的结果类型常是 Any（`let d = Dict(a:1)`）→ 判据失败，
// 落到通用调用分支发 `Dict(_KwArg{..}, _KwArg{..})` → E0422/E0423。BTreeMap 是类型
// 别名不是 struct，须走 BUG-290 的 `BTreeMap::from([..])` 字面量形态（对齐原生
// expr_gen.rs 的 Dict kwarg 分支）。同族 Set/HashSet kwarg 同理。
def is_dict_kwarg_ctor(n: str, a: List<Expr>) -> bool =
    (n == "Dict" or n == "HashMap" or n == "dict") and all_kwarg_args(a)

def is_set_kwarg_ctor(n: str, a: List<Expr>) -> bool =
    (n == "Set" or n == "HashSet" or n == "set") and all_kwarg_args(a)

def gen_dict_kwarg_ctor(a: List<Expr>, fn_raises: MaybeIrType, user_fns: List[str]) -> String =
    "std::collections::BTreeMap::from([".to_string() + dict_kwarg_pairs_str(a, fn_raises, user_fns) + "])".to_string()

def gen_set_kwarg_ctor(a: List[Expr], fn_raises: MaybeIrType, user_fns: List[str]) -> String =
    let mut out: String = "".to_string()
    for idx in 0..a.len():
        if idx > 0:
            out = out + ", ".to_string()
        out = out + dict_kwarg_value_of(a[idx].clone(), fn_raises, user_fns)
    "std::collections::HashSet::from([".to_string() + out + "])".to_string()

def dict_kwarg_pairs_str(a: List<Expr>, fn_raises: MaybeIrType, user_fns: List[str]) -> String =
    let mut out: String = "".to_string()
    for idx in 0..a.len():
        if idx > 0:
            out = out + ", ".to_string()
        out = out + dict_kwarg_pair_of(a[idx].clone(), fn_raises, user_fns)
    out

def dict_kwarg_pair_of(e: Expr, fn_raises: MaybeIrType, user_fns: List[str]) -> String =
    match e:
        case Expr.StructCtor(name: n, fields: fs, ty: t) =>
            "(".to_string() + "\"".to_string() + esc_rust(kwarg_name_of(fs)) + "\".to_string(), ".to_string() + kwarg_value_of(fs, fn_raises, user_fns) + ")".to_string()
        case _ => gen_expr(e, fn_raises, user_fns)

def dict_kwarg_value_of(e: Expr, fn_raises: MaybeIrType, user_fns: List[str]) -> String =
    match e:
        case Expr.StructCtor(name: n, fields: fs, ty: t) =>
            kwarg_value_of(fs, fn_raises, user_fns)
        case _ => gen_expr(e, fn_raises, user_fns)

// BUG-477：内建类型转换 `str(x)` / `int(x)` / `f64(x)`。rs-lz 此前走通用分支原发
// `str(x)`（E0423 expected function, found builtin type `str`）/ `int(x)`（E0425
// cannot find function）/ `f64(x)`。对齐原生 expr_gen.rs:1876 的规则：
//   str(x)  → 集合走 `format!("{:?}", x)`（无 Display），标量走 `format!("{}", x)`
//   int(x)  → 字符串走 `(x).parse::<i64>().unwrap()`，否则 `(x as i64)`
//   f64(x)  → 字符串走 `(x).parse::<f64>().unwrap()`，否则 `(x as f64)`
def is_cast_call(n: str, a: List<Expr>) -> bool =
    (n == "str" or n == "int" or n == "f64" or n == "float") and a.len() >= 1

def gen_cast_call(n: str, a: List<Expr>, fn_raises: MaybeIrType, user_fns: List[str]) -> String =
    if n == "str":
        if is_collection_irtype(expr_ty(a[0].clone())):
            "format!(\"{:?}\", ".to_string() + gen_expr(a[0].clone(), fn_raises, user_fns) + ")".to_string()
        else:
            "format!(\"{}\", ".to_string() + gen_expr(a[0].clone(), fn_raises, user_fns) + ")".to_string()
    elif n == "int":
        if is_string_irtype(expr_ty(a[0].clone())):
            "(".to_string() + gen_expr(a[0].clone(), fn_raises, user_fns) + ").parse::<i64>().unwrap()".to_string()
        else:
            "(".to_string() + gen_expr(a[0].clone(), fn_raises, user_fns) + " as i64)".to_string()
    else:
        if is_string_irtype(expr_ty(a[0].clone())):
            "(".to_string() + gen_expr(a[0].clone(), fn_raises, user_fns) + ").parse::<f64>().unwrap()".to_string()
        else:
            "(".to_string() + gen_expr(a[0].clone(), fn_raises, user_fns) + " as f64)".to_string()

def is_collection_irtype(t: IrType) -> bool =
    match t:
        case IrType.Named(path: p, args: ar) =>
            p == "Vec" or p == "List" or p == "HashMap" or p == "HashSet" or p == "Dict" or p == "Set"
        case _ => false

def irtype_named_path(t: IrType, n: str) -> bool =
    match t:
        case IrType.Named(path: p, args: ar) => p == n
        case _ => false

def print_fmt(as_: List<Expr>) -> String =
    if as_.len() == 0:
        "\"\"".to_string()
    else:
        // BUG-419：格式串按实参**逐位**选择——字符串（字面量/f-string/str 类型/
        // cast 到 str）走 Display `{}`，其余走 Debug `{:?}`，对齐原生
        // expr_gen.rs:1941 的 print_arg_is_display 规则。旧实现恒发 `{:?}`，使同一份
        // LZ 源码在 --emit=rs-lz 下打印 `"hi"`（带引号转义）、原生打印 `hi`——
        // 两条 codegen 路线运行结果不一致（D1 字节判据语料恰好只打印 int，未暴露）。
        let mut out: String = "\"".to_string()
        for idx in 0..as_.len():
            if idx > 0:
                out = out + " ".to_string()
            out = out + print_placeholder(as_[idx].clone())
        out + "\", ".to_string()

def print_placeholder(e: Expr) -> String =
    if print_arg_is_display(e):
        "{}".to_string()
    else:
        "{:?}".to_string()

def print_arg_is_display(e: Expr) -> bool =
    match e:
        case Expr.LitStr(s: sv, ty: tv) => true
        case Expr.LitFStr(s: sv, ty: tv) => true
        case Expr.Cast(inner: i, target: tg, ty: tv) =>
            if is_string_irtype(tg):
                true
            else:
                is_string_irtype(expr_ty(e))
        case _ => is_string_irtype(expr_ty(e))

def is_string_irtype(t: IrType) -> bool =
    match t:
        case IrType.Str => true
        case IrType.Ref(inner: i) => is_string_irtype(i)
        case IrType.MutRef(inner: i) => is_string_irtype(i)
        case IrType.Named(path: p, args: a) => p == "String" || p == "str"
        case _ => false

// print 实参渲染：字符串字面量去掉多余的 `.to_string()`（Display 已足够，省一次
// 堆分配），对齐原生 expr_gen.rs:1954 的同款裁剪；其余沿用 gen_kwarg_value。
def print_args_list(es: List<Expr>, fn_raises: MaybeIrType, user_fns: List[str]) -> String =
    if es.len() == 0:
        "".to_string()
    else:
        let head = print_arg_of(es[0].clone(), fn_raises, user_fns)
        if es.len() > 1:
            head + ", ".to_string() + print_args_list(ec_tail(es), fn_raises, user_fns)
        else:
            head

def print_arg_of(e: Expr, fn_raises: MaybeIrType, user_fns: List[str]) -> String =
    match e:
        case Expr.LitStr(s: sv, ty: t) => "\"".to_string() + esc_rust(sv) + "\"".to_string()
        case _ => gen_kwarg_value(e, fn_raises, user_fns)

def gen_kwarg_value(e: Expr, fn_raises: MaybeIrType, user_fns: List[str]) -> String =
    match e:
        case Expr.StructCtor(name: n, fields: fs, ty: t) =>
            if n == "_KwArg":
                kwarg_value_of(fs, fn_raises, user_fns)
            else:
                gen_expr(e, fn_raises, user_fns)
        case _ => gen_expr(e, fn_raises, user_fns)

// BUG-408：`f(x~=1)` / `Shape.Circle(radius: 5)` 等关键字参数在 IR 中表现为
// StructCtor(name="_KwArg", fields=[(name, "radius"), (value, 5)])。原生 codegen 用
// gen_kwarg_value 提取 value 字段、丢弃字段名（位置参数构造）；LZ 侧此前直接渲染成
// `_KwArg { name: ..., value: ... }` → rustc E0422 cannot find struct `_KwArg`。
def kwarg_value_of(fs: List<(str, Expr)>, fn_raises: MaybeIrType, user_fns: List[str]) -> String =
    let mut out: String = "".to_string()
    for idx in 0..fs.len():
        let f = fs[idx].clone()
        if f.0 == "value":
            out = gen_expr(f.1, fn_raises, user_fns)
    out

// BUG-411：命名字段变体构造 `Enum::Variant { f: v, ... }` 的两块拼装。
// 实参为 _KwArg（`name` 字段是字段名字面量，`value` 字段是值表达式）时取字段名；
// 序列化侧已把位置实参按声明名补成 _KwArg，故此处只需渲染 pairs。
def all_kwarg_args(a: List<Expr>) -> bool =
    let mut all_kw: bool = a.len() > 0
    for idx in 0..a.len():
        if not is_kwarg_expr(a[idx].clone()):
            all_kw = false
    all_kw

def is_kwarg_expr(e: Expr) -> bool =
    match e:
        case Expr.StructCtor(name: n, fields: fs, ty: t) => n == "_KwArg"
        case _ => false

def kwarg_pairs_str(a: List<Expr>, fn_raises: MaybeIrType, user_fns: List[str]) -> String =
    let mut out: String = "".to_string()
    for idx in 0..a.len():
        if idx > 0:
            out = out + ", ".to_string()
        out = out + kwarg_pair_of(a[idx].clone(), fn_raises, user_fns)
    out

def kwarg_pair_of(e: Expr, fn_raises: MaybeIrType, user_fns: List[str]) -> String =
    match e:
        case Expr.StructCtor(name: n, fields: fs, ty: t) =>
            kwarg_name_of(fs) + ": ".to_string() + kwarg_value_of(fs, fn_raises, user_fns)
        case _ => gen_expr(e, fn_raises, user_fns)

def kwarg_name_of(fs: List<(str, Expr)>) -> String =
    let mut out: String = "".to_string()
    for idx in 0..fs.len():
        let f = fs[idx].clone()
        if f.0 == "name":
            out = lit_str_of(f.1)
    out

def lit_str_of(e: Expr) -> String =
    match e:
        case Expr.LitStr(s: sv, ty: tv) => sv
        case _ => "".to_string()

// BUG-411：命名字段枚举字段访问的匹配臂串（对齐原生 expr_gen.rs:5184 的
// `E::V { f, .. } => f.clone(), `，含该字段的每个变体各一臂）。
def enum_field_arms(en: str, vs: List<str>, f: str) -> String =
    let mut out: String = "".to_string()
    for idx in 0..vs.len():
        let v = vs[idx].clone()
        out = out + en.to_string() + "::".to_string() + v.to_string() + " { ".to_string() + f.to_string() + ", .. } => ".to_string() + f.to_string() + ".clone(), ".to_string()
    out

def expr_cs_list(es: List<Expr>, fn_raises: MaybeIrType, user_fns: List[str]) -> String =
    if es.len() == 0:
        "".to_string()
    else:
        let head = gen_kwarg_value(es[0].clone(), fn_raises, user_fns)
        if es.len() > 1:
            head + ", ".to_string() + expr_cs_list(ec_tail(es), fn_raises, user_fns)
        else:
            head

def ec_tail(es: List<Expr>) -> List<Expr> =
    let mut out: List<Expr> = []
    for idx in 1..es.len():
        out.push(es[idx].clone())
    out

def ctor_fields(fs: List<(str, Expr)>, user_fns: List[str]) -> String =
    let mut out: String = "".to_string()
    for idx in 0..fs.len():
        let f = fs[idx].clone()
        out = out + (if idx > 0: ", ".to_string() else: "".to_string()) + f.0.to_string() + ": ".to_string() + gen_expr(f.1, MaybeIrType.NoTy, user_fns)
    out

// BUG-475：构造端的 Box 包装。字段值/参数的类型为被构造类型自身（`expr_ty(v)` 为
// Named(path=owner) 或 Self_）即视为递归字段，发 `Box::new(<expr>)`，与声明端
// field_ty_str 的 `Box<T>` 对应；否则原样。避免 `Box<T>` 字段被赋裸 `T` 值（E0308）。
def ctor_fields_boxed(fs: List<(str, Expr)>, owner: str, fn_raises: MaybeIrType, user_fns: List[str]) -> String =
    let mut out: String = "".to_string()
    for idx in 0..fs.len():
        let f = fs[idx].clone()
        out = out + (if idx > 0: ", ".to_string() else: "".to_string()) + f.0.to_string() + ": ".to_string() + maybe_box_expr(f.1, owner, fn_raises, user_fns)
    out

def kwarg_pairs_str_boxed(a: List<Expr>, owner: str, fn_raises: MaybeIrType, user_fns: List[str]) -> String =
    let mut out: String = "".to_string()
    for idx in 0..a.len():
        if idx > 0:
            out = out + ", ".to_string()
        out = out + kwarg_pair_of_boxed(a[idx].clone(), owner, fn_raises, user_fns)
    out

def kwarg_pair_of_boxed(e: Expr, owner: str, fn_raises: MaybeIrType, user_fns: List[str]) -> String =
    match e:
        case Expr.StructCtor(name: n, fields: fs, ty: t) =>
            kwarg_name_of(fs) + ": ".to_string() + maybe_box_expr(kwarg_value_expr(fs), owner, fn_raises, user_fns)
        case _ => maybe_box_expr(e, owner, fn_raises, user_fns)

def expr_cs_list_boxed(es: List<Expr>, owner: str, fn_raises: MaybeIrType, user_fns: List[str]) -> String =
    if es.len() == 0:
        "".to_string()
    else:
        let head = maybe_box_expr(es[0].clone(), owner, fn_raises, user_fns)
        if es.len() > 1:
            head + ", ".to_string() + expr_cs_list_boxed(ec_tail(es), owner, fn_raises, user_fns)
        else:
            head

// kwarg 值表达式（`_KwArg { name: ..., value: X }` 的 value 字段），供 maybe_box_expr 判型。
def kwarg_value_expr(fs: List<(str, Expr)>) -> Expr =
    let mut out: Expr = Expr.LitUnit(ty: IrType.Unit)
    for idx in 0..fs.len():
        let f = fs[idx].clone()
        if f.0 == "value":
            out = f.1.clone()
    out

def maybe_box_expr(v: Expr, owner: str, fn_raises: MaybeIrType, user_fns: List[str]) -> String =
    if expr_is_recursive_of(v, owner):
        "Box::new(".to_string() + gen_expr(v, fn_raises, user_fns) + ")"
    else:
        gen_expr(v, fn_raises, user_fns)

def expr_is_recursive_of(v: Expr, owner: str) -> bool =
    match expr_ty(v):
        case IrType.Named(path: p, args: a) => p == owner
        case IrType.Self_ => true
        case _ => false

// ── 语句生成 ──

def gen_stmt(s: Stmt, is_tail: bool, is_main: bool, auto_mut: String, fn_raises: MaybeIrType, user_fns: List[str], tbm: List[(str, List[(str, bool)])], vem: List[(str, List[(str, List[str])])]) -> String =
    match s:
        case Stmt.Let(name: n, ty: t, value: v, is_mut: m, is_ref: r) =>
            gen_let(n, t, v, m, r, auto_mut, fn_raises, user_fns)
        case Stmt.Assign(target: tg, value: v) =>
            match tg:
                case Expr.IndexGet(base: b, key: k, ty: t) =>
                    // BUG-461：dict 下标赋值的判定用类型判据而非 base_is_dict（后者只认
                    // Expr.Var，`self.d[k] = v` 的 base 是 FieldAccess → 判定失败，落到非
                    // dict 分支把 `.get().unwrap()` 当写目标 → E0070）。base 走 gen_recv_place
                    // 免 `.clone()`：对齐原生顶层 dict 赋值的正确形态 `d.insert(k, v)`
                    // （原生对 `self.d` 套 clone → 插到临时 dict → 数据丢失运行 panic，
                    // 见 ledger 原生 bug 条目，rs-lz 不复刻该缺陷）。
                    if is_dict_irtype(expr_ty(b)):
                        gen_dict_place(b, user_fns) + ".insert(".to_string() + gen_expr(k, MaybeIrType.NoTy, user_fns) + ", ".to_string() + gen_expr(v, MaybeIrType.NoTy, user_fns) + ");".to_string()
                    else:
                        // BUG-460：`self.items[0] = x` 的下标赋值 target 按 place 发射
                        // （gen_recv_place 已对 IndexGet 递归 base），否则 `self.items.clone()[0]=x`
                        // 赋到临时值，数据丢失。
                        gen_recv_place(tg, MaybeIrType.NoTy, user_fns) + " = ".to_string() + gen_expr(v, MaybeIrType.NoTy, user_fns) + ";".to_string()
                case _ =>
                            // BUG-458：赋值目标按 place 发射（免 `.clone()`），对齐原生
                            // `self.n = self.n.clone() + 1i64` 的 LHS 形态；否则 E0070。
                            gen_recv_place(tg, MaybeIrType.NoTy, user_fns) + " = ".to_string() + gen_expr(v, MaybeIrType.NoTy, user_fns) + ";".to_string()
        case Stmt.Return(value: v) =>
            match v:
                case MaybeExpr.YesExpr(value: inner) => "return ".to_string() + gen_expr(inner, fn_raises, user_fns) + ";".to_string()
                case MaybeExpr.NoExpr => "return;".to_string()
        case Stmt.ExprStmt(expr: e) =>
            let ret_prefix = ("return " if (is_tail && !is_main) else "").to_string()
            ret_prefix + gen_expr(e, fn_raises, user_fns) + ";".to_string()
        case Stmt.While(cond: c, guard_e: g, body: b, else_body: eb) =>
            gen_while(c, b, fn_raises, user_fns, tbm, vem)
        case Stmt.If(cond: c, then: tb, els: eb) =>
            gen_if(c, tb, eb, fn_raises, user_fns, tbm, vem)
        case Stmt.Break => "break;".to_string()
        case Stmt.Continue => "continue;".to_string()
        case Stmt.Pass => "();  // pass".to_string()
        case Stmt.For(var: v, iter: it, guard_e: g, body: b, else_body: eb) =>
            "for ".to_string() + v + " in ".to_string() + gen_expr(it, fn_raises, user_fns) + " ".to_string() + gen_block(b, fn_raises, user_fns, tbm, vem)
        case Stmt.Match(scrutinee: s, arms: as_) =>
            // BUG-420：值位置（函数尾/块尾）的 match 直出，各分支体经 gen_value_block
            // 产出值；语句位置用 `let _ = match …;` 丢弃值（否则「非 () 类型的表达式
            // 语句」E0308）。对齐原生：语句 match → `let _ = match …`。
            // BUG-469/470：对齐原生 stmt_gen.rs:2274-2312 的 scrutinee 变换（顺序不可颠倒）——
            //   ① Str → `.as_str()`（BUG-284，String scrutinee 对 &str 字面量模式 E0308）
            //   ② 纯 Var（非 self）→ `.clone()` 防局部移动 E0382；self → `self.clone()`
            //   ③ List/Vec/Tuple scrutinee + 任一臂含列表模式 → 再追加 `.as_slice()`（E0529）
            let base_s = gen_expr(s, fn_raises, user_fns)
            let base_sc = match expr_ty(s):
                case IrType.Str => base_s + ".as_str()".to_string()
                case _ =>
                    match s:
                        case Expr.Var(name: n, ty: _):
                            if n == "self": "self.clone()".to_string()
                            else: base_s + ".clone()".to_string()
                        case _: base_s
            let scrut_slice: bool = (scrut_is_list(expr_ty(s)) and any_arm_pat_is_list(as_))
            let scrut_s = base_sc + ".as_slice()".to_string() if scrut_slice else base_sc
            if is_tail:
                "match ".to_string() + scrut_s + " {\n".to_string() + gen_match_arms(as_, fn_raises, user_fns, scrut_slice, tbm, vem) + "}".to_string()
            else:
                "let _ = match ".to_string() + scrut_s + " {\n".to_string() + gen_match_arms(as_, fn_raises, user_fns, scrut_slice, tbm, vem) + "};".to_string()
        case Stmt.Block(stmts: ss) =>
            // BUG-406：裸块语句是嵌套上下文，其尾部表达式不是函数尾，不得发射 `return`
            // （is_main=true 仅在 gen_stmt 的 ExprStmt 处抑制尾 return，无其他副作用）。
            "{\n".to_string() + gen_body(ss, true, "".to_string(), fn_raises, user_fns, tbm, vem) + "}".to_string()
        case Stmt.Assert(cond: c) =>
            "assert!(".to_string() + gen_expr(c, fn_raises, user_fns) + ");".to_string()
        case Stmt.Raise(value: v) =>
            match fn_raises:
                case MaybeIrType.YesTy(value: _t) => "return Result::Err(".to_string() + gen_expr(v, fn_raises, user_fns) + ");".to_string()
                case MaybeIrType.NoTy => "panic!(".to_string() + gen_expr(v, fn_raises, user_fns) + ");".to_string()
        case Stmt.TypeAlias(name: n, ty: t) =>
            "type ".to_string() + n.to_string() + " = ".to_string() + rust_type(t) + ";".to_string()
        case Stmt.BreakLabel(label: l, value: v) =>
            match v:
                case MaybeExpr.YesExpr(value: inner) => "break '".to_string() + l + "' ".to_string() + gen_expr(inner, fn_raises, user_fns) + ";".to_string()
                case MaybeExpr.NoExpr => "break '".to_string() + l + "';".to_string()
        case Stmt.BlockLabel(label: l, body: b) =>
            "'".to_string() + l + ": ".to_string() + gen_block(b, fn_raises, user_fns, tbm, vem)
        case Stmt.WhileLet(pattern: p, expr: e, guard_e: g, body: b) =>
            "while let ".to_string() + gen_pattern(p) + " = ".to_string() + gen_expr(e, fn_raises, user_fns) + " ".to_string() + gen_block(b, fn_raises, user_fns, tbm, vem)
        case Stmt.Defer(body: b) =>
            "{ /* defer */ ".to_string() + gen_block(b, fn_raises, user_fns, tbm, vem) + " }".to_string()
        case Stmt.CheckerBlock(label: l, ps_name: p) =>
            "();  // checker block (defined at module level)".to_string()
        case Stmt.TryCatch(body: b, catches: cs, else_body: eb, finally_body: fb) =>
            let use_result_try = is_result_body(b)
            let result_marker = ("// [Result base detected]\n".to_string() if use_result_try else "".to_string())
            let try_body = gen_block(b, MaybeIrType.NoTy, user_fns, tbm, vem)
            let pr_prefix = "{ let __pr = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {".to_string()
            let pr_mid = " })); ".to_string()
            let match_expr: String = if cs.len() == 0:
                match eb:
                    case MaybeBlock.YesBlock(value: eb_blk) =>
                        let else_body_s = gen_block(eb_blk, MaybeIrType.NoTy, user_fns, tbm, vem)
                        "match __pr { Ok(_v) => { _v; ".to_string() + else_body_s + " }, Err(_p) => () }".to_string()
                    case _ =>
                        "__pr.unwrap_or_else(|_p| ())".to_string()
            else:
                let last_idx = cs.len() - 1
                let mut skipped_comments: String = String::new()
                for ci in 0..last_idx:
                    let pre_catch = cs[ci].clone()
                    let pre_pat = pre_catch.0
                    let cmt: String = match pre_pat:
                        case MaybePattern.YesPat(value: pp) =>
                            match pp:
                                case Pattern.Ident(name: pn) =>
                                    "// catch ".to_string() + pn + " skipped\n".to_string()
                                case Pattern.Enum(enum_name: en, variant: vv, args: _) =>
                                    "// catch ".to_string() + en + "::".to_string() + vv + " skipped\n".to_string()
                                case _ =>
                                    "// catch _ skipped\n".to_string()
                        case _ =>
                            "// catch _ skipped\n".to_string()
                    skipped_comments = skipped_comments + cmt
                let last_catch = cs[last_idx].clone()
                let pat = last_catch.0
                let catch_blk = last_catch.1
                let catch_body = gen_block(catch_blk, MaybeIrType.NoTy, user_fns, tbm, vem)
                let mut binds: String = String::new()
                match pat:
                    case MaybePattern.YesPat(value: p2) =>
                        match p2:
                            case Pattern.Ident(name: n) =>
                                let safe_n = if n == "line" || n == "column" || n == "file":
                                    n + "_".to_string()
                                else:
                                    n
                                binds = "let ".to_string() + safe_n + " = format!(\"{:?}\", _p); ".to_string()
                            case Pattern.Enum(enum_name: en, variant: v, args: a) =>
                                for ai in 0..a.len():
                                    let arg_p = a[ai].clone()
                                    match arg_p:
                                        case Pattern.Ident(name: n2) =>
                                            let safe_n2 = if n2 == "line" || n2 == "column" || n2 == "file":
                                                n2 + "_".to_string()
                                            else:
                                                n2
                                            binds = binds + "let ".to_string() + safe_n2 + " = format!(\"{:?}\", _p); ".to_string()
                                        case _ =>
                                            ()
                            case _ =>
                                ()
                    case _ =>
                        ()
                let ok_arm: String = match eb:
                    case MaybeBlock.YesBlock(value: eb_blk2) =>
                        "{ _v; ".to_string() + gen_block(eb_blk2, MaybeIrType.NoTy, user_fns, tbm, vem) + " }".to_string()
                    case _ =>
                        "_v".to_string()
                skipped_comments + "match __pr { Ok(_v) => ".to_string() + ok_arm + ", Err(_p) => { ".to_string() + binds + catch_body + " } }".to_string()
            let try_val_stmt = "let __try_val = ".to_string() + match_expr + "; ".to_string()
            let finally_part: String = match fb:
                case MaybeBlock.YesBlock(value: fb_blk) =>
                    let fb_body = gen_block(fb_blk, MaybeIrType.NoTy, user_fns, tbm, vem)
                    "let __final_val = __try_val; ".to_string() + fb_body + "; __final_val".to_string()
                case _ =>
                    "__try_val".to_string()
            result_marker + pr_prefix + try_body + pr_mid + try_val_stmt + finally_part + " }".to_string()
        case Stmt.Yield(value: v) =>
            "__gen_vec.push(".to_string() + gen_expr(v, fn_raises, user_fns) + ");".to_string()
        case Stmt.YieldFrom(iter: it) =>
            "__gen_vec.extend(".to_string() + gen_expr(it, fn_raises, user_fns) + ".into_iter());".to_string()
        case _ => "// TODO stmt".to_string()

// while true { pass } → loop { unimplemented!() }（对齐原生：无限循环 + pass 占位）
def gen_while(c: Expr, b: BlockIR, fn_raises: MaybeIrType, user_fns: List[str], tbm: List[(str, List[(str, bool)])], vem: List[(str, List[(str, List[str])])]) -> String =
    let inf = is_true_cond(c)
    if inf && block_is_pass_only(b):
        "loop {\n        unimplemented!()\n    }".to_string()
    else:
        "while ".to_string() + gen_expr(c, fn_raises, user_fns) + " ".to_string() + gen_block(b, fn_raises, user_fns, tbm, vem)

// if cond { then } else { els }（无 else 时省略 else 块，对齐原生 codegen/mod.rs:8072-8098）
def gen_if(c: Expr, tb: BlockIR, eb: MaybeBlock, fn_raises: MaybeIrType, user_fns: List[str], tbm: List[(str, List[(str, bool)])], vem: List[(str, List[(str, List[str])])]) -> String =
    let base = "if ".to_string() + gen_expr(c, fn_raises, user_fns) + " ".to_string() + gen_block(tb, fn_raises, user_fns, tbm, vem)
    match eb:
        case MaybeBlock.YesBlock(value: b) => base + " else ".to_string() + gen_block(b, fn_raises, user_fns, tbm, vem)
        case MaybeBlock.NoBlock => base

def is_true_cond(c: Expr) -> bool =
    match c:
        case Expr.LitBool(b: bv, ty: tv) => bv
        case _ => false

def block_is_pass_only(b: BlockIR) -> bool =
    match b:
        case BlockIR.Block(stmts: ss, ty: t) =>
            if ss.len() == 1:
                match ss[0].clone():
                    case Stmt.Pass => true
                    case _ => false
            else:
                false

def gen_let(n: str, t: IrType, v: Expr, m: bool, r: bool, auto_mut: String, fn_raises: MaybeIrType, user_fns: List[str]) -> String =
    if expr_has_var(v, n):
        // BUG-454：LZ 的 `i = i + 1` 在嵌套块（while/for 体、match 分支）内被解析为
        // `Stmt.Let(is_mut=true)`，其 value 引用自身名字 —— LZ 语义为重绑定（Python 风格）。
        // 若照直发射 `let mut i = i + 1;` 会落成 Rust shadow-let，循环体内不累积外层变量
        // ⇒ 外层 i 恒为初值，`while i < 5 { i = i + 1 }` 无限循环挂死（g33_while RSLZ 超时）。
        // 原生 codegen 以 `declared.contains(name) && (is_mut || 自引用 || 循环内)` 判定改为
        // 赋值（stmt_gen.rs:653-737）；rs-lz 无作用域表，用等价判据「value 提到自身名字」
        // 覆盖：合法程序里 value 能引用 n，则 n 必已在作用域（自引用/循环重绑定两态都命中）。
        gen_rebind_assign(n, t, v, fn_raises, user_fns)
    else:
        let mut_kw = ("mut " if (m || str_contains(auto_mut, n)) else "").to_string()
        let ref_kw = ("ref " if r else "").to_string()
        let ty_s = rust_type(t)
        // 空容器强制类型标注（对齐原生 force_ty：空 ListLit / 空 Dict 构造 且 ty 为 Dict/Set）
        let empty_c = is_empty_container(v)
        let force = empty_c && is_dict_or_set_ty(t)
        if skip_ty_ann(t) && !force:
            "let ".to_string() + mut_kw + ref_kw + n.to_string() + " = ".to_string() + gen_expr(v, fn_raises, user_fns) + ";".to_string()
        else:
            "let ".to_string() + mut_kw + ref_kw + n.to_string() + ": ".to_string() + ty_s + " = ".to_string() + gen_expr(v, fn_raises, user_fns) + ";".to_string()

// BUG-454：重绑定赋值的纯语法收敛 —— `a = a op b`（标量 Int/F64/Bool，lhs 是变量 a 自身）
// → `a op= b`，对齐原生 stmt_gen.rs:685-714 与手写 Rust 惯用形态。非标量类型（String/
// BigInt 等无 AddAssign）或不符 lhs 形态则回退 `a = rhs`。
def gen_rebind_assign(n: str, t: IrType, v: Expr, fn_raises: MaybeIrType, user_fns: List[str]) -> String =
    match v:
        case Expr.BinOp(op: o, lhs: l, rhs: r, ty: tt) =>
            match l:
                case Expr.Var(name: ln, ty: lt) =>
                    if (ln == n) && is_scalar_ty(t):
                        let op_s = binop_compound_symbol(o)
                        if op_s != "":
                            n + " " + op_s + "= " + gen_expr(r, fn_raises, user_fns) + ";"
                        else:
                            n + " = " + gen_expr(v, fn_raises, user_fns) + ";"
                    else:
                        n + " = " + gen_expr(v, fn_raises, user_fns) + ";"
                case _ => n + " = " + gen_expr(v, fn_raises, user_fns) + ";"
        case _ => n + " = " + gen_expr(v, fn_raises, user_fns) + ";"

// BinOp 运算符 → 复合赋值符（+= -= *= /= %= &= |= ^= <<= >>=）；不支持者返回 ""
def binop_compound_symbol(op: str) -> String =
    if op == "+": "+"
    elif op == "-": "-"
    elif op == "*": "*"
    elif op == "/": "/"
    elif op == "%": "%"
    elif op == "&": "&"
    elif op == "|": "|"
    elif op == "^": "^"
    elif op == "<<": "<<"
    elif op == ">>": ">>"
    else: ""

// 原生 stmt_gen.rs 只对 Int/F64/Bool 做复合回写（String/BigInt 无 AddAssign ⇒ E0308）
def is_scalar_ty(t: IrType) -> bool =
    match t:
        case IrType.Int => true
        case IrType.F64 => true
        case IrType.Bool => true
        case _ => false

def is_empty_container(v: Expr) -> bool =
    match v:
        case Expr.ListLit(items: xs, ty: t) => xs.len() == 0
        case Expr.StructCtor(name: nn, fields: fs, ty: t) => nn == "Dict" && fs.len() == 0
        case _ => false

def is_dict_or_set_ty(t: IrType) -> bool =
    match t:
        case IrType.Named(path: p, args: a) => p == "Dict" || p == "Set"
        case _ => false

def skip_ty_ann(t: IrType) -> bool =
    // 对齐 Rust 版 codegen：skip_ty 逻辑（简化版 D1）
    match t:
        case IrType.Any => true
        case IrType.Unit => true
        case IrType.Duck(fields: fs) => true
        case IrType.Generic(name: nn) => true
        case IrType.FnType(params: ps, ret: rr) => true
        case IrType.Named(path: p, args: a) =>
            p == "Dict" || p == "Set" || p == "Range" || p == "Nil" || args_is_empty_or_generic(a)
        case IrType.Ref(inner: x) =>
            match x:
                case IrType.Generic(name: nn) => true
                case _ => false
        case IrType.MutRef(inner: x) =>
            match x:
                case IrType.Generic(name: nn) => true
                case _ => false
        case _ => false

def args_is_empty_or_generic(a: List<IrType>) -> bool =
    if a.len() == 0:
        true
    else:
        let mut has_generic = false
        for idx in 0..a.len():
            let ai = a[idx].clone()
            match ai:
                case IrType.Generic(name: nn) => has_generic = true
                case IrType.Any => has_generic = true
                case _ => has_generic = has_generic
        has_generic

// ── f64 字面量格式化：对齐 Rust to_string + 补 .0 规则 ──
// Rust: let s = f.to_string(); if s.contains('.') || s.contains('e') { s } else { s + ".0" }
def fmt_f64(n: f64) -> String =
    let s = n.to_string()
    if has_dot_or_e(s):
        s + "f64".to_string()
    else:
        s + ".0f64".to_string()

def has_dot_or_e(s: str) -> bool =
    let len = s.len()
    let mut i = 0
    let mut found = false
    while i < len:
        let c = s[i..(i + 1)]
        if c == "." || c == "e":
            found = true
        i = i + 1
    found

// ── f-string 模板解析（对齐原生 gen_fstring）──
// {expr} → {:?} 占位 + 参数列表；{{ → {{；}} → }}；无插值 → 普通字符串
def gen_fstring(s: str) -> String =
    let mut fmt: String = "".to_string()
    let mut args: List<str> = []
    let n = s.len()
    let mut i = 0
    while i < n:
        let c = s[i..(i + 1)]
        if c == "{":
            if i + 1 < n:
                let c2 = s[(i + 1)..(i + 2)]
                if c2 == "{":
                    fmt = fmt + "{{".to_string()
                    i = i + 2
                else:
                    // 提取插值表达式 {expr} 到匹配的 }
                    let mut j = i + 1
                    while j < n:
                        let cj = s[j..(j + 1)]
                        if cj == "}":
                            break
                        j = j + 1
                    let expr = s[(i + 1)..j]
                    fmt = fmt + "{:?}".to_string()
                    args.push(expr)
                    i = j + 1
            else:
                fmt = fmt + "{".to_string()
                i = i + 1
        elif c == "}":
            if i + 1 < n:
                let c2 = s[(i + 1)..(i + 2)]
                if c2 == "}":
                    fmt = fmt + "}}".to_string()
                    i = i + 2
                else:
                    fmt = fmt + "}".to_string()
                    i = i + 1
            else:
                fmt = fmt + "}".to_string()
                i = i + 1
        else:
            fmt = fmt + c
            i = i + 1
    let fmt_q = "\"".to_string() + esc_quote_only(fmt) + "\"".to_string()
    if args.len() == 0:
        fmt_q + ".to_string()".to_string()
    else:
        "format!(".to_string() + fmt_q + ", ".to_string() + args_join(args) + ")".to_string()

def args_join(xs: List<str>) -> String =
    if xs.len() == 0:
        "".to_string()
    else:
        let head = xs[0].clone()
        if xs.len() > 1:
            head.to_string() + ", ".to_string() + args_join(aj_tail(xs))
        else:
            head.to_string()

def aj_tail(xs: List<str>) -> List<str> =
    let mut out: List<str> = []
    for idx in 1..xs.len():
        out.push(xs[idx].clone())
    out

// 仅转义双引号（f-string 格式串对齐原生 gen_fstring：只 replace('"', "\\\"")，换行保持原样）
def esc_quote_only(s: String) -> String =
    let len = s.len()
    let mut out: String = "".to_string()
    let mut i = 0
    while i < len:
        let c = s[i..(i + 1)]
        if c == "\"":
            out = out + "\\\"".to_string()
        else:
            out = out + c
        i = i + 1
    out

// ── Rust 字符串转义（escape_default 常用子集）──
def esc_rust(s: str) -> String =
    // BUG-482：旧实现按字节切片 `s[i..(i+1)]`，多字节 UTF-8 字符（中文/破折号/emoji）
    // 会让 end byte index 落在字符中间 → 运行期 panic「not a char boundary」。
    // 改用 `replace` 链：Rust String::replace 按字符边界匹配，天然字节安全，且
    // 无需 chars() 迭代（rs-lz 对 `for ch in s.chars()` 生成 Rust char 元素，与
    // 拼接语境不兼容）。顺序固定：先转义 `\` 再转义其它特殊字符，保证结果一致。
    s.replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "\\n").replace("\t", "\\t").replace("\r", "\\r")

// ── Item 生成 ──

// BUG-431：trait 关联类型声明（§五 `type Item`）→ Rust `type Item;`。关联类型名必须在
// trait 内声明，否则 impl 端的 `type Item = i64` 报 E0191（trait 未声明关联类型）。
def gen_trait_assoc_types(ats: List<str>) -> String =
    let mut out: String = "".to_string()
    for idx in 0..ats.len():
        out = out + "    type ".to_string() + ats[idx].clone() + ";\n".to_string()
    out

// D2 缺口补齐：TraitDef 生成
def gen_trait_def(name: str, generics: List<(str, List<IrType>)>, supertraits: List<IrType>, assoc_types: List<str>, methods: List<(str, List<IrType>, IrType)>) -> String =
    let st_str = if supertraits.len() == 0:
        "".to_string()
    else:
        let mut st_parts: String = "".to_string()
        for idx in 0..supertraits.len():
            let st = supertraits[idx].clone()
            if idx > 0:
                st_parts = st_parts + " + ".to_string()
            st_parts = st_parts + rust_type(st)
        ": ".to_string() + st_parts
    "pub trait ".to_string() + name.to_string() + generic_sig_b(generics, []) + st_str + " {\n".to_string() + gen_trait_assoc_types(assoc_types) + gen_trait_methods(methods, assoc_types) + "\n}".to_string()

// self 标记类型（trait 形参表里可能保留一项 self 类型，渲染签名时须跳过）
def is_self_irtype(t: IrType) -> bool =
    match t:
        case IrType.Self_ => true
        case IrType.Ref(inner: i) => is_self_irtype(i)
        case IrType.MutRef(inner: i) => is_self_irtype(i)
        case _ => false

// BUG-431：trait 方法签名里的关联类型名须写成 `Self::Item`。原生此处直接发裸名
// `-> Item`（trait 内裸名本应可解析，但 Rust 仍报 E0425 cannot find type `Item`），
// rs-lz 侧修正为 `Self::Item` 以保证生成代码可编译。
def str_in_list(xs: List<str>, s: str) -> bool =
    let mut found = false
    for idx in 0..xs.len():
        if xs[idx].clone() == s:
            found = true
    found

def rust_type_assoc(t: IrType, ats: List<str>) -> String =
    match t:
        case IrType.Named(path: p, args: _) =>
            if str_in_list(ats, p):
                "Self::".to_string() + p
            else:
                rust_type(t)
        case _ => rust_type(t)

def gen_trait_methods(methods: List<(str, List<IrType>, IrType)>, assoc_types: List<str>) -> String =
    let mut out: String = "".to_string()
    for idx in 0..methods.len():
        let m = methods[idx].clone()
        // BUG-422：trait 方法签名必须带参数名——Rust 的 fn 签名不允许无名形参，
        // 且 self 要写成 `&self`（旧实现把 self 类型的 `&Self` 原样发射，既是无效
        // Rust，impl 侧又与其对不上 → E0185）。对齐原生 `fn add(&self, _p1: i64) -> i64;`：
        // 首个形参恒为 `&self`（LZ trait 方法均为实例方法）；形参表中若含 self 标记
        // （Ref(Self_)/MutRef(Self_)/Self_，序列化保留了它）需**跳过**，否则 self 被
        // 计两次 → E0050。其余按位置命名 `_pN`。
        let mut params: String = "&self".to_string()
        let mut pn: int = 1
        for pidx in 0..m.1.len():
            let pt = m.1[pidx].clone()
            if not is_self_irtype(pt):
                params = params + ", _p".to_string() + pn.to_string() + ": ".to_string() + rust_type_assoc(pt, assoc_types)
                pn = pn + 1
        out = out + "    fn ".to_string() + m.0.to_string() + "(".to_string() + params + ") -> ".to_string() + rust_type_assoc(m.2, assoc_types) + ";\n".to_string()
    out

// BUG-431：where 约束的 type_param 可能是关联类型路径（`I::Item`，含点号），Rust 里
// 要写成 `I::Item`（本就带 ::），故把 `.` 换成 `::`。LZ String 无 replace，用循环。
def dot_to_path(s: str) -> String =
    let mut out: String = "".to_string()
    let len = s.len()
    let mut i = 0
    while i < len:
        let c = s[i..(i + 1)]
        if c == ".":
            out = out + "::"
        else:
            out = out + c
        i = i + 1
    out

// BUG-431：impl 级 where 约束（原生 `impl<T> ... where I::Item: Clone, K: Eq`）。
// 须在 `{` 之前生成，否则 non-item in item list。
def impl_where_clause(wc: List<(str, List<IrType>)>) -> String =
    if wc.len() == 0:
        "".to_string()
    else:
        let mut parts: String = "".to_string()
        for idx in 0..wc.len():
            let w = wc[idx].clone()
            if idx > 0:
                parts = parts + ", ".to_string()
            parts = parts + dot_to_path(w.0) + ": ".to_string() + bounds_join(w.1)
        " where ".to_string() + parts

def bounds_join(bs: List<IrType>) -> String =
    let mut out: String = "".to_string()
    for idx in 0..bs.len():
        if idx > 0:
            out = out + " + ".to_string()
        out = out + rust_type(bs[idx].clone())
    out

// BUG-431：某泛型形参在 where 子句中的边界串（`where T: HasArea` → `HasArea`）。
def wc_bounds_for(tp: str, wc: List<(str, List<IrType>)>) -> String =
    let mut out: String = "".to_string()
    for idx in 0..wc.len():
        let w = wc[idx].clone()
        if w.0 == tp:
            out = bounds_join(w.1)
    out

// BUG-431：泛型形参签名（内联边界，对齐原生 `impl<T: Clone + Debug> Box4<T>` /
// `fn area_plus2<T: HasArea>`）。边界取泛型形参自身携带的 bounds，再并入 where 子句
// 中对该形参的约束；无边界时退化为原 `<T>` 形态，保持既有输出不变。
def generic_bounds(g: (str, List<IrType>), wc: List<(str, List<IrType>)>) -> String =
    let nm = g.0.clone()
    let bnds = g.1.clone()
    let mut out: String = bounds_join(bnds)
    let extra = wc_bounds_for(nm, wc)
    if extra.len() > 0:
        if out.len() > 0:
            out = out + " + ".to_string()
        out = out + extra
    out

def generic_sig_b(gs: List<(str, List<IrType>)>, wc: List<(str, List<IrType>)>) -> String =
    if gs.len() == 0:
        "".to_string()
    else:
        let mut out: String = "<".to_string()
        for idx in 0..gs.len():
            if idx > 0:
                out = out + ", ".to_string()
            let g = gs[idx].clone()
            let nm = g.0.clone()
            out = out + nm
            let bd = generic_bounds(g, wc)
            if bd.len() > 0:
                out = out + ": ".to_string() + bd
        out + ">".to_string()

// BUG-431：impl 关联类型绑定（§五 `type Item = T`）→ Rust `type Item = ...;`。
def gen_impl_assoc_bindings(atb: List<(str, IrType)>) -> String =
    let mut out: String = "".to_string()
    for idx in 0..atb.len():
        let b = atb[idx].clone()
        out = out + "    type ".to_string() + b.0.to_string() + " = ".to_string() + rust_type(b.1) + ";\n".to_string()
    out

// D2 缺口补齐：Impl 生成
def gen_impl_def(trait_: MaybeIrType, for_type: IrType, generics: List<(str, List<IrType>)>, where_clause: List<(str, List<IrType>)>, assoc_type_bindings: List<(str, IrType)>, methods: List<ImplMethod>, user_fns: List[str], tbm: List[(str, List[(str, bool)])], vem: List[(str, List[(str, List[str])])]) -> String =
    let trait_part = match trait_:
        case MaybeIrType.YesTy(t: ty) => rust_type(ty) + " for ".to_string()
        case MaybeIrType.NoTy => "".to_string()
    // BUG-434：trait impl 的接收者必须与 trait 声明一致。IR 里 TraitDef 方法接收者
    // 只记为 Self_（无 ref 标志），rs-lz 统一按 `&self` 渲染 trait 声明；而 impl 方法的
    // `("self", Self_, is_ref, ...)` 若 is_ref=false 则渲染为按值 `self`，两者不一致 →
    // rustc E0053 method `item` has an incompatible type for trait。原生把 trait impl
    // 的方法接收者也渲染为 `&self`（一致）。此处对 trait impl（trait_=YesTy）强制接收者
    // 取引用：&self / &mut self，绝不按值。固有 impl（NoTy）保持 IR 原语义。
    let force_ref = match trait_:
        case MaybeIrType.YesTy(t: ty) => true
        case MaybeIrType.NoTy => false
    let mut body: String = gen_impl_assoc_bindings(assoc_type_bindings)
    // BUG-434 同族：本 impl 的关联类型名（`type Name = String` 的 Name）登记后传给
    // gen_impl_method，供其把方法返回类型里的裸名改写为 `Self::Name`（否则 E0425）。
    let mut atb_names: List[str] = []
    for idx in 0..assoc_type_bindings.len():
        atb_names.push(assoc_type_bindings[idx].0)
    for idx in 0..methods.len():
        body = body + gen_impl_method(methods[idx].clone(), force_ref, atb_names, user_fns, tbm, vem)
    "impl ".to_string() + generic_sig_b(generics, where_clause) + trait_part + rust_type(for_type) + impl_where_clause(where_clause) + " {\n".to_string() + body + "}".to_string()

// BUG-422：真实方法体（对齐原生 impl 块内的 `fn name(...) -> ret { body }`）。
// 形参：self 渲染为 `&self` / `&mut self` / `self`（元组序 = name, ty, is_ref,
// is_mut, is_owned），其余 `name: ty`。返回 () 时省略 `-> ()`。
def gen_impl_method(m: ImplMethod, force_ref: bool, atb_names: List[str], user_fns: List[str], tbm: List[(str, List[(str, bool)])], vem: List[(str, List[(str, List[str])])]) -> String =
    let ret_s = "".to_string() if r_eq_unit(m.ret) else (" -> ".to_string() + rust_type_assoc(m.ret, atb_names))
    "    fn ".to_string() + m.name + "(".to_string() + impl_method_params(m.params, force_ref) + ")".to_string() + ret_s + " {\n".to_string() + gen_body(m.body, false, auto_mut_names(m.body), m.exc, user_fns, tbm, vem) + "    }\n".to_string()

def impl_method_params(ps: List<(str, IrType, bool, bool, bool)>, force_ref: bool) -> String =
    let mut out: String = "".to_string()
    for idx in 0..ps.len():
        let p = ps[idx].clone()
        if idx > 0:
            out = out + ", ".to_string()
        if p.0 == "self":
            out = out + self_param_str(p, force_ref)
        else:
            out = out + p.0 + ": ".to_string() + rust_type(p.1)
    out

def self_param_str(p: (str, IrType, bool, bool, bool), force_ref: bool) -> String =
    if force_ref:
        if p.3:
            "&mut self".to_string()
        else:
            "&self".to_string()
    elif p.4:
        "self".to_string()
    elif p.2:
        if p.3:
            "&mut self".to_string()
        else:
            "&self".to_string()
    else:
        // BUG-456：与原生对齐——原生对非 owned 的 self 默认发 `&self`（见 decl_gen.rs
        // 「self 参数修饰」分支：is_owned 才发 `self`，其余一律 `&self`）。rs-lz 旧实现
        // 落到 else 时发 `self`（按值接收），导致 `fn sum(self)` 而非 `fn sum(&self)`：
        // 语义上按值接收会 move 掉接收者，非 Copy struct 后续再用实例即 borrow-after-move。
        if p.3:
            "&mut self".to_string()
        else:
            "&self".to_string()

// D2 缺口补齐：UseStmt 生成
def gen_use_stmt(path: List<str>, alias: MaybeStr, items: List<str>, is_from: bool) -> String =
    let mut path_parts: String = "".to_string()
    for idx in 0..path.len():
        let ps = path[idx].clone()
        if idx > 0:
            path_parts = path_parts + "::".to_string()
        path_parts = path_parts + ps.to_string()
    let path_str = path_parts
    if is_from:
        if items.len() == 1 && items[0] == "*":
            "use ".to_string() + path_str + "::*;".to_string()
        else:
            let mut item_parts: String = "".to_string()
            for idx in 0..items.len():
                let it = items[idx].clone()
                if idx > 0:
                    item_parts = item_parts + ", ".to_string()
                item_parts = item_parts + it.to_string()
            "use ".to_string() + path_str + "::{".to_string() + item_parts + "}".to_string()
    else:
        "use ".to_string() + path_str + ";".to_string()

// D2 缺口补齐：TypeAlias 生成
def gen_type_alias(name: str, ty: IrType) -> String =
    "pub type ".to_string() + name.to_string() + " = ".to_string() + rust_type(ty) + ";".to_string()

// D2 缺口补齐：Test 生成
def gen_test_def(name: str, body: List<Stmt>, user_fns: List[str], tbm: List[(str, List[(str, bool)])], vem: List[(str, List[(str, List[str])])]) -> String =
    "#[test]\nfn ".to_string() + name.to_string() + "() {\n".to_string() + gen_body(body, false, auto_mut_names(body), MaybeIrType.NoTy, user_fns, tbm, vem) + "}".to_string()

// BUG-404（轮28）：--emit=rs-lz 缺 struct 提取魔法方法 __unapply__ / __unapply_seq__。
// 原生 codegen 对「带字段的非递归 struct」合成这两个方法（builder/convert_decl.rs:1911），
// 结构体解构糖化为 `.__unapply__()` 调用；LZ 版 codegen 未生成 → E0599
// （`let Point(a,b) = p` 报 no method named `__unapply__`）。此处补齐，输出与原生逐字符一致：
//   impl Point {
//       fn __unapply__(&self) -> (f64, f64) { return (self.x.clone(), self.y.clone()); }
//       fn __unapply_seq__(&self) -> Vec<f64> { return vec![self.x.clone(), self.y.clone()]; }
//   }
// `__unapply_seq__`（变长提取）仅当字段类型同构时生成（对应 convert_decl 的
// struct_has_unapply_seq 判定）。
// BUG-431：自动生成的 `__unapply__` impl 会对泛型字段调 `.clone()`，须带
// `Clone` 边界（原生对齐：`impl<T: std::clone::Clone + std::fmt::Debug> Box3<T>`，
// 边界由 struct 的 derive 推断而来，struct 自身泛型不带边界）。
def generic_sig_cd(gs: List<(str, List<IrType>)>) -> String =
    if gs.len() == 0:
        "".to_string()
    else:
        let mut out: String = "<".to_string()
        for idx in 0..gs.len():
            if idx > 0:
                out = out + ", ".to_string()
            out = out + gs[idx].clone().0 + ": std::clone::Clone + std::fmt::Debug"
        out + ">".to_string()

def gen_struct_unapply(name: str, generics: List<(str, List<IrType>)>, fs: List<(str, IrType)>) -> String =
    let mut tys: String = "".to_string()
    let mut accs: String = "".to_string()
    let mut same: bool = true
    for idx in 0..fs.len():
        let f = fs[idx].clone()
        if idx > 0:
            tys = tys + ", ".to_string()
            accs = accs + ", ".to_string()
        tys = tys + rust_type(f.1)
        accs = accs + "self.".to_string() + f.0.to_string() + ".clone()".to_string()
        if idx == 1:
            same = (rust_type(fs[0].clone().1) == rust_type(f.1))
        if idx > 1:
            if rust_type(fs[0].clone().1) != rust_type(f.1):
                same = false
    // 单字段 tuple 需尾逗号：原生为 `-> (i64,)` / `return (self.z.clone(),);`；
    // 而 `__unapply_seq__` 的 vec![...] 不追加尾逗号（原生 `vec![self.z.clone()]`）。
    let mut accs_tup: String = accs.clone()
    if fs.len() == 1:
        tys = tys + ","
        accs_tup = accs_tup + ","
    let mut out: String = "impl ".to_string() + generic_sig_cd(generics) + name.to_string() + generic_sig(generics) + " {\n".to_string()
    out = out + "    fn __unapply__(&self) -> (".to_string() + tys + ") {\n".to_string()
    out = out + "        return (".to_string() + accs_tup + ");\n".to_string()
    out = out + "    }\n".to_string()
    if same:
        out = out + "\n".to_string()
        out = out + "    fn __unapply_seq__(&self) -> Vec<".to_string() + rust_type(fs[0].clone().1) + "> {\n".to_string()
        out = out + "        return vec![".to_string() + accs + "];\n".to_string()
        out = out + "    }\n".to_string()
    out = out + "\n}\n".to_string()
    out

// BUG-473：方法定义语法 `def Type.method(...)`（点号固有方法）在 Rust 中必须是
// `impl Type { fn method(...) }`，不能发 `pub fn Type.method(...)`（非法 Rust，rustc 直接报
// 语法错）。原生 gen_item（decl_gen.rs:169-182）检测函数名含 `.` 即切分并包 impl 块。
// 此处返回 (类型名, 方法名)；名中无 `.` 时返回 (n, "")，由调用方据此判「非方法」。
def split_method_name(n: str) -> (str, str) =
    let dot = find_dot_index(n)
    if dot >= 0:
        (n[0..dot], n[(dot + 1)..n.len()])
    else:
        (n, "")

def find_dot_index(n: str) -> int =
    let mut i = 0
    let mut idx = -1
    let mut found = false
    while i < n.len():
        if !found and n[i..(i + 1)] == ".":
            idx = i
            found = true
        i = i + 1
    idx

def gen_item(i: Item, user_fns: List[str], tbm: List[(str, List[(str, bool)])], vem: List[(str, List[(str, List[str])])]) -> String =
    match i:
        case Item.FnDef(name: n, generics: gs, params: ps, ret: r, exc: rs, where_clause: wc, body: b) =>
            let (ty, mn) = split_method_name(n)
            if mn.len() > 0:
                // 固有方法：`impl Type { fn method(&self, ...) -> ret { body } }`
                // force_ref=false（与原生固有 impl 同口径）；gen_impl_method 负责 `fn` 前缀
                // 与 body 缩进；此处补 `impl <ty> {` 外壳与闭合 `}`。
                let im = ImplMethod(name: mn, params: ps, ret: r, exc: rs, body: b)
                // 固有方法无关联类型绑定 → atb_names 传空（rust_type_assoc 退化为 rust_type）。
                let mut empty_atb: List[str] = []
                "impl ".to_string() + ty + " {\n".to_string() + gen_impl_method(im, false, empty_atb, user_fns, tbm, vem) + "}\n".to_string()
            else:
                let is_main = (n == "main")
                let ret_s = "".to_string() if (is_main && r_eq_unit(r)) else (" -> ".to_string() + rust_type(r))
                let auto_mut = auto_mut_names(b)
                "pub fn ".to_string() + n.to_string() + generic_sig_b(gs, wc) + "(".to_string() + fn_param_list(ps, auto_mut) + ")".to_string() + ret_s + " {\n".to_string() + gen_body(b, is_main, auto_mut, rs, user_fns, tbm, vem) + "}".to_string()
        case Item.StructDef(name: n, generics: gs, fields: fs) =>
            let struct_def = "#[derive(Debug, Clone, PartialEq)]\npub struct ".to_string() + n.to_string() + generic_sig(gs) + " {\n".to_string() + gen_struct_fields(fs, n) + "}".to_string()
            if fs.len() > 0:
                struct_def + "\n\n".to_string() + gen_struct_unapply(n, gs, fs)
            else:
                struct_def
        case Item.EnumDef(name: n, generics: gs, variants: vs) =>
            "#[derive(Debug, Clone, PartialEq)]\npub enum ".to_string() + n.to_string() + generic_sig(gs) + " {\n".to_string() + gen_enum_variants(vs, n) + "}".to_string()
        case Item.Const(name: n, ty: t, value: v) =>
            gen_const_item(n, t, v, user_fns)
        case Item.TraitDef(name: n, generics: gs, supertraits: sts, assoc_types: ats, methods: ms) =>
            gen_trait_def(n, gs, sts, ats, ms)
        case Item.Impl(trait_: tr, for_type: ft, generics: gs, where_clause: wc, assoc_type_bindings: atb, method_names: mns) =>
            gen_impl_def(tr, ft, gs, wc, atb, mns, user_fns, tbm, vem)
        case Item.UseStmt(path: pth, alias: al, items: its, is_from: fr) =>
            gen_use_stmt(pth, al, its, fr)
        case Item.TypeAlias(name: n, ty: t) =>
            gen_type_alias(n, t)
        case Item.Test(name: n, body: b) =>
            gen_test_def(n, b, user_fns, tbm, vem)
        case Item.CheckerBlock(name: n, ps_name: p) =>
            "fn ".to_string() + n.to_string() + "(ps: &mut __Params) { unimplemented!() }".to_string()
        case Item.ScriptMain(body: b) =>
            // BUG-410：对齐原生 codegen/mod.rs:1370 !has_main 合成分支——
            // `pub fn main() {\n` + gen_block_inner(top_level_stmts) + `}`。
            // is_main=false 是关键：原生合成 main 不设 self.is_main，尾语句**带**
            // `return ` 前缀（声明式 main 才抑制），此处同口径。
            if b.len() == 0:
                "pub fn main() {\n}".to_string()
            else:
                "pub fn main() {\n".to_string() + gen_body(b, false, auto_mut_names(b), MaybeIrType.NoTy, user_fns, tbm, vem) + "}".to_string()
        case Item.DuckDef(name: n, method_count: mc) =>
            "pub trait ".to_string() + n.to_string() + " { /* ".to_string() + mc.to_string() + " methods */ }".to_string()
        case _ => "// TODO Item ".to_string() + display_item(i)

def r_eq_unit(t: IrType) -> bool =
    match t:
        case IrType.Unit => true
        case _ => false

def fn_param_list(ps: List<(str, IrType, bool, bool, bool)>, auto_mut: String) -> String =
    if ps.len() == 0:
        "".to_string()
    else:
        let p0 = ps[0].clone()
        fn_param_str(p0, auto_mut) + (", " + fn_param_list(pl_tail(ps), auto_mut) if ps.len() > 1 else "")

def fn_param_str(p: (str, IrType, bool, bool, bool), auto_mut: String) -> String =
    // BUG-444：函数体内发生 &mut 用法（`d.remove(..)`、集合 push/insert 等）的参数
    // 在 Rust 端须标 `mut`。原生 codegen 用 auto_mut_locals 同一扫描覆盖局部变量与
    // 参数，rs-lz 此前恒发 `name: type`（无 mut）⇒ E0596 cannot borrow as mutable。
    // 仅按精确名字匹配（逗号分隔 token），避免 `x` 误中 `xy`。
    (("mut " if auto_mut_has(auto_mut, p.0) else "").to_string()) + p.0.to_string() + ": ".to_string() + rust_type(p.1)  // D1: 忽略 ref/mut/owned 前缀（原生 codegen 对 fn 参数只输出 name: type，mut 前缀除外）

def auto_mut_has(list: String, name: str) -> bool =
    if list.len() == 0:
        false
    else:
        let padded = ",".to_string() + list + ","
        str_contains(padded, "," + name + ",")

def pl_tail(ps: List<(str, IrType, bool, bool, bool)>) -> List<(str, IrType, bool, bool, bool)> =
    let mut out: List<(str, IrType, bool, bool, bool)> = []
    for idx in 1..ps.len():
        out.push(ps[idx].clone())
    out

def gen_body(ss: List<Stmt>, is_main: bool, auto_mut: String, fn_raises: MaybeIrType, user_fns: List[str], tbm: List[(str, List[(str, bool)])], vem: List[(str, List[(str, List[str])])]) -> String =
    let n = ss.len()
    if n == 0:
        // 空函数体（抽象声明）：对齐原生 loop { unimplemented!() }
        "    loop {\n        unimplemented!()\n    }\n".to_string()
    else:
        let mut out: String = String::new()
        for idx in 0..n:
            let is_tail = (idx == n - 1)
            // 2026-10-08（方向 E）：与原生 codegen 对齐 —— 逐语句 `// STMT:*` 定位
            // 注释默认**不再发射**（它让生成 .rs 行数近乎翻倍、抬升 rustc 段开销，
            // 且全仓无断言依赖）。原生侧可用 `--stmt-marks` / `LZ_STMT_MARKS=1`
            // 恢复；本镜像跟随默认形态，保证 `tests/lz_ir_bootstrap.rs` 的
            // 「rs-lz 产物 == 常规 codegen 产物」逐字节等价断言成立。
            out = out + "    ".to_string() + gen_stmt(ss[idx].clone(), is_tail, is_main, auto_mut, fn_raises, user_fns, tbm, vem) + "\n".to_string()
        out

// STMT 类型标签（对齐原生 codegen 的 // STMT:{Let|Expr|Try|Block|Defer|If|For|Other}）
def stmt_type_label(s: Stmt) -> String =
    match s:
        case Stmt.Let(name: n, ty: t, value: v, is_mut: m, is_ref: r) => "Let".to_string()
        case Stmt.ExprStmt(expr: e) => "Expr".to_string()
        case Stmt.TryCatch(body: b, catches: cs, else_body: eb, finally_body: fb) => "Try".to_string()
        case Stmt.Block(stmts: b) => "Block".to_string()
        case Stmt.Defer(body: b) => "Defer".to_string()
        case Stmt.If(cond: c, then: t, els: e) => "If".to_string()
        case Stmt.For(var: v, iter: it, guard_e: g, body: b, else_body: eb) => "For".to_string()
        case _ => "Other".to_string()

// 对齐原生 codegen 的 auto_mut_locals：扫描函数体，找出需要标为 mut 的变量
// （add/push/append 等集合可变函数的首参、方法调用接收者、赋值目标）
// 返回逗号分隔的变量名字符串
def auto_mut_names(ss: List<Stmt>) -> String =
    let mut out: String = String::new()
    for idx in 0..ss.len():
        out = scan_stmt_auto_mut(ss[idx].clone(), out)
    out

def scan_stmt_auto_mut(s: Stmt, out: String) -> String =
    let mut acc = out.clone()
    match s:
        case Stmt.Let(name: n, ty: t, value: v, is_mut: m, is_ref: r) =>
            scan_expr_auto_mut(v, out)
        case Stmt.Assign(target: tg, value: v) =>
            acc = add_var_auto_mut(tg, acc)
            acc = scan_expr_auto_mut(tg, acc)
            acc = scan_expr_auto_mut(v, acc)
            acc
        case Stmt.ExprStmt(expr: e) =>
            scan_expr_auto_mut(e, out)
        case Stmt.Return(value: v) =>
            match v:
                case MaybeExpr.YesExpr(value: inner) => scan_expr_auto_mut(inner, out)
                case MaybeExpr.NoExpr => out
        case Stmt.If(cond: c, then: t, els: e) =>
            acc = scan_expr_auto_mut(c, acc)
            acc = scan_block_stmts_auto_mut(t, acc)
            acc = scan_block_maybe_auto_mut(e, acc)
            acc
        case _ => out

def scan_block_stmts_auto_mut(b: BlockIR, out: String) -> String =
    let mut acc = out.clone()
    match b:
        case BlockIR.Block(stmts: bss, ty: bt) =>
            for idx in 0..bss.len():
                acc = scan_stmt_auto_mut(bss[idx].clone(), acc)
            acc

def scan_block_maybe_auto_mut(mb: MaybeBlock, out: String) -> String =
    let mut acc = out.clone()
    match mb:
        case MaybeBlock.YesBlock(value: es) =>
            scan_block_stmts_auto_mut(es, acc)
        case MaybeBlock.NoBlock => out

// 如果 expr 是 Var，将其 name 追加到 out（逗号分隔）
def add_var_auto_mut(e: Expr, out: String) -> String =
    match e:
        case Expr.Var(name: n, ty: t) =>
            if str_contains(out, n):
                out.clone()
            else:
                let sep = ",".to_string() if out.len() > 0 else "".to_string()
                out + sep + n.to_string()
        case _ => out.clone()

def str_contains(s: String, sub: str) -> bool =
    let len = s.len()
    let sub_len = sub.len()
    if sub_len == 0:
        false
    else:
        let mut i = 0
        let mut found = false
        while i + sub_len <= len:
            if s[i..(i + sub_len)] == sub:
                found = true
            i = i + 1
        found

def scan_expr_auto_mut(e: Expr, out: String) -> String =
    let mut acc = out.clone()
    match e:
        case Expr.Call(callee: c, args: a, ty: t) =>
            acc = scan_expr_auto_mut(c, acc)
            for idx in 0..a.len():
                acc = scan_expr_auto_mut(a[idx].clone(), acc)
            if callee_is_mut_fn(c) && a.len() > 0:
                acc = add_var_auto_mut(a[0].clone(), acc)
            acc
        case Expr.MethodCall(receiver: r, method: m, args: a, ty: t) =>
            acc = add_var_auto_mut(r, acc)
            acc = scan_expr_auto_mut(r, acc)
            for idx in 0..a.len():
                acc = scan_expr_auto_mut(a[idx].clone(), acc)
            acc
        case Expr.IndexSet(base: b, key: k, value: v, ty: t) =>
            acc = add_var_auto_mut(b, acc)
            acc = scan_expr_auto_mut(b, acc)
            acc = scan_expr_auto_mut(k, acc)
            acc = scan_expr_auto_mut(v, acc)
            acc
        case Expr.AssignExpr(target: tg, value: v, ty: t) =>
            acc = add_var_auto_mut(tg, acc)
            acc = scan_expr_auto_mut(tg, acc)
            acc = scan_expr_auto_mut(v, acc)
            acc
        case Expr.FieldAccess(base: b, field: f, ty: t) =>
            // BUG-472：base 是字段（`c.d["a"] = 1` 的 FieldAccess 底座）时也要把 Var 底座
            // 记入 auto_mut，否则 `let c = ...` 缺 `mut`，rustc E0596 cannot borrow as mutable。
            acc = add_var_auto_mut(b, acc)
            scan_expr_auto_mut(b, acc)
        case Expr.IndexGet(base: b, key: k, ty: t) =>
            acc = add_var_auto_mut(b, acc)
            acc = scan_expr_auto_mut(b, acc)
            scan_expr_auto_mut(k, acc)
        case _ => out

def callee_is_mut_fn(c: Expr) -> bool =
    match c:
        case Expr.Var(name: nn, ty: tt) =>
            if nn == "add" || nn == "push" || nn == "append" || nn == "pop" || nn == "extend" || nn == "insert" || nn == "remove" || nn == "delete":
                true
            else:
                false
        case _ => false

// BUG-475：递归类型字段自动 Box（对齐 helpers.rs:759 field_needs_box + decl_gen.rs:1752-1766）。
// 递归 struct/enum（链表、树）字段类型为 Self_ 或 Named(自身名) 时必须发 `Box<T>`，
// 否则 rustc E0072 recursive type has infinite size。
def field_needs_box(ty: IrType, name: str) -> bool =
    match ty:
        case IrType.Self_ => true
        case IrType.Named(path: p, args: a) => p == name
        case IrType.Opt(inner: i) =>
            match i:
                case IrType.Self_ => true
                case IrType.Named(path: p, args: a) => p == name
                case _ => false
        case _ => false

// 字段类型字符串（递归字段包 Box）。对齐 decl_gen.rs:1752-1766 的三种形态：
//   Option<Self> → Option<Box<Self>>；裸 Self/Named → Box<T>；Vec/List<Self> → Vec<Box<T>>。
def field_ty_str(ty: IrType, name: str) -> String =
    if field_needs_box(ty, name):
        match ty:
            case IrType.Opt(inner: i) => "Option<Box<".to_string() + box_inner_ty(i, name) + ">>".to_string()
            case IrType.Named(path: p, args: a) =>
                if p == "Option":
                    "Option<Box<".to_string() + rust_type(ty) + ">>".to_string()
                elif p == "Vec" or p == "List":
                    "Vec<Box<".to_string() + rust_type(a[0]) + ">>".to_string()
                else:
                    "Box<".to_string() + rust_type(ty) + ">".to_string()
            case _ => "Box<".to_string() + rust_type(ty) + ">".to_string()
    else:
        rust_type(ty)

def box_inner_ty(i: IrType, name: str) -> String =
    match i:
        case IrType.Self_ => name
        case _ => rust_type(i)

def gen_struct_fields(fs: List<(str, IrType)>, sname: str) -> String =
    let mut out: String = "".to_string()
    for idx in 0..fs.len():
        let f = fs[idx].clone()
        out = out + "    pub ".to_string() + f.0.to_string() + ": ".to_string() + field_ty_str(f.1, sname) + ",\n".to_string()
    out

// BUG-411：命名字段变体定义（对齐原生 decl_gen.rs:1985 gen_enum_def）——
//   空字段        → `    Name,`
//   全命名字段    → `    Name {\n        f: ty,\n    },`
//   位置（元组）  → `    Name(ty, ty),`
// 旧实现只序列化字段类型、丢字段名，一律降级为元组变体，与原生产物分叉且
// 使 `x.f` 字段访问无从生成解构。
def gen_enum_variants(vs: List<(str, List<(str, IrType)>)>, ename: str) -> String =
    let mut out: String = "".to_string()
    for idx in 0..vs.len():
        let v = vs[idx].clone()
        out = out + "    ".to_string() + v.0.to_string() + gen_enum_variant_body(v.1, ename) + ",\n".to_string()
    out

def gen_enum_variant_body(fs: List<(str, IrType)>, ename: str) -> String =
    if fs.len() == 0:
        "".to_string()
    elif variant_fields_named(fs):
        let mut body: String = " {\n".to_string()
        for idx in 0..fs.len():
            let f = fs[idx].clone()
            body = body + "        ".to_string() + f.0.to_string() + ": ".to_string() + field_ty_str(f.1, ename) + ",\n".to_string()
        body + "    }".to_string()
    else:
        "(".to_string() + variant_field_types(fs, ename) + ")".to_string()

def variant_fields_named(fs: List<(str, IrType)>) -> bool =
    let mut all_named: bool = true
    for idx in 0..fs.len():
        let f = fs[idx].clone()
        if f.0 == "":
            all_named = false
    all_named

def variant_field_types(fs: List<(str, IrType)>, ename: str) -> String =
    let mut out: String = "".to_string()
    for idx in 0..fs.len():
        let f = fs[idx].clone()
        if idx > 0:
            out = out + ", ".to_string()
        out = out + field_ty_str(f.1, ename)
    out

def gen_enum_variant_args(ts: List<IrType>) -> String =
    if ts.len() == 0:
        "".to_string()
    else:
        "(".to_string() + type_rust_list(ts) + ")".to_string()

def gen_const_item(n: str, t: IrType, v: Expr, user_fns: List[str]) -> String =
    // 对齐原生 gen_const_def：ty=Str 且值为字符串字面量 → &str 裸字面量（转义）
    match t:
        case IrType.Str =>
            match v:
                case Expr.LitStr(s: sv, ty: tv) =>
                    "const ".to_string() + n.to_string() + ": &str = \"".to_string() + esc_rust(sv) + "\";".to_string()
                case _ => "const ".to_string() + n.to_string() + ": String = ".to_string() + gen_expr(v, MaybeIrType.NoTy, user_fns) + ";".to_string()
        case _ => "const ".to_string() + n.to_string() + ": ".to_string() + rust_type(t) + " = ".to_string() + gen_expr(v, MaybeIrType.NoTy, user_fns) + ";".to_string()

def is_magic_name(n: str) -> bool =
    n == "__name__" || n == "__file__" || n == "__package__" || n == "__path__" || n == "__doc__" || n == "__is_macro__"

def gen_magic_const(n: str, t: IrType, v: Expr, user_fns: List[str]) -> String =
    if n == "__is_macro__":
        "const ".to_string() + n.to_string() + ": bool = ".to_string() + gen_expr(v, MaybeIrType.NoTy, user_fns) + ";".to_string()
    else:
        // __name__/__file__/__package__/__path__/__doc__ → &str
        "const ".to_string() + n.to_string() + ": &str = ".to_string() + gen_expr(v, MaybeIrType.NoTy, user_fns) + ";".to_string()

// ── 模块组装 ──

// BUG-478：收集模块顶层 FnDef 的名字，供 gen_call 判断标准库魔法（sum/min/max/
// abs/zip/len/print/sorted/reversed/set!）是否被用户同名函数遮蔽。原生用
// `self.fn_param_types.contains_key(name)` 守卫；rs-lz 无可变全局，故在 main 里
// 一次性算好并穿透到 gen_expr/gen_call。
def module_user_fn_names(m: IrModule) -> List[str] =
    let mut out: List[str] = []
    for idx in 0..m.items.len():
        let it = m.items[idx].clone()
        match it:
            case Item.FnDef(name: n, generics: gs, params: ps, ret: r, exc: rs, where_clause: wc, body: b) =>
                if n != "main":
                    out = out + [n]
            case _ => ()
    out

def codegen_module(m: IrModule, user_fns: List[str]) -> String =
    // BUG-475：预计算类型元信息（Box 字段 + 变体字段序），供 gen_match_arm 在
    // match 解构端插 `let n = *n;`。LZ 无可变全局，只能像 user_fns 一样穿透。
    let tbm: List[(str, List[(str, bool)])] = type_box_map(m)
    let vem: List[(str, List[(str, List[str])])] = enum_variant_map(m)
    let mut out: String = module_header()
    for idx in 0..m.items.len():
        out = out + gen_item(m.items[idx].clone(), user_fns, tbm, vem) + "\n\n".to_string()
    // print_str 用 println! 会再补一个换行：裁剪末尾 "\n\n" 后补一个 "\n"
    out[0..(out.len() - 2)] + "\n".to_string()

def module_header() -> String =
    "\n// ── LZ rustc link recipe (BUG-10: lz_builtins re-exports num-bigint/num-complex) ──\n// To compile & run this generated file in isolation:\n//   rustc --edition 2021 --extern lz_builtins=<rlib> -L dependency=<deps_dir> -O <this_file>.rs\n//   <rlib>     = liblz_builtins.rlib (build it: `cargo build -p lz_builtins`)\n//   <deps_dir> = the directory containing that rlib (e.g. <workspace>/target/debug/deps)\n// Omitting -L gives error[E0463] even if this program never uses BigInt/Complex.\n// ─────────────────────────────────────────────────────────────────────────────────────\n\n#[allow(unused_imports)]\n#[allow(unused_variables)]\n#[allow(dead_code)]\n#[allow(non_snake_case)]\n\nuse std::collections::{HashMap, HashSet};\nuse std::any::Any;\nuse std::rc::Rc;\nuse std::sync::Arc;\nuse std::fmt::Debug;\nuse std::fmt::Display;\n\nuse lz_builtins::*;\n\n".to_string()