// ============================================================
// @curry — 函数柯里化
//
// 将 n 元函数转换为 n 层嵌套的一元函数。
// 每次部分应用返回一个新函数，直到所有参数都被提供。
//
// 语法：
//   @curry
//   def add(a: int, b: int, c: int) -> int = a + b + c
//
//   let add_1 = add(1)          // fn(int, int) -> int
//   let add_1_2 = add(1)(2)     // fn(int) -> int
//   let result = add(1)(2)(3)   // 6
//
// 类型转换：
//   fn(A, B, C) -> D
//   → fn(A) -> fn(B) -> fn(C) -> D
//
// 三元以上函数使用 Vec 缓存优化策略：
//   2 参数 → 嵌套闭包
//   3~6 参数 → Vec 参数缓存 + FnMut
//   >6 参数 → Box<dyn Fn> 嵌套
//
// 限制：
//   @curry 对 0 参数 / 1 参数函数无意义（编译器警告）
//   @curry 生成的闭包有堆分配开销
// ============================================================
