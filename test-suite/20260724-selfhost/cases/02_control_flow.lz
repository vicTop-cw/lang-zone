// ============================================================
// Phase 2: lz 自测试 — 02 控制流（规避 str→String 代码生成缺口）
// ============================================================

// 用 int 返回码代替 str 以避免 &str/String 缺口
def classify_int(x: int) -> int =
  if x > 0:
    1
  elif x < 0:
    -1
  else:
    0

def abs(x: int) -> int =
  if x >= 0:
    x
  else:
    -x

def sum_to(n: int) -> int =
  i = 0
  s = 0
  while i < n:
    s = s + i
    i = i + 1
  s

// 用迭代代替递归（递归涉及 int 类型推断问题）
def factorial_iter(n: int) -> int =
  i = 1
  result = 1
  while i <= n:
    result = result * i
    i = i + 1
  result

suite "if_tests":
  test "abs_positive":
    assert abs(5) == 5
  test "abs_negative":
    assert abs(-3) == 3
  test "abs_zero":
    assert abs(0) == 0
  test "classify_pos":
    assert classify_int(10) == 1
  test "classify_neg":
    assert classify_int(-5) == -1
  test "classify_zero":
    assert classify_int(0) == 0

suite "while_tests":
  test "sum_to_5":
    assert sum_to(5) == 10
  test "sum_to_0":
    assert sum_to(0) == 0
  test "sum_to_1":
    assert sum_to(1) == 0

suite "factorial_tests":
  test "factorial_5":
    assert factorial_iter(5) == 120
  test "factorial_0":
    assert factorial_iter(0) == 1
  test "factorial_1":
    assert factorial_iter(1) == 1
