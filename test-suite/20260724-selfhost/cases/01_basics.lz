// ============================================================
// Phase 2: lz 自测试 — 01 基础语法：变量/常量/字面量/操作符
// ============================================================

def twice(x: int) -> int = x * 2
def add(a: int, b: int) -> int = a + b
def is_positive(x: int) -> bool = x > 0
def negate(b: bool) -> bool = not b

test "int literal addition":
  assert 1 + 2 == 3

test "int literal multiplication":
  assert 3 * 4 == 12

test "int literal subtraction":
  assert 10 - 3 == 7

test "function call with literal":
  assert twice(21) == 42

test "function call with two params":
  assert add(100, 200) == 300

test "negative integer":
  assert -5 + 10 == 5

test "boolean literal true":
  assert True == True

test "boolean literal false":
  assert False == False

test "boolean not":
  assert negate(False) == True

test "comparison lt":
  assert is_positive(5) == True

test "comparison lt false":
  assert is_positive(-1) == False

test "comparison eq":
  assert 5 == 5

test "comparison ne":
  assert (5 != 3) == True

test "string literal":
  s = "hello"
  assert s == "hello"

test "fstring_basic":
  x = 42
  s = f"answer is {x}"
  assert s == "answer is 42"

test "mutable variable":
  y = 1
  y = y + 1
  assert y == 2

test "let immutable":
  let z = 100
  assert z == 100
