// 普通函数（regular function）：基础、默认参数、泛型、raises
def add(a: int, b: int) -> int = a + b

def power(base: int, exp: int = 2) -> int = base * exp

def identity<T>(x: T) -> T = x

enum AppError =
    BadInput(str)

def might_fail(x: int) -> int raises AppError =
    if x < 0:
        raise AppError.BadInput("neg")
    x
