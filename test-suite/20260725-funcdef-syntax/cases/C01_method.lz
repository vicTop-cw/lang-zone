// 方法（method）：struct 方法、mut self 方法、trait 抽象方法
struct Point =
    x: int
    y: int
    def area(self: Point) -> int = self.x + self.y
    def shift(mut self: Point, dx: int) -> Point = Point(x: self.x + dx, y: self.y)

trait Drawable =
    def draw(self: Self) -> str = ...
    def name(self: Self) -> str = ...

def use_method() -> int =
    let p = Point(x: 1, y: 2)
    p.area()
