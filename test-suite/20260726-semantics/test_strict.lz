// ============================================================
// test_strict.lz — --strict 模式测试 (strict mode)
// ============================================================

// strict 模式下要求类型注解更完整
// 以下测试验证 strict 模式的编译行为

// 完整类型注解函数
def add_strict(a: int, b: int) -> int = a + b

// 带类型注解的变量
def strict_var() -> int =
    x: int = 42
    x

// 严格模式下的 bool 操作
def strict_bool(x: int) -> bool =
    if x > 0:
        True
    else:
        False

def main() =
    assert add_strict(10, 20) == 30
    assert strict_var() == 42
    assert strict_bool(5) == True
    assert strict_bool(-1) == False
    print("test_strict: ALL PASSED")
