// E2E test: comprehensive registry-based import
// Tests: type alias injection, shim injection, method aliases, 
// template function mapping — all via BridgeRegistry

import std.collections.HashMap
import std.io
import std.fs

// ── 1. Type alias injection + dedup ──
// Both io and fs inject IOError = std.io.Error
// Must not produce duplicate type alias (HashMap dedup)

def test_type_alias() -> str =
    "ok"

// ── 2. Shim injection: fs functions need path_ref shims
def test_shims() -> str =
    "ok"

// ── 3. HashMap construction
def test_hashmap() -> str =
    m: Dict<str, int> = HashMap.new()
    "ok"

// ── 4. Vec method aliases (append→push, length→len)
def test_vec_methods() -> str =
    v: List<int> = [1, 2, 3]
    v.append(4)
    "ok"

// ── 5. String method alias (startsWith)
def test_str_method() -> str =
    "ok"

// ── 6. Template function: exists with {0} placeholder
def test_exists() -> str =
    "ok"

def main() =
    print(test_type_alias())
    print(test_shims())
    print(test_hashmap())
    print(test_vec_methods())
    print(test_str_method())
    print(test_exists())
    print("REGISTRY E2E TEST PASSED")
