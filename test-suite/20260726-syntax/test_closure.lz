// ============================================================
// test_closure.lz — 闭包测试 (closures / anonymous functions)
// ============================================================

// 简单闭包：|params| expr
def run_add() -> int =
    let f = |a, b| a + b
    f(3, 4)

// 单参数闭包
def run_square() -> int =
    let g = |n| n * n
    g(5)

// 闭包赋值给变量
def run_capture() -> int =
    x = 10
    let h = |y| x + y
    h(5)

// 链式调用闭包
def run_chain() -> int =
    let inc = |x| x + 1
    let dbl = |x| x * 2
    dbl(inc(3))

def main() =
    assert run_add() == 7
    assert run_square() == 25
    assert run_capture() == 15
    assert run_chain() == 8
    print("test_closure: ALL PASSED")
