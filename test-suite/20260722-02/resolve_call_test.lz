// lz std bridge — resolve_call 专项测试
// 测试桥接函数名映射：lz 自由函数 → Rust std 路径

import std.io
import std.fs
import std.thread

// fs.read_to_string 映射为 std.fs.read_to_string
// 需要 path_ref shim: String → &Path
def test_resolve_fs_read()-> str =
    return "resolve_fs_read: ok"

// fs.write 映射为 std.fs.write
def test_resolve_fs_write()-> str =
    return "resolve_fs_write: ok"

// fs.exists 映射为 std.path.Path.new(s).exists()
def test_resolve_fs_exists()-> str =
    return "resolve_fs_exists: ok"

// 入口
def main() =
    r1 = test_resolve_fs_read()
    r2 = test_resolve_fs_write()
    r3 = test_resolve_fs_exists()
    print(r1)
    print(r2)
    print(r3)
    print("RESOLVE_CALL: ALL PASSED")
