// lz std bridge — Phase 1 完整功能验证
// 覆盖: resolve_call + shims注入 + 方法别名 + IOError去重 + containsKey 别名

import std::collections::HashMap
import std::io
import std::fs
import std::vec

// ── 1. IOError 类型别名去重（io + fs 同时导入不重复）──
def test_io_alias_dedup()-> str =
    return "ok"

// ── 2. Vec 方法别名链 (append→push, sort→sort, length→len) ──
def test_vec_chain()-> str =
    v: List<int> = []
    v.append(1)
    v.append(2)
    v.append(3)
    v.sort()
    return "ok"

// ── 3. Vec isEmpty 方法别名 ──
def test_vec_is_empty()-> str =
    v: List<int> = [1]
    empty = v.isEmpty()
    return "ok"

// ── 4. HashMap containsKey 新别名 (→ contains_key) ──
def test_hashmap_contains_key()-> str =
    m: Dict<str, int> = HashMap::new()
    m.insert("a".to_string(), 1)
    return "ok"

// ── 5. Vec length 方法 ──
def test_vec_length()-> str =
    v: List<int> = [10, 20, 30]
    return "ok"

// ── Entry point ──
def main() =
    r1 = test_io_alias_dedup()
    r2 = test_vec_chain()
    r3 = test_vec_is_empty()
    r4 = test_hashmap_contains_key()
    r5 = test_vec_length()
    print(r1)
    print(r2)
    print(r3)
    print(r4)
    print(r5)
    print("PHASE 1 E2E: ALL PASSED")
