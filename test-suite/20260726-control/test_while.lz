// ============================================================
// test_while.lz — while 循环测试
// ============================================================

// 计数循环
def countdown(n: int) -> int =
    i = n
    c = 0
    while i > 0:
        c = c + 1
        i = i - 1
    c

// 累加和
def sum_to(n: int) -> int =
    i = 0
    s = 0
    while i < n:
        s = s + i
        i = i + 1
    s

// 阶乘
def factorial(n: int) -> int =
    i = 1
    result = 1
    while i <= n:
        result = result * i
        i = i + 1
    result

// while 零次执行
def zero_iter() -> int =
    i = 0
    while i < 0:
        i = i + 1
    i

def main() =
    assert countdown(3) == 3
    assert countdown(0) == 0
    assert sum_to(5) == 10
    assert sum_to(0) == 0
    assert sum_to(1) == 0
    assert factorial(5) == 120
    assert factorial(1) == 1
    assert factorial(0) == 1
    assert zero_iter() == 0
    print("test_while: ALL PASSED")
