// ============================================================
// test_if.lz — if/elif/else 分支测试
// ============================================================

// 简单 if
def simple_if(x: int) -> int =
    if x > 0:
        1
    else:
        0

// if/elif/else
def classify(x: int) -> int =
    if x > 0:
        1
    elif x < 0:
        -1
    else:
        0

// if 作为表达式
def abs_val(x: int) -> int =
    if x >= 0:
        x
    else:
        -x

// 嵌套 if
def nested_if(a: int, b: int) -> int =
    if a > 0:
        if b > 0:
            1
        else:
            0
    else:
        0

// if 返回 bool
def is_big(x: int) -> bool =
    if x > 100:
        True
    else:
        False

def main() =
    assert simple_if(5) == 1
    assert simple_if(-1) == 0
    assert simple_if(0) == 0
    assert classify(10) == 1
    assert classify(-5) == -1
    assert classify(0) == 0
    assert abs_val(5) == 5
    assert abs_val(-3) == 3
    assert abs_val(0) == 0
    assert nested_if(1, 1) == 1
    assert nested_if(1, 0) == 0
    assert nested_if(0, 1) == 0
    assert is_big(200) == True
    assert is_big(50) == False
    print("test_if: ALL PASSED")
