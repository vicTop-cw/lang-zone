{
  "name": "lz-lang",
  "displayName": "LZ Language Support",
  "description": "Syntax highlighting for the Lang-Zone (LZ) programming language",
  "version": "0.1.0",
  "publisher": "lang-zone",
  "license": "MIT",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "lz",
        "aliases": [
          "LZ",
          "lz",
          "Lang-Zone"
        ],
        "extensions": [
          ".lz"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "lz",
        "scopeName": "source.lz",
        "path": "./syntaxes/lz.tmLanguage.json"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lang-zone/lz-vscode"
  }
}