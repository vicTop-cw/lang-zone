{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "LZ",
  "scopeName": "source.lz",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#attribute-macros" },
    { "include": "#decorators" },
    { "include": "#function-definitions" },
    { "include": "#ellipsis-marker" },
    { "include": "#magic-methods" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#types" },
    { "include": "#function-calls" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#variables" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.lz",
          "begin": "/\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.line.double-slash.lz",
          "match": "//.*$"
        }
      ]
    },

    "strings": {
      "patterns": [
        {
          "name": "string.quoted.multi.f.lz",
          "begin": "f\"\"\"",
          "end": "\"\"\"",
          "patterns": [
            { "include": "#string-interpolation" }
          ]
        },
        {
          "name": "string.quoted.multi.r.lz",
          "begin": "r\"\"\"",
          "end": "\"\"\""
        },
        {
          "name": "string.quoted.multi.lz",
          "begin": "\"\"\"",
          "end": "\"\"\""
        },
        {
          "name": "string.quoted.double.f.lz",
          "begin": "f\"",
          "end": "\"",
          "patterns": [
            { "include": "#string-interpolation" }
          ]
        },
        {
          "name": "string.quoted.double.r.lz",
          "begin": "r\"",
          "end": "\""
        },
        {
          "name": "string.quoted.double.lz",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "include": "#string-escape" }
          ]
        }
      ]
    },

    "string-interpolation": {
      "patterns": [
        {
          "name": "constant.character.escape.lz",
          "match": "\\{\\{|\\}\\}"
        },
        {
          "name": "meta.embedded.expression.lz",
          "begin": "\\{",
          "end": "\\}",
          "patterns": [
            { "include": "$self" }
          ]
        }
      ]
    },

    "string-escape": {
      "patterns": [
        {
          "name": "constant.character.escape.lz",
          "match": "\\\\[nrt\\\\\"0]|\\\\x[0-9a-fA-F]{2}|\\\\u\\{[0-9a-fA-F]+\\}"
        }
      ]
    },

    "attribute-macros": {
      "patterns": [
        {
          "name": "meta.attribute.lz",
          "match": "#!\\s*(\\w+|\\[\\w+(\\([^)]*\\))?\\])\\s*(\\([^)]*\\))?",
          "captures": {
            "0": { "name": "keyword.control.attribute.lz" }
          }
        }
      ]
    },

    "decorators": {
      "patterns": [
        {
          "name": "meta.decorator.lz",
          "match": "@\\w+\\s*(\\([^)]*\\))?",
          "captures": {
            "0": { "name": "entity.name.tag.decorator.lz" }
          }
        }
      ]
    },

    "function-definitions": {
      "patterns": [
        {
          "name": "meta.function.lz",
          "match": "\\b(def|async\\s+def)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.function.lz" },
            "2": { "name": "entity.name.function.lz" }
          }
        }
      ]
    },

    "function-calls": {
      "patterns": [
        {
          "name": "meta.function-call.lz",
          "match": "\\b([a-z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.lz" }
          }
        }
      ]
    },

    "ellipsis-marker": {
      "patterns": [
        {
          "name": "storage.type.ellipsis.lz",
          "match": "\\.\\.\\."
        }
      ]
    },

    "magic-methods": {
      "patterns": [
        {
          "name": "support.function.magic.lz",
          "match": "__[a-zA-Z_][a-zA-Z0-9_]*__"
        }
      ]
    },

    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.lz",
          "match": "\\b(if|elif|else|match|case|guard|for|while|loop|pass|break|continue|return|with|defer|raise|try|catch|finally|yield|async|await|spawn|go|comptime|panic|assert|check)\\b"
        },
        {
          "name": "storage.type.lz",
          "match": "\\b(def|struct|enum|trait|impl|type|const|let|mut|ref|owned|magic|macro|template|test|suite|setup|teardown|import|from|as|where|raises|Number)\\b"
        },
        {
          "name": "keyword.operator.word.lz",
          "match": "\\b(and|or|not|is|in)\\b"
        }
      ]
    },

    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.lz",
          "match": "\\b(True|False)\\b"
        },
        {
          "name": "constant.language.null.lz",
          "match": "\\bNone\\b"
        },
        {
          "name": "constant.language.option.lz",
          "match": "\\b(Some|Ok|Err)\\b"
        },
        {
          "name": "constant.language.unit.lz",
          "match": "\\b(Unit|Never|Nil)\\b"
        }
      ]
    },

    "types": {
      "patterns": [
        {
          "name": "support.type.builtin.lz",
          "match": "\\b(int|f64|str|bool|Self)\\b"
        },
        {
          "name": "support.type.container.lz",
          "match": "\\b(List|Dict|Set|Option|Result)\\b"
        }
      ]
    },

    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.lz",
          "match": "\\b0[xX][0-9a-fA-F_]+"
        },
        {
          "name": "constant.numeric.octal.lz",
          "match": "\\b0[oO][0-7_]+"
        },
        {
          "name": "constant.numeric.binary.lz",
          "match": "\\b0[bB][01_]+"
        },
        {
          "name": "constant.numeric.float.lz",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*([eE][+-]?[0-9][0-9_]*)?\\b"
        },
        {
          "name": "constant.numeric.float.lz",
          "match": "\\b[0-9][0-9_]*[eE][+-]?[0-9][0-9_]*\\b"
        },
        {
          "name": "constant.numeric.integer.lz",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },

    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.compound.lz",
          "match": "\\+=|-=|\\*\\*=|\\*=|/=|%=|&=|\\|=|\\^=|<<=|>>="
        },
        {
          "name": "keyword.operator.arrow.lz",
          "match": "->|=>"
        },
        {
          "name": "keyword.operator.range.inclusive.lz",
          "match": "\\.\\.="
        },
        {
          "name": "keyword.operator.range.lz",
          "match": "\\.\\."
        },
        {
          "name": "keyword.operator.pipe.lz",
          "match": "\\|>"
        },
        {
          "name": "keyword.operator.walrus.lz",
          "match": ":="
        },
        {
          "name": "keyword.operator.null-coalescing.lz",
          "match": "\\?\\?"
        },
        {
          "name": "keyword.operator.safe-navigation.lz",
          "match": "\\?\\."
        },
        {
          "name": "keyword.operator.build.lz",
          "match": "=:|~:|\\*:"
        },
        {
          "name": "keyword.operator.comparison.lz",
          "match": "==|!=|<=|>="
        },
        {
          "name": "keyword.operator.shift.lz",
          "match": "<<|>>"
        },
        {
          "name": "keyword.operator.logical.lz",
          "match": "&&|\\|\\|"
        },
        {
          "name": "keyword.operator.arithmetic.lz",
          "match": "\\*\\*|[+\\-*/%]"
        },
        {
          "name": "keyword.operator.comparison.single.lz",
          "match": "<|>"
        },
        {
          "name": "keyword.operator.assignment.lz",
          "match": "="
        },
        {
          "name": "keyword.operator.bitwise.lz",
          "match": "&|\\||~"
        },
        {
          "name": "keyword.operator.ownership.lz",
          "match": "\\^"
        },
        {
          "name": "keyword.operator.nullable.lz",
          "match": "\\?"
        },
        {
          "name": "keyword.operator.negation.lz",
          "match": "!"
        },
        {
          "name": "punctuation.separator.colon.lz",
          "match": ":"
        },
        {
          "name": "punctuation.separator.lz",
          "match": ","
        },
        {
          "name": "punctuation.accessor.lz",
          "match": "\\."
        }
      ]
    },

    "variables": {
      "patterns": [
        {
          "name": "variable.other.readwrite.lz",
          "match": "\\b[a-z_][a-zA-Z0-9_]*\\b"
        },
        {
          "name": "entity.name.type.lz",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}