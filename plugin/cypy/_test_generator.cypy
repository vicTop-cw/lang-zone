"""
Round 2a: 测试 Cypy 生成器 —— yield
"""
# 1. 简单 yield 生成器
def simple_gen() -> int:
    yield 1
    yield 2
    yield 3
    return 0

# 2. yield 在 for 循环中
def gen_in_loop() -> int:
    let i: int = 3
    for loop in "xxx":
        if i <= 0:
            break
        yield i
        i = i - 1
    return 0

def main() -> int:
    print("=== Generator Test ===")
    print("simple_gen: defined")
    print("gen_in_loop: defined")
    print("=== Done ===")
    return 0