# 作用域边界测试

# 1. 嵌套函数中的变量遮蔽
def test_shadow() -> int:
    let x: int = 10
    def inner() -> int:
        let x: int = 20
        return x
    return inner()

# 2. 闭包捕获外部变量
def test_closure() -> int:
    let x: int = 10
    def inner() -> int:
        return x
    return inner()

# 3. 同名变量在不同作用域
def test_same_name() -> int:
    let x: int = 1
    if x > 0:
        let y: int = x + 1
        return y
    return 0

# 4. 循环内 let 声明
def test_let_in_loop() -> int:
    let total: int = 0
    let counter: int = 0
    for i in range(3):
        let doubled: int = counter * 2
        total = total + doubled
        counter = counter + 1
    return total

# 5. 多层嵌套函数
def test_deep_nested_func() -> int:
    def level1() -> int:
        def level2() -> int:
            def level3() -> int:
                return 42
            return level3()
        return level2()
    return level1()

# 6. 全局变量遮蔽
let GLOBAL_VAL: int = 100

def test_global_shadow() -> int:
    let GLOBAL_VAL: int = 200
    return GLOBAL_VAL

# 7. if 块内变量作用域
def test_if_scope(flag: bool) -> int:
    let result: int = 0
    if flag:
        let temp: int = 10
        result = temp
    return result