# ============================================================
# Bug 复测: Round 5 - 边界与组合测试
# ============================================================

# Bug-R5-1: 类型别名解析失败
type MyInt = int
type MyList = list[int]
def test_type_alias(x: MyInt) -> MyList:
    return [x]

# Bug-R5-2: tuple 返回类型被误判为 list
# def test_empty_tuple() -> tuple:
#     return ()

# Bug-R5-3: 嵌套泛型类型解析为 list[object]
type NestedAlias = list[list[int]]
def test_nested_alias(x: NestedAlias) -> int:
    return 0

# Bug-R5-4: 函数类型注解语法不支持
# def test_func_type(f: (int) -> int) -> int:  # 如果报错则 Bug-R5-4 仍存在
#     return f(1)

# Bug-R5-5: for i in range(n) 循环变量类型为 object
def test_for_range() -> int:
    let total: int = 0
    for i in range(3):
        total = total + 1
    return total

# Bug-R5-6: case other: 变量绑定模式不支持
def test_match() -> int:
    let result: int = 0
    match result:
        case 0:
            result = 1
        case 1:
            result = 2
        else:
            result = 99
    return result

# Bug-R5-7: defer expr 单行语法不支持
def test_defer() -> int:
    let result: int = 0
    defer:
        result = result + 1
    return result

# Bug-R5-8: 十六进制/八进制/二进制字面量不支持
# def test_hex() -> int:
#     return 0xFF  # 如果报错则 Bug-R5-8 仍存在

# Bug-R5-9: 浮点数精度截断
def test_float_precision() -> float:
    return 3.14159265358979323846

# Bug-R5-10: 模块级 let 声明生成 cdef int 而非 Python 全局变量
let GLOBAL_VAL: int = 100

# Bug-R5-11: 转义序列 \t, \n 在代码生成中丢失
def test_escape() -> str:
    return "tab:\t newline:\n quote:\" backslash:\\"