# Bug-R4-1: @decorator 装饰器语法不支持
# def decorator(func):
#     return func
# @decorator  # 如果报错则 Bug-R4-1 仍存在
# def decorated() -> int:
#     return 1

# Bug-R4-2: test 关键字未注册到作用域
# test def test_simple() -> int:  # 如果报错则 Bug-R4-2 仍存在
#     return 0

# Bug-R4-3: in 运算符在 if 条件中不支持
def test_in() -> int:
    if "a" in "abc":
        return 1
    return 0

# Bug-R4-4: is 运算符在 if 条件中不支持
def test_is() -> int:
    let x: int = 1
    if x is 1:
        return 1
    return 0

# Bug-R4-5: not 关键字在 if 条件中不支持
def test_not() -> int:
    if not 1 == 2:
        return 1
    return 0

# Bug-R4-6: del 关键字未定义
