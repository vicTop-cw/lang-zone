# ============================================================
# Round 6 综合重测: 编译器源码审查发现的关键 Bug
# ============================================================

# --- 可测试的 R6 Bug ---

# Bug-R6-1: 不支持十六进制/八进制/二进制字面量 (与 R5-8 重复)
# def test_hex_r6() -> int:
#     return 0xFF

# Bug-R6-7: match 模式不支持变量绑定 (与 R5-6 相关)
def test_match_var(x: int) -> int:
    match x:
        case 0:
            return 0
        case _:
            return -1

# Bug-R6-8: 复合赋值不支持 Subscript 目标
# def test_subscript_assign() -> int:
#     let lst: list[int] = [1, 2, 3]
#     lst[0] += 1  # 取消注释测试 Bug-R6-8
#     return 0

# Bug-R6-12: _parse_typed_var 不区分 let/val
val CONST_VAL: int = 42
# def test_val_mutable() -> int:
#     CONST_VAL = 100  # 应该报错但不报

# Bug-R6-15: for i in range(n) 循环变量推断为 object (与 R5-5 重复)
def test_for_type() -> int:
    let total: int = 0
    for i in range(5):
        total = total + i
    return total

# Bug-R6-17: 类型别名未在 _get_type_from_node 中解析 (与 R5-1 重复)
type MyType = int
def test_alias_r6(x: MyType) -> MyType:
    return x

# Bug-R6-18: 缺少 MatchStmt 类型检查
def test_match_type(x: int) -> int:
    match x:
        case 0:
            return 0
        case _:
            return -1

# Bug-R6-19: 缺少 GuardStmt 类型检查
def test_guard_type(x: int) -> int:
    guard x >= 0 else:
        return -1
    return x

# Bug-R6-20: 缺少 DeferStmt 类型检查
def test_defer_type() -> int:
    defer:
        let cleanup: int = 1
    return 0

# Bug-R6-25: 缺少大量 AST 节点的代码生成方法
# - TryStmt 测试
def test_try_block() -> int:
    try:
        let x: int = 1
    except:
        let x: int = 0
    return 0

# - RaiseStmt 测试
def test_raise() -> int:
    raise Exception("test")
    return 0

# - AssertStmt 测试
def test_assert() -> int:
    assert 1 == 1
    return 0

def main() -> int:
    return 0