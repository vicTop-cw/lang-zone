# Test: generic function type inference
struct Pair[T]:
    first: T
    second: T

def make_pair[T](a: T, b: T) -> Pair[T]:
    return Pair {first: a, second: b}

def make_pair_with_constraint[T: int](a: T, b: T) -> Pair[T]:
    return Pair {first: a, second: b}

def main() -> int:
    # 推断为 make_pair[int]
    p1 = make_pair(1, 2)
    # 推断为 make_pair[str]
    p2 = make_pair("hello", "world")
    # 使用显式类型参数
    p3 = make_pair[float](1.5, 2.5)
    # 测试约束
    p4 = make_pair_with_constraint(1, 2)
    return p1.first