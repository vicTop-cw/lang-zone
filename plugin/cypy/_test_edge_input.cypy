# 极端输入测试

# 1. 空函数
def test_empty_func() -> int:
    return 0

# 2. 多参数函数
def test_many_params(a: int, b: int, c: int, d: int, e: int, f: int, g: int, h: int) -> int:
    return a + b + c + d + e + f + g + h

# 3. 递归函数
def test_recursive(n: int) -> int:
    if n <= 0:
        return 0
    return n + test_recursive(n - 1)

# 4. 尾递归风格
def test_tail_recursive(n: int, acc: int) -> int:
    if n <= 0:
        return acc
    return test_tail_recursive(n - 1, acc + n)

# 5. 无类型注解函数
def test_no_type_annot(x: int) -> int:
    return x

# 6. 无返回值函数
def test_no_return():
    print("hello")

# 7. 多返回语句
def test_multi_return(x: int) -> int:
    if x > 0:
        return 1
    elif x < 0:
        return -1
    return 0

# 8. 运算符重载风格
def test_chained_compare(x: int) -> bool:
    if x > 0:
        if x < 10:
            return True
    return False