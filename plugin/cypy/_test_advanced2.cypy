# 高级特性测试：管道、构建块、f-string、as类型转换

# 1. 管道操作符测试
def add_one(x: int) -> int:
    return x + 1

def double(x: int) -> int:
    return x * 2

def test_pipe() -> int:
    let result: int = 5 |> add_one |> double
    print(result)
    return result

# 2. 变量构建块 =: 测试
def test_var_build_block() -> int:
    result =:
        x = 10
        y = 20
        x + y
    return result

# 3. 调用构建块 ~: 测试
def greet(name: str, age: int) -> str:
    return f"Hello {name}, age {age}"

def test_call_build_block() -> str:
    return greet ~:
        name = "World"
        age = 42

# 4. 生成器构建块 *: 测试
def process_items(items: list) -> int:
    for item in items:
        print(item)
    return 0

def test_gen_build_block() -> int:
    result = process_items *:
        yield (1,)
        yield (2,)
        yield (3,)
    return result

# 5. f-string 测试
def test_fstring() -> str:
    name: str = "Cypy"
    version: int = 2
    return f"Testing {name} version {version}"

# 6. as 类型转换测试
def test_as_cast() -> float:
    a: int = 42
    b: float = a as float
    c: int = b as int
    return (a + c) as float

def main() -> int:
    print("=== Testing Advanced Cypy Features ===")

    print("--- Pipe Operator ---")
    pipe_result: int = test_pipe()
    print(f"Pipe result: {pipe_result}")

    print("--- Variable Build Block ---")
    var_result: int = test_var_build_block()
    print(f"Var build block result: {var_result}")

    print("--- Call Build Block ---")
    call_result: str = test_call_build_block()
    print(f"Call build block result: {call_result}")

    print("--- Generator Build Block ---")
    gen_result: int = test_gen_build_block()
    print(f"Gen build block result: {gen_result}")

    print("--- F-string ---")
    fstr_result: str = test_fstring()
    print(f"F-string result: {fstr_result}")

    print("--- As Type Cast ---")
    cast_result: float = test_as_cast()
    print(f"As cast result: {cast_result}")

    print("=== All tests passed ===")
    return 0

main()