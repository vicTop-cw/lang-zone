# Test: generic parameter union constraint
def add[T: int | float](a: T, b: T) -> T:
    return a + b

def main() -> int:
    x = add(1, 2)      # OK: int satisfies int | float
    y = add(1.5, 2.5)  # OK: float satisfies int | float
    z = add("a", "b")  # Should fail: str does not satisfy int | float
    return x