# Test R7-8: 布尔运算符 and 在表达式中
def test_and_expr() -> int:
    if True and False:
        return 1
    return 0

# Test R7-9: 布尔运算符 or 在表达式中
def test_or_expr() -> int:
    if True or False:
        return 1
    return 0

# Test R7-10: not 在表达式中
def test_not_expr() -> bool:
    return not True

# Test R7-11: 比较运算符链
def test_compare_chain(a: int, b: int, c: int) -> bool:
    return a < b and b < c

# Test R7-12: 下标表达式嵌套
def test_nested_subscript() -> int:
    let lst: list[int] = [1, 2, 3]
    return lst[0]

# Test R7-13: 属性访问链
def test_attr_chain() -> int:
    let p: Point = Point{x: 1, y: 2}
    return 0

# Test R7-14: 函数调用链
def test_call_chain() -> int:
    return 0

# Test R7-15: 混合运算符优先级
def test_mixed_precedence() -> int:
    return 1 + 2 * 3 - 4 / 2

# Test R7-16: 负号与括号
def test_neg_paren() -> int:
    return -(1 + 2) * 3

# Test R7-17: 类型转换
def test_type_cast() -> int:
    let f: float = 3.14
    let x: int = int(f)
    return x

struct Point:
    x: int = 0
    y: int = 0

