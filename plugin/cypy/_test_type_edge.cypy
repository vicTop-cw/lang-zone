# 类型系统边界测试

# 1. 深层嵌套类型注解
def test_nested_list(l: list[list[list[int]]]) -> int:
    return 0

# 2. 多重联合类型
def test_multi_union(x: int | str | float | None) -> int:
    return 0

# 3. 可选类型
def test_optional(x: int | None) -> int:
    return 0

# 4. Any 类型
def test_any(x: Any) -> int:
    return 0

# 5. 类型别名
type MyInt = int
type MyList = list[int]
type NestedAlias = list[list[int]]

def test_type_alias(x: MyInt) -> MyList:
    return [x]

# 6. 嵌套类型别名
def test_nested_alias(x: NestedAlias) -> int:
    return x[0]

# 7. 复杂返回类型
def test_complex_return() -> list[int | str]:
    return [1, "hello"]

# 9. 空元组类型
def test_empty_tuple() -> tuple:
    return ()

# 10. 元组类型
def test_tuple_type() -> tuple[int, str, float]:
    return (1, "a", 1.0)

# 11. 多层可选
def test_multi_optional(x: int | None | str | None) -> int:
    return 0

# 12. 泛型列表嵌套
def test_generic_nested() -> list[list[int | str]]:
    return [[1, "a"]]