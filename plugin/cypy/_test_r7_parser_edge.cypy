# Test: 解析层边界测试 - 深层嵌套、复杂表达式
def test_deep_if_else() -> int:
    if 1:
        if 2:
            if 3:
                if 4:
                    return 42
    return 0

def test_deep_match() -> int:
    match 1:
        case 1:
            match 2:
                case 2:
                    return 42
                case _:
                    return 0
        case _:
            return 0

def test_tuple_expr() -> int:
    let t: tuple[int, int] = (1, 2)
    return t[0]

def test_paren_expr() -> int:
    return (((1 + 2) * 3) - 4)

def test_chained_compare() -> bool:
    return 1 < 2 && 2 < 3

def test_subscript_assign() -> int:
    let lst: list[int] = [1, 2, 3]
    return lst[0]

def test_attr_assign() -> int:
    struct Point:
        x: int = 0
        y: int = 0
    let p: Point = Point{x: 1, y: 2}
    return p.x

def test_method_call() -> int:
    let s: str = "hello"
    return 0

