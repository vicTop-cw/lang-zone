# Test: 数字字面量边界测试
def test_hex() -> int:
    let x: int = 255
    return x

def test_hex_upper() -> int:
    let x: int = 255
    return x

def test_binary() -> int:
    let x: int = 10
    return x

def test_octal() -> int:
    let x: int = 511
    return x

def test_underscore_num() -> int:
    let x: int = 1000000
    return x

def test_big_int() -> int:
    return 9999999999999999999

def test_negative_hex() -> int:
    return -255

def test_float_sci() -> float:
    return 1.5e10

def test_float_neg_sci() -> float:
    return -1.5e-10

def main() -> int:
    return 0