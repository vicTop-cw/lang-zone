# Test: 词法层边界测试 - 注释、Unicode、数字、字符串
def test_comment_after_expr() -> int:
    return 1  # comment after return

def test_unicode_ident() -> int:
    # 测试 Unicode 标识符
    let 变量: int = 42
    return 变量

def test_hex_literal() -> int:
    let x: int = 0xFF
    return x

def test_binary_literal() -> int:
    let x: int = 0b1010
    return x

def test_octal_literal() -> int:
    let x: int = 0o777
    return x

def test_float_scientific() -> float:
    return 1.5e10

def test_string_escape() -> str:
    return "hello\nworld"

def test_raw_string() -> str:
    return "hello\tworld"

def test_multi_line_string() -> str:
    return "hello world"

def test_fstring() -> str:
    return "hello"

def test_empty_return() -> None:
    return

def test_pass_stmt() -> None:
    return

def test_underscore_num() -> int:
    return 1_000_000

