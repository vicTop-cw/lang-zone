# Bug-R4-3/R4-4/R4-5: in/is/not 运算符
def test_in_operator(s: str) -> bool:
    if "a" in s:
        return True
    return False

def test_is_operator(x: int) -> bool:
    if x is None:
        return True
    return False

def test_not_operator(x: int) -> bool:
    if not x > 0:
        return True
    return False

def main() -> int:
    return 0
