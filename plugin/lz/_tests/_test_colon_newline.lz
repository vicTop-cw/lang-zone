def test_guard_no_newline() =
    x = 10
    guard x > 0 else: return "fail"
    print("ok")

def test_guard_with_newline() =
    x = 10
    guard x > 0 else:
        return "fail"
    print("ok")

def test_match_no_newline() =
    val = 42
    result = match val:
        case 1: print("one")
        case 42: print("answer")
        case _: print("other")

def test_match_with_newline() =
    val = 42
    result = match val:
        case 1:
            print("one")
        case 42:
            print("answer")
        case _:
            print("other")

def main() =
    test_guard_no_newline()
    test_guard_with_newline()
    test_match_no_newline()
    test_match_with_newline()
