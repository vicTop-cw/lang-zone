// _test_control_flow.lz — 阶段 5: 控制流与错误处理测试

// ── 5.1 模式匹配 ──

def test_match_guard() =
    x = 10
    match x:
        case 5:
            print("Five")
        case 10:
            print("Ten")
        case n:
            print("Other")

def test_match_bool() =
    b = true
    match b:
        case true:
            print("True")
        case false:
            print("False")

// ── 5.2 错误处理 ──

def test_try_catch() =
    try:
        print("Try block")
    catch e:
        print("Catch: ")
        print(e)

def test_guard_cond() =
    x = 10
    guard x > 0 else:
        print("Guard failed")
    print("Guard passed")

def test_guard_let() =
    opt = Some(42)
    guard let Some(val) = opt else:
        print("None")
        return
    print("Value: ")
    print(val)

// ── 5.3 闭包与高阶 ──

def test_closure_capture() =
    factor = 10
    multiply = |x| x * factor
    result = multiply(5)
    print("Closure result: ")
    print(result)

def test_for_loop() =
    for i in 0..3:
        print("For i: ")
        print(i)

// ── 主入口 ──
def main() =
    print("=== Control Flow Test ===")
    test_match_guard()
    test_match_bool()
    test_try_catch()
    test_guard_cond()
    test_guard_let()
    test_closure_capture()
    test_for_loop()
    print("=== Control Flow Test Complete ===")