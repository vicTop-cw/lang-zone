// Phase 16: 边界场景测试

// ── 16.1 列表推导式 ──
def test_list_comp() =
    result = [x * 2 for x in 1..5]
    print("List comp: ")
    print(result)

// ── 16.2 范围迭代 ──
def test_range() =
    i = 1
    while i < 5:
        print("Range val: ")
        print(i)
        i = i + 1

// ── 16.3 字符串比较 ──
def test_string_compare() =
    a = "hello"
    b = "hello"
    c = "world"
    print("a == b: ")
    print(a == b)
    print("a != c: ")
    print(a != c)

// ── 16.4 逻辑运算组合 ──
def test_logical_combo() =
    a = true
    b = false
    c = true
    print("a and c: ")
    print(a and c)
    print("a or b: ")
    print(a or b)
    print("not b: ")
    print(not b)

// ── 16.5 嵌套 if-elif-else ──
def test_nested_if() =
    x = 15
    if x > 20:
        print(">20")
    elif x > 10:
        print(">10 and <=20")
        if x > 15:
            print(">15")
        else:
            print("<=15")
    else:
        print("<=10")

// ── 入口 ──
def main() =
    print("=== Edge Test ===")
    test_list_comp()
    test_range()
    test_string_compare()
    test_logical_combo()
    test_nested_if()
    print("=== Edge Test Complete ===")