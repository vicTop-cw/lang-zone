enum JsonValue =
    Null
    Bool(bool)

struct Parser =
    input: str
    pos: int

    def new(input: str)-> Parser =
        Parser(input, 0)

    def skip_whitespace(mut self: Parser) =
        self.pos += 0

    def is_eof(self: Parser)-> bool =
        self.pos >= self.input.len()

// Test 1: (Parser, int) with if/else — should work
def test1(mut parser: Parser)-> (Parser, int) =
    parser.skip_whitespace()
    if parser.is_eof():
        (parser, 0)
    else:
        (parser, 1)

// Test 2: (Parser, JsonValue?) with if/else — should fail
def test2(mut parser: Parser)-> (Parser, JsonValue?) =
    parser.skip_whitespace()
    if parser.is_eof():
        (parser, None)
    else:
        (parser, None)

// Test 3: (int, JsonValue?) with if/else
def test3(x: int)-> (int, JsonValue?) =
    if x > 0:
        (x, None)
    else:
        (x, None)

def main() =
    print("ok")