struct Parser =
    input: str
    pos: int

    def has_next(self: Parser, offset: int)-> bool =
        n = self.input.len()
        self.pos + offset < n

    def next_is(self: Parser, offset: int, expected: str)-> bool =
        n = self.input.len()
        self.pos + offset < n and self.input[self.pos + offset] == expected

def main() =
    p = Parser("hello", 0)
    print(p.has_next(1))
    print(p.next_is(1, "e"))
