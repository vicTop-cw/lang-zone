// Task 2: 验证 enum + match 可用性
// 测试 enum 变体带数据 vs 不带数据

enum Color =
    Red
    Green
    Blue

enum Shape =
    Circle_(f64, f64, f64)
    Rect(f64, f64)
    Square(f64)

def area(s: Shape)-> f64 =
    match s:
        case Circle_(_, _, r):
            3.14159 * r * r
        case Rect(w, h):
            w * h
        case Square(side):
            side * side

def describe(c: Color)-> str =
    match c:
        case Red: "red"
        case Green: "green"
        case Blue: "blue"

def main() =
    c = Red
    print(describe(c))
    s1 = Circle_(0.0, 0.0, 5.0)
    s2 = Rect(3.0, 4.0)
    print(area(s1))
    print(area(s2))