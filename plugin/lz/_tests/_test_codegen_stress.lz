// _test_codegen_stress.lz — 阶段 4: 代码生成鲁棒性测试

// ── 4.1 字符串处理 ──

def test_string_concat() =
    a = "Hello"
    b = " "
    c = "World"
    result = a + b + c
    print("Chain concat: ")
    print(result)

def test_string_interpolation() =
    name = "Alice"
    age = 30
    result = "Name: " + name + ", Age: " + str(age)
    print("Interpolation: ")
    print(result)

def test_to_string() =
    val = 42
    s = val.to_string()
    print("to_string: ")
    print(s)

// ── 4.2 所有权与移动 ──

def test_move_semantics() =
    x = "hello"
    y = x
    print("After move: ")
    print(y)

def test_if_branch_reassign() =
    val = 1
    if val > 0:
        val = 2
    print("Branch reassign: ")
    print(val)

// ── 4.3 索引与切片 ──

def test_str_index() =
    s = "hello"
    ch = s[0]
    print("String index: ")
    print(ch)

// ── 4.4 变量遮蔽 ──

def test_variable_shadow() =
    x = 1
    if x > 0:
        x = 10
        print("Inner x: ")
        print(x)
    print("Outer x: ")
    print(x)

def test_loop_reassign() =
    i = 0
    while i < 3:
        print("Loop i: ")
        print(i)
        i = i + 1

// ── 主入口 ──
def main() =
    print("=== Codegen Stress Test ===")
    test_string_concat()
    test_string_interpolation()
    test_to_string()
    test_move_semantics()
    test_if_branch_reassign()
    test_str_index()
    test_variable_shadow()
    test_loop_reassign()
    print("=== Codegen Stress Test Complete ===")