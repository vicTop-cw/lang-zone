enum JsonValue =
    Null
    Bool(bool)
    Number(f64)
    String(str)
    Array(List<JsonValue>)
    Object(Dict<str, JsonValue>)

struct Parser =
    input: str
    pos: int

    def new(input: str)-> Parser =
        Parser(input, 0)

    def skip_whitespace(mut self: Parser) =
        while self.pos < self.input.len():
            ch = self.input[self.pos]
            if ch == " " or ch == "\n" or ch == "\r" or ch == "\t":
                self.pos += 1
            else:
                break

def parse_null(mut parser: Parser)-> (Parser, JsonValue?) =
    parser.skip_whitespace()
    if parser.pos >= parser.input.len():
        return (parser, None)
    if not (parser.input[parser.pos] == "n"):
        return (parser, None)
    parser.pos += 1
    if parser.pos >= parser.input.len():
        return (parser, None)
    if not (parser.input[parser.pos] == "u"):
        return (parser, None)
    parser.pos += 1
    if parser.pos >= parser.input.len():
        return (parser, None)
    if not (parser.input[parser.pos] == "l"):
        return (parser, None)
    parser.pos += 1
    if parser.pos >= parser.input.len():
        return (parser, None)
    if not (parser.input[parser.pos] == "l"):
        return (parser, None)
    parser.pos += 1
    return (parser, Some(JsonValue.Null))

def parse_true(mut parser: Parser)-> (Parser, JsonValue?) =
    parser.skip_whitespace()
    if parser.pos >= parser.input.len():
        return (parser, None)
    if not (parser.input[parser.pos] == "t"):
        return (parser, None)
    parser.pos += 1
    if parser.pos >= parser.input.len():
        return (parser, None)
    if not (parser.input[parser.pos] == "r"):
        return (parser, None)
    parser.pos += 1
    if parser.pos >= parser.input.len():
        return (parser, None)
    if not (parser.input[parser.pos] == "u"):
        return (parser, None)
    parser.pos += 1
    if parser.pos >= parser.input.len():
        return (parser, None)
    if not (parser.input[parser.pos] == "e"):
        return (parser, None)
    parser.pos += 1
    return (parser, Some(JsonValue.Bool(True)))

def parse_false(mut parser: Parser)-> (Parser, JsonValue?) =
    parser.skip_whitespace()
    if parser.pos >= parser.input.len():
        return (parser, None)
    if not (parser.input[parser.pos] == "f"):
        return (parser, None)
    parser.pos += 1
    if parser.pos >= parser.input.len():
        return (parser, None)
    if not (parser.input[parser.pos] == "a"):
        return (parser, None)
    parser.pos += 1
    if parser.pos >= parser.input.len():
        return (parser, None)
    if not (parser.input[parser.pos] == "l"):
        return (parser, None)
    parser.pos += 1
    if parser.pos >= parser.input.len():
        return (parser, None)
    if not (parser.input[parser.pos] == "s"):
        return (parser, None)
    parser.pos += 1
    if parser.pos >= parser.input.len():
        return (parser, None)
    if not (parser.input[parser.pos] == "e"):
        return (parser, None)
    parser.pos += 1
    return (parser, Some(JsonValue.Bool(False)))

def parse_bool(mut parser: Parser)-> (Parser, JsonValue?) =
    parser.skip_whitespace()
    saved: int = parser.pos
    (parser, val) = parse_true(parser)
    match val:
        case Some(_):
            return (parser, val)
        case None:
            parser.pos = saved
            parse_false(parser)

def main() =
    print("ok")