// Fuzz 13: 函数边界测试

// ── 13.1 递归函数 (display result instead of return) ──
def factorial_display(n: i64) =
    if n <= 1:
        print("fact result: 1")
    else:
        print("fact step: ")
        print(n)
        factorial_display(n - 1)

def test_recursion() =
    print("factorial(5): ")
    factorial_display(5)

// ── 13.2 尾递归 (display) ──
def sum_to_display(n: i64) =
    if n <= 0:
        print("sum done")
    else:
        print("sum n: ")
        print(n)
        sum_to_display(n - 1)

def test_tail_recursion() =
    print("sum_to(3): ")
    sum_to_display(3)

// ── 13.3 函数链式调用 (print-based) ──
def add5_print(x: i64) =
    print("add5: ")
    print(x + 5)

def mul3_print(x: i64) =
    print("mul3: ")
    print(x * 3)

def test_chain_call() =
    print("chain: ")
    add5_print(10)
    mul3_print(15)

// ── 13.4 管道运算符 ──
def test_pipe() =
    result = 10 |> add5_print
    mul3_print(15)

// ── 13.5 多参数函数 ──
def add3_display(a: i64, b: i64, c: i64) =
    print("add3: ")
    print(a + b + c)

def test_multi_param() =
    add3_display(1, 2, 3)

// ── 13.6 字符串参数 ──
def greet(name: str) =
    print("hello, ")
    print(name)

def test_str_param() =
    greet("world")

// ── 13.7 bool 条件 ──
def test_bool_check() =
    x = 2
    if x == 2:
        print("2 is even: true")
    else:
        print("2 is even: false")

    if x == 3:
        print("3 is even: true")
    else:
        print("3 is even: false")

// ── 入口 ──
def main() =
    print("=== Fuzz Func Edge ===")
    test_recursion()
    test_tail_recursion()
    test_chain_call()
    test_pipe()
    test_multi_param()
    test_str_param()
    test_bool_check()
    print("=== Fuzz Func Edge Complete ===")