// Fuzz 9: 闭包与管道

// ── 9.1 闭包捕获变量 ──
def test_closure_capture() =
    x = 10
    doubler = |y| x * y
    result = doubler(3)
    print("closure: ")
    print(result)

// ── 9.2 管道操作符 ──
def square(x: i64) = x * x

def double(x: i64) = x * 2

def test_pipe() =
    result = 3 |> square |> double
    print("pipe: ")
    print(result)

// ── 9.3 多步管道 ──
def add_one(x: i64) = x + 1

def test_pipe_chain() =
    result = 5 |> add_one |> square |> double
    print("pipe chain: ")
    print(result)

// ── 入口 ──
def main() =
    print("=== Fuzz Recursive ===")
    test_closure_capture()
    test_pipe()
    test_pipe_chain()
    print("=== Fuzz Recursive Complete ===")