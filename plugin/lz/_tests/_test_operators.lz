// _test_operators.lz — 阶段 9: 运算符与布尔短路

// ── 9.1 比较运算符 ──

def test_comparison_ops() =
    a = 10
    b = 20
    print("a >= b: ")
    print(a >= b)
    print("a <= b: ")
    print(a <= b)
    print("a != b: ")
    print(a != b)

// ── 9.2 布尔短路 ──

def test_short_circuit_and() =
    x = 0
    if false and x > 0:
        print("Never")
    else:
        print("Short circuit and")

def test_short_circuit_or() =
    y = 0
    if true or y > 0:
        print("Short circuit or")

// ── 9.3 逻辑非 ──

def test_logical_not() =
    flag = false
    if not flag:
        print("Not works")

// ── 9.4 算术运算 ──

def test_arithmetic() =
    a = 10
    b = 3
    print("Add: ")
    print(a + b)
    print("Sub: ")
    print(a - b)
    print("Mul: ")
    print(a * b)
    print("Div: ")
    print(a / b)

// ── 主入口 ──
def main() =
    print("=== Operators Test ===")
    test_comparison_ops()
    test_short_circuit_and()
    test_short_circuit_or()
    test_logical_not()
    test_arithmetic()
    print("=== Operators Test Complete ===")