// Fuzz 4: 表达式组合测试

// ── 4.1 长运算符链 ──
def test_long_chain() =
    result = 1 + 2 * 3 - 4 / 2 + 5
    print("long chain: ")
    print(result)

// ── 4.2 括号嵌套 ──
def test_paren_nest() =
    result = ((1 + 2) * (3 + 4)) - 5
    print("paren nest: ")
    print(result)

// ── 4.3 负号与表达式 ──
def test_neg_expr() =
    a = 10
    b = -(a + 5)
    print("neg expr: ")
    print(b)

// ── 4.4 逻辑表达式组合 ──
def test_logic_combo() =
    a = true
    b = false
    c = true
    d = (a and b) or (c and not b)
    print("logic combo: ")
    print(d)
    e = a and (b or c)
    print("logic combo 2: ")
    print(e)

// ── 4.5 比较组合 ──
def test_compare_combo() =
    x = 5
    y = 10
    result = (x < y) and (x + 5 == y)
    print("compare combo: ")
    print(result)

// ── 4.6 表达式作为函数参数 ──
def test_expr_arg() =
    a = 3
    print("expr arg: ")
    print(a * 2 + 1)

// ── 入口 ──
def main() =
    print("=== Fuzz Expr ===")
    test_long_chain()
    test_paren_nest()
    test_neg_expr()
    test_logic_combo()
    test_compare_combo()
    test_expr_arg()
    print("=== Fuzz Expr Complete ===")