// _test_enum_defer.lz — 阶段 11: Enum/Defer 边界

// ── 11.1 带数据的枚举 ──

enum Status =
    Ok_
    Failed(str)
    Pending_

def test_enum_with_data() =
    s = Failed("Something went wrong")
    match s:
        case Ok_:
            print("OK")
        case Failed(msg):
            print("Error: ")
            print(msg)
        case Pending_:
            print("Pending")

// ── 11.2 defer 边界 ──

def test_defer_order() =
    defer print("defer 1")
    defer print("defer 2")
    print("normal body")

// ── 11.3 defer 与提前返回 ──

def test_defer_with_return() =
    defer print("defer cleanup")
    print("before return")
    if true:
        return
    print("never reached")

// ── 主入口 ──
def main() =
    print("=== Enum/Defer Test ===")
    test_enum_with_data()
    test_defer_order()
    test_defer_with_return()
    print("=== Enum/Defer Test Complete ===")