// LZ Lexer

enum TokenType =
    Keyword(str)
    IntLiteral(int)
    FloatLiteral(f64)
    StringLiteral(str)
    Ident(str)
    Plus
    Minus
    Star
    Slash
    Percent
    Eq
    EqEq
    NotEq
    Lt
    Gt
    Le
    Ge
    Colon
    ColonEq
    Arrow
    FatArrow
    Dot
    DotDot
    DotDotEq
    Comma
    LParen
    RParen
    LBracket
    RBracket
    LBrace
    RBrace
    At
    Question
    Newline
    EOF
    Unknown(str)

struct Token =
    kind: TokenType
    lexeme: str
    line: int
    col: int

def is_ident_start(ch: str)-> bool =
    ch >= "a" and ch <= "z" or ch >= "A" and ch <= "Z" or ch == "_"

def is_ident_char(ch: str)-> bool =
    is_ident_start(ch) or ch >= "0" and ch <= "9"

def is_kw1(word: str)-> bool =
    word == "def" or word == "struct" or word == "enum" or word == "trait"

def is_kw2(word: str)-> bool =
    word == "impl" or word == "if" or word == "elif" or word == "else"

def is_kw3(word: str)-> bool =
    word == "match" or word == "case" or word == "for" or word == "in"

def is_kw4(word: str)-> bool =
    word == "while" or word == "loop" or word == "break" or word == "continue"

def is_kw5(word: str)-> bool =
    word == "return" or word == "guard" or word == "defer" or word == "with"

def is_kw6(word: str)-> bool =
    word == "try" or word == "catch" or word == "finally" or word == "raise"

def is_kw7(word: str)-> bool =
    word == "panic" or word == "import" or word == "from" or word == "as"

def is_kw8(word: str)-> bool =
    word == "const" or word == "mut" or word == "ref" or word == "owned"

def is_kw9(word: str)-> bool =
    word == "let" or word == "where" or word == "and" or word == "or"

def is_kw10(word: str)-> bool =
    word == "not" or word == "is" or word == "True" or word == "False"

def is_kw11(word: str)-> bool =
    word == "None" or word == "Some" or word == "Ok" or word == "Err"

def is_kw12(word: str)-> bool =
    word == "Self" or word == "async" or word == "await" or word == "spawn"

def is_kw13(word: str)-> bool =
    word == "yield" or word == "test" or word == "suite" or word == "assert"

def is_kw14(word: str)-> bool =
    word == "check" or word == "macro" or word == "comptime" or word == "raises"

def is_kw_a(word: str)-> bool =
    is_kw1(word) or is_kw2(word) or is_kw3(word) or is_kw4(word)

def is_kw_b(word: str)-> bool =
    is_kw5(word) or is_kw6(word) or is_kw7(word) or is_kw8(word)

def is_kw_c(word: str)-> bool =
    is_kw9(word) or is_kw10(word) or is_kw11(word)

def is_kw_d(word: str)-> bool =
    is_kw12(word) or is_kw13(word) or is_kw14(word)

def is_keyword(word: str)-> bool =
    is_kw_a(word) or is_kw_b(word) or is_kw_c(word) or is_kw_d(word)

struct Lexer =
    input: str
    pos: int
    line: int
    col: int
    tokens: List<Token>

    def new(input: str)-> Lexer =
        Lexer(input, 0, 1, 1, [])

    def add_token(mut self: Lexer, t: Token) =
        self.tokens.append(t)

    def skip_whitespace(mut self: Lexer) =
        while self.pos < self.input.len():
            if self.input[self.pos] == " " or self.input[self.pos] == "\t":
                self.pos += 1
                self.col += 1
            else:
                break

    def skip_line_comment(mut self: Lexer) =
        self.pos += 2
        while self.pos < self.input.len():
            if self.input[self.pos] == "\n":
                break
            self.pos += 1

    def skip_block_comment(mut self: Lexer) =
        self.pos += 2
        while self.pos < self.input.len():
            if self.input[self.pos] == "*":
                self.pos += 1
                if self.pos < self.input.len():
                    if self.input[self.pos] == "/":
                        self.pos += 1
                        return
            else:
                self.pos += 1

    def read_number(mut self: Lexer)-> Token =
        line = self.line
        col = self.col
        start = self.pos
        is_float = False
        while self.pos < self.input.len():
            if self.input[self.pos] >= "0" and self.input[self.pos] <= "9":
                self.pos += 1
                self.col += 1
            elif self.input[self.pos] == ".":
                if is_float:
                    break
                is_float = True
                self.pos += 1
                self.col += 1
            else:
                break
        lexeme = self.input[start..self.pos]
        if is_float:
            Token(FloatLiteral(0.0), lexeme, line, col)
        else:
            Token(IntLiteral(0), lexeme, line, col)

    def read_string(mut self: Lexer)-> Token =
        line = self.line
        col = self.col
        self.pos += 1
        self.col += 1
        result = ""
        while self.pos < self.input.len():
            if self.input[self.pos] == "\"":
                self.pos += 1
                self.col += 1
                return Token(StringLiteral(result), result, line, col)
            elif self.input[self.pos] == "\\":
                self.pos += 1
                self.col += 1
                if self.pos >= self.input.len():
                    break
                esc = self.input[self.pos]
                if esc == "n":
                    result += "\n"
                elif esc == "t":
                    result += "\t"
                elif esc == "r":
                    result += "\r"
                elif esc == "\\":
                    result += "\\"
                elif esc == "\"":
                    result += "\""
                else:
                    result += esc
                self.pos += 1
                self.col += 1
            else:
                result += self.input[self.pos]
                self.pos += 1
                self.col += 1
        Token(Unknown("unclosed string"), "\"", line, col)

    def read_ident_or_keyword(mut self: Lexer)-> Token =
        line = self.line
        col = self.col
        start = self.pos
        while self.pos < self.input.len():
            if is_ident_char(self.input[self.pos]):
                self.pos += 1
                self.col += 1
            else:
                break
        lexeme = self.input[start..self.pos]
        if is_keyword(lexeme):
            Token(Keyword(lexeme), lexeme, line, col)
        else:
            Token(Ident(lexeme), lexeme, line, col)

    def read_eq(mut self: Lexer)-> Token =
        self.pos += 1
        if self.pos < self.input.len():
            if self.input[self.pos] == "=":
                self.pos += 1
                self.col += 2
                Token(EqEq, "==", self.line, self.col - 2)
            elif self.input[self.pos] == ">":
                self.pos += 1
                self.col += 2
                Token(FatArrow, "=>", self.line, self.col - 2)
            else:
                self.col += 1
                Token(Eq, "=", self.line, self.col - 1)
        else:
            self.col += 1
            Token(Eq, "=", self.line, self.col - 1)

    def read_colon(mut self: Lexer)-> Token =
        self.pos += 1
        if self.pos < self.input.len():
            if self.input[self.pos] == "=":
                self.pos += 1
                self.col += 2
                Token(ColonEq, ":=", self.line, self.col - 2)
            else:
                self.col += 1
                Token(Colon, ":", self.line, self.col - 1)
        else:
            self.col += 1
            Token(Colon, ":", self.line, self.col - 1)

    def read_bang(mut self: Lexer)-> Token =
        self.pos += 1
        if self.pos < self.input.len():
            if self.input[self.pos] == "=":
                self.pos += 1
                self.col += 2
                Token(NotEq, "!=", self.line, self.col - 2)
            else:
                self.col += 1
                Token(Unknown("!"), "!", self.line, self.col - 1)
        else:
            self.col += 1
            Token(Unknown("!"), "!", self.line, self.col - 1)

    def read_lt(mut self: Lexer)-> Token =
        self.pos += 1
        if self.pos < self.input.len():
            if self.input[self.pos] == "=":
                self.pos += 1
                self.col += 2
                Token(Le, "<=", self.line, self.col - 2)
            else:
                self.col += 1
                Token(Lt, "<", self.line, self.col - 1)
        else:
            self.col += 1
            Token(Lt, "<", self.line, self.col - 1)

    def read_gt(mut self: Lexer)-> Token =
        self.pos += 1
        if self.pos < self.input.len():
            if self.input[self.pos] == "=":
                self.pos += 1
                self.col += 2
                Token(Ge, ">=", self.line, self.col - 2)
            else:
                self.col += 1
                Token(Gt, ">", self.line, self.col - 1)
        else:
            self.col += 1
            Token(Gt, ">", self.line, self.col - 1)

    def read_minus(mut self: Lexer)-> Token =
        self.pos += 1
        if self.pos < self.input.len():
            if self.input[self.pos] == ">":
                self.pos += 1
                self.col += 2
                Token(Arrow, "->", self.line, self.col - 2)
            else:
                self.col += 1
                Token(Minus, "-", self.line, self.col - 1)
        else:
            self.col += 1
            Token(Minus, "-", self.line, self.col - 1)

    def read_dot(mut self: Lexer)-> Token =
        self.pos += 1
        if self.pos < self.input.len():
            if self.input[self.pos] == ".":
                self.pos += 1
                if self.pos < self.input.len():
                    if self.input[self.pos] == "=":
                        self.pos += 1
                        self.col += 3
                        Token(DotDotEq, "..=", self.line, self.col - 3)
                    else:
                        self.col += 2
                        Token(DotDot, "..", self.line, self.col - 2)
                else:
                    self.col += 2
                    Token(DotDot, "..", self.line, self.col - 2)
            else:
                self.col += 1
                Token(Dot, ".", self.line, self.col - 1)
        else:
            self.col += 1
            Token(Dot, ".", self.line, self.col - 1)

    def tokenize(mut self: Lexer)-> List<Token> =
        while self.pos < self.input.len():
            self.scan_token()
        self.add_token(Token(EOF, "", self.line, self.col))
        self.tokens

    def scan_token(mut self: Lexer) =
        if self.pos >= self.input.len():
            return
        if self.input[self.pos] == " " or self.input[self.pos] == "\t":
            self.skip_whitespace()
        elif self.input[self.pos] == "\n":
            self.add_token(Token(Newline, "\n", self.line, self.col))
            self.pos += 1
            self.line += 1
            self.col = 1
        elif self.input[self.pos] == "/":
            self.pos += 1
            if self.pos < self.input.len():
                if self.input[self.pos] == "/":
                    self.skip_line_comment()
                elif self.input[self.pos] == "*":
                    self.skip_block_comment()
                else:
                    self.add_token(Token(Slash, "/", self.line, self.col))
                    self.col += 1
            else:
                self.add_token(Token(Slash, "/", self.line, self.col))
                self.col += 1
        elif self.input[self.pos] >= "0" and self.input[self.pos] <= "9":
            self.add_token(self.read_number())
        elif self.input[self.pos] == "\"":
            self.add_token(self.read_string())
        elif is_ident_start(self.input[self.pos]):
            self.add_token(self.read_ident_or_keyword())
        elif self.input[self.pos] == "=":
            self.add_token(self.read_eq())
        elif self.input[self.pos] == ":":
            self.add_token(self.read_colon())
        elif self.input[self.pos] == "!":
            self.add_token(self.read_bang())
        elif self.input[self.pos] == "<":
            self.add_token(self.read_lt())
        elif self.input[self.pos] == ">":
            self.add_token(self.read_gt())
        elif self.input[self.pos] == "-":
            self.add_token(self.read_minus())
        elif self.input[self.pos] == ".":
            self.add_token(self.read_dot())
        elif self.input[self.pos] == "?":
            self.add_token(Token(Question, "?", self.line, self.col))
            self.pos += 1
            self.col += 1
        elif self.input[self.pos] == "+":
            self.add_token(Token(Plus, "+", self.line, self.col))
            self.pos += 1
            self.col += 1
        elif self.input[self.pos] == "*":
            self.add_token(Token(Star, "*", self.line, self.col))
            self.pos += 1
            self.col += 1
        elif self.input[self.pos] == "%":
            self.add_token(Token(Percent, "%", self.line, self.col))
            self.pos += 1
            self.col += 1
        elif self.input[self.pos] == "(":
            self.add_token(Token(LParen, "(", self.line, self.col))
            self.pos += 1
            self.col += 1
        elif self.input[self.pos] == ")":
            self.add_token(Token(RParen, ")", self.line, self.col))
            self.pos += 1
            self.col += 1
        elif self.input[self.pos] == "[":
            self.add_token(Token(LBracket, "[", self.line, self.col))
            self.pos += 1
            self.col += 1
        elif self.input[self.pos] == "]":
            self.add_token(Token(RBracket, "]", self.line, self.col))
            self.pos += 1
            self.col += 1
        elif self.input[self.pos] == "{":
            self.add_token(Token(LBrace, "{", self.line, self.col))
            self.pos += 1
            self.col += 1
        elif self.input[self.pos] == "}":
            self.add_token(Token(RBrace, "}", self.line, self.col))
            self.pos += 1
            self.col += 1
        elif self.input[self.pos] == ",":
            self.add_token(Token(Comma, ",", self.line, self.col))
            self.pos += 1
            self.col += 1
        elif self.input[self.pos] == "@":
            self.add_token(Token(At, "@", self.line, self.col))
            self.pos += 1
            self.col += 1
        else:
            self.add_token(Token(Unknown(self.input[self.pos]), self.input[self.pos], self.line, self.col))
            self.pos += 1
            self.col += 1

def print_token(t: Token) =
    match t.kind:
        case Keyword(k):
            print("Keyword: " + k)
        case Ident(name):
            print("Ident: " + name)
        case IntLiteral(n):
            print("Int: " + t.lexeme)
        case FloatLiteral(n):
            print("Float: " + t.lexeme)
        case StringLiteral(s):
            print("String: " + t.lexeme)
        case Newline:
            print("Newline")
        case EOF:
            print("EOF")
        case _:
            print("Token: " + t.lexeme)

def main() =
    lexer = Lexer.new("def main() = 42\n")
    tokens = lexer.tokenize()
    print("Tokens:")
    for t in tokens:
        print_token(t)