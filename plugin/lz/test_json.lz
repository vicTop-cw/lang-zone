// ============================================================
// test_json.lz — JSON 解析器测试用例
// ============================================================

suite JsonParserTests:
    test "parse null":
        r = parse("null")
        match r:
            case Some(v):
                assert True
            case None:
                assert False

    test "parse true":
        r = parse("true")
        match r:
            case Some(v):
                assert True
            case None:
                assert False

    test "parse false":
        r = parse("false")
        match r:
            case Some(v):
                assert True
            case None:
                assert False

    test "parse number":
        r = parse("42")
        match r:
            case Some(v):
                assert True
            case None:
                assert False

    test "parse string":
        r = parse("\"hello\"")
        match r:
            case Some(v):
                assert True
            case None:
                assert False

    test "parse empty array":
        r = parse("[]")
        match r:
            case Some(v):
                assert True
            case None:
                assert False

    test "parse empty object":
        r = parse("{}")
        match r:
            case Some(v):
                assert True
            case None:
                assert False

    test "parse array with elements":
        r = parse("[1, 2, 3]")
        match r:
            case Some(v):
                assert True
            case None:
                assert False

    test "parse simple object":
        r = parse("{\"key\": \"value\"}")
        match r:
            case Some(v):
                assert True
            case None:
                assert False

    test "parse nested object":
        r = parse("{\"a\": {\"b\": 1}}")
        match r:
            case Some(v):
                assert True
            case None:
                assert False

def main() =
    print("JSON parser tests loaded")